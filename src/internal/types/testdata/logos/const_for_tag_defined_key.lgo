package p

import "comptime"

type Key string

const k Key = "key"

func lookup() {
	const for _, f := range comptime.Fields[struct {
		Field int `key:"value"`
	}]() {
		_ = f.Tag.Get(string(k))
		_ = f.Tag.Get(k /* ERROR "as string value in argument to f.Tag.Get" */)
	}
}
