package p

type PropRM interface {
	const M int
}

type GoodRM struct : PropRM {
}

func (s GoodRM) M() int { return 1 }

var _ PropRM = GoodRM{}

type BadRM struct : PropRM /* ERROR "correctness::property_unsatisfied" */ {
}

func (s const BadRM) M() int { return 1 }
