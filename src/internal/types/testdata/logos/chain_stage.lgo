func unorderedAfterMap(ctx context.Context, xs []int) {
	_, _ = xs.group(ctx, limit = 2).map(x => x).unordered /* ERROR "directly follow group" */ ()
}

func unorderedTwice(ctx context.Context, xs []int) {
	_, _ = xs.group(ctx, limit = 2).unordered().unordered /* ERROR "directly follow group" */ ().map(x => x)
