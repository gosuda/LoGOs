func stageRangeTerminal(ctx context.Context, xs []int) error {
	for y := range xs.group(ctx, limit = 2).map(x => x).sum /* ERROR "may follow group" */ () {
		_ = y
	}
	return nil
}

func stageRangeTake(ctx context.Context, xs []int) error {
	for y := range xs.group(ctx, limit = 2).map(x => x).take /* ERROR "may follow group" */ (1) {
		_ = y
	}
	return nil
