package p

type A int
type B string
type C bool

type U interface {
	A | B
}

type V3 interface {
	A | B | C
}

type Sub interface {
	A
}

func missMember(x U) {
	switch /* ERRORx "nonexhaustive_switch.*misses: .*B" */ x.(type) {
	case A:
	case nil:
	}
}

func missNil(x U) {
	switch /* ERRORx "nonexhaustive_switch.*misses: nil" */ x.(type) {
	case A:
	case B:
	}
}

func missTwo(x V3) {
	switch /* ERRORx "nonexhaustive_switch.*misses: B, C, nil" */ x.(type) {
	case A:
	}
}

func withDefault(x U) {
	switch x.(type) {
	case A:
	default:
	}
}

func subUnion(x U) {
	switch x.(type) {
	case Sub:
	case B:
	case nil:
	}
}

func exhaustive(x U) {
	switch x.(type) {
	case A:
	case B:
	case nil:
	}
}

func dupCase(x U) {
	switch x.(type) {
	case A:
	case A /* ERRORx "duplicate case .*A in type switch" */ :
	case B:
	case nil:
	}
}
