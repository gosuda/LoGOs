package p

type A int
type B string
type C bool

type U interface {
	A | B
}

type V3 interface {
	A | B | C
}

type Sub interface {
	A
}

func missMember(x U) {
	switch /* ERRORx "nonexhaustive_switch.*misses: .*B" */ x.(type) {
	case A:
	case nil:
	}
}

func missNil(x U) {
	switch /* ERRORx "nonexhaustive_switch.*misses: nil" */ x.(type) {
	case A:
	case B:
	}
}

func missTwo(x V3) {
	switch /* ERRORx "nonexhaustive_switch.*misses: B, C, nil" */ x.(type) {
	case A:
	}
}

func withDefault(x U) {
	switch x.(type) {
	case A:
	default:
	}
}

func subUnion(x U) {
	switch x.(type) {
	case Sub:
	case B:
	case nil:
	}
}

func exhaustive(x U) {
	switch x.(type) {
	case A:
	case B:
	case nil:
	}
}

func dupCase(x U) {
	switch x.(type) {
	case A:
	case A /* ERRORx "duplicate case .*A in type switch" */ :
	case B:
	case nil:
	}
}

func narrowSwitchEarly(p U?) string {
	if p == nil {
		return "none"
	}
	switch p.(type) {
	case A:
		return "a"
	case B:
		return "b"
	}
	return "unreachable"
}

func narrowSwitchBlock(p U?) string {
	if p != nil {
		switch p.(type) {
		case A:
			return "a"
		case B:
			return "b"
		}
		return "unreachable"
	}
	return "none"
}

func narrowSwitchExpr(p U?) string {
	if p == nil {
		return "none"
	}
	return switch p.(type) {
	case A => "a"
	case B => "b"
	}
}

type Bytes162 interface {
	[]byte | A
}

func narrowSwitchStructRepr(p Bytes162?) {
	if p == nil {
		return
	}
	switch /* ERROR "misses: nil" */ p.(type) {
	case []byte:
	case A:
	}
}

func narrowSwitchReassigned(p U?) {
	if p == nil {
		return
	}
	p = nil
	switch p /* ERROR "not an interface" */ .(type) {
	case A:
	case B:
	}
}

func narrowSwitchClosure(p U?) {
	f := func() {
		p = nil
	}
	_ = f
	if p == nil {
		return
	}
	switch p /* ERROR "not an interface" */ .(type) {
	case A:
	case B:
	}
}

func narrowSwitchGoto(p U?, c bool) string {
	if c {
		goto done
	}
	if p == nil {
		return "none"
	}
done:
	switch p /* ERROR "not an interface" */ .(type) {
	case A:
		return "a"
	case B:
		return "b"
	case nil:
		return "nil"
	}
	return "?"
}
