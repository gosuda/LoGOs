package p

func fetch337_34() (int, error) { return 1, nil }
func use337_34(v int) {}

type h337_34 struct {
	stats int
	err   error
}

// Nested cleanup replaces the result's error after the body exit. The
// final error is always nil, so checking it must not prove the read.
func nestedFieldClear337_34() {
	h := h337_34{}
	func() {
		defer func() {
			defer func() { h.err = nil }()
			h.stats, h.err = fetch337_34()
		}()
	}()
	if h.err != nil {
		return
	}
	use337_34(h.stats /* ERROR "[correctness::result_before_error_check]" */)
}

// A guard-only overwrite without a result rewrite still reports: clearing
// the error alone cannot validate an unchecked use.
func guardOnlyFieldClear337_34() {
	h := h337_34{}
	h.stats, h.err = fetch337_34()
	func() {
		defer func() {
			h.err = nil
		}()
	}()
	if h.err != nil {
		return
	}
	use337_34(h.stats /* ERROR "[correctness::result_before_error_check]" */)
}
