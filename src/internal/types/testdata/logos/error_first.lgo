package p

import "bytes"
import "strconv"

func fetch() (int, error) {
	return 1, nil
}

func useInt(v int) {
}

func beforeCheck() {
	n, err := fetch()
	useInt(n /* ERROR "[correctness::result_before_error_check]" */)
	if err != nil {
		return
	}
	useInt(n)
}

func afterCheck() {
	n, err := fetch()
	if err != nil {
		return
	}
	useInt(n)
	_ = n
}

func insideNil() {
	n, err := fetch()
	if err == nil {
		useInt(n)
	}
	useInt(n /* ERROR "[correctness::result_before_error_check]" */)
}

func reassignResult() {
	n, err := fetch()
	n = 42
	useInt(n)
	_ = err
}

func plainAssign() {
	var n int
	var err error
	n, err = fetch()
	useInt(n /* ERROR "[correctness::result_before_error_check]" */)
	if err != nil {
		return
	}
	useInt(n)
	_ = err
}

func goPackageCall() {
	n, err := strconv.Atoi("42")
	useInt(n)
	if err != nil {
		return
	}
	useInt(n)
}

func goMethodCall() {
	r := bytes.NewReader([]byte("hi"))
	buf := make([]byte, 4)
	n, err := r.Read(buf)
	useInt(n)
	if err != nil {
		return
	}
	useInt(n)
	_ = buf
}
