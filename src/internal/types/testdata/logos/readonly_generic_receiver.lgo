type PtrWrite[T ~*int] struct {
	v T
}

func (p *PtrWrite[T]) Count() int {
	*p.v = 1
	return 0
}

type SliceWrite[T ~[]int] struct {
	v T
}

func (s *SliceWrite[T]) Count() int {
	s.v[0] = 1
	return 0
}

type MapWrite[T ~map[string]int] struct {
	v T
}

func (m *MapWrite[T]) Count() int {
	m.v["a"] = 1
	return 0
}

var ptrWrite = &PtrWrite[*int]{v: new(int)}
var sliceWrite = &SliceWrite[[]int]{}
var mapWrite = &MapWrite[map[string]int]{}

