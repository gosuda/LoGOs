func (u *UnsafeTerm[T]) Get() T { return u.v }

type AnyTerm[T ~int | any] struct {
	v T
}

func (a *AnyTerm[T]) Get() T { return a.v }

type FreeTerm[T ~int | [2]int | struct{ n int }] struct {
	v T
}

func (f *FreeTerm[T]) Get() T { return f.v }

type PtrOnly[T ~*int] struct {
	v T
}

type PtrGetter interface {
