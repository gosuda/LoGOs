package p

import "unsafe"

type Counter interface {
	const Count() int
}

type Sized interface {
	const Size() int
}

type IntGetter interface {
	const Get() int
}

type Box[T any] struct {
	n  int
	xs []T
}

func (b *Box[T]) Count() int { return b.n }

func (b Box[T]) Size() int { return len(b.xs) }

var boxPtr = &Box[string]{}
var boxVal = Box[[]int]{}

var _ Counter = boxPtr
var _ Sized = boxVal
var _ Sized = boxPtr

type Bumper[T any] struct {
	n  int
	xs []T
}

func (b *Bumper[T]) Count() int {
	b.n++
	return b.n
}

func (b Bumper[T]) Size() int {
	var zero T
	b.xs[0] = zero
	return len(b.xs)
}

var bumpPtr = &Bumper[int]{}
var bumpVal = Bumper[int]{}

var _ Counter = bumpPtr /* ERROR "[correctness::const_view_mutation]" */
var _ Sized = bumpVal /* ERROR "[correctness::const_view_mutation]" */

type Relay[T any] struct {
	n int
}

func (r *Relay[T]) inc() { r.n++ }

func (r *Relay[T]) Count() int {
	r.inc()
	return r.n
}

var relayPtr = &Relay[int]{}

var _ Counter = relayPtr /* ERROR "[correctness::const_view_mutation]" */

type Reader[T any] struct {
	n int
}

func (r *Reader[T]) peek() int { return r.n }

func (r *Reader[T]) Count() int { return r.peek() }

var readerPtr = &Reader[int]{}

var _ Counter = readerPtr

func viewSize(b const Box[string]) int { return b.Size() }

func viewSizeNested(b const Box[[]int]) int { return b.Size() }

func viewBump(b const Bumper[string]) int {
	return b.Size /* ERROR "[correctness::const_view_mutation]" */ ()
}

func viewCount(b const *Box[string]) int {
	return b.Count /* ERROR "[correctness::const_view_mutation]" */ ()
}

type Slicer interface {
	const Items() []string
}

type Ptrer interface {
	const Ptr() *int
}

type Mapper interface {
	const Table() map[string]int
}

type Alias[T any] struct {
	xs []T
	p  *T
}

func (a *Alias[T]) Items() []T { return a.xs }

func (a *Alias[T]) Ptr() *T { return a.p }

type MapAlias[K comparable, V any] struct {
	m map[K]V
}

func (a *MapAlias[K, V]) Table() map[K]V { return a.m }

var aliasPtr = &Alias[string]{p: new(string)}
var aliasInt = &Alias[int]{p: new(int)}
var mapAlias = &MapAlias[string, int]{}

var _ Slicer = aliasPtr /* ERROR "[correctness::const_view_mutation]" */
var _ Ptrer = aliasInt /* ERROR "[correctness::const_view_mutation]" */
var _ Mapper = mapAlias /* ERROR "[correctness::const_view_mutation]" */

type Counts[T any] struct {
	xs []T
	m  map[string]T
}

func (c *Counts[T]) Count() int { return len(c.xs) + len(c.m) }

var countsPtr = &Counts[[]int]{}

var _ Counter = countsPtr

type Num interface {
	~int | ~float64
}

type Scalar[T Num] struct {
	v T
}

func (s *Scalar[T]) Get() T { return s.v }

type Open[T any] struct {
	v T
}

func (o *Open[T]) Get() T { return o.v }

type Cmp[T comparable] struct {
	v T
}

func (c *Cmp[T]) Get() T { return c.v }

type Widen[T ~int | ~[]int] struct {
	v T
}

func (w *Widen[T]) Get() T { return w.v }

var scalarPtr = &Scalar[int]{}
var openPtr = &Open[int]{}
var cmpPtr = &Cmp[int]{}
var widenPtr = &Widen[int]{}

var _ IntGetter = scalarPtr
var _ IntGetter = openPtr /* ERROR "[correctness::const_view_mutation]" */
var _ IntGetter = cmpPtr /* ERROR "[correctness::const_view_mutation]" */
var _ IntGetter = widenPtr /* ERROR "[correctness::const_view_mutation]" */

type HasV interface {
	const V int
}

type Holder[T Num] struct {
	v T
}

func (h *Holder[T]) V() T { return h.v }

type Wrap struct : HasV {
	Holder[int]
}

type BadHolder[T Num] struct {
	v T
}

func (h *BadHolder[T]) V() T {
	h.v++
	return h.v
}

type BadWrap struct : HasV /* ERROR "[correctness::const_view_mutation]" */ {
	BadHolder[int]
}

type Mut interface {
	Bump()
}

type Shared[T Mut] struct {
	v T
}

func (s *Shared[T]) Count() int {
	s.v.Bump()
	return 0
}

var sharedPtr = &Shared[Mut]{}

var _ Counter = sharedPtr /* ERROR "[correctness::const_view_mutation]" */

type Selfish[T any] struct {
	n int
}

type SelfGetter interface {
	const Self() *Selfish[int]
}

func (s *Selfish[T]) Self() *Selfish[T] { return s }

var selfPtr = &Selfish[int]{}

var _ SelfGetter = selfPtr /* ERROR "[correctness::const_view_mutation]" */

func (a MapAlias[K, V]) Put(k K, v V) int {
	a.m[k] = v
	return len(a.m)
}

func (a Alias[T]) Store(v T) int {
	*a.p = v
	return 0
}

func viewPut(a const MapAlias[string, int]) int {
	return a.Put /* ERROR "[correctness::const_view_mutation]" */ ("k", 1)
}

func viewStore(a const Alias[int]) int {
	return a.Store /* ERROR "[correctness::const_view_mutation]" */ (1)
}

type Tally[T any] struct : Counter {
	n  int
	xs []T
}

func (t *Tally[T]) Count() int { return t.n + len(t.xs) }

type BadTally[T any] struct : Counter {
	n int
}

func (t *BadTally[T]) Count /* ERROR "[correctness::const_view_mutation]" */ () int {
	t.n++
	return t.n
}

type GenProp[T any] interface {
	const V T
}

type Slot[T Num] struct : GenProp[T] {
	v T
}

func (s *Slot[T]) V() T { return s.v }

type OpenSlot[T any] struct : GenProp[ /* ERROR "[correctness::const_view_mutation]" */ T] {
	v T
}

func (s *OpenSlot[T]) V() T { return s.v }

type BumpSlot[T Num] struct : GenProp[ /* ERROR "[correctness::const_view_mutation]" */ T] {
	v T
}

func (s *BumpSlot[T]) V() T {
	s.v++
	return s.v
}

type PtrTerm[T ~int | ~*int] struct {
	v T
}

func (p *PtrTerm[T]) Get() T { return p.v }

type MapTerm[T ~int | ~map[string]int] struct {
	v T
}

func (m *MapTerm[T]) Get() T { return m.v }

