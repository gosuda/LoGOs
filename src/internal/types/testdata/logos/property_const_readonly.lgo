package p

type RO interface {
	const ID int
	const Start() error
}

type Gadget struct : RO /* ERROR "const_view_mutation" */ {
	ID int
}

func (m *Gadget) Start() error {
	m.ID = 1
	return nil
}

var g = &Gadget{ID: 1}

var _ RO = g /* ERROR "const_view_mutation" */
