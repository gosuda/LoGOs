type reservedItems = iter.Seq[int]

type reservedBox struct{ f int }

func (reservedBox) m() {}

func reservedIndexAssign() iter.Seq[int] {
	yield := []int{1, 2}
	yield /* ERRORx "." */ [0] = 5
	yield 1
}

func reservedIndexAssignAlias() reservedItems {
	yield := []int{1, 2}
	yield /* ERRORx "." */ [0] = 5
	yield 1
}

func reservedIndexInc() iter.Seq[int] {
