func outsideDeref(p *int) int {
	yield /* ERROR "yield_outside_generator" */ *p + 1
	return 0
}

func outsideAddress(x int) bool {
	yield /* ERROR "yield_outside_generator" */ &x == nil
	return false
}

func outsideNot(ok bool) bool {
	yield /* ERROR "yield_outside_generator" */ !ok
