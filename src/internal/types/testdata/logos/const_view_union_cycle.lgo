package p

type loop /* ERROR "invalid recursive type" */ const loop

func assertLoop(v loop) {
	_ = v.(int)
}

func switchLoop(v loop) string {
	switch v.(type) {
	case int:
		return "int"
	default:
		return "other"
	}
}

func exprLoop(v loop) string {
	return switch v.(type) {
	case int => "int"
	default => "other"
	}
}
