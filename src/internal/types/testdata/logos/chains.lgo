func bumpEffect(x int) int { return 2 * x }

func chainSideEffectBeforeSort(xs []int) {
	_ = xs.map(x => bumpEffect(x)).sortBy /* ERROR "[suspicious::side_effect_before_sort] chain lambda with a call of unknown purity before sortBy" */ (x => x)
	_ = xs.filter(x => x > 0).map(x => bumpEffect(x) + 1).sortBy /* ERROR "[suspicious::side_effect_before_sort] chain lambda with a call of unknown purity before sortBy" */ (x => x)
	_ = xs.map(x => x * 2).sortBy(x => x)
	_ = xs.map(x => float64(x)).sortBy(x => x)
	_ = xs.map(x => len("ab") + x).sortBy(x => x)
}

