func chainShapes(xs []int, strs []string) {
	_ = xs.filter(x => x > 0)
	_ = xs.map(x => x * 2)
	_ = xs.map(x => "s")
	var ss []string = xs.map(x => "s")
	_ = ss
	var fs []float64 = xs.map(x => float64(x))
	_ = fs
	var fs2 []float64 = xs.map(x => float64(x) / 3)
	_ = fs2
	var ks []int = strs.sortBy(s => s).map(s => len(s))
	_ = ks
	_ = xs.find(x => x > 0)
	_ = xs.any(x => x > 0)
	_ = xs.all(x => x > 0)
	_ = xs.sortBy(x => x)
	_ = strs.sortBy(s => s)
	_ = xs.first()
	_ = xs.last()
	_ = xs.get(0)
	_ = xs.take(2)
	_ = xs.drop(2)
	_ = xs.sum()
	_ = xs.count()
	_ = xs.count(x => x > 0)
	_ = xs.filter(x => x > 0).map(x => x).take(3).drop(1)
	_ = xs.find(x => x > 0) ?? -1
	_ = xs.first() ?? 0
	_ = xs.get(0) ?? 0
}

func chainFloats(xs []float64) {
	_ = xs.sum()
	_ = xs.sortBy(x => x)
}

