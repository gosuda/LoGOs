package p

type U interface {
	int | string
}

func noDefault(n int) int {
	return switch /* ERROR "correctness::switch_expr_needs_default" */ n {
	case 1 => 1
	}
}

func typedVsUntyped(n int) int {
	return switch n {
	case 1 => n
	default => "s" // ERROR "correctness::switch_arm_mismatch"
	}
}

func allUntyped(n int) int {
	return switch n {
	case 1 => 1
	default => "s" // ERROR "correctness::switch_arm_mismatch"
	}
}

func nilToInt(n int) int {
	return switch n {
	case 1 => n
	case 2 => nil // ERROR "correctness::switch_arm_mismatch"
	default => 1
	}
}

func singleUntyped(n int) int {
	return switch n {
	default => 1
	}
}

func nilAlone(x U) int {
	return switch /* ERROR "correctness::nonexhaustive_switch" */ x.(type) {
	case nil => 0
	}
}

func unionCommon(n int, x U) U {
	return switch n {
	case 1 => x
	case 2 => 0
	default => "s"
	}
}

func nilWithUnion(n int, x U) U {
	return switch n {
	case 1 => x
	default => nil
	}
}
