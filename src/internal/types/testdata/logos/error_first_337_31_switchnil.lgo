package p

func fetch337_31() (int, error) { return 1, nil }
func use337_31(n int) {}

// The nil arm proves the error, so the read is valid.
func switchNilProvesErr337_31() {
	n, err := fetch337_31()
	v := switch err { case nil => n; default => 0 }
	_ = v
}

// The default arm leaves the error unproven, so the read must fail.
func switchDefaultKeepsErr337_31() {
	n, err := fetch337_31()
	v := switch err {
	case nil => 0
	default => n /* ERROR "[correctness::result_before_error_check]" */
	}
	_ = v
}
