}

func andLiteralLeft(q U?) bool {
	return func() bool { return take(q /* ERROR "[correctness::nil_deref_unproven]" */) != "" }() && q != nil
}

func orLiteral(q U?) bool {
	return q == nil || func() bool { return take(q /* ERROR "[correctness::nil_deref_unproven]" */) != "" }()
}

