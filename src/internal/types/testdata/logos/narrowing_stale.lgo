func andLiteral(q U?) bool {
	return q != nil && func() bool { return take(q) != "" }()
}

func andLiteralChain(q, r U?) bool {
	return q != nil && r != nil && func() bool { return take(q) != take(r) }()
}

func andLiteralInIf(q U?) string {
	if q != nil && func() bool { return take(q) != "" }() {
		return take(q)
	}
	return ""
}

func andLiteralNested(q U?) bool {
	return q != nil && func() bool {
		return func() bool { return take(q) != "" }()
	}()
}

func andLiteralAssigned(q U?) bool {
	ok := q != nil && func() bool { return take(q /* ERROR "[correctness::nil_deref_unproven]" */) != "" }()
	q = nil
