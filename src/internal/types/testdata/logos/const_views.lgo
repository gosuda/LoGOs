package p

import (
	"fmt"
	"sort"
)

type CVItem struct {
	Name string
	Tags []string
}

func (v CVItem) Label() string { return v.Name }

func (p *CVItem) Rename(n string) { p.Name = n }

func (r const *CVItem) Peek() string { return r.Name }

var cvInts const []int = []int{1, 2, 3}

var cvInt const int = 42

var cvMap const map[string]int = map[string]int{"a": 1}

var cvPtr const *CVItem = &CVItem{Name: "n"}

func cvParam(xs const []int) {
	_ = xs
}

func cvConstParamCall(xs const []int) {
	cvParam(xs)
	_ = xs
}

func cvResult() const []int {
	return []int{1}
}

func cvWrapAround(plain []int, ci const int) {
	var cv const []int = plain
	var i int = ci
	var cv2 const []int = cv
	_, _, _ = cv, i, cv2
}

type CVHolder struct {
	F const []int
}

func cvNilRestrict() {
	var cn const []int = nil
	var ci const int = nil /* ERROR "cannot use nil as const int" */
	_, _ = cn, ci
}

func cvBadElem() {
	var bad const int = "x" /* ERROR "cannot use" */
	_ = bad
}

func cvIndexAssign(xs const []int) {
	xs /* ERRORx "\\[correctness::const_view_mutation\\] cannot assign index through const view xs" */ [0] = 1
}

func cvFieldAssign(cp const *CVItem) {
	cp /* ERROR "[correctness::const_view_mutation] cannot assign field through const view cp" */ .Name = "x"
}

func cvBuiltins(xs const []int, cm const map[string]int) {
	_ = append(xs /* ERROR "[correctness::const_view_mutation] cannot append through const view xs" */, 1)
	dst := []int{0, 0}
	_ = copy(xs /* ERROR "[correctness::const_view_mutation] cannot copy through const view xs" */, dst)
	_ = dst
	delete(cm /* ERROR "[correctness::const_view_mutation] cannot delete through const view cm" */, "a")
	clear(cm /* ERROR "[correctness::const_view_mutation] cannot clear through const view cm" */)
}

func cvSliceExpr(xs const []int, n int) {
	_ = xs /* ERROR "[correctness::const_view_mutation] cannot slice through const view xs" */ [:cap(xs)]
	_ = xs[:n]
	_ = xs[1:2]
}

func cvArrayBound(a const [4]int) {
	_ = a /* ERROR "[correctness::const_view_mutation] cannot slice through const view a" */ [:cap(a)]
	_ = a /* ERROR "[correctness::const_view_mutation] cannot slice through const view a" */ [:8 /* ERROR "out of bounds" */]
	_ = a[:2]
}

func cvMethods(cp const *CVItem, v CVItem) {
	cp.Rename /* ERROR "[correctness::const_view_mutation] cannot call Rename through const view cp" */ ("x")
	_ = cp.Peek()
	_ = v.Label()
	_ = cp.Label()
}

func cvTake(xs []int) {
	_ = xs
}

func cvPass(xs const []int) {
	cvTake(xs /* ERROR "[correctness::const_view_mutation] cannot pass argument through const view xs" */)
}

func cvPassStd(xs const []int, ci const int) {
	sort.Ints(xs /* ERROR "[correctness::const_view_mutation] cannot pass const view xs to parameter x of sort.Ints" */)
	_ = fmt.Sprint(xs /* ERROR "[correctness::const_view_mutation] cannot pass const view xs to parameter a of fmt.Sprint" */)
	_ = fmt.Sprint(ci)
}

func cvEscape(xs const []int) {
	var plain []int = xs /* ERROR "[correctness::const_view_escape]" */
	_ = plain
}

func cvEscapePtr(ps const []*CVItem) {
	var plain []*CVItem = ps /* ERROR "[correctness::const_view_escape]" */
	_ = plain
}

var cvLambda = func(xs const []int) {
	xs /* ERROR "[correctness::const_view_mutation] cannot assign index through const view" */ [0] = 9
}

func cvRange(css const [][]int) {
	for _, row := range css {
		row /* ERROR "[correctness::const_view_mutation] cannot assign index through const view" */ [0] = 1
	}
}

func cvReads(cs const []int, cp const *CVItem) int {
	total := 0
	for _, v := range cs {
		total += v
	}
	var s string = cp.Name
	_ = s
	_ = len(cs)
	_ = cap(cs)
	_ = cp.Peek()
	return total
}

func cvPlainReslice(s []int, b []byte) {
	s = s[:0]
	b = b[:cap(b)]
	_, _ = s, b
}

func cvPlainReuseLoop() {
	buf := make([]byte, 0, 64)
	for i := 0; i < 4; i++ {
		buf = buf[:0]
		buf = append(buf, byte(i))
	}
}
