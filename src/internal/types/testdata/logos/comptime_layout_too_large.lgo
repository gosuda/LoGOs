package p

import "comptime"

type Huge [1 << 62]int64

type HugeCell struct {
	Body Huge
}

func hugeSize[U any]() int {
	return comptime /* ERROR "too large" */ .SizeOf[Huge]()
}

func hugeCellSize[U any]() int {
	return comptime /* ERROR "too large" */ .SizeOf[HugeCell]()
}

func hugeAlign[U any]() int {
	return comptime.AlignOf[Huge]()
}
