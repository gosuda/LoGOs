package p

type User struct {
	Name string
	Age  int
}

func (u User) Greet() string { return u.Name }

type Holder struct {
	P *User?
}

func narrowBlock(up *User?) {
	if up != nil {
		_ = up.Name
		_ = *up
		_ = up.Greet()
		_ = up.Age + 1
		var w *User = up
		_ = w
		var q *User? = up
		_ = q
	}
}

func narrowChain(up *User?) {
	if up != nil {
		_ = up?.Name
		_ = up ?? &User{Name: "d"}
	}
}

func earlyReturn(up *User?) {
	if up == nil {
		return
	}
	_ = up.Name
}

func earlyPanic(up *User?) {
	if up == nil {
		panic("nil")
	}
	_ = up.Name
}

func earlyBreak(up *User?, n int) {
	for i := 0; i < n; i++ {
		if up == nil {
			break
		}
		_ = up.Name
	}
}

func earlyContinue(up *User?, n int) {
	for i := 0; i < n; i++ {
		if up == nil {
			continue
		}
		_ = up.Name
	}
}

func andChain(up *User?) {
	if up != nil && up.Age > 0 {
		_ = up.Name
	}
}

func killAssign(up *User?, other *User?) {
	if up != nil {
		_ = up.Name
		up = other
		_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
		if up != nil {
			_ = up.Name
		}
	}
}

func addrTaken(up *User?) {
	p := &up
	_ = p
	if up != nil {
		_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	}
}

func closureAssign(up *User?) {
	f := func() {
		up = nil
	}
	_ = f
	if up != nil {
		_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	}
}

func loopAssign(up *User?, n int) {
	for i := 0; i < n; i++ {
		up = nil
	}
	if up != nil {
		_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	}
}

func fieldNoNarrow(h Holder) {
	if h.P != nil {
		_ = h.P.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	}
}

func fieldCopy(h Holder) {
	loc := h.P
	if loc != nil {
		_ = loc.Name
	}
}

func elseBranch(up *User?) {
	if up != nil {
		_ = up.Name
	} else {
		_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	}
	_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
}

func elseFall(up *User?) {
	if up == nil {
		return
	} else {
		_ = up.Name
	}
	_ = up.Name
}

func elseFallKill(up *User?, other *User?) {
	if up == nil {
		return
	} else {
		up = other
	}
	_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
}

func outerScope(up *User?) {
	if up == nil {
		return
	}
	{
		_ = up.Name
		loc := up
		_ = loc.Name
		up2 := 1
		_ = up2
	}
	_ = up.Name
}

func shadowBlock(up *User?) {
	if up == nil {
		return
	}
	_ = up.Name
	{
		var up *User? = nil
		_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
		_ = up
	}
	_ = up.Name
}

func noGuard(up *User?) {
	_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	_ = *up /* ERROR "cannot indirect" */
	var v *User = up /* ERROR "as *User value in" */
	_ = v
	_ = up
}
