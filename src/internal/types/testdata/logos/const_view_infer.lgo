package p

func inferTake[T any](v T) T { return v }

func inferSlice(xs const []int) {
	_ = inferTake(xs /* ERROR "[correctness::const_view_mutation] cannot pass argument through const view" */)
}

func inferMap(xm const map[string]int) {
	_ = inferTake(xm /* ERROR "[correctness::const_view_mutation] cannot pass argument through const view" */)
}

type inferItem struct {
	Name string
}

func inferPtr(xp const *inferItem) {
	_ = inferTake(xp /* ERROR "[correctness::const_view_mutation] cannot pass argument through const view" */)
}

func inferConstParam[T any](v const []T) int { return len(v) }

func inferConstParamCall(xs const []int) int {
	return inferConstParam(xs)
}
