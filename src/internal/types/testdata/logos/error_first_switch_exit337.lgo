package p

func fetchExit337() (int, error) { return 1, nil }
func useExit337(n int) {}

func switchInitAssignment337() {
	n, err := fetchExit337()
	if err != nil { return }
	useExit337(n)
	x := switch panic("stop"); 0 { default => 0 }
	useExit337(x)
}

func switchInitDeclaration337() {
	n, err := fetchExit337()
	if err != nil { return }
	useExit337(n)
	var x = switch panic("stop"); 0 { default => 0 }
	useExit337(x)
}
