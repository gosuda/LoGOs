type heldField struct {
	stats int
	err   error
}

func fetchHeld() (int, error) {
	return 1, nil
}

// A deferred cleanup inside a directly invoked literal reads with the
// state at the cleanup's entry: an unchecked field result fails.
func cleanupUncheckedInInvokedLit() {
	h := heldField{}
	func() {
		h.stats, h.err = fetchHeld()
		defer func() {
			use(h.stats /* ERROR "[correctness::result_before_error_check]" */)
		}()
	}()
}

// A cleanup that checks the guard first proves its own read.
func cleanupCheckedInInvokedLit() {
	h := heldField{}
	func() {
		h.stats, h.err = fetchHeld()
		defer func() {
			if h.err == nil {
				use(h.stats)
			}
		}()
	}()
}

// A checked arm does not mask an unchecked field arm: the join keeps no
// proof when one path holds only a may mark for the result.
func joinCheckedPlainMasksUncheckedField(cond bool) {
	h := heldField{}
	var err error
	func() {
		if cond {
			h.stats, err = fetchHeld()
			if err != nil {
				panic("boom")
			}
		} else {
			h.stats, h.err = fetchHeld()
		}
	}()
	use(h.stats /* ERROR "[correctness::result_before_error_check]" */)
	_ = err
}

// Both arms checked through their own errors: the joined read is proven.
func joinBothArmsChecked(cond bool) {
	h := heldField{}
	var err error
	var err2 error
	func() {
		if cond {
			h.stats, err = fetchHeld()
			if err != nil {
				panic("boom")
			}
		} else {
			h.stats, err2 = fetchHeld()
			if err2 != nil {
				panic("boom")
			}
		}
	}()
	use(h.stats)
	_ = err
	_ = err2
}

var unrelatedReady bool

// An unrelated write inside an invoked literal leaves an earlier pairing,
// overwritten by a discarded-error store, silent.
func unrelatedWriteDiscardedStore() {
	h := heldField{}
	h.stats, h.err = fetchHeld()
	h.stats, _ = fetchHeld()
	func() {
		unrelatedReady = true
	}()
	use(h.stats)
}

// A literal that overwrites the guard breaks the pairing: no later check
// can discharge the read.
func invokedLitBreaksGuard() {
	h := heldField{}
	h.stats, h.err = fetchHeld()
	func() {
		h.err = nil
	}()
	use(h.stats /* ERROR "[correctness::result_before_error_check]" */)
}

type deferInner struct {
	stats int
}

type deferOuter struct {
	in  deferInner
	err error
}

func useDeferInner(v deferInner) {}

// A deferred read of a parent struct still observes an earlier
// discarded-error store: the nested field keeps its may mark, so the
// whole-struct read fails even when a later store pairs it with a
// checked error.
func deferredParentSeesDiscardedStore(cond bool) {
	var err error
	o := deferOuter{}
	o.in.stats, _ = fetchHeld()
	defer func() {
		if err == nil {
			useDeferInner(o.in /* ERROR "[correctness::result_before_error_check]" */)
		}
	}()
	if cond {
		o.in.stats, err = fetchHeld()
	}
}

// A cleanup that does nothing leaves no entries behind: a caller read
// of an unchanged field result stays silent.
func cleanupNoopLeavesNothing() {
	h := heldField{}
	h.stats, h.err = fetchHeld()
	func() {
		defer func() {}()
	}()
	use(h.stats)
}

// A checked plain arm does not mask a field arm: checking the field
// guard afterwards proves the joined read.
func joinFieldCheckProvesAfterJoin(cond bool) {
	h := heldField{}
	var err error
	func() {
		if cond {
			h.stats, err = fetchHeld()
			if err != nil {
				panic("boom")
			}
		} else {
			h.stats, h.err = fetchHeld()
		}
	}()
	if h.err != nil {
		return
	}
	use(h.stats)
	_ = err
}

// Same, with the arms swapped.
func joinFieldCheckProvesAfterJoinSwapped(cond bool) {
	h := heldField{}
	var err error
	func() {
		if cond {
			h.stats, h.err = fetchHeld()
		} else {
			h.stats, err = fetchHeld()
			if err != nil {
				panic("boom")
			}
		}
	}()
	if h.err != nil {
		return
	}
	use(h.stats)
	_ = err
}
