package p

type Leaf struct {
	Name string
}

type Node struct {
	Child const Tree
	ID    int
}

type Tree interface {
	Leaf | Node
}

func classify(v Tree) string {
	switch v.(type) {
	case Leaf:
		return "leaf"
	case Node:
		return "node"
	default:
		return "other"
	}
}
