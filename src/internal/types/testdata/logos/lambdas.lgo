func closure() {
	n := 0
	var f func() int = () => n
	_ = f
	n = 1
	_ = n
}

func closureParam() {
	m := map[string]int{"k": 1}
	var f func(string) int = k => m[k] ?? -1
	_ = f
}

type handler struct{ f func(int) int }

type pairFns struct {
	one func(int) int
	two func(int, int) int
}

type namedFn func(int) int

func takeNamed(f namedFn)                               {}
func takeFuncs(fs ...func(int) int)                     {}
func reduce[T, A any](xs []T, init A, f func(A, T) A) A { return init }

func positionStructKeyed() {
	_ = handler{f: x => x + 1}
	_ = &handler{f: (x => x + 1)}
}

func positionStructPositional() {
	_ = pairFns{x => x, (a, b) => a + b}
}

func positionStructSpread(base pairFns) {
	_ = pairFns{..base, one: x => x + 1}
}

func positionSlice() {
	_ = []func(int) int{x => x + 1, x => x * 2}
	_ = []func(int) int{2: x => x + 1}
	_ = [][]func(int) int{{x => x}}
}

func positionArray() {
	_ = [2]func(int) int{x => x, x => x * 2}
	_ = [...]func(int) int{x => x}
}

func positionMap() {
	_ = map[string]func(int) int{"k": x => x + 1}
	_ = map[string]handler{"k": {f: x => x}}
	_ = []*handler{{f: x => x}}
}

func positionSend(ch chan func(int) int) {
	ch <- x => x + 1
	select {
	case ch <- x => x * 2:
	default:
	}
}

func positionAppend(fs []func(int) int) []func(int) int {
	fs = append(fs, x => x + 1, x => x * 2)
	return append(fs, (x => x))
}

func positionNamedParam() {
	takeNamed(x => x + 1)
	takeNamed((x => x))
}

func positionVariadic() {
	takeFuncs(x => x, x => x * 2)
}

func positionGenericCallee(xs []int, ss []string) {
	_ = slices.IndexFunc(xs, x => x > 1)
	_ = reduce(ss, 0, (n, s) => n + len(s))
}

func positionCurried() {
	var add func(int) func(int) int = x => y => x + y
	_ = add
}

func positionMismatch() {
	_ = handler{f: (a, b) => /* ERROR "mismatch" */ a}
	_ = []func(int) string{x => x /* ERROR "cannot use" */}
	_ = pairFns{x => x, a => /* ERROR "mismatch" */ a}
}
