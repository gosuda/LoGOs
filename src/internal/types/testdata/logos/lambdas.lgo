func takeAny(v any)                {}
func takeAnys(vs ...any)           {}
func takeError(e error)            {}
func takeInt(n int)                {}
func takeIface(s interface{ M() }) {}
func apply2[T any](f func(T) T)    {}
func ident[T any](v T) T           { return v }

