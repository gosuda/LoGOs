type UserID int

func validSwitch[T any](v T, items []T) string {
	_, _ = v, items
	const switch T {
	case int:
		return "int"
	case ~int:
		return "tilde"
	case io.Writer:
		return "writer"
	}
	return "other"
}

func shadowedAfterBroader[T any](v T) string {
	_ = v
	const switch T {
	case ~int:
		return "tilde"
	case int /* ERROR "comptime::unreachable_case" */ :
		return "int"
	}
	return "other"
}

func shadowedDuplicateExact[T any](v T) string {
	_ = v
	const switch T {
	case int:
		return "int"
	case int /* ERROR "comptime::unreachable_case" */ :
		return "again"
	}
	return "other"
}

type writerInt int

func (w writerInt) Write(p []byte) (int, error) { return len(p), nil }

func shadowedAfterInterface[T any](v T) string {
	_ = v
	const switch T {
	case io.Writer:
		return "writer"
	case writerInt /* ERROR "comptime::unreachable_case" */ :
		return "writerint"
	}
	return "other"
}

func ifaceGainsKeeps[T io.Reader](v T) {
	const switch T {
	case io.Writer:
		_, _ = v.Read(nil)
		_, _ = v.Write(nil)
	}
}

func ifaceCasesScopeSeparately[T any](v T) {
	_ = v
	const switch T {
	case io.Reader:
		x := 1
		_ = x
	case io.Writer:
		x := 2
		_ = x
	}
}

func sliceNeverRebinds[T any](items []T) {
	const switch T {
	case io.Writer:
		var ws []io.Writer = items // ERROR "cannot use items"
		_ = ws
	}
}

func bump[T any](v T) {
	const switch T {
	case int:
		_ = v + 1
	}
}

func exactRebindsAssign[T any](v T) {
	const switch T {
	case int:
		var n int = v
		_ = n
	}
}

func exactRebindsTypeName[T any](v T) {
	const switch T {
	case int:
		var z T = v
		var n int = z
		_, _ = n, v
	}
}

func tildeKeepsDeclaredType(v UserID) int {
	const switch UserID {
	case ~int:
		var n int = v // ERROR "cannot use v"
		return int(v) + n
	}
	return 0
}

func tildeKeepsTypeParam[T ~int](v T) int {
	const switch T {
	case ~int:
		var n int = v // ERROR "cannot use v"
		return int(v) + n
	}
	return 0
}

func concreteFold(v UserID) string {
	_ = v
	const switch UserID {
	case int /* ERROR "comptime::unreachable_case" */ :
		return "exact"
	case ~int:
		return "tilde"
	}
	return "other"
}

