func caseDefault[T any](v T) string {
	_ = v
	out := ""
	const switch T {
	case int:
		out = "int"
	default:
		out = "other"
	}
	return out
}

func caseDefaultShadowed[T any](v T) string {
	_ = v
	out := ""
	const switch T {
	default:
		out = "d"
	case string /* ERROR "comptime::unreachable_case" */ :
		out = "s"
	}
	return out
}

