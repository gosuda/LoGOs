package p

type RO interface {
	const ID int
	const Start() error
}

type Gadget struct : RO {
	ID int
}

func (m Gadget) Start() error {
	return nil
}

func useROs(xs const []RO) int {
	return len(xs)
}

func accept(gs []Gadget) {
	_ = useROs(gs)
}

var _ RO = Gadget{ID: 1}
