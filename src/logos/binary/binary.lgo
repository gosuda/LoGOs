// Package binary is the loGo/s twin of encoding/binary for fixed-size
// data.
//
// The twin covers the fixed-size entry points of encoding/binary with
// the value carried as a type parameter instead of an any operand:
//
//	Size     func Size[T any](v T) int
//	ReadInto  func ReadInto[T any](r io.Reader, order ByteOrder, data *T) error
//	Write    func Write[T any](w io.Writer, order ByteOrder, data T) error
//	Encode   func Encode[T any](buf []byte, order ByteOrder, data T) (int, error)
//	Decode   func Decode[T any](buf []byte, order ByteOrder, data *T) (int, error)
//	Append   func Append[T any](buf []byte, order ByteOrder, data T) ([]byte, error)
//
// ByteOrder, the three orders and the varint functions carry no
// reflect and are re-exported from encoding/binary, so the wire format
// is identical by construction. Only the fixed-size layout path is
// twinned.
//
// Mechanism: layout is derived at compile time. A comptime generic
// walks comptime.Fields[T]() in declaration order and dispatches each
// field with const switch over its type: the fixed-size scalars encode
// through ByteOrder append helpers, a nested struct recurses, a blank
// (_) field writes zero bytes and skips on read. There is no reflect,
// no unsafe and no per-type plan: every instantiation lowers to plain
// field code, so Size folds to a constant and a warmed call is a
// straight-line field walk.
//
// Fixed-size scalars, the enumerated array shapes, and structs of
// those encode through comptime dispatch with no reflect, no unsafe
// and no per-type plan: every instantiation lowers to plain field
// code, so Size folds to a constant and a warmed call is a
// straight-line field walk. Anything else (slices, pointers,
// platform integers, strings, maps, unlisted arrays) takes the
// dynamic original path, so behavior and error kinds match
// encoding/binary exactly. A struct with no visible fixed-size fields
// takes the dynamic original path, so a struct whose fields are all
// hidden still encodes every byte. Decoding into a struct with a
// visible unexported field panics, as with the original. Structs with
// blank (_) fields do not compile: Go cannot select a blank field,
// so no projection can name it.
//
// Mapping from the original (data any) to the twin: ReadInto and
// Decode take *T where the original takes a pointer or slice operand,
// so Read(r, order, &s) becomes ReadInto(r, order, &s) and
// Read(r, order, slice) becomes ReadInto(r, order, &slice). Write,
// Encode, Append and Size take T by value, and T itself may be a
// pointer or slice exactly where the original accepts one. Anything
// arriving as any keeps the dynamic original path; the twin
// dispatches on the static type only.
package binary

import (
	stdbinary "encoding/binary"
	"errors"
)

// ByteOrder is encoding/binary.ByteOrder: how to convert byte slices
// into 16-, 32- or 64-bit unsigned integers.
type ByteOrder = stdbinary.ByteOrder

// AppendByteOrder is encoding/binary.AppendByteOrder.
type AppendByteOrder = stdbinary.AppendByteOrder

// Order is the byte order the twin's encode and decode functions
// take: ByteOrder for reads and AppendByteOrder for writes.
// LittleEndian, BigEndian and NativeEndian all satisfy it.
type Order interface {
	ByteOrder
	AppendByteOrder
}

var (
	// LittleEndian is the little-endian implementation of ByteOrder.
	LittleEndian = stdbinary.LittleEndian
	// BigEndian is the big-endian implementation of ByteOrder.
	BigEndian = stdbinary.BigEndian
	// NativeEndian is the native-endian implementation of ByteOrder.
	NativeEndian = stdbinary.NativeEndian
)

// ErrTooSmall reports a short caller buffer. Its text matches
// encoding/binary ("buffer too small") so message comparisons
// transfer.
var ErrTooSmall = errors.New("buffer too small")
