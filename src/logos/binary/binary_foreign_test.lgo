package binary_test

import (
	"bytes"
	obinary "encoding/binary"
	"testing"

	"logos/binary"
)

// hiddenOnly is foreign to logos/binary and shows it no visible
// fields: comptime.Fields omits b, so the fast path would size it 0
// and drop every byte. The original path keeps them instead.
type hiddenOnly struct {
	b int32
}

func TestTwinForeignHiddenRoundTrip(t *testing.T) {
	v := hiddenOnly{b: 0x01020304}
	if got, want := binary.Size(v), obinary.Size(v); got != want {
		t.Fatalf("Size = %d, want original %d", got, want)
	}
	tb, terr := binary.Append(nil, binary.LittleEndian, v)
	if terr != nil {
		t.Fatalf("twin Append: %v", terr)
	}
	ob, oerr := obinary.Append(nil, binary.LittleEndian, v)
	if oerr != nil {
		t.Fatalf("original Append: %v", oerr)
	}
	if !bytes.Equal(tb, ob) {
		t.Fatalf("twin bytes %x, original %x: hidden bytes dropped", tb, ob)
	}
	twinPanicked := false
	func() {
		defer func() {
			if recover() != nil {
				twinPanicked = true
			}
		}()
		var back hiddenOnly
		_, _ = binary.Decode(tb, binary.LittleEndian, &back)
	}()
	if !twinPanicked {
		t.Fatalf("twin Decode did not panic like the original")
	}
	origPanicked := false
	func() {
		defer func() {
			if recover() != nil {
				origPanicked = true
			}
		}()
		var back hiddenOnly
		_ = obinary.Read(bytes.NewReader(ob), binary.LittleEndian, &back)
	}()
	if !origPanicked {
		t.Fatalf("original Read did not panic")
	}
}

// mixedMiddle and mixedLeading are foreign to logos/binary and mix
// exported with hidden fixed-size fields: comptime.Fields omits the
// hidden ones, so the fast path sizes, encodes and decodes only the
// exported remainder. These tests lock in that truncation. If a
// hidden-field predicate lands and the twin delegates such layouts to
// the original, they must flip to assert equality with the original.
type mixedMiddle struct {
	Kind     uint8
	sequence uint16
	Flags    uint8
}

type mixedLeading struct {
	tag uint32
	A   uint16
	B   uint8
}

func TestTwinForeignMixedMiddleTruncation(t *testing.T) {
	v := mixedMiddle{Kind: 0x11, sequence: 0x2233, Flags: 0x44}
	if got, want := binary.Size(v), 2; got != want {
		t.Fatalf("twin Size = %d, want truncated %d", got, want)
	}
	if got, want := obinary.Size(v), 4; got != want {
		t.Fatalf("original Size = %d, want %d", got, want)
	}
	tb, terr := binary.Append(nil, binary.LittleEndian, v)
	if terr != nil {
		t.Fatalf("twin Append: %v", terr)
	}
	if want := []byte{0x11, 0x44}; !bytes.Equal(tb, want) {
		t.Fatalf("twin bytes %x, want truncated %x", tb, want)
	}
	ob, oerr := obinary.Append(nil, obinary.LittleEndian, v)
	if oerr != nil {
		t.Fatalf("original Append: %v", oerr)
	}
	if want := []byte{0x11, 0x33, 0x22, 0x44}; !bytes.Equal(ob, want) {
		t.Fatalf("original bytes %x, want %x", ob, want)
	}
	var back mixedMiddle
	n, derr := binary.Decode(ob, binary.LittleEndian, &back)
	if derr != nil {
		t.Fatalf("twin Decode: %v", derr)
	}
	if n != 2 || back.Kind != 0x11 || back.Flags != 0x33 || back.sequence != 0 {
		t.Fatalf("twin Decode consumed %d into %+v, want 2 into {Kind:17 Flags:51}", n, back)
	}
}

func TestTwinForeignMixedLeadingTruncation(t *testing.T) {
	v := mixedLeading{tag: 0x11223344, A: 0x5566, B: 0x77}
	if got, want := binary.Size(v), 3; got != want {
		t.Fatalf("twin Size = %d, want truncated %d", got, want)
	}
	if got, want := obinary.Size(v), 7; got != want {
		t.Fatalf("original Size = %d, want %d", got, want)
	}
	tb, terr := binary.Append(nil, binary.LittleEndian, v)
	if terr != nil {
		t.Fatalf("twin Append: %v", terr)
	}
	if want := []byte{0x66, 0x55, 0x77}; !bytes.Equal(tb, want) {
		t.Fatalf("twin bytes %x, want truncated %x", tb, want)
	}
	ob, oerr := obinary.Append(nil, obinary.LittleEndian, v)
	if oerr != nil {
		t.Fatalf("original Append: %v", oerr)
	}
	if want := []byte{0x44, 0x33, 0x22, 0x11, 0x66, 0x55, 0x77}; !bytes.Equal(ob, want) {
		t.Fatalf("original bytes %x, want %x", ob, want)
	}
	var back mixedLeading
	n, derr := binary.Decode(ob, binary.LittleEndian, &back)
	if derr != nil {
		t.Fatalf("twin Decode: %v", derr)
	}
	if n != 3 || back.A != 0x3344 || back.B != 0x22 || back.tag != 0 {
		t.Fatalf("twin Decode consumed %d into %+v, want 3 into {A:13124 B:34}", n, back)
	}
}
