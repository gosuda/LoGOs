package binary

import (
	"comptime"
	stdbinary "encoding/binary"
	"io"
	"math"
)

func DecValue[T any](buf []byte, order Order, off *int, v *T) error {
	const if comptime.IsStruct[T]() {
		return DecStruct[T](buf, order, off, v)
	}
	return DecNonStruct[T](buf, order, off, v)
}

// boundSliceInput caps the buffer handed to the original decoder when
// the held destination is one of the two slice types whose fast path
// loops over the input instead of the destination ([]bool, []int8).
// A longer buffer would index past the destination after filling it.
// A short buffer passes through unchanged so the original still
// reports the short-buffer error.
func boundSliceInput(buf []byte, held any) []byte {
	if b, ok := held.([]bool); ok {
		if len(buf) > len(b) {
			return buf[:len(b)]
		}
		return buf
	}
	if s, ok := held.([]int8); ok {
		if len(buf) > len(s) {
			return buf[:len(s)]
		}
	}
	return buf
}

//logos:allow(complexity::cognitive_overflow)
func DecNonStruct[T any](buf []byte, order Order, off *int, v *T) error {
	const switch T {
	case ~bool:
		if *off >= len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(buf[*off] != 0)
		*off++
	case ~int8:
		if *off >= len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(int8(buf[*off]))
		*off++
	case ~uint8:
		if *off >= len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(buf[*off])
		*off++
	case ~int16:
		if *off+2 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(int16(order.Uint16(buf[*off:])))
		*off += 2
	case ~uint16:
		if *off+2 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(order.Uint16(buf[*off:]))
		*off += 2
	case ~int32:
		if *off+4 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(int32(order.Uint32(buf[*off:])))
		*off += 4
	case ~uint32:
		if *off+4 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(order.Uint32(buf[*off:]))
		*off += 4
	case ~int64:
		if *off+8 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(int64(order.Uint64(buf[*off:])))
		*off += 8
	case ~uint64:
		if *off+8 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(order.Uint64(buf[*off:]))
		*off += 8
	case ~float32:
		if *off+4 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(math.Float32frombits(order.Uint32(buf[*off:])))
		*off += 4
	case ~float64:
		if *off+8 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(math.Float64frombits(order.Uint64(buf[*off:])))
		*off += 8
	case ~complex64:
		if *off+8 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(complex(
			math.Float32frombits(order.Uint32(buf[*off:])),
			math.Float32frombits(order.Uint32(buf[*off+4:])),
		))
		*off += 8
	case ~complex128:
		if *off+16 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		*v = T(complex(
			math.Float64frombits(order.Uint64(buf[*off:])),
			math.Float64frombits(order.Uint64(buf[*off+8:])),
		))
		*off += 16
	case [4]uint8:
		if *off+4 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		copy((*v)[:], buf[*off:*off+4])
		*off += 4
	case [4]bool:
		if *off+4 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		for i := range *v {
			(*v)[i] = buf[*off] != 0
			*off++
		}
	case [3]int32:
		if *off+12 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		for i := range *v {
			(*v)[i] = int32(order.Uint32(buf[*off:]))
			*off += 4
		}
	case [4]int16:
		if *off+8 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		for i := range *v {
			(*v)[i] = int16(order.Uint16(buf[*off:]))
			*off += 2
		}
	case [7]byte:
		if *off+7 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		copy((*v)[:], buf[*off:*off+7])
		*off += 7
	case [8]float32:
		if *off+32 > len(buf) {
			return io.ErrUnexpectedEOF
		}
		for i := range *v {
			(*v)[i] = math.Float32frombits(order.Uint32(buf[*off:]))
			*off += 4
		}
	case any:
		if p, ok := any(v).(*any); ok && *p != nil {
			n, err := stdbinary.Decode(boundSliceInput(buf[*off:], *p), order, *p)
			if err != nil {
				return err
			}
			*off += n
			return nil
		}
		n, err := stdbinary.Decode(buf[*off:], order, v)
		if err != nil {
			return err
		}
		*off += n
		return nil
	}
	return nil
}

func DecStruct[T any](buf []byte, order Order, off *int, v *T) error {
	const for _, f := range comptime.Fields[T]() {
		if !f.Exported {
			if FixedSizeOf[f.Type]() != 0 {
				panic("logos/binary: cannot decode unexported field " + f.Name)
			}
		}
		err := DecValue[f.Type](buf, order, off, &v.[f])
		if err != nil {
			return err
		}
	}
	return nil
}
