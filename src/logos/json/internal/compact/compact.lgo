// Package compact applies the encoding/json marshalerEncoder contract
// to bytes a MarshalJSON method returned. It lives in its own package
// because an exported LoGOs generic cannot name an unexported function
// of its own package.
package compact

import (
	"bytes"
	stdjson "encoding/json"
)

const hex = "0123456789abcdef"

// Escaped reproduces appendCompact(src, escape=true): it strips
// insignificant space while validating the input and escapes the HTML
// metacharacters and the two Unicode line separators the way
// encoding/json does for top-level Marshal output. Bytes that need no
// compaction and no escaping are returned unchanged after a Valid
// check, so generated output costs one scan and no copy.
func Escaped(src []byte) ([]byte, error) {
	if clean(src) {
		if stdjson.Valid(src) {
			return src, nil
		}
	}
	var buf bytes.Buffer
	buf.Grow(len(src))
	if err := stdjson.Compact(&buf, src); err != nil {
		return nil, err
	}
	compact := buf.Bytes()
	if !needsEscape(compact) {
		return compact, nil
	}
	out := make([]byte, 0, len(compact)+8)
	for i := 0; i < len(compact); i++ {
		c := compact[i]
		switch {
		case c == '<' || c == '>' || c == '&':
			out = append(out, '\\', 'u', '0', '0', hex[c>>4], hex[c&0xF])
		case c == 0xE2 && i+2 < len(compact) && compact[i+1] == 0x80 && compact[i+2]&^1 == 0xA8:
			out = append(out, '\\', 'u', '2', '0', '2', hex[compact[i+2]&0xF])
			i += 2
		default:
			out = append(out, c)
		}
	}
	return out, nil
}

// clean reports whether src can contain neither insignificant space
// nor a byte the escape pass would rewrite. Space inside a quoted
// string is significant and survives compaction, so only space
// outside strings disqualifies the input; the HTML metacharacters and
// U+2028/U+2029 are rewritten wherever they appear.
func clean(b []byte) bool {
	inStr, esc := false, false
	for i := 0; i < len(b); i++ {
		c := b[i]
		if esc {
			esc = false
			continue
		}
		if inStr {
			switch c {
			case '\\':
				esc = true
			case '"':
				inStr = false
			case '<', '>', '&':
				return false
			}
		} else {
			switch c {
			case '"':
				inStr = true
			case ' ', '\t', '\r', '\n', '<', '>', '&':
				return false
			}
		}
		if c == 0xE2 && i+2 < len(b) && b[i+1] == 0x80 && b[i+2]&^1 == 0xA8 {
			return false
		}
	}
	return true
}

// Trimmed returns data without surrounding JSON space and whether the
// document is valid JSON. valid=false means the caller should delegate
// to encoding/json for the real error. Exported because a comptime
// generic cannot name an unexported function of its own package.
func Trimmed(data []byte) (val []byte, valid bool) {
	if !stdjson.Valid(data) {
		return nil, false
	}
	start := 0
	for start < len(data) && isSpace(data[start]) {
		start++
	}
	end := len(data)
	for end > start && isSpace(data[end-1]) {
		end--
	}
	return data[start:end], true
}

// IsNull reports whether data is the `null` literal, ignoring
// surrounding JSON space.
func IsNull(data []byte) bool {
	start := 0
	for start < len(data) && isSpace(data[start]) {
		start++
	}
	end := len(data)
	for end > start && isSpace(data[end-1]) {
		end--
	}
	return end-start == 4 && data[start] == 'n' && data[start+1] == 'u' && data[start+2] == 'l' && data[start+3] == 'l'
}

func isSpace(c byte) bool {
	return c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

func needsEscape(b []byte) bool {
	for i := 0; i < len(b); i++ {
		c := b[i]
		if c == '<' || c == '>' || c == '&' {
			return true
		}
		if c == 0xE2 && i+2 < len(b) && b[i+1] == 0x80 && b[i+2]&^1 == 0xA8 {
			return true
		}
	}
	return false
}
