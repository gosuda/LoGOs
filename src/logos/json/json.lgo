package json

import (
	"comptime"
	stdjson "encoding/json"
	"io"

	"logos/json/internal/compact"
)

// Marshal returns the JSON encoding of v. For a value-struct type
// with a generated or hand-written MarshalJSON method it calls that
// method directly through a comptime interface case, with no value
// boxing, and runs the result through the same compact-and-escape pass
// the original applies. Every other value, including nil pointers and
// interfaces, goes through encoding/json, so output bytes equal the
// original on the same inputs (a nil pointer marshals as null, never
// panics).
//
// Failure path: when the method returns an error, or when its output
// is not valid JSON, the twin delegates the whole value to
// encoding/json and returns that result, so the error value, its type
// field and its text are the original's by construction. The method
// runs a second time inside that call.
func Marshal[T any](v T) ([]byte, error) {
	const if comptime.IsStruct[T]() {
		const switch T {
		case stdjson.Marshaler:
			b, err := v.MarshalJSON()
			if err != nil {
				return stdjson.Marshal(v)
			}
			out, cerr := compact.Escaped(b)
			if cerr != nil {
				return stdjson.Marshal(v)
			}
			return out, nil
		}
	}
	return stdjson.Marshal(v)
}

// Unmarshal parses data into a value of type T and returns it. For a
// struct type with a generated or hand-written UnmarshalJSON method it
// calls that method. Every other type goes through encoding/json, so
// results and error values equal the original on the same inputs.
func Unmarshal[T any](data []byte) (T, error) {
	var v T
	if u, ok := any(&v).(stdjson.Unmarshaler); ok {
		err := u.UnmarshalJSON(data)
		return v, err
	}
	err := stdjson.Unmarshal(data, &v)
	return v, err
}

// MarshalWrite marshals in and writes the bytes to out in one Write
// call. Value-struct types take the same generated-method path as
// Marshal; every other value goes through encoding/json. A method
// failure delegates to encoding/json the same way Marshal does, so the
// returned error is the original's.
func MarshalWrite[T any](out io.Writer, in T) error {
	const if comptime.IsStruct[T]() {
		const switch T {
		case stdjson.Marshaler:
			b, err := in.MarshalJSON()
			if err != nil {
				_, merr := stdjson.Marshal(in)
				return merr
			}
			eb, cerr := compact.Escaped(b)
			if cerr != nil {
				_, merr := stdjson.Marshal(in)
				return merr
			}
			_, err = out.Write(eb)
			return err
		}
	}
	b, err := stdjson.Marshal(in)
	if err != nil {
		return err
	}
	_, err = out.Write(b)
	return err
}
