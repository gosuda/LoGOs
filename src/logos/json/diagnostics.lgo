package json

// Diagnostics describes where in the input a syntax error sits. Line
// and Column count from 1. Offset is the byte offset from the start of
// the input, as encoding/json reports it. Context is the single input
// line that holds the offset, without the line break.
type Diagnostics struct {
	Line    int
	Column  int
	Offset  int
	Context string
}

// DiagnosticsFor converts offset (an encoding/json SyntaxError or
// UnmarshalTypeError offset) to line, column and context. It scans the
// input once and allocates only the context string. Callers that never
// ask for diagnostics pay nothing: Unmarshal itself never calls this.
func DiagnosticsFor(data []byte, offset int64) Diagnostics {
	off := clampOffset(data, offset)
	line, lineStart := countLines(data, off)
	lineEnd := findLineEnd(data, off)
	ctx := string(data[lineStart:lineEnd])
	return Diagnostics{
		Line:    line,
		Column:  off - lineStart + 1,
		Offset:  off,
		Context: trimContext(ctx, off-lineStart),
	}
}

func clampOffset(data []byte, offset int64) int {
	off := int(offset)
	if off < 0 {
		return 0
	}
	if off > len(data) {
		return len(data)
	}
	return off
}

func countLines(data []byte, off int) (int, int) {
	line := 1
	start := 0
	for i := 0; i < off; i++ {
		if data[i] == '\n' {
			line++
			start = i + 1
		}
	}
	return line, start
}

func findLineEnd(data []byte, off int) int {
	for i := off; i < len(data); i++ {
		if data[i] == '\n' {
			return i
		}
	}
	return len(data)
}

func trimContext(ctx string, rel int) string {
	if len(ctx) <= 200 {
		return ctx
	}
	lo := rel - 80
	if lo < 0 {
		lo = 0
	}
	hi := lo + 200
	if hi > len(ctx) {
		hi = len(ctx)
		lo = hi - 200
	}
	return ctx[lo:hi]
}
