package slog_test

import (
	"bytes"
	"context"
	"errors"
	"io"
	"log/slog"
	"math"
	"runtime"
	"strings"
	"testing"
	"time"

	twinslog "logos/slog"
)

func twinTextPlain(w io.Writer) slog.Handler {
	return twinslog.NewTextHandler(w, new(slog.HandlerOptions))
}
func origTextPlain(w io.Writer) slog.Handler { return slog.NewTextHandler(w, new(slog.HandlerOptions)) }
func twinJSONPlain(w io.Writer) slog.Handler {
	return twinslog.NewJSONHandler(w, new(slog.HandlerOptions))
}
func origJSONPlain(w io.Writer) slog.Handler { return slog.NewJSONHandler(w, new(slog.HandlerOptions)) }

var twinTestTime = time.Date(2000, 1, 2, 3, 4, 5, 0, time.UTC)

type twinText struct{ s string }

func (t twinText) MarshalText() ([]byte, error) {
	if t.s == "" {
		return nil, errors.New("twinText: empty string")
	}
	return []byte("twinText{" + t.s + "}"), nil
}

type twinTextAppend struct{ s string }

func (t twinTextAppend) AppendText(b []byte) ([]byte, error) {
	if t.s == "" {
		return nil, errors.New("twinTextAppend: empty string")
	}
	return append(b, "twinTextAppend{"+t.s+"}"...), nil
}

type twinNamedBytes []byte

type twinRawJSON []byte

func (m twinRawJSON) MarshalJSON() ([]byte, error) {
	if len(m) == 0 {
		return nil, errors.New("twinRawJSON: empty")
	}
	return []byte(m), nil
}

type twinGroupValuer struct{ n int }

func (g twinGroupValuer) LogValue() slog.Value {
	return slog.GroupValue(slog.Int("n", g.n), slog.String("s", "x"))
}

type twinScalarValuer struct{ s string }

func (g twinScalarValuer) LogValue() slog.Value {
	return slog.StringValue("resolved:" + g.s)
}

type twinPanicValuer struct{}

func (twinPanicValuer) LogValue() slog.Value {
	panic("valuer boom")
}

type twinPanicText struct{}

func (twinPanicText) MarshalText() ([]byte, error) {
	panic("text boom")
}

func compareBoth(t *testing.T, r slog.Record, newTwin func(io.Writer) slog.Handler, newOrig func(io.Writer) slog.Handler) {
	t.Helper()
	var twinBuf, origBuf bytes.Buffer
	th := newTwin(&twinBuf)
	oh := newOrig(&origBuf)
	ctx := context.Background()
	if err := th.Handle(ctx, r); err != nil {
		t.Fatalf("twin Handle: %v", err)
	}
	if err := oh.Handle(ctx, r); err != nil {
		t.Fatalf("orig Handle: %v", err)
	}
	if twinBuf.String() != origBuf.String() {
		t.Errorf("output differs:\n twin %q\n orig %q", twinBuf.String(), origBuf.String())
	}
}

func TestTwinBehavior(t *testing.T) {
	attrs := []slog.Attr{
		slog.String("s", "hello"),
		slog.Int64("i", -123456789),
		slog.Int("ni", 42),
		slog.Uint64("u", 123456789),
		slog.Float64("f", 3.14159),
		slog.Float64("big", 1e21),
		slog.Float64("small", 1.23e-9),
		slog.Bool("b", true),
		slog.Duration("d", 123456789*time.Nanosecond),
		slog.Duration("neg", -90*time.Minute),
		slog.Time("t", twinTestTime),
		slog.Any("bs", []byte{1, 2, 3, 4}),
		slog.Any("named", twinNamedBytes("abc")),
		slog.Any("raw", twinRawJSON([]byte("1234"))),
		slog.Any("tm", twinText{s: "abc"}),
		slog.Any("ta", twinTextAppend{s: "abc"}),
		slog.Any("err", errors.New("an error occurred")),
		slog.Any("nilv", nil),
		slog.Any("gv", twinGroupValuer{n: 3}),
		slog.Any("sv", twinScalarValuer{s: "q"}),
		slog.Any("m", map[string]int{"b": 2}),
		slog.Any("st", struct {
			A int
			B string
		}{A: 1, B: "two"}),
		slog.Any("dup", 1),
		slog.Any("dup", 2),
		slog.String("sp ace", "a=b"),
		slog.String("quote", "qu\"o"),
		slog.String("uni", "µåπ\thello\n"),
		slog.String("badutf", "badutf\xf6key"),
		slog.String("html", "<escape&>"),
		slog.String("sep", "  "),
		slog.String("", "empty key"),
		slog.Any("", nil),
		slog.Group("g", slog.Int("a", 1), slog.Group("h", slog.Int("b", 2))),
		slog.Group("empty"),
		slog.Group("", slog.Int("inl", 1)),
	}
	full := func() slog.Record {
		r := slog.NewRecord(twinTestTime, slog.LevelInfo, "a message", 0)
		r.AddAttrs(attrs...)
		return r
	}
	upper := func(_ []string, a slog.Attr) slog.Attr {
		a.Key = strings.ToUpper(a.Key)
		return a
	}
	cases := []struct {
		name   string
		record func() slog.Record
		twin   func(io.Writer) slog.Handler
		orig   func(io.Writer) slog.Handler
	}{
		{
			"text full",
			full,
			twinTextPlain,
			origTextPlain,
		},
		{
			"json full",
			full,
			twinJSONPlain,
			origJSONPlain,
		},
		{
			"text empty",
			func() slog.Record { return slog.NewRecord(twinTestTime, slog.LevelWarn, "", 0) },
			twinTextPlain,
			origTextPlain,
		},
		{
			"json empty",
			func() slog.Record { return slog.NewRecord(twinTestTime, slog.LevelWarn, "", 0) },
			twinJSONPlain,
			origJSONPlain,
		},
		{
			"text zero time",
			func() slog.Record { return slog.NewRecord(time.Time{}, slog.LevelError, "m", 0) },
			twinTextPlain,
			origTextPlain,
		},
		{
			"json zero time",
			func() slog.Record { return slog.NewRecord(time.Time{}, slog.LevelError, "m", 0) },
			twinJSONPlain,
			origJSONPlain,
		},
		{
			"text replace upper",
			full,
			func(w io.Writer) slog.Handler {
				return twinslog.NewTextHandler(w, &slog.HandlerOptions{ReplaceAttr: upper})
			},
			func(w io.Writer) slog.Handler {
				return slog.NewTextHandler(w, &slog.HandlerOptions{ReplaceAttr: upper})
			},
		},
		{
			"json replace upper",
			full,
			func(w io.Writer) slog.Handler {
				return twinslog.NewJSONHandler(w, &slog.HandlerOptions{ReplaceAttr: upper})
			},
			func(w io.Writer) slog.Handler {
				return slog.NewJSONHandler(w, &slog.HandlerOptions{ReplaceAttr: upper})
			},
		},
		{
			"text group replace builtin",
			full,
			func(w io.Writer) slog.Handler {
				return twinslog.NewTextHandler(w, &slog.HandlerOptions{ReplaceAttr: func(_ []string, a slog.Attr) slog.Attr {
					if a.Key == slog.TimeKey {
						return slog.Group(slog.TimeKey, slog.Int("mins", 3), slog.Int("secs", 2))
					}
					if a.Key == slog.LevelKey {
						return slog.Attr{}
					}
					return a
				}})
			},
			func(w io.Writer) slog.Handler {
				return slog.NewTextHandler(w, &slog.HandlerOptions{ReplaceAttr: func(_ []string, a slog.Attr) slog.Attr {
					if a.Key == slog.TimeKey {
						return slog.Group(slog.TimeKey, slog.Int("mins", 3), slog.Int("secs", 2))
					}
					if a.Key == slog.LevelKey {
						return slog.Attr{}
					}
					return a
				}})
			},
		},
		{
			"json group replace builtin",
			full,
			func(w io.Writer) slog.Handler {
				return twinslog.NewJSONHandler(w, &slog.HandlerOptions{ReplaceAttr: func(_ []string, a slog.Attr) slog.Attr {
					if a.Key == slog.TimeKey {
						return slog.Group(slog.TimeKey, slog.Int("mins", 3), slog.Int("secs", 2))
					}
					if a.Key == slog.LevelKey {
						return slog.Attr{}
					}
					return a
				}})
			},
			func(w io.Writer) slog.Handler {
				return slog.NewJSONHandler(w, &slog.HandlerOptions{ReplaceAttr: func(_ []string, a slog.Attr) slog.Attr {
					if a.Key == slog.TimeKey {
						return slog.Group(slog.TimeKey, slog.Int("mins", 3), slog.Int("secs", 2))
					}
					if a.Key == slog.LevelKey {
						return slog.Attr{}
					}
					return a
				}})
			},
		},
		{
			"text drop all",
			full,
			func(w io.Writer) slog.Handler {
				return twinslog.NewTextHandler(w, &slog.HandlerOptions{ReplaceAttr: func([]string, slog.Attr) slog.Attr {
					return slog.Attr{}
				}})
			},
			func(w io.Writer) slog.Handler {
				return slog.NewTextHandler(w, &slog.HandlerOptions{ReplaceAttr: func([]string, slog.Attr) slog.Attr {
					return slog.Attr{}
				}})
			},
		},
		{
			"json drop all",
			full,
			func(w io.Writer) slog.Handler {
				return twinslog.NewJSONHandler(w, &slog.HandlerOptions{ReplaceAttr: func([]string, slog.Attr) slog.Attr {
					return slog.Attr{}
				}})
			},
			func(w io.Writer) slog.Handler {
				return slog.NewJSONHandler(w, &slog.HandlerOptions{ReplaceAttr: func([]string, slog.Attr) slog.Attr {
					return slog.Attr{}
				}})
			},
		},
		{
			"text preformatted groups",
			full,
			func(w io.Writer) slog.Handler {
				return twinslog.NewTextHandler(w, new(slog.HandlerOptions)).WithAttrs([]slog.Attr{slog.Int("p1", 1)}).WithGroup("s1").WithAttrs([]slog.Attr{slog.Int("p2", 2)}).WithGroup("s2")
			},
			func(w io.Writer) slog.Handler {
				return slog.NewTextHandler(w, new(slog.HandlerOptions)).WithAttrs([]slog.Attr{slog.Int("p1", 1)}).WithGroup("s1").WithAttrs([]slog.Attr{slog.Int("p2", 2)}).WithGroup("s2")
			},
		},
		{
			"json preformatted groups",
			full,
			func(w io.Writer) slog.Handler {
				return twinslog.NewJSONHandler(w, new(slog.HandlerOptions)).WithAttrs([]slog.Attr{slog.Int("p1", 1)}).WithGroup("s1").WithAttrs([]slog.Attr{slog.Int("p2", 2)}).WithGroup("s2")
			},
			func(w io.Writer) slog.Handler {
				return slog.NewJSONHandler(w, new(slog.HandlerOptions)).WithAttrs([]slog.Attr{slog.Int("p1", 1)}).WithGroup("s1").WithAttrs([]slog.Attr{slog.Int("p2", 2)}).WithGroup("s2")
			},
		},
		{
			"text source",
			func() slog.Record {
				var pcs [1]uintptr
				runtime.Callers(1, pcs[:])
				r := slog.NewRecord(twinTestTime, slog.LevelInfo, "message", pcs[0])
				r.AddAttrs(slog.Int("a", 1))
				return r
			},
			func(w io.Writer) slog.Handler {
				return twinslog.NewTextHandler(w, &slog.HandlerOptions{AddSource: true})
			},
			func(w io.Writer) slog.Handler {
				return slog.NewTextHandler(w, &slog.HandlerOptions{AddSource: true})
			},
		},
		{
			"json source",
			func() slog.Record {
				var pcs [1]uintptr
				runtime.Callers(1, pcs[:])
				r := slog.NewRecord(twinTestTime, slog.LevelInfo, "message", pcs[0])
				r.AddAttrs(slog.Int("a", 1))
				return r
			},
			func(w io.Writer) slog.Handler {
				return twinslog.NewJSONHandler(w, &slog.HandlerOptions{AddSource: true})
			},
			func(w io.Writer) slog.Handler {
				return slog.NewJSONHandler(w, &slog.HandlerOptions{AddSource: true})
			},
		},
		{
			"text marshaler error",
			func() slog.Record {
				r := slog.NewRecord(twinTestTime, slog.LevelInfo, "m", 0)
				r.AddAttrs(slog.Any("t", twinText{s: ""}), slog.Any("ta", twinTextAppend{s: ""}))
				return r
			},
			twinTextPlain,
			origTextPlain,
		},
		{
			"text panic text",
			func() slog.Record {
				r := slog.NewRecord(twinTestTime, slog.LevelInfo, "m", 0)
				r.AddAttrs(slog.Any("t", twinPanicText{}))
				return r
			},
			twinTextPlain,
			origTextPlain,
		},
		{
			"text nan inf",
			func() slog.Record {
				r := slog.NewRecord(twinTestTime, slog.LevelInfo, "m", 0)
				r.AddAttrs(slog.Float64("nan", math.NaN()), slog.Float64("inf", math.Inf(1)))
				return r
			},
			twinTextPlain,
			origTextPlain,
		},
		{
			"json nan inf",
			func() slog.Record {
				r := slog.NewRecord(twinTestTime, slog.LevelInfo, "m", 0)
				r.AddAttrs(slog.Float64("nan", math.NaN()), slog.Float64("inf", math.Inf(1)))
				return r
			},
			twinJSONPlain,
			origJSONPlain,
		},
		{
			"json error marshaler",
			func() slog.Record {
				r := slog.NewRecord(twinTestTime, slog.LevelInfo, "m", 0)
				r.AddAttrs(slog.Any("e", io.EOF), slog.Any("rawerr", twinRawJSON([]byte(""))))
				return r
			},
			twinJSONPlain,
			origJSONPlain,
		},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			compareBoth(t, tc.record(), tc.twin, tc.orig)
		})
	}
}

func TestTwinPanickingValuer(t *testing.T) {
	for _, newH := range []struct {
		name string
		fn   func(io.Writer) slog.Handler
	}{
		{"twin-text", twinTextPlain},
		{"twin-json", twinJSONPlain},
	} {
		t.Run(newH.name, func(t *testing.T) {
			var buf bytes.Buffer
			h := newH.fn(&buf)
			r := slog.NewRecord(twinTestTime, slog.LevelInfo, "m", 0)
			r.AddAttrs(slog.Any("v", twinPanicValuer{}))
			if err := h.Handle(context.Background(), r); err != nil {
				t.Fatal(err)
			}
			got := buf.String()
			if !strings.Contains(got, "LogValue panicked") {
				t.Errorf("missing panic marker in %q", got)
			}
		})
	}
}
