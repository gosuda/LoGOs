package slog

import (
	"context"
	"encoding"
	"fmt"
	"io"
	"log/slog"
	"strconv"
	"sync"
	"unicode"
	"unicode/utf8"

	rtjson "logos/rt/json"
)

// TextHandler writes records as space-separated key=value pairs, one
// record per line, with exactly the layout of log/slog's TextHandler.
// Each call to Handle results in a single serialized call to io.Writer.Write.
type TextHandler struct {
	common *commonHandler
}

// NewTextHandler creates a TextHandler that writes to w with the given
// options. If opts is nil, the default options are used.
func NewTextHandler(w io.Writer, opts *slog.HandlerOptions) *TextHandler {
	if opts == nil {
		opts = &slog.HandlerOptions{}
	}
	return &TextHandler{
		common: &commonHandler{
			json: false,
			w:    w,
			opts: *opts,
			mu:   &sync.Mutex{},
		},
	}
}

// Enabled reports whether the handler handles records at the given level.
func (h *TextHandler) Enabled(_ context.Context, level slog.Level) bool {
	return h.common.enabled(level)
}

// WithAttrs returns a new TextHandler whose attributes consist of h's
// attributes followed by attrs.
func (h *TextHandler) WithAttrs(attrs []slog.Attr) slog.Handler {
	return &TextHandler{common: h.common.withAttrs(attrs)}
}

// WithGroup returns a new TextHandler with the given group appended.
func (h *TextHandler) WithGroup(name string) slog.Handler {
	if name == "" {
		return h
	}
	return &TextHandler{common: h.common.withGroup(name)}
}

// Handle formats its argument Record as a single line of space-separated
// key=value items.
func (h *TextHandler) Handle(_ context.Context, r slog.Record) error {
	return h.common.handle(r)
}

func appendTextValue(s *handleState, v slog.Value) error {
	switch v.Kind() {
	case slog.KindString:
		s.appendString(v.String())
	case slog.KindTime:
		s.appendTime(v.Time())
	case slog.KindAny:
		return appendTextAnyValue(s, v)
	default:
		switch v.Kind() {
		case slog.KindGroup:
			*s.buf = fmt.Append(s.buf.bytes(), v.Group())
		case slog.KindAny, slog.KindLogValuer:
			*s.buf = fmt.Append(s.buf.bytes(), v.Any())
		default:
			*s.buf = appendTextScalar(s.buf.bytes(), v)
		}
	}
	return nil
}

func appendTextAnyValue(s *handleState, v slog.Value) error {
	if ta, ok := v.Any().(encoding.TextAppender); ok {
		var buf []byte
		buf, err := ta.AppendText(buf)
		if err != nil {
			return err
		}
		s.appendBytesAsString(buf)
		return nil
	}
	if tm, ok := v.Any().(encoding.TextMarshaler); ok {
		data, err := tm.MarshalText()
		if err != nil {
			return err
		}
		s.appendBytesAsString(data)
		return nil
	}
	if bs, ok := rtjson.ByteSliceOf(v.Any()); ok {
		*s.buf = strconv.AppendQuote(s.buf.bytes(), string(bs))
		return nil
	}
	s.appendString(fmt.Sprintf("%+v", v.Any()))
	return nil
}

// appendTextScalar appends the text form of a scalar value: the same
// output as log/slog's Value.append for the scalar kinds.
func appendTextScalar(dst []byte, v slog.Value) []byte {
	switch v.Kind() {
	case slog.KindString:
		return append(dst, v.String()...)
	case slog.KindInt64:
		return strconv.AppendInt(dst, v.Int64(), 10)
	case slog.KindUint64:
		return strconv.AppendUint(dst, v.Uint64(), 10)
	case slog.KindFloat64:
		return strconv.AppendFloat(dst, v.Float64(), 'g', -1, 64)
	case slog.KindBool:
		return strconv.AppendBool(dst, v.Bool())
	case slog.KindDuration:
		return appendDuration(dst, v.Duration())
	case slog.KindTime:
		return v.Time().AppendFormat(dst, "2006-01-02 15:04:05.999999999 -0700 MST")
	default:
		return dst
	}
}

// appendBytesAsString appends bytes as a text string value: unquoted when
// the content needs no quoting, double-quoted otherwise. It matches
// appendString(string(b)) byte for byte while saving the intermediate
// string conversion of the payload.
func (s *handleState) appendBytesAsString(b []byte) {
	if needsQuotingBytes(b) {
		*s.buf = strconv.AppendQuote(s.buf.bytes(), string(b))
	} else {
		s.buf.write(b)
	}
}

func needsQuoting(s string) bool {
	if len(s) == 0 {
		return true
	}
	for i := 0; i < len(s); {
		b := s[i]
		if b < utf8.RuneSelf {
			if b != '\\' && (b == ' ' || b == '=' || !safeSet[b]) {
				return true
			}
			i++
			continue
		}
		r, size := utf8.DecodeRuneInString(s[i:])
		if r == utf8.RuneError || unicode.IsSpace(r) || !unicode.IsPrint(r) {
			return true
		}
		i += size
	}
	return false
}

func needsQuotingBytes(s []byte) bool {
	if len(s) == 0 {
		return true
	}
	for i := 0; i < len(s); {
		b := s[i]
		if b < utf8.RuneSelf {
			if b != '\\' && (b == ' ' || b == '=' || !safeSet[b]) {
				return true
			}
			i++
			continue
		}
		r, size := utf8.DecodeRune(s[i:])
		if r == utf8.RuneError || unicode.IsSpace(r) || !unicode.IsPrint(r) {
			return true
		}
		i += size
	}
	return false
}

// safeSet holds the value true if the ASCII character with the given array
// position can be represented inside a JSON string without any further
// escaping. Copied from log/slog's JSON handler, which shares the table
// with the text quoting rule above.
var safeSet = [utf8.RuneSelf]bool{
	' ':      true,
	'!':      true,
	'"':      false,
	'#':      true,
	'$':      true,
	'%':      true,
	'&':      true,
	'\'':     true,
	'(':      true,
	')':      true,
	'*':      true,
	'+':      true,
	',':      true,
	'-':      true,
	'.':      true,
	'/':      true,
	'0':      true,
	'1':      true,
	'2':      true,
	'3':      true,
	'4':      true,
	'5':      true,
	'6':      true,
	'7':      true,
	'8':      true,
	'9':      true,
	':':      true,
	';':      true,
	'<':      true,
	'=':      true,
	'>':      true,
	'?':      true,
	'@':      true,
	'A':      true,
	'B':      true,
	'C':      true,
	'D':      true,
	'E':      true,
	'F':      true,
	'G':      true,
	'H':      true,
	'I':      true,
	'J':      true,
	'K':      true,
	'L':      true,
	'M':      true,
	'N':      true,
	'O':      true,
	'P':      true,
	'Q':      true,
	'R':      true,
	'S':      true,
	'T':      true,
	'U':      true,
	'V':      true,
	'W':      true,
	'X':      true,
	'Y':      true,
	'Z':      true,
	'[':      true,
	'\\':     false,
	']':      true,
	'^':      true,
	'_':      true,
	'`':      true,
	'a':      true,
	'b':      true,
	'c':      true,
	'd':      true,
	'e':      true,
	'f':      true,
	'g':      true,
	'h':      true,
	'i':      true,
	'j':      true,
	'k':      true,
	'l':      true,
	'm':      true,
	'n':      true,
	'o':      true,
	'p':      true,
	'q':      true,
	'r':      true,
	's':      true,
	't':      true,
	'u':      true,
	'v':      true,
	'w':      true,
	'x':      true,
	'y':      true,
	'z':      true,
	'{':      true,
	'|':      true,
	'}':      true,
	'~':      true,
	'\u007f': true,
}
