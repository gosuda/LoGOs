package expect_test

import (
	"fmt"
	"logos/expect"
	unitsa "logos/expect/internal/unitsa"
	unitsb "logos/expect/internal/unitsb"
	"strings"
	"testing"
)

type order struct {
	ID   string
	Qty  int
	Paid bool
	Note string
}

var _ expect.Reporter = (*recorder)(nil)

type recorder struct {
	msg string
}

func (r *recorder) Helper() {}

func (r *recorder) Errorf(format string, args ...any) {
	r.msg += fmt.Sprintf(format, args...)
}

func TestEqualPass(t *testing.T) {
	// Planted fault: Equal reports a diff for identical values.
	a := order{ID: "abc", Qty: 3, Paid: true, Note: "hi"}
	r := &recorder{}
	expect.Equal(r, a, a)
	if r.msg != "" {
		t.Errorf("Equal on identical structs failed:\n got %q", r.msg)
	}
	s := &recorder{}
	expect.Equal(s, 42, 42)
	if s.msg != "" {
		t.Errorf("Equal on identical ints failed:\n got %q", s.msg)
	}
	q := &recorder{}
	expect.Equal(q, "{\"id\":1}", "{\"id\":1}")
	if q.msg != "" {
		t.Errorf("Equal on identical strings failed:\n got %q", q.msg)
	}
}

func TestEqualStructMismatchDiff(t *testing.T) {
	// Planted fault: struct compare skips Qty or emits fields out of order.
	before := order{ID: "abc", Qty: 3, Paid: true, Note: "hi"}
	after := order{ID: "abc", Qty: 4, Paid: true, Note: "hi"}
	r := &recorder{}
	expect.Equal(r, before, after)
	want := "expect: values differ\n--- want\n+++ got\n  ID: \"abc\"\n- Qty: 3\n+ Qty: 4\n  Paid: true\n  Note: \"hi\"\n"
	if r.msg != want {
		t.Errorf("struct diff:\n got %q\nwant %q", r.msg, want)
	}
}

func TestEqualJSONLineDiff(t *testing.T) {
	// Planted fault: multi-line strings diff as one block, hiding the line.
	wantJSON := "{\n  \"id\": 1,\n  \"ok\": true\n}"
	gotJSON := "{\n  \"id\": 2,\n  \"ok\": true\n}"
	r := &recorder{}
	expect.Equal(r, wantJSON, gotJSON)
	want := "expect: values differ\n--- want\n+++ got\n  {\n-   \"id\": 1,\n+   \"id\": 2,\n    \"ok\": true\n  }\n"
	if r.msg != want {
		t.Errorf("json diff:\n got %q\nwant %q", r.msg, want)
	}
}

func TestEqualGreppable(t *testing.T) {
	// Planted fault: diff emits color codes or bare lines gate logs cannot grep.
	r := &recorder{}
	expect.Equal(r, "a\nb\nc\nd", "a\nB\nc\nD")
	if r.msg == "" {
		t.Fatalf("Equal of differing texts recorded nothing")
	}
	if strings.Contains(r.msg, "\x1b") {
		t.Errorf("diff output holds color codes: %q", r.msg)
	}
	lines := strings.Split(r.msg, "\n")
	if lines[0] != "expect: values differ" {
		t.Errorf("header line:\n got %q", lines[0])
	}
	for _, line := range lines[1:] {
		if line == "" || strings.HasPrefix(line, "  ") || strings.HasPrefix(line, "- ") || strings.HasPrefix(line, "+ ") || strings.HasPrefix(line, "--- ") || strings.HasPrefix(line, "+++ ") {
			continue
		}
		t.Errorf("diff line not greppable: %q", line)
	}
}

func TestEqualFieldQuoting(t *testing.T) {
	// Planted fault: string fields render raw, so one field spans two lines.
	before := order{ID: "x", Qty: 0, Paid: false, Note: "a\nb"}
	after := order{ID: "x", Qty: 0, Paid: false, Note: "a\nc"}
	r := &recorder{}
	expect.Equal(r, before, after)
	if !strings.Contains(r.msg, "- Note: \"a\\nb\"") {
		t.Errorf("quoted want line missing:\n got %q", r.msg)
	}
	if !strings.Contains(r.msg, "+ Note: \"a\\nc\"") {
		t.Errorf("quoted got line missing:\n got %q", r.msg)
	}
	if !strings.Contains(r.msg, "Qty: 0") {
		t.Errorf("int field line missing:\n got %q", r.msg)
	}
}

func TestEqualLeafValues(t *testing.T) {
	// Planted fault: leaf renders nil as "<nil>" or slices without %v spacing.
	cases := []struct {
		name string
		want any
		got  any
		diff string
	}{
		{name: "nil", want: nil, got: 42, diff: "expect: values differ\n--- want\n+++ got\n- nil\n+ 42\n"},
		{name: "int", want: 42, got: 43, diff: "expect: values differ\n--- want\n+++ got\n- 42\n+ 43\n"},
		{name: "bool", want: true, got: false, diff: "expect: values differ\n--- want\n+++ got\n- true\n+ false\n"},
		{name: "slice", want: []int{1, 2}, got: []int{1, 3}, diff: "expect: values differ\n--- want\n+++ got\n- [1 2]\n+ [1 3]\n"},
		{name: "string raw", want: "a\nb", got: "a\nc", diff: "expect: values differ\n--- want\n+++ got\n  a\n- b\n+ c\n"},
	}
	for _, c := range cases {
		same := &recorder{}
		expect.Equal(same, c.want, c.want)
		if same.msg != "" {
			t.Errorf("Leaf %s: identical values failed:\n got %q", c.name, same.msg)
		}
		r := &recorder{}
		expect.Equal(r, c.want, c.got)
		if r.msg != c.diff {
			t.Errorf("Leaf %s:\n got %q\nwant %q", c.name, r.msg, c.diff)
		}
	}
}

func TestEqualAmbiguousLeafType(t *testing.T) {
	// Planted fault: the string "nil" renders like nil, so the two
	// compare equal and the mismatch stays silent.
	var wantAny any = "nil"
	var gotAny any = nil
	r := &recorder{}
	expect.Equal(r, wantAny, gotAny)
	want := "expect: ambiguous values differ in type\n- (string) nil\n+ (<nil>) nil\n"
	if r.msg != want {
		t.Errorf("ambiguous leaf:\n got %q\nwant %q", r.msg, want)
	}
	same := &recorder{}
	expect.Equal(same, wantAny, wantAny)
	if same.msg != "" {
		t.Errorf("identical ambiguous values failed:\n got %q", same.msg)
	}
}
func TestEqualStructFieldTypes(t *testing.T) {
	// Planted fault: the struct branch compares rendered text, so an
	// any field changing from int(7) to uint(7) passes silently.
	type holder struct {
		V any
	}
	same := &recorder{}
	expect.Equal(same, holder{V: 7}, holder{V: 7})
	if same.msg != "" {
		t.Errorf("identical struct fields failed:\n got %q", same.msg)
	}
	r := &recorder{}
	expect.Equal(r, holder{V: int(7)}, holder{V: uint(7)})
	if !strings.Contains(r.msg, "differ in type") {
		t.Errorf("int-to-uint field change passed:\n got %q", r.msg)
	}
}

func TestEqualStructSameNameTypes(t *testing.T) {
	// Planted fault: interface fields holding distinct types with the
	// same %T display name and rendered value compare equal, so a
	// cross-package type swap passes silently.
	type holder struct {
		V any
	}
	same := &recorder{}
	expect.Equal(same, holder{V: unitsa.Count(7)}, holder{V: unitsa.Count(7)})
	if same.msg != "" {
		t.Errorf("identical same-name values failed:\n got %q", same.msg)
	}
	r := &recorder{}
	expect.Equal(r, holder{V: unitsa.Count(7)}, holder{V: unitsb.Count(7)})
	if !strings.Contains(r.msg, "differ in type") {
		t.Errorf("same-name type swap passed:\n got %q", r.msg)
	}
	if !strings.Contains(r.msg, "internal/unitsa") || !strings.Contains(r.msg, "internal/unitsb") {
		t.Errorf("diff does not disambiguate the packages:\n got %q", r.msg)
	}
}

type value344 interface{ int | string }

func TestEqualOptionalUnionMemberMismatch(t *testing.T) {
	// Planted fault: Equal skips the type comparison for optional
	// unions lowered to bare interfaces, so int(1) and string("1")
	// compare equal through their rendered text.
	var want value344? = 1
	var got value344? = "1"
	r := &recorder{}
	expect.Equal(r, want, got)
	if !strings.Contains(r.msg, "differ in type") {
		t.Errorf("optional union int-to-string change passed:\n got %q", r.msg)
	}
}

func TestEqualOptionalUnionSameMember(t *testing.T) {
	// Positive control: two optional unions holding the same member
	// type stay equal, so the type check adds no false positive.
	var want value344? = 1
	var other value344? = 1
	same := &recorder{}
	expect.Equal(same, want, other)
	if same.msg != "" {
		t.Errorf("identical optional unions failed:\n got %q", same.msg)
	}
}
type text344 string
type fvalue344 interface{ int | text344 }

func TestEqualOptionalUnionFieldMismatch(t *testing.T) {
	// Planted fault: the struct branch skips the type comparison for
	// an optional-union field, so a member change hides behind the text.
	// The union uses a named string member so both sides render as 1.
	type holder struct {
		V fvalue344?
	}
	var want fvalue344? = 1
	var got fvalue344? = text344("1")
	r := &recorder{}
	expect.Equal(r, holder{V: want}, holder{V: got})
	if !strings.Contains(r.msg, "differ in type") {
		t.Errorf("optional-union field change passed:\n got %q", r.msg)
	}
	same := &recorder{}
	var other fvalue344? = 1
	expect.Equal(same, holder{V: want}, holder{V: other})
	if same.msg != "" {
		t.Errorf("identical optional-union fields failed:\n got %q", same.msg)
	}
}

func TestEqualOptionalIntStaysEqual(t *testing.T) {
	// Positive control: two optional ints with equal text stay equal.
	var a int? = 1
	var b int? = 1
	s := &recorder{}
	expect.Equal(s, a, b)
	if s.msg != "" {
		t.Errorf("identical optional ints failed:\n got %q", s.msg)
	}
}
