type innerRow struct {
	B int    `col:"b"`
	C string `col:"c"`
}

type outerRow struct {
	A     string `col:"a"`
	Inner innerRow
	D     bool `col:"d"`
}

func TestQueryFlattensNestedStructs(t *testing.T) {
	db := openTwinFake(t, "nested", []string{"a", "b", "c", "d"}, [][]driver.Value{{"x", int64(7), "y", int64(1)}})
	gotRows, gotErr := twindb.Query[outerRow](t.Context(), db, "SELECT a, b, c, d FROM nested")
	if gotErr != nil {
		panic(fmt.Sprintf("query nested: %v", gotErr))
	}
	got := gotRows
	if len(got) != 1 {
		t.Fatalf("Query returned %d rows, want 1", len(got))
	}
	if got[0].A != "x" || got[0].Inner.B != 7 || got[0].Inner.C != "y" || got[0].D != true {
		t.Fatalf("nested scan = %+v, want a=x b=7 c=y d=true", got[0])
	}
	raw := openTwinFake(t, "nested-raw", []string{"a", "b", "c", "d"}, [][]driver.Value{{"x", int64(7), "y", int64(1)}})
	rows, err := raw.QueryContext(t.Context(), "SELECT a, b, c, d FROM nested")
	if err != nil {
		panic(fmt.Sprintf("raw query: %v", err))
	}
	if rows == nil {
		panic("raw query returned no rows handle")
	}
	defer func() {
		if cerr := rows.Close(); cerr != nil {
			t.Errorf("raw close: %v", cerr)
		}
	}()
	if !rows.Next() {
		t.Fatal("raw query returned no row")
	}
	var a string
	var b int
	var c string
	var d bool
	if serr := rows.Scan(&a, &b, &c, &d); serr != nil {
		t.Fatalf("raw scan: %v", serr)
	}
	if got[0].A != a || got[0].Inner.B != b || got[0].Inner.C != c || got[0].D != d {
		t.Fatalf("twin %+v disagrees with raw scan %q %d %q %v", got[0], a, b, c, d)
	}
}

func TestQueryRejectsWrongNestedOrder(t *testing.T) {
	db := openTwinFake(t, "nested-bad", []string{"a", "c", "b", "d"}, [][]driver.Value{{"x", "y", int64(7), int64(1)}})
	_, err := twindb.Query[outerRow](t.Context(), db, "SELECT a, c, b, d FROM nested")
	if err == nil || !strings.Contains(err.Error(), `column 1 is "c"`) {
		t.Fatalf("error = %v, want column 1 mismatch", err)
	}
}

type stampedRow struct {
	ID int64     `col:"id"`
	At time.Time `col:"ts"`
}

func TestQueryScansTimestampColumn(t *testing.T) {
	want := time.Unix(1, 2).UTC()
	db := openTwinFake(t, "stamped", []string{"id", "ts"}, [][]driver.Value{{int64(1), want}})
	gotRows, gotErr := twindb.Query[stampedRow](t.Context(), db, "SELECT id, ts FROM stamped")
	if gotErr != nil {
		panic(fmt.Sprintf("query stamped: %v", gotErr))
	}
	got := gotRows
	if len(got) != 1 || got[0].ID != 1 || !got[0].At.Equal(want) {
		t.Fatalf("scan = %+v, want id=1 ts=%v", got, want)
	}
}

func TestOneAbsentAndPresent(t *testing.T) {
	empty := openTwinFake(t, "one-none", []string{"n"}, nil)
	got, err := twindb.One[int64](t.Context(), empty, "SELECT n FROM nums")
	if err != nil {
		panic(fmt.Sprintf("one absent: %v", err))
	}
	if got != nil {
		t.Fatalf("One = %v, want absent", got)
	}
	one := openTwinFake(t, "one-row", []string{"n"}, [][]driver.Value{{int64(7)}})
	present, perr := twindb.One[int64](t.Context(), one, "SELECT n FROM nums")
	if perr != nil {
		panic(fmt.Sprintf("one row: %v", perr))
	}
	if present == nil {
		t.Fatal("One returned no row")
	}
	if value := present ?? 0; value != 7 {
		t.Fatalf("One = %d, want 7", value)
	}
}

func TestOneRejectsTwoRows(t *testing.T) {
	db := openTwinFake(t, "one-two", []string{"n"}, [][]driver.Value{{int64(1)}, {int64(2)}})
	_, err := twindb.One[int64](t.Context(), db, "SELECT n FROM nums")
	if err == nil || !strings.Contains(err.Error(), "query returned more than one row") {
		t.Fatalf("error = %v, want more-than-one-row", err)
	}
}

