func TestQueryRejectsMismatchedColumnsWithoutRows(t *testing.T) {
	db := openTwinFake(t, "pairs-empty", []string{"a", "b", "c"}, nil)
	_, err := twindb.Query[pairRow](t.Context(), db, "SELECT a, b, c FROM pairs")
	if err == nil || !strings.Contains(err.Error(), "has 2 fields, query returned 3 columns") {
