// The fake driver serves canned tables by DSN name and ignores the SQL
// text. A fake driver in the test package is a real part of the
// database/sql contract, not a mock of the twin: values arrive boxed as
// driver.Value exactly as from any driver, and boxing at table setup
// stays outside every allocation gate.

type fakeTable struct {
	cols []string
	rows [][]driver.Value
	err  error
	more *fakeTable?
}

type fakeDriver struct {
	tables map[string]*fakeTable
}

func (d *fakeDriver) Open(name string) (driver.Conn, error) {
	t, ok := d.tables[name]
	if !ok {
		return nil, fmt.Errorf("twinfake: unknown table %q", name)
	}
	return &fakeConn{table: t}, nil
}

type fakeConn struct {
	table *fakeTable
}

func (c *fakeConn) Prepare(query string) (driver.Stmt, error) {
	return &fakeStmt{table: c.table}, nil
}

func (c *fakeConn) Close() error {
	return nil
}

func (c *fakeConn) Begin() (driver.Tx, error) {
	return nil, fmt.Errorf("twinfake: no transactions")
}

func (c *fakeConn) Query(query string, args []driver.Value) (driver.Rows, error) {
	if c.table.err != nil {
		return nil, c.table.err
	}
	return &fakeRows{table: c.table}, nil
}

type fakeStmt struct {
	table *fakeTable
}

func (s *fakeStmt) Close() error {
	return nil
}

func (s *fakeStmt) NumInput() int {
	return -1
}

func (s *fakeStmt) Exec(args []driver.Value) (driver.Result, error) {
	if s.table.err != nil {
		return nil, s.table.err
	}
	return fakeResult{}, nil
}

func (s *fakeStmt) Query(args []driver.Value) (driver.Rows, error) {
	if s.table.err != nil {
		return nil, s.table.err
	}
	return &fakeRows{table: s.table}, nil
}

type fakeResult struct{}

func (fakeResult) LastInsertId() (int64, error) {
	return 1, nil
}

func (fakeResult) RowsAffected() (int64, error) {
	return 1, nil
}

type fakeRows struct {
	table *fakeTable
	idx int
}

func (r *fakeRows) Columns() []string {
	return r.table.cols
}

func (r *fakeRows) Close() error {
	return nil
}

func (r *fakeRows) Next(dest []driver.Value) error {
	if r.idx >= len(r.table.rows) {
		return io.EOF
	}
	copy(dest, r.table.rows[r.idx])
	r.idx++
	return nil
}

func (r *fakeRows) HasNextResultSet() bool {
	return r.table.more != nil
}

func (r *fakeRows) NextResultSet() error {
	if r.table.more == nil {
		return io.EOF
	}
	r.table = r.table.more ?? r.table
	r.idx = 0
	return nil
}

var twinFake = &fakeDriver{tables: map[string]*fakeTable{}}

var twinFakeOnce sync.Once

func openTwinFake(t *testing.T, name string, cols []string, rows [][]driver.Value) *sql.DB {
	t.Helper()
	twinFakeOnce.Do(func() {
		sql.Register("twinfake", twinFake)
	})
	twinFake.tables[name] = &fakeTable{cols: cols, rows: rows}
	return openFakeDB(t, name)
}

func openTwinFakeMulti(t *testing.T, name string, cols []string, rows [][]driver.Value, moreCols []string, moreRows [][]driver.Value) *sql.DB {
	t.Helper()
	twinFakeOnce.Do(func() {
		sql.Register("twinfake", twinFake)
	})
	twinFake.tables[name] = &fakeTable{cols: cols, rows: rows, more: &fakeTable{cols: moreCols, rows: moreRows}}
	return openFakeDB(t, name)
}

func openFakeDB(t *testing.T, name string) *sql.DB {
	t.Helper()
	db, err := sql.Open("twinfake", name)
	if err != nil {
		panic(fmt.Sprintf("open %s: %v", name, err))
	}
	t.Cleanup(func() {
		delete(twinFake.tables, name)
		if cerr := db.Close(); cerr != nil {
			t.Errorf("close %s: %v", name, cerr)
		}
	})
	return db
}

func openTwinFakeErr(t *testing.T, name string, err error) *sql.DB {
	t.Helper()
	twinFakeOnce.Do(func() {
		sql.Register("twinfake", twinFake)
	})
	twinFake.tables[name] = &fakeTable{err: err}
	db, oerr := sql.Open("twinfake", name)
	if oerr != nil {
		panic(fmt.Sprintf("open %s: %v", name, oerr))
	}
	t.Cleanup(func() {
		delete(twinFake.tables, name)
		if cerr := db.Close(); cerr != nil {
			t.Errorf("close %s: %v", name, cerr)
		}
	})
	return db
}

type pairRow struct {
	A string `col:"a"`
	B string `col:"b"`
}

func TestQueryScansStructAndScalars(t *testing.T) {
	db := openTwinFake(t, "pairs", []string{"a", "b"}, [][]driver.Value{{"x", "y"}})
	gotRows, gotErr := twindb.Query[pairRow](t.Context(), db, "SELECT a, b FROM pairs")
	if gotErr != nil {
		panic(fmt.Sprintf("query pairs: %v", gotErr))
	}
	got := gotRows
	if len(got) != 1 || got[0].A != "x" || got[0].B != "y" {
		t.Fatalf("Query = %+v, want [{x y}]", got)
	}
}

func TestQueryScansScalarColumns(t *testing.T) {
	db := openTwinFake(t, "nums", []string{"n"}, [][]driver.Value{{int64(7)}})
	gotRows, gotErr := twindb.Query[int64](t.Context(), db, "SELECT n FROM nums")
	if gotErr != nil {
		panic(fmt.Sprintf("query nums: %v", gotErr))
	}
	got := gotRows
	if len(got) != 1 || got[0] != 7 {
		t.Fatalf("Query = %v, want [7]", got)
	}
	db2 := openTwinFake(t, "words", []string{"w"}, [][]driver.Value{{"7"}})
	wordsRows, wordsErr := twindb.Query[string](t.Context(), db2, "SELECT w FROM words")
	if wordsErr != nil {
		panic(fmt.Sprintf("query words: %v", wordsErr))
	}
	words := wordsRows
	if len(words) != 1 || words[0] != "7" {
		t.Fatalf("Query = %v, want [7]", words)
	}
}

func TestQueryRejectsWrongColumnOrder(t *testing.T) {
	db := openTwinFake(t, "pairs-bad", []string{"b", "a"}, [][]driver.Value{{"y", "x"}})
	_, err := twindb.Query[pairRow](t.Context(), db, "SELECT b, a FROM pairs")
	if err == nil || !strings.Contains(err.Error(), `column 0 is "b"`) {
		t.Fatalf("error = %v, want column 0 mismatch", err)
	}
}

func TestQueryRejectsExtraColumn(t *testing.T) {
	db := openTwinFake(t, "pairs-wide", []string{"a", "b", "c"}, [][]driver.Value{{"x", "y", "z"}})
	_, err := twindb.Query[pairRow](t.Context(), db, "SELECT a, b, c FROM pairs")
	if err == nil || !strings.Contains(err.Error(), "has 2 fields, query returned 3 columns") {
		t.Fatalf("error = %v, want field count mismatch", err)
	}
}

