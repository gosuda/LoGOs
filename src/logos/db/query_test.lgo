func TestOneRejectsMismatchedColumnsWithoutRows(t *testing.T) {
	db := openTwinFake(t, "one-empty", []string{"b", "a"}, nil)
	_, err := twindb.One[pairRow](t.Context(), db, "SELECT b, a FROM pairs")
