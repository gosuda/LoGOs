type snakeRow struct {
	ProductID  int64
	OrderTotal float64
}

func TestQueryExpectsSnakeCaseWithoutTag(t *testing.T) {
	db := openTwinFake(t, "snake", []string{"product_id", "order_total"}, [][]driver.Value{{int64(9), float64(4.5)}})
	gotRows, gotErr := twindb.Query[snakeRow](t.Context(), db, "SELECT product_id, order_total FROM snake")
	if gotErr != nil {
		panic(fmt.Sprintf("query snake: %v", gotErr))
	}
	got := gotRows
	if len(got) != 1 || got[0].ProductID != 9 || got[0].OrderTotal != 4.5 {
		t.Fatalf("Query = %+v, want one row 9/4.5", got)
	}
}

type optionRow struct {
	OptS string?  `col:"opt_s"`
	OptB bool?    `col:"opt_b"`
	OptI int64?   `col:"opt_i"`
	OptF float64? `col:"opt_f"`
	OptT time.Time? `col:"opt_t"`
}

func TestQueryRoundTripsOptionFields(t *testing.T) {
	when := time.Unix(1690000000, 0).UTC()
	db := openTwinFake(t, "opts", []string{"opt_s", "opt_b", "opt_i", "opt_f", "opt_t"}, [][]driver.Value{
		{nil, nil, nil, nil, nil},
		{"sku", int64(1), int64(-64), float64(2.25), when},
	})
	rowsQ, rowsQErr := twindb.Query[optionRow](t.Context(), db, "SELECT opt_s, opt_b, opt_i, opt_f, opt_t FROM opts")
	if rowsQErr != nil {
		panic(fmt.Sprintf("query opts: %v", rowsQErr))
	}
	rows := rowsQ
	if len(rows) != 2 {
		t.Fatalf("Query returned %d rows, want 2", len(rows))
	}
	if rows[0].OptS != nil || rows[0].OptB != nil || rows[0].OptT != nil {
		t.Fatalf("NULL row = %+v, want every option absent", rows[0])
	}
	if value := rows[1].OptS ?? ""; value != "sku" {
		t.Fatalf("row opt_s = %q, want sku", value)
	}
	if value := rows[1].OptB ?? false; value != true {
		t.Fatalf("row opt_b = %v, want true", value)
	}
	if value := rows[1].OptI ?? 0; value != -64 {
		t.Fatalf("row opt_i = %d, want -64", value)
	}
	if value := rows[1].OptF ?? 0; value != 2.25 {
		t.Fatalf("row opt_f = %v, want 2.25", value)
	}
	zero := time.Time{}
	if value := rows[1].OptT ?? zero; !value.Equal(when) {
		t.Fatalf("row opt_t = %v, want %v", value, when)
	}
	raw := openTwinFake(t, "opts-raw", []string{"opt_s", "opt_b", "opt_i", "opt_f", "opt_t"}, [][]driver.Value{
		{nil, nil, nil, nil, nil},
		{"sku", int64(1), int64(-64), float64(2.25), when},
	})
	rrows, err := raw.QueryContext(t.Context(), "SELECT opt_s, opt_b, opt_i, opt_f, opt_t FROM opts")
	if err != nil {
		panic(fmt.Sprintf("raw query: %v", err))
	}
	if rrows == nil {
		panic("raw query returned no rows handle")
	}
	defer func() {
		if cerr := rrows.Close(); cerr != nil {
			t.Errorf("raw close: %v", cerr)
		}
	}()
	var raws []optionRaw
	for rrows.Next() {
		var raw optionRaw
		if serr := rrows.Scan(&raw.OptS, &raw.OptB, &raw.OptI, &raw.OptF, &raw.OptT); serr != nil {
			t.Fatalf("raw scan: %v", serr)
		}
		raws = append(raws, raw)
	}
	if len(raws) != 2 || raws[0].OptS.Valid || !raws[1].OptS.Valid || raws[1].OptS.V != "sku" {
		t.Fatalf("raw oracle = %+v, want NULL then sku", raws)
	}
	if !raws[1].OptT.Valid || !raws[1].OptT.V.Equal(when) {
		t.Fatalf("raw oracle time = %+v, want %v", raws[1].OptT, when)
	}
	twinB := rows[1].OptB ?? false
	if raws[1].OptB.V != twinB {
		t.Fatalf("twin opt_b disagrees with raw oracle")
	}
}

type optionRaw struct {
	OptS sql.Null[string]
	OptB sql.Null[bool]
	OptI sql.Null[int64]
	OptF sql.Null[float64]
	OptT sql.Null[time.Time]
}

type mixedRow struct {
	A   string `col:"a"`
	Mid int64? `col:"mid"`
	B   string `col:"b"`
}

func TestQueryKeepsOptionPosition(t *testing.T) {
	db := openTwinFake(t, "mixed", []string{"a", "mid", "b"}, [][]driver.Value{
		{"p", int64(42), "q"},
		{"x", nil, "y"},
	})
	rowsQ, rowsQErr := twindb.Query[mixedRow](t.Context(), db, "SELECT a, mid, b FROM mixed ORDER BY a")
	if rowsQErr != nil {
		panic(fmt.Sprintf("query mixed: %v", rowsQErr))
	}
	rows := rowsQ
	if len(rows) != 2 {
		t.Fatalf("Query returned %d rows, want 2", len(rows))
	}
	if rows[0].A != "p" || rows[0].B != "q" {
		t.Fatalf("first row = %+v, want a=p b=q", rows[0])
	}
	if value := rows[0].Mid ?? 0; value != 42 {
		t.Fatalf("first mid = %d, want 42", value)
	}
	if rows[1].Mid != nil {
		t.Fatalf("second mid holds a value, want absent")
	}
	if rows[1].A != "x" || rows[1].B != "y" {
		t.Fatalf("second row = %+v, want a=x b=y", rows[1])
	}
}

type Status string

type statusRow struct {
	Name Status  `col:"name"`
	Note string? `col:"note"`
}

type namedScalarRow struct {
	ID     int64   `col:"id"`
	Active Status2 `col:"active"`
	Score  float64 `col:"score"`
	Note   int64?  `col:"note"`
}

type Status2 string

func TestQueryScansNamedScalars(t *testing.T) {
	db := openTwinFake(t, "named", []string{"id", "active", "score", "note"}, [][]driver.Value{
		{int64(7), "yes", float64(2.5), int64(42)},
		{int64(8), "no", float64(3.25), nil},
	})
	rowsQ, rowsQErr := twindb.Query[namedScalarRow](t.Context(), db, "SELECT id, active, score, note FROM named")
	if rowsQErr != nil {
		panic(fmt.Sprintf("query named: %v", rowsQErr))
	}
	rows := rowsQ
	if len(rows) != 2 {
		t.Fatalf("Query returned %d rows, want 2", len(rows))
	}
	if rows[0].ID != 7 || rows[0].Active != "yes" || rows[0].Score != 2.5 {
		t.Fatalf("first row = %+v, want id=7 active=yes score=2.5", rows[0])
	}
	if value := rows[0].Note ?? 0; value != 42 {
		t.Fatalf("first note = %d, want 42", value)
	}
	if rows[1].Note != nil {
		t.Fatalf("second note holds a value, want absent")
	}
}

func TestQueryScansStatusRow(t *testing.T) {
	db := openTwinFake(t, "status", []string{"name", "note"}, [][]driver.Value{{"on", nil}})
	rowsQ, rowsQErr := twindb.Query[statusRow](t.Context(), db, "SELECT name, note FROM status")
	if rowsQErr != nil {
		panic(fmt.Sprintf("query status: %v", rowsQErr))
	}
	rows := rowsQ
	if len(rows) != 1 || rows[0].Name != "on" || rows[0].Note != nil {
		t.Fatalf("Query = %+v, want name=on note absent", rows)
	}
}

func TestQueryRejectsNullInNamedScalar(t *testing.T) {
	db := openTwinFake(t, "named-null", []string{"id", "active", "score", "note"}, [][]driver.Value{{nil, "yes", float64(2.5), int64(9)}})
	_, err := twindb.Query[namedScalarRow](t.Context(), db, "SELECT id, active, score, note FROM named")
	if err == nil || !strings.Contains(err.Error(), "NULL in non-optional") {
		t.Fatalf("error = %v, want NULL in non-optional", err)
	}
}

type uuidRow struct {
	ID uuid.UUID `col:"id"`
}

func TestQueryScansUUID(t *testing.T) {
	want := uuid.MustParse("97b6a4e0-5323-43e9-82c8-88110d6686d6")
	db := openTwinFake(t, "uuids", []string{"id"}, [][]driver.Value{{"97b6a4e0-5323-43e9-82c8-88110d6686d6"}})
	gotRows, gotErr := twindb.Query[uuidRow](t.Context(), db, "SELECT id FROM uuids")
	if gotErr != nil {
		panic(fmt.Sprintf("query uuids: %v", gotErr))
	}
	got := gotRows
	if len(got) != 1 || got[0].ID != want {
		t.Fatalf("Query = %+v, want %v", got, want)
	}
	raw := []byte{0x97, 0xb6, 0xa4, 0xe0, 0x53, 0x23, 0x43, 0xe9, 0x82, 0xc8, 0x88, 0x11, 0x0d, 0x66, 0x86, 0xd6}
	db2 := openTwinFake(t, "uuids-raw", []string{"id"}, [][]driver.Value{{raw}})
	got2Rows, got2Err := twindb.Query[uuidRow](t.Context(), db2, "SELECT id FROM uuids")
	if got2Err != nil {
		panic(fmt.Sprintf("query uuids-raw: %v", got2Err))
	}
	got2 := got2Rows
	if len(got2) != 1 || got2[0].ID != want {
		t.Fatalf("Query = %+v, want %v", got2, want)
	}
}

type nullRow struct {
	S sql.Null[string] `col:"s"`
	N sql.Null[int64]   `col:"n"`
}

func TestQueryScansNullFields(t *testing.T) {
	db := openTwinFake(t, "nulls", []string{"s", "n"}, [][]driver.Value{{nil, int64(3)}, {"v", nil}})
	rowsQ, rowsQErr := twindb.Query[nullRow](t.Context(), db, "SELECT s, n FROM nulls")
	if rowsQErr != nil {
		panic(fmt.Sprintf("query nulls: %v", rowsQErr))
	}
	rows := rowsQ
	if len(rows) != 2 {
		t.Fatalf("Query returned %d rows, want 2", len(rows))
	}
	if rows[0].S.Valid || !rows[0].N.Valid || rows[0].N.V != 3 {
		t.Fatalf("first row = %+v, want s invalid n=3", rows[0])
	}
	if !rows[1].S.Valid || rows[1].S.V != "v" || rows[1].N.Valid {
		t.Fatalf("second row = %+v, want s=v n invalid", rows[1])
	}
}

type anyRow struct {
	V any `col:"v"`
}

func TestQueryScansAnyField(t *testing.T) {
	db := openTwinFake(t, "anys", []string{"v"}, [][]driver.Value{{"s"}, {int64(4)}, {[]byte("b")}})
	rowsQ, rowsQErr := twindb.Query[anyRow](t.Context(), db, "SELECT v FROM anys")
	if rowsQErr != nil {
		panic(fmt.Sprintf("query anys: %v", rowsQErr))
	}
	rows := rowsQ
	if len(rows) != 3 {
		t.Fatalf("Query returned %d rows, want 3", len(rows))
	}
	if rows[0].V != any("s") || rows[1].V != any(int64(4)) {
		t.Fatalf("Query = %+v, want s and 4", rows)
	}
	bb, ok := rows[2].V.([]byte)
	if !ok || string(bb) != "b" {
		t.Fatalf("Query row 2 = %#v, want b", rows[2].V)
	}
}

type uintRow struct {
	U   uint   `col:"u"`
	U8  uint8  `col:"u8"`
	U16 uint16 `col:"u16"`
	U32 uint32 `col:"u32"`
	U64 uint64 `col:"u64"`
	OU  uint?  `col:"ou"`
}

func TestQueryScansUintKinds(t *testing.T) {
	db := openTwinFake(t, "uints", []string{"u", "u8", "u16", "u32", "u64", "ou"}, [][]driver.Value{
		{int64(1), int64(2), int64(3), int64(4), int64(5), nil},
		{int64(6), int64(7), int64(8), int64(9), int64(10), int64(11)},
	})
	rowsQ, rowsQErr := twindb.Query[uintRow](t.Context(), db, "SELECT u, u8, u16, u32, u64, ou FROM uints")
	if rowsQErr != nil {
		panic(fmt.Sprintf("query uints: %v", rowsQErr))
	}
	rows := rowsQ
	if len(rows) != 2 {
		t.Fatalf("Query returned %d rows, want 2", len(rows))
	}
	if rows[0].U != 1 || rows[0].U8 != 2 || rows[0].U16 != 3 || rows[0].U32 != 4 || rows[0].U64 != 5 || rows[0].OU != nil {
		t.Fatalf("first row = %+v, want 1/2/3/4/5 absent", rows[0])
	}
	if value := rows[1].OU ?? 0; value != 11 {
		t.Fatalf("second ou = %d, want 11", value)
	}
}


func TestExecPassthrough(t *testing.T) {
	db := openTwinFake(t, "exec-ok", []string{"n"}, [][]driver.Value{{int64(1)}})
	res, err := twindb.Exec(t.Context(), db, "UPDATE nums SET n = 8")
	if err != nil {
		panic(fmt.Sprintf("exec: %v", err))
	}
	id, ierr := res.LastInsertId()
	if ierr != nil {
		panic(fmt.Sprintf("last insert id: %v", ierr))
	}
	if id != 1 {
		t.Fatalf("LastInsertId = %d, want 1", id)
	}
	boom := fmt.Errorf("twinfake: boom")
	bad := openTwinFakeErr(t, "exec-boom", boom)
	_, berr := twindb.Exec(t.Context(), bad, "UPDATE nums SET n = 8")
	if berr == nil || !strings.Contains(berr.Error(), "twinfake: boom") {
		t.Fatalf("error = %v, want twinfake: boom", berr)
	}
}

func TestQueryPropagatesDriverError(t *testing.T) {
	boom := fmt.Errorf("twinfake: query boom")
	db := openTwinFakeErr(t, "query-boom", boom)
	_, err := twindb.Query[int64](t.Context(), db, "SELECT n FROM nums")
	if err == nil || !strings.Contains(err.Error(), "twinfake: query boom") {
		t.Fatalf("error = %v, want twinfake: query boom", err)
	}
}

func TestQueryScanErrorWraps(t *testing.T) {
	db := openTwinFake(t, "bad-int", []string{"n"}, [][]driver.Value{{"foo"}})
	_, err := twindb.Query[int64](t.Context(), db, "SELECT n FROM bad")
	if err == nil || !strings.Contains(err.Error(), "Scan error on column index 0") || !strings.Contains(err.Error(), "invalid syntax") {
		t.Fatalf("error = %v, want wrapped scan error", err)
	}
}

type reuseScanner struct {
	buf []byte
}

// Scan keeps one buffer and rewrites it in place, exactly the shape
// that exposes a destination reused across rows without a reset.
func (s *reuseScanner) Scan(src any) error {
	b, ok := src.([]byte)
	if !ok {
		return fmt.Errorf("reuse scanner got %T", src)
	}
	if cap(s.buf) == 0 {
		s.buf = make([]byte, 0, 16)
	}
	s.buf = append(s.buf[:0], b...)
	return nil
}

type reuseRow struct {
	S reuseScanner `col:"s"`
}

func TestQueryResetsScannerRows(t *testing.T) {
	db := openTwinFake(t, "reuse", []string{"s"}, [][]driver.Value{
		{[]byte("aa")},
		{[]byte("bb")},
	})
	gotRows, gotErr := twindb.Query[reuseRow](t.Context(), db, "SELECT s FROM reuse")
	if gotErr != nil {
		panic(fmt.Sprintf("query reuse: %v", gotErr))
	}
	rows := gotRows
	if len(rows) != 2 {
		t.Fatalf("Query returned %d rows, want 2", len(rows))
	}
	if string(rows[0].S.buf) != "aa" {
		t.Fatalf("first buf = %q, want aa", rows[0].S.buf)
	}
	if string(rows[1].S.buf) != "bb" {
		t.Fatalf("second buf = %q, want bb", rows[1].S.buf)
	}
}

func TestQueryTopLevelScalarShapes(t *testing.T) {
	when := time.Unix(1690000000, 0).UTC()
	db := openTwinFake(t, "times", []string{"t"}, [][]driver.Value{{when}})
	rows, err := twindb.Query[time.Time](t.Context(), db, "SELECT t FROM times")
	if err != nil {
		panic(fmt.Sprintf("query times: %v", err))
	}
	if len(rows) != 1 || !rows[0].Equal(when) {
		t.Fatalf("Query[time.Time] = %+v, want [%v]", rows, when)
	}
	ndb := openTwinFake(t, "nulls", []string{"v"}, [][]driver.Value{{nil}, {"x"}})
	ns, nerr := twindb.Query[sql.Null[string]](t.Context(), ndb, "SELECT v FROM nulls")
	if nerr != nil {
		panic(fmt.Sprintf("query nulls: %v", nerr))
	}
	if len(ns) != 2 || ns[0].Valid || !ns[1].Valid || ns[1].V != "x" {
		t.Fatalf("Query[sql.Null[string]] = %+v, want [{false} {x true}]", ns)
	}
}

func TestQueryRejectsSecondResultSet(t *testing.T) {
	db := openTwinFakeMulti(t, "two-sets", []string{"a"}, [][]driver.Value{{"x"}}, []string{"b"}, [][]driver.Value{{"y"}})
	_, err := twindb.Query[string](t.Context(), db, "SELECT a FROM s")
	if err == nil || !strings.Contains(err.Error(), "multiple result sets") {
		t.Fatalf("Query error = %v, want multiple result sets", err)
	}
	db2 := openTwinFakeMulti(t, "two-sets-one", []string{"a"}, [][]driver.Value{{"x"}}, []string{"b"}, [][]driver.Value{{"y"}})
	_, err = twindb.One[string](t.Context(), db2, "SELECT a FROM s")
	if err == nil || !strings.Contains(err.Error(), "multiple result sets") {
		t.Fatalf("One error = %v, want multiple result sets", err)
	}
}

type wideOptRow struct {
	B []byte?        `col:"b"`
	U uuid.UUID?    `col:"u"`
	R sql.RawBytes? `col:"r"`
}

func TestQueryScansWideOptions(t *testing.T) {
	uid := uuid.MustParse("97b6a4e0-5323-43e9-82c8-88110d6686d6")
	db := openTwinFake(t, "wide", []string{"b", "u", "r"}, [][]driver.Value{
		{[]byte("x"), "97b6a4e0-5323-43e9-82c8-88110d6686d6", []byte("r1")},
		{nil, nil, nil},
	})
	rowsQ, rowsErr := twindb.Query[wideOptRow](t.Context(), db, "SELECT b, u, r FROM wide")
	if rowsErr != nil {
		panic(fmt.Sprintf("query wide: %v", rowsErr))
	}
	rows := rowsQ
	if len(rows) != 2 {
		t.Fatalf("Query returned %d rows, want 2", len(rows))
	}
	if value := rows[0].B ?? nil; string(value) != "x" {
		t.Fatalf("row b = %q, want x", value)
	}
	var zu uuid.UUID
	if value := rows[0].U ?? zu; value != uid {
		t.Fatalf("row u = %v, want %v", value, uid)
	}
	if value := rows[0].R ?? nil; string(value) != "r1" {
		t.Fatalf("row r = %q, want r1", value)
	}
	if rows[1].B != nil || rows[1].U != nil || rows[1].R != nil {
		t.Fatalf("NULL row = %+v, want every option absent", rows[1])
	}
}

func TestQueryRowAllocs(t *testing.T) {
	db := openTwinFake(t, "allocs", []string{"a", "b"}, [][]driver.Value{
		{"x", "y"},
		{"x", "y"},
		{"x", "y"},
		{"x", "y"},
	})
	n := testing.AllocsPerRun(50, func() {
		got, err := twindb.Query[pairRow](t.Context(), db, "SELECT a, b FROM pairs")
		if err != nil {
			panic(fmt.Sprintf("query pairs: %v", err))
		}
		if len(got) != 4 {
			panic(fmt.Sprintf("query pairs = %d rows, want 4", len(got)))
		}
	})
	t.Logf("Query allocs per run: %v", n)
	if n > 60 {
		t.Fatalf("allocs = %v, want at most 60", n)
	}
}
