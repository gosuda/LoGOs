package owner

import "comptime"

type FirstID int
type SecondID int
type OptionalIntPointer = *int?

func PointerTypesDiffer() bool {
	return differentTypes[*int, OptionalIntPointer]()
}

func differentTypes[A, B any]() bool {
	const if comptime.TypeOf[A]() != comptime.TypeOf[B]() {
		return true
	}
	return false
}

func Pair[A, B any]() [2]string {
	return [2]string{Kind[A](), Kind[B]()}
}

func Kind[T any]() string {
	const if comptime.TypeOf[T]() == comptime.TypeOf[*int]() {
		return "non-nil"
	}
	const if comptime.TypeOf[T]() == comptime.TypeOf[OptionalIntPointer]() {
		return "optional"
	}
	const if comptime.TypeOf[T]() == comptime.TypeOf[FirstID]() {
		return "first-id"
	}
	const if comptime.TypeOf[T]() == comptime.TypeOf[SecondID]() {
		return "second-id"
	}
	panic("unexpected type argument")
}
