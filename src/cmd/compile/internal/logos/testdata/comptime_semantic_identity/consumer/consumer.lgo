package consumer

import "example.com/semanticidentity/forward"

type optionalIntPointer = *int?

func Reverse() [2]string {
	return forward.Pair[optionalIntPointer, *int]()
}

func Shared() [2]string {
	return forward.Pair[*int, optionalIntPointer]()
}
