package main

import (
	"fmt"

	"example.com/semanticidentity/owner"
)

type optionalIntPointer = *int?

func main() {
	if !owner.PointerTypesDiffer() {
		panic("non-nil and optional pointers have the same compile-time type")
	}
	fmt.Println("forward", [2]string{owner.Kind[*int](), owner.Kind[optionalIntPointer]()})
	fmt.Println("reverse", [2]string{owner.Kind[optionalIntPointer](), owner.Kind[*int]()})
	fmt.Println("shared", [2]string{owner.Kind[*int](), owner.Kind[optionalIntPointer]()})
	fmt.Println("named", [2]string{owner.Kind[owner.FirstID](), owner.Kind[owner.SecondID]()})
}
