package owner

import "comptime"

type Shared struct {
	N int
}

type Distinct struct {
	N int
}

func Adjust[T any](n int) int {
	const if comptime.TypeOf[T]() == comptime.TypeOf[Shared]() {
		return n + 1
	}
	return n + 2
}
