package scan

import "comptime"

func Tags[T any]() ([2]string, [2]string) {
	var tags, arms [2]string
	const for i, f := range comptime.Fields[T]() {
		tags[i] = f.Tag.Get(f.Tag.Get("key"))
		const if f.Tag.Get(f.Tag.Get("key")) == "one" {
			arms[i] = "then"
		} else {
			arms[i] = "else"
		}
	}
	return tags, arms
}
