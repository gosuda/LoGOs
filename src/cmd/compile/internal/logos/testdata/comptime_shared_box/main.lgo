package main

import (
	"fmt"

	"example.com/sharedbox/left"
	"example.com/sharedbox/right"
)

func main() {
	written, leftMap := left.Write(77)
	read, rightMap := right.Read()
	fmt.Println(written, read, leftMap == rightMap)
}
