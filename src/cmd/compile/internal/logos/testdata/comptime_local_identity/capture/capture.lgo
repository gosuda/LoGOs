package capture

import "example.com/localidentity/probe"

func Measure[T any]() (int, any) {
	type record struct{ Value T }
	type stamp struct{}
	size, _ := probe.Measure[record](record{})
	_, token := probe.Measure[stamp](stamp{})
	return size, token
}
