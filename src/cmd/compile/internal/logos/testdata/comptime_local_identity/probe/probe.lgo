package probe

import (
	"comptime"
	"fmt"
)

func Measure[T any](sample any) (int, any) {
	var zero T
	if _, ok := sample.(T); !ok {
		panic(fmt.Sprintf("comptime specialized for %T, want %T", zero, sample))
	}
	return comptime.SizeOf[T](), zero
}
