package right

import "example.com/helperunit/owner"

func Probe(key int) (map[int]int, map[int]int) { return owner.Probe[owner.Shared](key, 1) }

func ProbeDistinct(key int) (map[int]int, map[int]int) { return owner.Probe[owner.Distinct](key, 2) }

func Declared() map[int]int { return owner.Declared[owner.Distinct]() }
