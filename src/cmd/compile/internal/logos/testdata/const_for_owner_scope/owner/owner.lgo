package owner

import "comptime"

type scoreSeed [3]int

func nextScore(n int) int { return 2*n + 1 }

func Score[T any]() int {
	var seed scoreSeed
	n := len(seed)
	const for _, f := range comptime.Fields[T]() {
		n = nextScore(n + f.Index)
	}
	return n
}
