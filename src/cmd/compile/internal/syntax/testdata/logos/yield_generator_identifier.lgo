package p

import "iter"

type T struct{ f int }

func (T) m() {}

func genField() iter.Seq[int] {
	yield := T{}
	yield.f = 3
	yield.m()
	yield 1
}

func plainIndex(yield []int) {
	yield[0] = 1
	yield[0]++
}

func plainField(yield T) {
	yield.f = 1
	yield.m()
}
