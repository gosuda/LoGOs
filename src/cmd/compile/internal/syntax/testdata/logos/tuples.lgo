type Holder struct {
	F (int, error)
	G (x int, y string)
}

func params(t (x int, y string), u (int, error)) (int, error) {
	_ = t.x
	_ = t.y
	a, b := t
	_, _ = a, b
	c, d := u
	_, _ = c, d
	return a, nil
}

func lits(a int, b string) {
	u := (1, "s")
	_ = u
	v := (a, b)
	_ = v
	w := (a)
	_ = w
	_ = (a + 1, b)
	_ = ((a, b))
}

func lambdas(f func(int, int) bool) {
	g := (a, b) => a < b
	_ = g
	h := x => x + 1
	_ = h
	m := (a, b) => {
		return a < b
	}
	_ = m
	_ = f
}

func parens(x int) int {
	y := (x + 1) * 2
	_ = y
	var z (int) = (x)
	_ = z
	if (x > 0) {
		return (x)
	}
	return x
}

