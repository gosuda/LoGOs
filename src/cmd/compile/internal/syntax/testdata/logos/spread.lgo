package p

type SpreadState struct {
	A int
	B int
}

func spreadForms(s, t SpreadState) {
	_ = SpreadState{..s}
	_ = SpreadState{A: 1, ..s}
	_ = SpreadState{..s, B: 2}
	_ = SpreadState{A: s.B, B: s.A, ..s}
	_ = SpreadState{..s, ..t}
	_ = SpreadState{..s.A}
	_ = SpreadState{..t}
	_ = []SpreadState{{A: 1, ..s}}
	_ = &SpreadState{..s}
}

func spreadLoneDot() {
	_ = SpreadState{.A: 1} // ERROR syntax error: unexpected name A, expected \. for spread `\.\.src` in struct literal
}
