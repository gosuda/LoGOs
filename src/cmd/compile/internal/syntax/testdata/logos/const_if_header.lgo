package p

const debugOn = true

type point struct{ x, y int }

func constIfName() int {
	const if debugOn {
		return 1
	}
	return 2
}

func constIfTrue() int {
	const if true {
		return 1
	} else {
		return 2
	}
}

func constIfBinary() int {
	const if debugOn && !false {
		return 1
	} else const if debugOn {
		return 2
	} else const if false {
		return 3
	}
	return 4
}

func constIfParenLiteral(p point) int {
	const if (point{1, 2}) == p {
		return 1
	}
	return 2
}

func constIfCall() int {
	const if len("ab") == 2 {
		return 1
	}
	return 2
}
