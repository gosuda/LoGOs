// run -goexperiment logosarena

package main

import (
	"context"
	"fmt"
	"os"
	"runtime"
	"testing"
)

type preNode struct {
	v int
}

var preSink int

var prePool []*preNode

//go:noinline
func preScratch(n int) int {
	b := make([]byte, n)
	for i := range b {
		b[i] = byte((i * 17) & 0xFF)
	}
	s := 0
	for _, v := range b {
		s += int(v)
	}
	return s
}

//go:noinline
func preScanSum(n int, want int) (int, bool) {
	s := make([]*preNode, 0, n)
	for i := 0; i < n; i++ {
		s = append(s, &preNode{v: i})
	}
	before := 0
	for _, p := range s {
		before += p.v
	}
	first := s[0]
	last := s[n-1]
	runtime.GC()
	runtime.GC()
	after := 0
	for _, p := range s {
		after += p.v
	}
	ident := s[0] == first && s[n-1] == last && before == after && after == want
	runtime.KeepAlive(s)
	return after, ident
}

func scanReachable() (int, bool) {
	return preScanSum(512, 512*511/2)
}

//go:noinline
func preSliceFromPool(pool []*preNode, n int) int {
	s := make([]*preNode, 0, n)
	for _, p := range pool[:n] {
		s = append(s, p)
	}
	sum := 0
	for _, p := range s {
		sum += p.v
	}
	return sum
}

func preemptWaves(ctx context.Context) error {
	const workers = 8
	const iters = 200
	sums := make([]int, workers)
	go group (ctx) {
		for w := 0; w < workers; w++ {
			go {
				total := 0
				for i := 0; i < iters; i++ {
					total += preScratch(1024)
					if i%16 == 0 {
						runtime.Gosched()
					}
				}
				sums[w] = total
			}
		}
		go {
			for i := 0; i < 4; i++ {
				runtime.GC()
				runtime.Gosched()
			}
		}
	}
	for w := 0; w < workers; w++ {
		if sums[w] == 0 {
			return fmt.Errorf("worker %d sum zero", w)
		}
	}
	single := preScratch(1024)
	for w := 0; w < workers; w++ {
		if sums[w] != single*iters {
			return fmt.Errorf("worker %d sum %d, want %d", w, sums[w], single*iters)
		}
	}
	return nil
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

//logos:allow(complexity::cognitive_overflow)
func main() {
	ctx := context.Background()
	sum, ident := scanReachable()
	check("arena-scan-reachable", ident, fmt.Sprint(sum), fmt.Sprint(512*511/2))
	if err := preemptWaves(ctx); err != nil {
		fmt.Println("FAIL arena-preempt-reachable", err)
		os.Exit(1)
	}
	check("arena-preempt-reachable", true, "reached", "reached")
	prePool = make([]*preNode, 0, 512)
	for i := 0; i < 512; i++ {
		prePool = append(prePool, &preNode{v: i})
	}
	allocNoscan := testing.AllocsPerRun(100, func() { preSink = preScratch(1024) })
	check("arena-noscan-zero-alloc", allocNoscan == 0, fmt.Sprint(allocNoscan), "0")
	allocScan := testing.AllocsPerRun(100, func() { preSink = preSliceFromPool(prePool, 512) })
	check("arena-scan-zero-alloc", allocScan == 0, fmt.Sprint(allocScan), "0")
	if failed {
		os.Exit(1)
	}
	_ = preSink
}
