// run

package main

import (
	"errors"
	"fmt"
	"os"
)

var errFirst = errors.New("first")
var errClose = errors.New("close")

type file struct{ closeErr error }

func (f *file) Close() error { return f.closeErr }

func copyNil() (err error) {
	f := &file{}
	defer f.Close()?
	return nil
}

func copyCloseErr() (err error) {
	f := &file{closeErr: errClose}
	defer f.Close()?
	return nil
}

func copyBoth() (err error) {
	f := &file{closeErr: errClose}
	defer f.Close()?
	return errFirst
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	check("defer-close-nil-kept", copyNil() == nil, fmt.Sprint(copyNil()), "<nil>")
	cerr := copyCloseErr()
	check("defer-close-error-returned", errors.Is(cerr, errClose), fmt.Sprint(cerr), "close")
	berr := copyBoth()
	check("defer-close-join-keeps-primary", errors.Is(berr, errFirst), fmt.Sprint(berr), "first")
	check("defer-close-join-keeps-close", errors.Is(berr, errClose), fmt.Sprint(errors.Is(berr, errClose)), "true")
	if failed {
		os.Exit(1)
	}
}
