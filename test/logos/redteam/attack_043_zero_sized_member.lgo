// run

package main

import (
	"fmt"
	"os"
)

type Z interface {
	struct{} | int
}

func show(z Z) string {
	switch v := z.(type) {
	case struct{}:
		return "empty"
	case int:
		return fmt.Sprint("int ", v)
	case nil:
		return "nil"
	default:
		return "other"
	}
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	var z Z = struct{}{}
	if _, ok := z.(struct{}); ok {
		check("zero-sized-empty-member", show(z) == "empty", show(z), "empty")
	} else {
		check("zero-sized-empty-member", false, show(z), "empty")
	}
	z = 9
	if n, ok := z.(int); ok {
		check("zero-sized-int-member", n == 9 && show(z) == "int 9", show(z), "int 9")
	} else {
		check("zero-sized-int-member", false, show(z), "int 9")
	}
	if w, ok := z.(Z); ok {
		check("zero-sized-assert-to-union", show(w) == "int 9", show(w), "int 9")
	} else {
		check("zero-sized-assert-to-union", false, "not-member", "int 9")
	}
	if failed {
		os.Exit(1)
	}
}
