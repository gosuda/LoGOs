// run

package main

import (
	"fmt"
	"os"
)

type S interface {
	int | string | bool
}

func show(s S) string {
	switch v := s.(type) {
	case int:
		return fmt.Sprint("int ", v)
	case string:
		return fmt.Sprint("str ", v)
	case bool:
		return fmt.Sprint("bool ", v)
	case nil:
		return "nil"
	default:
		return "other"
	}
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	var s S = 42
	if n, ok := s.(int); ok {
		check("scalar-union-int-roundtrip", n == 42 && show(s) == "int 42", show(s), "int 42")
	} else {
		check("scalar-union-int-roundtrip", false, show(s), "int 42")
	}
	s = "hi"
	if str, ok := s.(string); ok {
		check("scalar-union-string-roundtrip", str == "hi" && show(s) == "str hi", show(s), "str hi")
	} else {
		check("scalar-union-string-roundtrip", false, show(s), "str hi")
	}
	s = true
	if b, ok := s.(bool); ok {
		check("scalar-union-bool-roundtrip", b && show(s) == "bool true", show(s), "bool true")
	} else {
		check("scalar-union-bool-roundtrip", false, show(s), "bool true")
	}
	if w, ok := s.(S); ok {
		check("scalar-union-assert-to-union", show(w) == "bool true", show(w), "bool true")
	} else {
		check("scalar-union-assert-to-union", false, "not-member", "bool true")
	}
	if failed {
		os.Exit(1)
	}
}
