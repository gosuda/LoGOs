// run

package main

import (
	"errors"
	"fmt"
	"os"
)

var errPrimary = errors.New("primary")
var errRollback = errors.New("rollback")

func rollbackFail() error { return errRollback }

func rollbackOK() error { return nil }

func both() (err error) {
	errdefer rollbackFail()?
	return errPrimary
}

func onlyRollback() (err error) {
	defer func() { _ = recover() }()
	errdefer rollbackFail()?
	panic("rollback-only")
}

func primaryKept() (err error) {
	errdefer rollbackOK()?
	return errPrimary
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	berr := both()
	check("errdefer-join-keeps-primary", errors.Is(berr, errPrimary), fmt.Sprint(errors.Is(berr, errPrimary)), "true")
	check("errdefer-join-keeps-rollback", errors.Is(berr, errRollback), fmt.Sprint(errors.Is(berr, errRollback)), "true")
	rerr := onlyRollback()
	check("errdefer-panic-join-keeps-rollback-only", errors.Is(rerr, errRollback) && !errors.Is(rerr, errPrimary), fmt.Sprint(errors.Is(rerr, errPrimary)), "false")
	kerr := primaryKept()
	check("errdefer-success-keeps-primary", errors.Is(kerr, errPrimary) && !errors.Is(kerr, errRollback), fmt.Sprint(errors.Is(kerr, errRollback)), "false")
	if failed {
		os.Exit(1)
	}
}
