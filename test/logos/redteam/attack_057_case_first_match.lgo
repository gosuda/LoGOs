// run

package main

import (
	"fmt"
	"os"
)

type Sub interface {
	int | string
}

func show(a any) string {
	switch v := a.(type) {
	case int:
		return fmt.Sprint("first ", v)
	case Sub:
		return fmt.Sprint("sub ", v)
	case nil:
		return "nil"
	default:
		return "other"
	}
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	check("const-switch-int-first-match", show(1) == "first 1", show(1), "first 1")
	check("const-switch-sub-fallback", show("s") == "sub s", show("s"), "sub s")
	if failed {
		os.Exit(1)
	}
}
