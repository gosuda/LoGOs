// run

package main

import "fmt"

type Sub interface {
	int | string
}

func show(a any) string {
	switch v := a.(type) {
	case int:
		return fmt.Sprint("first ", v)
	case Sub:
		return fmt.Sprint("sub ", v)
	case nil:
		return "nil"
	default:
		return "other"
	}
}

func main() {
	fmt.Println(show(1))
	fmt.Println(show("s"))
}
