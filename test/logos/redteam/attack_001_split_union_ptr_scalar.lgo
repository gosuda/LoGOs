// run

package main

import (
	"fmt"
	"os"
)

type Node struct{ V int }

type PtrOrInt interface {
	*Node | int
}

func show(u PtrOrInt) string {
	switch v := u.(type) {
	case int:
		return fmt.Sprint("int ", v)
	case *Node:
		return fmt.Sprint("node ", v.V)
	case nil:
		return "nil"
	default:
		return "other"
	}
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	var u PtrOrInt = 3
	if n, ok := u.(int); ok {
		check("split-union-int-roundtrip", n == 3 && show(u) == "int 3", show(u), "int 3")
	} else {
		check("split-union-int-roundtrip", false, show(u), "int 3")
	}
	u = &Node{V: 5}
	if p, ok := u.(*Node); ok {
		check("split-union-pointer-roundtrip", p.V == 5 && show(u) == "node 5", show(u), "node 5")
	} else {
		check("split-union-pointer-roundtrip", false, show(u), "node 5")
	}
	if w, ok := u.(PtrOrInt); ok {
		check("split-union-assert-to-union", show(w) == "node 5", show(w), "node 5")
	} else {
		check("split-union-assert-to-union", false, "not-member", "node 5")
	}
	u = nil
	check("split-union-nil-arm", show(u) == "nil", show(u), "nil")
	if failed {
		os.Exit(1)
	}
}
