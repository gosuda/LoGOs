// run

package main

import (
	"errors"
	"fmt"
	"os"
	"strings"
)

var errAlpha = errors.New("alpha")

var order []string

func note(s string) { order = append(order, s) }

func cleanup(name string, fail bool) error {
	note(name)
	if fail {
		return errAlpha
	}
	return nil
}

func lifoFail() (err error) {
	errdefer note("E-errdefer")
	defer note("C-defer")
	defer cleanup("B-defertry-ok", false)?
	defer note("A-defer")
	return errAlpha
}

func lifoOk() (err error) {
	errdefer note("E2-errdefer")
	defer note("C2-defer")
	defer cleanup("B2-defertry-ok", false)?
	defer note("A2-defer")
	return nil
}

func lifoLate() (err error) {
	errdefer note("E3-errdefer")
	defer cleanup("B3-defertry-fail", true)?
	defer note("A3-defer")
	return nil
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	ferr := lifoFail()
	check("defer-lifo-runs-innermost-first", strings.Join(order, ",") == "A-defer,B-defertry-ok,C-defer,E-errdefer", strings.Join(order, ","), "A-defer,B-defertry-ok,C-defer,E-errdefer")
	check("defer-lifo-failure-returns-error", errors.Is(ferr, errAlpha), fmt.Sprint(ferr), "alpha")
	order = nil
	oerr := lifoOk()
	check("defer-lifo-success-skips-errdefer", strings.Join(order, ",") == "A2-defer,B2-defertry-ok,C2-defer", strings.Join(order, ","), "A2-defer,B2-defertry-ok,C2-defer")
	check("defer-lifo-success-returns-nil", oerr == nil, fmt.Sprint(oerr), "<nil>")
	order = nil
	lerr := lifoLate()
	check("defer-lifo-late-error-joins", strings.Join(order, ",") == "A3-defer,B3-defertry-fail,E3-errdefer" && errors.Is(lerr, errAlpha), strings.Join(order, ","), "A3-defer,B3-defertry-fail,E3-errdefer")
	if failed {
		os.Exit(1)
	}
}
