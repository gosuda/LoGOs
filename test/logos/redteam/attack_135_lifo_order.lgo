// run

package main

import (
	"errors"
	"fmt"
	"os"
	"strings"
)

var errClose = errors.New("close")

var order []string

func note(s string) { order = append(order, s) }

func closer() error {
	note("defertry")
	return nil
}

func mixedOK() (err error) {
	errdefer note("errdefer")
	defer closer()?
	defer note("defer")
	return nil
}

func mixedFail() (err error) {
	errdefer note("errdefer")
	defer closer()?
	defer note("defer")
	return errClose
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

//logos:allow(slop::discarded_error)
func main() {
	_ = mixedOK()
	check("lifo-defer-before-defertry-on-success", strings.Join(order, ",") == "defer,defertry", strings.Join(order, ","), "defer,defertry")
	order = nil
	ferr := mixedFail()
	check("lifo-errdefer-last-on-failure", strings.Join(order, ",") == "defer,defertry,errdefer" && errors.Is(ferr, errClose), strings.Join(order, ","), "defer,defertry,errdefer")
	if failed {
		os.Exit(1)
	}
}
