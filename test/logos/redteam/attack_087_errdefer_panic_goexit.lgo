// run

package main

import (
	"context"
	"fmt"
	"os"
	"runtime"
	"time"
)

var order []string

func note(s string) { order = append(order, s) }

func onPanic() (err error) {
	errdefer note("panic-cleanup")
	panic("boom")
}

func evalBoom() (int, error) { panic("eval-boom") }

func returnEvalPanics() (v int, err error) {
	errdefer note("eval-cleanup")
	return evalBoom()
}

//logos:allow(correctness::unbounded_channel_op)
func goexitWorker(done chan string) (err error) {
	errdefer func() { done <- "goexit-cleanup" }()
	runtime.Goexit()
	return nil
}

func spawnGoexit(done chan string) error {
	go group (context.Background()) {
		go goexitWorker(done)
	}
	return nil
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func has(s string) bool {
	for _, e := range order {
		if e == s {
			return true
		}
	}
	return false
}

//logos:allow(correctness::unbounded_channel_op)
//logos:allow(slop::discarded_error)
func main() {
	func() {
		defer func() { _ = recover() }()
		_ = onPanic()
	}()
	check("errdefer-runs-on-panic", has("panic-cleanup"), fmt.Sprint(order), "[panic-cleanup]")
	func() {
		defer func() { _ = recover() }()
		_, _ = returnEvalPanics()
	}()
	check("errdefer-runs-on-return-eval-panic", has("eval-cleanup"), fmt.Sprint(order), "[panic-cleanup eval-cleanup]")
	done := make(chan string, 1)
	_ = spawnGoexit(done)
	select {
	case msg := <-done:
		order = append(order, msg)
	case <-time.After(2 * time.Second):
		check("errdefer-runs-on-goexit", false, "goexit-timeout", "goexit-cleanup")
		os.Exit(1)
	}
	check("errdefer-runs-on-goexit", has("goexit-cleanup"), fmt.Sprint(order), "[panic-cleanup eval-cleanup goexit-cleanup]")
	if failed {
		os.Exit(1)
	}
}
