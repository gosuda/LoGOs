// run

package main

import (
	"errors"
	"fmt"
	"os"
)

var errRec = errors.New("rec")

var order []string

func note(s string) { order = append(order, s) }

func ok() (err error) {
	errdefer func() {
		_ = recover()
		note("should-not-run")
	}()
	return nil
}

func fail() (err error) {
	errdefer func() {
		_ = recover()
		note("failed-cleanup")
	}()
	return errRec
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

//logos:allow(slop::discarded_error)
func main() {
	before := len(order)
	_ = ok()
	check("errdefer-recover-skipped-on-success", len(order) == before, fmt.Sprint(len(order)-before), "0")
	_ = fail()
	check("errdefer-recover-runs-on-failure", len(order) == before+1 && order[before] == "failed-cleanup", fmt.Sprint(order[before:]), "[failed-cleanup]")
	if failed {
		os.Exit(1)
	}
}
