// run

package main

import (
	"fmt"
	"os"
)

type opErr struct{ msg string }

func (e *opErr) Error() string { return e.msg }

var order []string

func note(s string) { order = append(order, s) }

func commit() (err error) {
	errdefer note("cleanup")
	p := (*opErr)(nil)
	return p
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	err := commit()
	check("typed-nil-counts-non-nil", err != nil, fmt.Sprint(err == nil), "false")
	check("typed-nil-runs-errdefer", len(order) == 1 && order[0] == "cleanup", fmt.Sprint(order), "[cleanup]")
	if failed {
		os.Exit(1)
	}
}
