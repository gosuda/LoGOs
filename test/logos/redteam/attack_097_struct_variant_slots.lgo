// run

package main

import (
	"fmt"
	"os"
)

type A struct {
	X int
	Y int
}

type B struct {
	Name string
	N    int
}

type V interface {
	A | B
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func checkA(name string, v V, x, y int) {
	a, ok := v.(A)
	check(name, ok && a.X == x && a.Y == y, fmt.Sprint(v), fmt.Sprint(A{X: x, Y: y}))
}

func checkB(name string, v V, s string, n int) {
	b, ok := v.(B)
	check(name, ok && b.Name == s && b.N == n, fmt.Sprint(v), fmt.Sprint(B{Name: s, N: n}))
}

func main() {
	var v V = A{X: 1, Y: 2}
	checkA("struct-variant-first-slot-intact", v, 1, 2)
	v = B{Name: "x", N: 9}
	checkB("struct-variant-second-slot-intact", v, "x", 9)
	v = A{X: 3, Y: 4}
	checkA("struct-variant-reuse-clears-stale-bytes", v, 3, 4)
	if w, ok := v.(V); ok {
		a, ok := w.(A)
		check("struct-variant-assert-to-union", ok && a.X == 3 && a.Y == 4, fmt.Sprint(w), fmt.Sprint(A{X: 3, Y: 4}))
	} else {
		check("struct-variant-assert-to-union", false, "not-member", fmt.Sprint(A{X: 3, Y: 4}))
	}
	if failed {
		os.Exit(1)
	}
}
