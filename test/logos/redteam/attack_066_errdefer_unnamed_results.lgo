// run

package main

import (
	"errors"
	"fmt"
	"os"
	"strings"
)

var errWork = errors.New("work")

var order []string

func note(s string) { order = append(order, s) }

func load(fail bool) (int, error) {
	errdefer note("load-cleanup")
	if fail {
		return 0, errWork
	}
	return 7, nil
}

func save(fail bool) (string, int, error) {
	errdefer note("save-cleanup")
	v := load(fail)?
	return "ok", v, nil
}

func cleanup(fail bool) error {
	if fail {
		return errWork
	}
	return nil
}

func flush(fail bool) error {
	defer cleanup(fail)?
	return nil
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	s, n, err := save(false)
	check("errdefer-unnamed-success-values", s == "ok" && n == 7 && err == nil, fmt.Sprintf("%q %d %v", s, n, err), `"ok" 7 <nil>`)
	s2, n2, err2 := save(true)
	check("errdefer-unnamed-failure-values", s2 == "" && n2 == 0 && errors.Is(err2, errWork), fmt.Sprintf("%q %d %v", s2, n2, err2), `"\"\" 0 work"`)
	check("errdefer-unnamed-flush-ok", flush(false) == nil, fmt.Sprint(flush(false)), "<nil>")
	check("errdefer-unnamed-flush-fail", errors.Is(flush(true), errWork), fmt.Sprint(flush(true)), "work")
	check("errdefer-unnamed-cleanup-once-per-failure", strings.Join(order, ",") == "load-cleanup,save-cleanup", strings.Join(order, ","), "load-cleanup,save-cleanup")
	if failed {
		os.Exit(1)
	}
}
