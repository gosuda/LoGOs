// run

package main

import (
	"fmt"
	"os"
)

type U interface {
	int | string
}

var failed bool

func check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	var a U = 1
	var b U = 1
	var c U = "x"
	check("union-equality-equal-true", a == b, fmt.Sprint(a == b), "true")
	check("union-equality-mismatch-false", a != c, fmt.Sprint(a == c), "false")
	if w, ok := a.(U); ok {
		check("union-equality-assert-to-union", w == b, fmt.Sprint(w == b), "true")
	} else {
		check("union-equality-assert-to-union", false, "not-member", "true")
	}
	if failed {
		os.Exit(1)
	}
}
