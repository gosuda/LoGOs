// asmcheck -O=2

package main

import "fmt"

func c33const() int {
	// amd64:-"CALL.*runtime.makeslice" arm64:-"CALL.*runtime.makeslice"
	s := make([]byte, 0, 100)
	return len(s)
}

//go:noinline
func c33var(n int) int {
	// amd64:1"CALL.*runtime\\.logosArenaMakeSlice" amd64:-"CALL.*runtime\\.makeslice" arm64:"CALL.*runtime.makeslice"
	s := make([]byte, n)
	for i := range s {
		s[i] = byte(i)
	}
	return len(s)
}

type c33node struct {
	kids []*c33node
	data []byte
}

func c33sum(b []byte) int {
	buf := make([]byte, 0, len(b))
	for _, c := range b {
		buf = append(buf, c)
	}
	return len(buf)
}

// amd64:"TEXT .*, [$][0-9]{1,3}-"
// arm64:"TEXT .*, [$][0-9]{1,3}-"
func c33rec(n *c33node) int {
	_ = recover()
	if n == nil {
		return 0
	}
	s := c33sum(n.data) + c33sum(n.data)
	for _, k := range n.kids {
		s += c33rec(k)
	}
	return s
}

// amd64:"TEXT .*, [$][0-9]{4,}-"
// arm64:"TEXT .*, [$][0-9]{4,}-"
func c33flat(n *c33node) int {
	_ = recover()
	if n == nil {
		return 0
	}
	return c33sum(n.data) + c33sum(n.data) + c33sum(n.data) + c33sum(n.data)
}

func main() {
	n := &c33node{data: []byte("abc"), kids: []*c33node{{data: []byte("de")}}}
	fmt.Println(c33const(), c33var(10), c33rec(n), c33flat(n))
}
