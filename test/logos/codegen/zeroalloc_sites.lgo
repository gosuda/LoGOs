// errorcheck

package p

type box struct{ v int }

func (b *box) get() int { return b.v }

//logos:zeroalloc
func newInt() *int {
	return new(int) // ERROR "\[perf::zeroalloc_violation\]"
}

//logos:zeroalloc
func makeMap() map[string]int {
	return make(map[string]int) // ERROR "\[perf::zeroalloc_violation\]"
}

//logos:zeroalloc
func mapLit() map[string]int {
	return map[string]int{"a": 1} // ERROR "\[perf::zeroalloc_violation\]"
}

//logos:zeroalloc
func concat(a, b string) string {
	return a + b // ERROR "\[perf::zeroalloc_violation\]"
}

//logos:zeroalloc
func toBytes(s string) []byte {
	return []byte(s) // ERROR "\[perf::zeroalloc_violation\]"
}

//logos:zeroalloc
func fromBytes(b []byte) string {
	return string(b) // ERROR "\[perf::zeroalloc_violation\]"
}

//logos:zeroalloc
func toRunes(s string) []rune {
	return []rune(s) // ERROR "\[perf::zeroalloc_violation\]"
}

//logos:zeroalloc
func fromRunes(rs []rune) string {
	return string(rs) // ERROR "\[perf::zeroalloc_violation\]"
}

//logos:zeroalloc
func fromRune(r rune) string {
	return string(r) // ERROR "\[perf::zeroalloc_violation\]"
}

//logos:zeroalloc
func (b *box) getter() func() int {
	return b.get // ERROR "\[perf::zeroalloc_violation\]"
}

//logos:zeroalloc
func emptySlice() []int {
	return []int{}
}

//logos:zeroalloc
func zeroBox() any {
	return struct{}{}
}

var sinkZeroPtr = new(struct{})

//logos:zeroalloc
func zeroEscape() {
	var z struct{}
	sinkZeroPtr = &z
}

//logos:zeroalloc
func growNil() []int {
	var dst []int
	return append(dst, 1)
}

//logos:zeroalloc
func makeZero() []int {
	return make([]int, 0)
}

//logos:zeroalloc
func makeZeroCap() []int {
	return make([]int, 0, 0)
}

//logos:zeroalloc
func makeZeroLenCap() []int {
	return make([]int, 0, 8) // ERROR "\[perf::zeroalloc_violation\]"
}

//logos:zeroalloc
func mapInsert(m map[string]int, k string, v int) {
	m[k] = v
}

//logos:zeroalloc
func localGrow(k string, v int) int {
	m := make(map[string]int)
	m[k] = v
	m["b"] = 2
	return len(m)
}

//logos:zeroalloc
func concatLen(a, b string) int {
	s := a + b
	return len(s)
}
