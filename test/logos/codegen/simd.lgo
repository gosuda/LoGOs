// asmcheck -goexperiment simd

package main

// arm64 is baseline NEON and never calls an X86 check.

//go:noinline
func addF32x8(a, b [8]float32) [8]float32 {
	// amd64/v1:"VADDPS" "CALL simd/archsimd\\.X86Features\\.AVX\\(SB\\)"
	// amd64/v2:"VADDPS" "CALL simd/archsimd\\.X86Features\\.AVX\\(SB\\)"
	// amd64/v3:"VADDPS" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// amd64/v4:"VADDPS" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"VFADD V[0-9]+\\.S4" -"CALL simd/archsimd\\.X86Features"
	return a + b
}

//go:noinline
func addI32x8(a, b [8]int32) [8]int32 {
	// amd64/v1:"VPADDD" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)"
	// amd64/v2:"VPADDD" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)"
	// amd64/v3:"VPADDD" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// amd64/v4:"VPADDD" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"VADD V[0-9]+\\.S4" -"CALL simd/archsimd\\.X86Features"
	return a + b
}

//go:noinline
func addF32x16(a, b [16]float32) [16]float32 {
	// amd64/v1:"VADDPS" "CALL simd/archsimd\\.X86Features\\.AVX512\\(SB\\)"
	// amd64/v3:"VADDPS" "CALL simd/archsimd\\.X86Features\\.AVX512\\(SB\\)"
	// amd64/v4:"VADDPS" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"VFADD V[0-9]+\\.S4" -"CALL simd/archsimd\\.X86Features"
	return a + b
}

//go:noinline
func mulU64x2(a, b [2]uint64) [2]uint64 {
	// amd64/v1:"VPMULLQ" "CALL simd/archsimd\\.X86Features\\.AVX512\\(SB\\)"
	// amd64/v3:"VPMULLQ" "CALL simd/archsimd\\.X86Features\\.AVX512\\(SB\\)"
	// amd64/v4:"VPMULLQ" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	return a * b
}

//go:noinline
func mulF64x2(a, b [2]float64) [2]float64 {
	// amd64/v1:"VMULPD" "CALL simd/archsimd\\.X86Features\\.AVX\\(SB\\)"
	// amd64/v3:"VMULPD" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	return a * b
}

//go:noinline
func andF64x2(a, b [2]float64) [2]float64 {
	// amd64/v1:"VPAND" "CALL simd/archsimd\\.X86Features\\.AVX\\(SB\\)"
	// amd64/v3:"VPAND" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"VAND V[0-9]+\\.B16" -"CALL simd/archsimd\\.X86Features"
	return a & b
}

//go:noinline
func andF32x4(a, b [4]float32) [4]float32 {
	// amd64/v1:"VPAND" "CALL simd/archsimd\\.X86Features\\.AVX\\(SB\\)"
	// amd64/v3:"VPAND" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"VAND V[0-9]+\\.B16" -"CALL simd/archsimd\\.X86Features"
	return a & b
}

//go:noinline
func andF32x8(a, b [8]float32) [8]float32 {
	// amd64/v1:"VPAND" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)"
	// amd64/v3:"VPAND" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"VAND V[0-9]+\\.B16" -"CALL simd/archsimd\\.X86Features"
	return a & b
}

//go:noinline
func orF64x4(a, b [4]float64) [4]float64 {
	// amd64/v1:"VPOR" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)"
	// amd64/v3:"VPOR" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"VORR V[0-9]+\\.B16" -"CALL simd/archsimd\\.X86Features"
	return a | b
}

//go:noinline
func andU32x8(a, b [8]uint32) [8]uint32 {
	// amd64/v1:"VPAND" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)"
	// amd64/v3:"VPAND" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"VAND V[0-9]+\\.B16" -"CALL simd/archsimd\\.X86Features"
	return a & b
}

//go:noinline
func orU32x8(a, b [8]uint32) [8]uint32 {
	// amd64/v1:"VPOR" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)"
	// amd64/v3:"VPOR" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"VORR V[0-9]+\\.B16" -"CALL simd/archsimd\\.X86Features"
	return a | b
}

//go:noinline
func xorU32x8(a, b [8]uint32) [8]uint32 {
	// amd64/v1:"VPXOR" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)"
	// amd64/v3:"VPXOR" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"VEOR V[0-9]+\\.B16" -"CALL simd/archsimd\\.X86Features"
	return a ^ b
}

//go:noinline
func xorF32x8(a, b [8]float32) [8]float32 {
	// amd64/v1:"VPXOR" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)"
	// amd64/v3:"VPXOR" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"VEOR V[0-9]+\\.B16" -"CALL simd/archsimd\\.X86Features"
	return a ^ b
}

func main() {
	a := [8]float32{1, 2, 3, 4, 5, 6, 7, 8}
	b := [8]float32{8, 7, 6, 5, 4, 3, 2, 1}
	c := addF32x8(a, b)
	var d, e [8]int32
	var f, g [16]float32
	var h, i [2]uint64
	var j, k [2]float64
	var p, q [4]float32
	var r, s [2]float64
	var t, u [4]float64
	var v, w [8]uint32
	println(c[0], c[7], addI32x8(d, e)[0], addF32x16(f, g)[0], mulU64x2(h, i)[0], mulF64x2(j, k)[0])
	println(andF64x2(r, s)[0], andF32x4(p, q)[0], andF32x8(a, b)[0], orF64x4(t, u)[0], xorF32x8(a, b)[0])
	println(andU32x8(v, w)[0], orU32x8(v, w)[0], xorU32x8(v, w)[0])
}
