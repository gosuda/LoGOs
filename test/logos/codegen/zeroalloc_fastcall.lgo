// asmcheck

package main

import "unsafe"

//go:linkname fastcall runtime.logosCgocallFast
func fastcall(fn, arg unsafe.Pointer) int32

var sink int32

//logos:zeroalloc
//go:noinline
func callFast(fn, arg unsafe.Pointer) int32 {
	// amd64:"CALL runtime\\.logosCgocallFast" -"CALL runtime\\.cgocall" -"CALL runtime\\.(newobject|mallocgc\\w*|makeslice|growslice|convT\\w*)"
	return fastcall(fn, arg)
}

func main() {
	sink = callFast(nil, nil)
}
