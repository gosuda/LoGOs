// asmcheck

package deadcheck

//go:noinline
func deadBranch() int { return 0 }

//go:noinline
func liveBranch() int { return 1 }

func pickThen() int {
	const if 1 == 1 {
		return liveBranch() // amd64:"CALL.*liveBranch" arm64:"CALL.*liveBranch"
	} else {
		return deadBranch() // amd64:-"CALL" arm64:-"CALL"
	}
}

func pickElse() int {
	const if 1 == 2 {
		return deadBranch() // amd64:-"CALL" arm64:-"CALL"
	} else {
		return liveBranch() // amd64:"CALL.*liveBranch" arm64:"CALL.*liveBranch"
	}
}

func pickChain() int {
	const if 1 == 2 {
		return deadBranch() // amd64:-"CALL" arm64:-"CALL"
	} else const if 1 == 1 {
		return liveBranch() // amd64:"CALL.*liveBranch" arm64:"CALL.*liveBranch"
	} else {
		return deadBranch() // amd64:-"CALL" arm64:-"CALL"
	}
}
