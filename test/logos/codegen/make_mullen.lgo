// asmcheck

package codegen

const mullenK = 3

func mullenConst() int {
	// amd64:-"IMULQ"
	// arm64:-"MUL"
	s := make([]int, mullenK*mullenK)
	return len(s)
}

func mullenVar(n, m int) int {
	// amd64:"IMULQ"
	// arm64:"MUL"
	s := make([]int, n*m)
	return len(s)
}

func mullenCapVar(n, m int) int {
	// amd64:"IMULQ"
	// arm64:"MUL"
	s := make([]int, n, n*m)
	return cap(s)
}
