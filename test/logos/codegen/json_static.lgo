// asmcheck

package jsoncheck

type Scalars struct { // amd64:"CALL.*runtime.makeslice" -"CALL.*reflect" -"CALL.*runtime.newobject" -"CALL.*runtime.convT" -"CALL.*runtime.concatstring" -"CALL.*runtime.slicebytetostring" arm64:"CALL.*runtime.makeslice" -"CALL.*reflect" -"CALL.*runtime.newobject" -"CALL.*runtime.convT" -"CALL.*runtime.concatstring" -"CALL.*runtime.slicebytetostring"
	A int64  `json:"a"`
	B string `json:"b"`
	C bool   `json:"c"`
}

func marshal(s Scalars) ([]byte, error) {
	return s.MarshalJSON()
}

func (s *Scalars) UnmarshalJSON(data []byte) error { return nil }

func (s Scalars) MarshalBinary() ([]byte, error) { return nil, nil }

func (s Scalars) AppendBinary(b []byte) ([]byte, error) { return b, nil }

func (s *Scalars) UnmarshalBinary(data []byte) error { return nil }

type SyncProbe struct { // amd64:-"CALL.*sync[/.]" -"CALL.*atomic\\." -"CALL.*Mutex" -"CALL.*Lock" arm64:-"CALL.*sync[/.]" -"CALL.*atomic\\." -"CALL.*Mutex" -"CALL.*Lock"
	A string `json:"a"`
	N int64  `json:"n"`
}
