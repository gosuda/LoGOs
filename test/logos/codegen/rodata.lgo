// run

package main

import (
	"bytes"
	"fmt"
	"os"
	"os/exec"
	"reflect"
	"strconv"
	"strings"
	"unsafe"
)

const roSlice = []int{2, 3, 5, 7, 11}
const roArray = [4]string{"a", "b", "c", "d"}

const (
	roGrouped = []int{9, 8, 7}
	roGlen    = len(roGrouped)
)

var roMutable = []int{1, 2, 3}

func forged(addr string) unsafe.Pointer {
	u, err := strconv.ParseUint(strings.TrimPrefix(addr, "0x"), 16, 64)
	if err != nil {
		panic(err)
	}
	return unsafe.Pointer(uintptr(u))
}

func storeThrough(target string) {
	switch target {
	case "slice":
		*(*int)(forged(fmt.Sprintf("%p", roSlice))) = 1
	case "array":
		var boxed any = roArray
		p := (*[2]unsafe.Pointer)(unsafe.Pointer(&boxed))[1]
		*(*string)(p) = "z"
	case "grouped":
		*(*int)(forged(fmt.Sprintf("%p", roGrouped))) = 1
	case "mutable":
		roMutable[0] = 9
	}
	fmt.Println("STORE-SUCCEEDED")
}

func childOutcome(self, target string) (int, string) {
	cmd := exec.Command(self, target)
	var buf bytes.Buffer
	cmd.Stdout = &buf
	cmd.Stderr = &buf
	err := cmd.Run()
	if ee, ok := err.(*exec.ExitError); ok {
		return ee.ExitCode(), buf.String()
	}
	if err != nil {
		return -1, err.Error()
	}
	return 0, buf.String()
}

func storeFaults(self, target string) bool {
	code, out := childOutcome(self, target)
	return code == 2 && strings.Contains(out, "fault") && !strings.Contains(out, "STORE-SUCCEEDED")
}

func main() {
	if len(os.Args) > 1 {
		storeThrough(os.Args[1])
		return
	}
	if !reflect.DeepEqual(roSlice, []int{2, 3, 5, 7, 11}) {
		fmt.Println("FAIL const-slice-holds-literal-values: DeepEqual mismatch")
		os.Exit(1)
	}
	fmt.Println("ok const-slice-holds-literal-values")
	if !reflect.DeepEqual(roArray, [4]string{"a", "b", "c", "d"}) {
		fmt.Println("FAIL const-array-holds-literal-values: DeepEqual mismatch")
		os.Exit(1)
	}
	fmt.Println("ok const-array-holds-literal-values")
	if roArray[0] != "a" || roArray[3] != "d" || len(roSlice) != 5 || roGlen != 3 {
		fmt.Println("FAIL const-indexing-and-len-rules: got mismatch")
		os.Exit(1)
	}
	fmt.Println("ok const-indexing-and-len-rules")
	self, err := os.Executable()
	if err != nil {
		fmt.Printf("FAIL self: %v\n", err)
		os.Exit(1)
	}
	var writable []string
	for _, target := range []string{"slice", "array", "grouped"} {
		if !storeFaults(self, target) {
			writable = append(writable, target)
		}
	}
	if len(writable) != 0 {
		fmt.Printf("FAIL const-composites-live-in-rodata: stores through %v did not fault\n", writable)
		os.Exit(1)
	}
	fmt.Println("ok const-composites-live-in-rodata")
	if code, out := childOutcome(self, "mutable"); code != 0 || !strings.Contains(out, "STORE-SUCCEEDED") {
		fmt.Printf("FAIL mutable-slice-stays-writable: exit %d, first output line %q\n", code, strings.SplitN(out, "\n", 2)[0])
		os.Exit(1)
	}
	fmt.Println("ok mutable-slice-stays-writable")
}
