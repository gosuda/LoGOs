// asmcheck -goexperiment logosarena

package main

// asmcheck match is per source line, so the closing safe marker lands on the

var (
	bumpSink   int
	bumpGlobal []byte
)

//go:noinline
func bumpUse(b []byte) int {
	if len(b) == 0 {
		return 0
	}
	b[0] = 1
	return len(b) + int(b[0])
}

//go:noinline
func bumpUsePtr(b []*int) int {
	return len(b) + cap(b)
}

//go:noinline
func bumpInline511() int {
	// amd64:"LEAQ 7\\("
	// amd64:"ANDQ \\$-8,"
	// amd64:"LEAQ 512\\("
	// amd64:-"LEAQ 511\\("
	// amd64:"CMPQ .*24\\("
	// amd64:"JHI"
	// amd64:"MOVQ 16\\("
	// amd64:"MOVQ .*, 16\\("
	// amd64:"PCDATA \\$0, \\$-2"
	// amd64:"PCDATA \\$0, \\$-1"
	// amd64:1"CALL.*runtime\\.logosArenaAlloc"
	// amd64:-"CALL.*runtime\\.logosArenaBump"
	// amd64:-"CALL.*runtime\\.logosArenaMakeSlice"
	// amd64:-"CALL.*runtime\\.makeslice"
	used := bumpUse(make([]byte, 511))
	return used
}

//go:noinline
func bumpInline512() int {
	// amd64:"LEAQ 7\\("
	// amd64:"ANDQ \\$-8,"
	// amd64:"LEAQ 512\\("
	// amd64:"CMPQ .*24\\("
	// amd64:"JHI"
	// amd64:"MOVQ 16\\("
	// amd64:"MOVQ .*, 16\\("
	// amd64:"PCDATA \\$0, \\$-2"
	// amd64:"PCDATA \\$0, \\$-1"
	// amd64:1"CALL.*runtime\\.logosArenaAlloc"
	// amd64:-"CALL.*runtime\\.logosArenaBump"
	// amd64:-"CALL.*runtime\\.logosArenaMakeSlice"
	// amd64:-"CALL.*runtime\\.makeslice"
	used := bumpUse(make([]byte, 512))
	return used
}

//go:noinline
func bumpSlow513() int {
	// amd64:1"CALL.*runtime\\.logosArenaAlloc"
	// amd64:-"CALL.*runtime\\.logosArenaBump"
	// amd64:-"CALL.*runtime\\.logosArenaMakeSlice"
	// amd64:-"CALL.*runtime\\.makeslice"
	// amd64:-"ANDQ \\$-8,"
	// amd64:-"PCDATA \\$0, \\$-2"
	used := bumpUse(make([]byte, 513))
	return used
}

//go:noinline
func bumpEscapes511() int {
	// amd64:1"CALL.*runtime\\.makeslice"
	// amd64:-"CALL.*runtime\\.logosArena"
	// amd64:-"ANDQ \\$-8,"
	b := make([]byte, 511)
	bumpGlobal = b
	return len(b)
}

//go:noinline
func bumpPointerDynamic(n int) int {
	// amd64:1"CALL.*runtime\\.logosArenaMakeSlice"
	// amd64:-"CALL.*runtime\\.makeslice"
	// amd64:-"CALL.*runtime\\.logosArenaBump"
	// amd64:-"ANDQ \\$-8,"
	// amd64:-"PCDATA \\$0, \\$-2"
	used := bumpUsePtr(make([]*int, 0, n))
	return used
}

func main() {
	bumpSink += bumpInline511()
	bumpSink += bumpInline512()
	bumpSink += bumpSlow513()
	bumpSink += bumpEscapes511()
	bumpSink += bumpPointerDynamic(8)
}
