// asmcheck -O=3

package main

import (
	"fmt"
	"slices"
)

type node struct {
	id   int
	name string
	kids []*node
	data []byte
}

func sumA(b []byte) int {
	buf := make([]byte, 0, len(b))
	for _, c := range b {
		buf = append(buf, c)
	}
	if slices.Contains(buf, 0) {
		return -1
	}
	return len(buf)
}

func sumB(b []byte) int {
	buf := make([]byte, 0, len(b)+1)
	for _, c := range b {
		buf = append(buf, c+1)
	}
	if slices.Contains(buf, 1) {
		return -1
	}
	return len(buf)
}

// amd64:"TEXT .*, [$][0-9]{1,3}-"
// arm64:"TEXT .*, [$][0-9]{1,3}-"
func label(n *node) int {
	t := $"id={n.id} name={n.name}"
	s := len(t)
	for _, k := range n.kids {
		s += label(k)
	}
	return s
}

// amd64:"TEXT .*, [$][0-9]{1,3}-"
// arm64:"TEXT .*, [$][0-9]{1,3}-"
func total(n *node) int {
	if n == nil {
		return 0
	}
	s := sumA(n.data) + sumB(n.data)
	for _, k := range n.kids {
		s += total(k)
	}
	return s
}

// amd64:"TEXT .*, [$][0-9]{5,}-"
// arm64:"TEXT .*, [$][0-9]{5,}-"
func flat(n *node) int {
	if n == nil {
		return 0
	}
	return sumA(n.data) + sumB(n.data)
}

// amd64:"TEXT .*, [$][0-9]{1,3}-"
// arm64:"TEXT .*, [$][0-9]{4,}-"
func flatLabel(n *node) int {
	t := $"id={n.id} name={n.name}"
	return len(t)
}

func main() {
	n := &node{id: 1, name: "a", data: []byte("abc"), kids: []*node{{id: 2, name: "b", data: []byte("de")}}}
	fmt.Println(label(n), total(n), flat(n), flatLabel(n))
}
