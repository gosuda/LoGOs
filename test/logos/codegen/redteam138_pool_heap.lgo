// asmcheck -goexperiment logosarena

package main

import "sync"

var r138cPool sync.Pool

//go:noinline
func r138cPut(n int) int {
	// amd64:1"CALL.*runtime\\.makeslice"
	// amd64:-"CALL.*runtime\\.logosArenaMakeSlice"
	// arm64:-"CALL.*runtime\\.logosArenaMakeSlice"
	buf := make([]byte, n)
	r138cPool.Put(buf)
	return len(buf)
}

func main() {
	println(r138cPut(1 << 16))
}
