// asmcheck -O=3

package main

import "fmt"

func bound4095(b bool) int {
	// amd64:-"CALL.*runtime.makeslice" arm64:-"CALL.*runtime.makeslice"
	t := $"{b}"
	return len(t)
}

func bound4096(b bool) int {
	// amd64:-"CALL.*runtime.makeslice" arm64:-"CALL.*runtime.makeslice"
	t := $"{b}"
	return len(t)
}

func bound4097(b bool, pad string) int {
	// amd64:"CALL.*runtime.makeslice" arm64:"CALL.*runtime.makeslice"
	t := $"{b}{pad}"
	return len(t)
}

func main() {
	fmt.Println(bound4095(true), bound4096(false), bound4097(true, ""))
}
