//go:noinline
func sumInt(xs []int) int {
	// amd64:-"VPMASKMOV" -"VPADD" -"CALL simd/archsimd"
	// arm64:-"VADD V" -"CALL simd/archsimd"
	return xs.sum()
}

//go:noinline
func sumUint(xs []uint) uint {
	// amd64:-"VPMASKMOV" -"VPADD" -"CALL simd/archsimd"
	// arm64:-"VADD V" -"CALL simd/archsimd"
	return xs.sum()
}

