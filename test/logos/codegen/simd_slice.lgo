//go:noinline
func sumInt(xs []int) int {
	// amd64:-"VPMASKMOV" -"VPADD" -"CALL simd/archsimd"
	// arm64:-"VADD V" -"CALL simd/archsimd"
	return xs.sum()
}

//go:noinline
func sumUint(xs []uint) uint {
	// amd64:-"VPMASKMOV" -"VPADD" -"CALL simd/archsimd"
	// arm64:-"VADD V" -"CALL simd/archsimd"
	return xs.sum()
}

//go:noinline
func sumUintptr(xs []uintptr) uintptr {
	// amd64:-"VPMASKMOV" -"VPADD" -"CALL simd/archsimd"
	// arm64:-"VADD V" -"CALL simd/archsimd"
	return xs.sum()
}

type watt = float64

//go:noinline
func sumAlias(xs []watt) float64 {
// amd64/v1:"VPMASKMOVQ\\s+\\(" "VMOVDQU\\s+\\(" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)" -"CALL simd/archsimd\\.Load"
// amd64/v3:"VPMASKMOVQ\\s+\\(" "VMOVDQU\\s+\\(" -"CALL simd/archsimd\\." -"CMPB internal/cpu\\.X86"
	// arm64:"CALL simd/archsimd\\.LoadFloat64x2Part\\(SB\\)" -"CALL simd/archsimd\\.X86Features"
	return xs.sum()
}

//go:noinline
func sumFiltered(xs []int32) int32 {
	// amd64:-"VPMASKMOV" -"VMOVDQU" -"CALL simd/archsimd" -"CALL runtime\\.makeslice"
	// arm64:-"VPMASKMOV" -"CALL simd/archsimd" -"CALL runtime\\.makeslice"
	return xs.filter(x => x > 0).sum()
}

func main() {
	var a []int32
	var b []uint64
	var c []uint16
	var d []uint8
	var e []float32
	var f []float64
	var g []int
	var u []uint
	var p []uintptr
	var w []watt
	var h []int8
	var i []int16
	var j []int64
	var k []uint32
	println(sumI32(a), sumU64(b), sumU16(c), sumU8(d), sumF32(e), sumF64(f), sumInt(g), sumUint(u), sumUintptr(p), sumAlias(w))
	println(sumI8(h), sumI16(i), sumI64(j), sumU32(k))
}
