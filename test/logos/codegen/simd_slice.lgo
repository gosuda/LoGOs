func sumF64(xs []float64) float64 {
// amd64/v1:"VPMASKMOVQ\\s+\\(" "VMOVDQU\\s+\\(" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)"
// amd64/v3:"VPMASKMOVQ\\s+\\(" "VMOVDQU\\s+\\(" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
	// arm64:"CALL simd/archsimd\\.LoadFloat64x2Part\\(SB\\)" -"CALL simd/archsimd\\.X86Features"
	return xs.sum()
