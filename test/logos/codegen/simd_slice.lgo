//go:noinline
func sumF32(xs []float32) float32 {
// amd64/v1:"VPMASKMOVD\\s+\\(" "VMOVDQU\\s+\\(" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)" -"CALL simd/archsimd\\.Load"
// amd64/v3:"VPMASKMOVD\\s+\\(" "VMOVDQU\\s+\\(" -"CALL simd/archsimd\\.X86Features" -"CMPB internal/cpu\\.X86"
