// asmcheck -goexperiment simd

package main

//go:noinline
func sumI32(xs []int32) int32 {
	// amd64/v1:"VPMASKMOVD\\s+\\(" "VPADDD\\s+\\("
	// amd64/v2:"VPMASKMOVD\\s+\\(" "VPADDD"
	// amd64/v3:"VPMASKMOVD\\s+\\(" "VPADDD"
	// amd64/v4:"VPMASKMOVD\\s+\\(" "VPADDD"
	// arm64:"VADD V[0-9]+\\.S4" -"VPMASKMOV"
	return xs.sum()
}

//go:noinline
func sumU64(xs []uint64) uint64 {
// amd64/v1:"VPMASKMOVQ\\s+\\(" "VPADDQ\\s+\\("
// amd64/v3:"VPMASKMOVQ\\s+\\(" "VPADDQ\\s+\\("
	// arm64:"VADD V[0-9]+\\.D2"
	return xs.sum()
}

//go:noinline
func sumU16(xs []uint16) uint16 {
	// amd64/v1:"VMOVDQU16\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDW"
	// amd64/v3:"VMOVDQU16\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDW"
	// amd64/v4:"VMOVDQU16\\.Z\\s+\\(" "VPADDW"
	// arm64:"VADD V[0-9]+\\.H8"
	return xs.sum()
}

//go:noinline
func sumU8(xs []uint8) uint8 {
	// amd64/v1:"VMOVDQU8\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDB"
	// amd64/v3:"VMOVDQU8\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDB"
	// amd64/v4:"VMOVDQU8\\.Z\\s+\\(" "VPADDB"
	// arm64:"VADD V[0-9]+\\.B16"
	return xs.sum()
}
//go:noinline
func sumI8(xs []int8) int8 {
	// amd64/v1:"VMOVDQU8\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDB"
	// amd64/v3:"VMOVDQU8\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDB"
	// amd64/v4:"VMOVDQU8\\.Z\\s+\\(" "VPADDB"
	// arm64:"VADD V[0-9]+\\.B16"
	return xs.sum()
}

//go:noinline
func sumI16(xs []int16) int16 {
	// amd64/v1:"VMOVDQU16\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDW"
	// amd64/v3:"VMOVDQU16\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDW"
	// amd64/v4:"VMOVDQU16\\.Z\\s+\\(" "VPADDW"
	// arm64:"VADD V[0-9]+\\.H8"
	return xs.sum()
}

//go:noinline
func sumI64(xs []int64) int64 {
	// amd64/v1:"VPMASKMOVQ\\s+\\(" "VPADDQ"
	// amd64/v3:"VPMASKMOVQ\\s+\\(" "VPADDQ"
	// arm64:"VADD V[0-9]+\\.D2"
	return xs.sum()
}

//go:noinline
func sumU32(xs []uint32) uint32 {
	// amd64/v1:"VPMASKMOVD\\s+\\(" "VPADDD\\s+\\("
	// amd64/v2:"VPMASKMOVD\\s+\\(" "VPADDD"
	// amd64/v3:"VPMASKMOVD\\s+\\(" "VPADDD"
	// amd64/v4:"VPMASKMOVD\\s+\\(" "VPADDD"
	// arm64:"VADD V[0-9]+\\.S4"
	return xs.sum()
}

//go:noinline
func sumF32(xs []float32) float32 {
// amd64/v1:"VPMASKMOVD\\s+\\(" "VMOVDQU\\s+\\("
// amd64/v3:"VPMASKMOVD\\s+\\(" "VMOVDQU\\s+\\("
	return xs.sum()
}

//go:noinline
func sumF64(xs []float64) float64 {
// amd64/v1:"VPMASKMOVQ\\s+\\(" "VMOVDQU\\s+\\("
// amd64/v3:"VPMASKMOVQ\\s+\\(" "VMOVDQU\\s+\\("
	return xs.sum()
}

//go:noinline
func sumInt(xs []int) int {
	// amd64:-"VPMASKMOV" -"VPADD"
	// arm64:-"VADD V"
	return xs.sum()
}

//go:noinline
func sumUint(xs []uint) uint {
	// amd64:-"VPMASKMOV" -"VPADD"
	// arm64:-"VADD V"
	return xs.sum()
}

//go:noinline
func sumUintptr(xs []uintptr) uintptr {
	// amd64:-"VPMASKMOV" -"VPADD"
	// arm64:-"VADD V"
	return xs.sum()
}

type watt = float64

//go:noinline
func sumAlias(xs []watt) float64 {
// amd64/v1:"VPMASKMOVQ\\s+\\(" "VMOVDQU\\s+\\("
// amd64/v3:"VPMASKMOVQ\\s+\\(" "VMOVDQU\\s+\\("
	return xs.sum()
}

//go:noinline
func sumFiltered(xs []int32) int32 {
	// amd64:-"VPMASKMOV" -"VMOVDQU" -"CALL runtime\\.makeslice"
	// arm64:-"VPMASKMOV" -"CALL runtime\\.makeslice"
	return xs.filter(x => x > 0).sum()
}

func main() {
	var a []int32
	var b []uint64
	var c []uint16
	var d []uint8
	var e []float32
	var f []float64
	var g []int
	var u []uint
	var p []uintptr
	var w []watt
	var h []int8
	var i []int16
	var j []int64
	var k []uint32
	println(sumI32(a), sumU64(b), sumU16(c), sumU8(d), sumF32(e), sumF64(f), sumInt(g), sumUint(u), sumUintptr(p), sumAlias(w))
	println(sumI8(h), sumI16(i), sumI64(j), sumU32(k))
}
