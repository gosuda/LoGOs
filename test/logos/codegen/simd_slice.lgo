func sumUintptr(xs []uintptr) uintptr {
	// amd64:-"VPMASKMOV" -"VPADD" -"CALL simd/archsimd"
	// arm64:-"VADD V" -"CALL simd/archsimd"
	return xs.sum()
}

//go:noinline
func sumRune(xs []rune) rune {
	// amd64/v1:1"VPMASKMOVD\\s+\\(" "VPADDD\\s+\\(" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)" -"CALL simd/archsimd\\.Load"
	// amd64/v2:1"VPMASKMOVD\\s+\\(" "VPADDD" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)" -"CALL simd/archsimd\\.Load"
	// amd64/v3:1"VPMASKMOVD\\s+\\(" "VPADDD" -"CALL simd/archsimd\\." -"CMPB internal/cpu\\.X86"
	// amd64/v4:1"VPMASKMOVD\\s+\\(" "VPADDD" -"CALL simd/archsimd\\." -"CMPB internal/cpu\\.X86"
	// arm64:1"CALL simd/archsimd\\.LoadInt32x4Part\\(SB\\)" "VADD V[0-9]+\\.S4" -"CALL simd/archsimd\\.X86Features"
	return xs.sum()
}
type watt = float64

//go:noinline
func sumAlias(xs []watt) float64 {
// amd64/v1:1"VPMASKMOVQ\\s+\\(" "VMOVDQU\\s+\\(" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)" -"CALL simd/archsimd\\.Load"
// amd64/v3:1"VPMASKMOVQ\\s+\\(" "VMOVDQU\\s+\\(" -"CALL simd/archsimd\\." -"CMPB internal/cpu\\.X86"
	// arm64:1"CALL simd/archsimd\\.LoadFloat64x2Part\\(SB\\)" -"CALL simd/archsimd\\.X86Features"
	return xs.sum()
}

//go:noinline
func sumFiltered(xs []int32) int32 {
	// amd64:-"VPMASKMOV" -"VMOVDQU" -"CALL simd/archsimd" -"CALL runtime\\.makeslice"
	// arm64:-"CALL simd/archsimd" -"CALL runtime\\.makeslice"
	return xs.filter(x => x > 0).sum()
}

type loopVecF32 []float32

//go:noinline
func (v loopVecF32) sum() float32 {
	var s float32
	// amd64:-"VPMASKMOV"
	// arm64:-"CALL simd/archsimd" -"VFADD"
	for i := 0; i < len(v); i++ {
		// amd64:-"VPMASKMOV"
		// arm64:-"CALL simd/archsimd" -"VFADD"
		s += v[i]
	}
	return s
}

type loopVecI32 []int32

//go:noinline
func (v loopVecI32) sum() int32 {
	var s int32
	// amd64:-"VPMASKMOV"
	// arm64:-"CALL simd/archsimd" -"VADD V[0-9]+\\.S4"
	for _, x := range v {
		// amd64:-"VPMASKMOV"
		// arm64:-"CALL simd/archsimd" -"VADD V[0-9]+\\.S4"
		s += x
	}
	return s
}

//go:noinline
func sumLoopF32(xs []float32) float32 {
	var s float32
	// amd64:-"VPMASKMOV"
	// arm64:-"CALL simd/archsimd" -"VFADD"
	for i := 0; i < len(xs); i++ {
		// amd64:-"VPMASKMOV"
		// arm64:-"CALL simd/archsimd" -"VFADD"
		s += xs[i]
	}
	return s
}

//go:noinline
func sumRangeI32(xs []int32) int32 {
	var s int32
	// amd64:-"VPMASKMOV"
	// arm64:-"CALL simd/archsimd" -"VADD V[0-9]+\\.S4"
	for _, x := range xs {
		// amd64:-"VPMASKMOV"
		// arm64:-"CALL simd/archsimd" -"VADD V[0-9]+\\.S4"
		s += x
	}
	return s
}

func main() {
	var a []int32
	var b []uint64
	var c []uint16
	var d []uint8
	var e []float32
	var f []float64
	var g []int
	var u []uint
	var p []uintptr
	var w []watt
	var h []int8
	var i []int16
	var j []int64
	var k []uint32
	var r []rune
	println(sumI32(a), sumU64(b), sumU16(c), sumU8(d), sumF32(e), sumF64(f), sumInt(g), sumUint(u), sumUintptr(p), sumAlias(w))
	println(sumI8(h), sumI16(i), sumI64(j), sumU32(k), sumRune(r))
	var lf loopVecF32
	var li loopVecI32
	println(lf.sum(), li.sum(), sumLoopF32(e), sumRangeI32(a))
}
