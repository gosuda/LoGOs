// asmcheck -goexperiment simd

package main

//go:noinline
func sumI32(xs []int32) int32 {
	// amd64/v1:1"VPMASKMOVD\\s+\\(" "VPADDD\\s+\\(" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)" -"CALL simd/archsimd\\.Load"
	// amd64/v2:1"VPMASKMOVD\\s+\\(" "VPADDD" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)" -"CALL simd/archsimd\\.Load"
	// amd64/v3:1"VPMASKMOVD\\s+\\(" "VPADDD" -"CALL simd/archsimd\\." -"CMPB internal/cpu\\.X86"
	// amd64/v4:1"VPMASKMOVD\\s+\\(" "VPADDD" -"CALL simd/archsimd\\." -"CMPB internal/cpu\\.X86"
	// arm64:1"CALL simd/archsimd\\.LoadInt32x4Part\\(SB\\)" "VADD V[0-9]+\\.S4" -"CALL simd/archsimd\\.X86Features"
	return xs.sum()
}

//go:noinline
func sumU64(xs []uint64) uint64 {
// amd64/v1:1"VPMASKMOVQ\\s+\\(" "VPADDQ\\s+\\(" "CALL simd/archsimd\\.X86Features\\.AVX2\\(SB\\)"
// amd64/v3:1"VPMASKMOVQ\\s+\\(" "VPADDQ\\s+\\(" -"CALL simd/archsimd\\." -"CMPB internal/cpu\\.X86"
	// arm64:1"CALL simd/archsimd\\.LoadUint64x2Part\\(SB\\)" "VADD V[0-9]+\\.D2" -"CALL simd/archsimd\\.X86Features"
	return xs.sum()
}

//go:noinline
func sumU16(xs []uint16) uint16 {
	// amd64/v1:1"VMOVDQU16\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDW" "CALL simd/archsimd\\.X86Features\\.AVX512\\(SB\\)"
	// amd64/v3:1"VMOVDQU16\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDW" "CALL simd/archsimd\\.X86Features\\.AVX512\\(SB\\)"
	// amd64/v4:1"VMOVDQU16\\.Z\\s+\\(" "VPADDW" -"CALL simd/archsimd\\." -"CMPB internal/cpu\\.X86"
	// arm64:1"CALL simd/archsimd\\.LoadUint16x8Part\\(SB\\)" "VADD V[0-9]+\\.H8" -"CALL simd/archsimd\\.X86Features"
	return xs.sum()
}

//go:noinline
func sumU8(xs []uint8) uint8 {
	// amd64/v1:1"VMOVDQU8\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDB" "CALL simd/archsimd\\.X86Features\\.AVX512\\(SB\\)"
	// amd64/v3:1"VMOVDQU8\\.Z\\s+\\(" "VMOVDQU64\\s+\\(" "VPADDB" "CALL simd/archsimd\\.X86Features\\.AVX512\\(SB\\)"
	// amd64/v4:1"VMOVDQU8\\.Z\\s+\\(" "VPADDB" -"CALL simd/archsimd\\." -"CMPB internal/cpu\\.X86"
	// arm64:1"CALL simd/archsimd\\.LoadUint8x16Part\\(SB\\)" "VADD V[0-9]+\\.B16" -"CALL simd/archsimd\\.X86Features"
	return xs.sum()
}
