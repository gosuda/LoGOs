// asmcheck

package main

//go:noinline
func addPlainF64(a, b [4]float64) [4]float64 {
	// amd64:"ADDSD" -"VADDPD" -"CALL simd/archsimd" -"J"
	// arm64:"FADDD" -"CALL simd/archsimd" -"B" -"CBZ" -"CBNZ" -"TBZ" -"TBNZ"
	// riscv64:-"JAL X1, simd/archsimd" -"BLT" -"BGE" -"BEQ" -"BNE" -"JAL X0"
	return a + b
}

//go:noinline
func addPlainI32(a, b [4]int32) [4]int32 {
	// amd64:"ADDL" -"VPADDD" -"CALL simd/archsimd" -"J"
	// arm64:"ADD R[0-9]+, R[0-9]+, R[0-9]+" -"CALL simd/archsimd" -"B" -"CBZ" -"CBNZ" -"TBZ" -"TBNZ"
	// riscv64:-"JAL X1, simd/archsimd" -"BLT" -"BGE" -"BEQ" -"BNE" -"JAL X0"
	return a + b
}

