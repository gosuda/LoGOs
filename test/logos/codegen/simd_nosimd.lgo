//go:noinline
func addPlainU16(a, b [8]uint16) [8]uint16 {
	// amd64:"ADDL" -"VPADDW" -"CALL simd/archsimd" -"J"
	// arm64:-"VADD" -"CALL simd/archsimd" -"B" -"CBZ" -"CBNZ" -"TBZ" -"TBNZ"
