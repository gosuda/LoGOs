// asmcheck -logos.wasmassume=logostest.trapYield

package codegen

import (
	"runtime"
	"time"
	"unsafe"
)

//go:linkname gopark runtime.gopark
func gopark(unlockf func(unsafe.Pointer, unsafe.Pointer) bool, lock unsafe.Pointer, reason, traceReason uint8, traceskip int)

//go:noinline
func leaf(a, b int) int { // js/wasm/:-"BrTable" -"Loop" wasip1/wasm/:-"BrTable" -"Loop"
	// js/wasm/:"I64Mul" "I64Add" wasip1/wasm/:"I64Mul" "I64Add"
	return a*b + 3
}

//go:noinline
func straight(x int) int { // js/wasm/:-"BrTable" wasip1/wasm/:-"BrTable"
	// js/wasm/:"Call \\S+\\.leaf" "UNDEF" -"BrIf" wasip1/wasm/:"Call \\S+\\.leaf" "UNDEF" -"BrIf"
	a := leaf(x, 1)
	// js/wasm/:"Call \\S+\\.leaf" "UNDEF" -"BrIf" wasip1/wasm/:"Call \\S+\\.leaf" "UNDEF" -"BrIf"
	b := leaf(x, 2)
	return a + b
}

//go:noinline
func recv() int { // js/wasm/:"BrTable" wasip1/wasm/:"BrTable"
	c := make(chan int, 1)
	c <- 1
	// js/wasm/:"Call runtime\\.chanrecv1" "BrIf" wasip1/wasm/:"Call runtime\\.chanrecv1" "BrIf"
	return <-c
}

//go:noinline
func deferred(p *int) { // js/wasm/:"BrTable" wasip1/wasm/:"BrTable"
	defer func() { *p++ }()
	*p = 1
}

//go:noinline
func parks() { // js/wasm/:"BrTable" wasip1/wasm/:"BrTable"
	gopark(nil, nil, 0, 0, 0)
}

//go:noinline
func transitive() { // js/wasm/:"BrTable" wasip1/wasm/:"BrTable"
	// js/wasm/:"Call \\S+\\.parks" "BrIf" wasip1/wasm/:"Call \\S+\\.parks" "BrIf"
	parks()
}

//go:noinline
func trapYield() int { // js/wasm/:"BrTable" wasip1/wasm/:"BrTable"
	c := make(chan int, 1)
	c <- 1
	// js/wasm/:"Call runtime\\.chanrecv1" "BrIf" wasip1/wasm/:"Call runtime\\.chanrecv1" "BrIf"
	return <-c
}

//go:noinline
func trapCaller() int { // js/wasm/:-"BrTable" wasip1/wasm/:-"BrTable"
	// js/wasm/:"Call \\S+\\.trapYield" "UNDEF" -"BrIf" wasip1/wasm/:"Call \\S+\\.trapYield" "UNDEF" -"BrIf"
	trapYield()
	return 7
}

//go:noinline
func sleeps() { // js/wasm/:"BrTable" wasip1/wasm/:"BrTable"
	time.Sleep(1)
}

//go:noinline
func goscheds() { // js/wasm/:"BrTable" wasip1/wasm/:"BrTable"
	runtime.Gosched()
}

//go:noinline
func selects() int { // js/wasm/:"BrTable" wasip1/wasm/:"BrTable"
	c1 := make(chan int, 1)
	c2 := make(chan int, 1)
	select {
	case v := <-c1:
		return v
	case v := <-c2:
		return -v
	}
}
