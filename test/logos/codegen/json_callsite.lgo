// asmcheck

package callsitecheck

import "encoding/json"

type Eligible struct {
	ID   int    `json:"id"`
	Name string `json:"name"`
}

func callMarshal(v Eligible) ([]byte, error) {
	// amd64:"CALL.*encoding/json.*Marshal" arm64:"CALL.*encoding/json.*Marshal"
	return json.Marshal(v)
}

func callMarshalPtr(v *Eligible) ([]byte, error) {
	// amd64:"CALL.*encoding/json.*Marshal" arm64:"CALL.*encoding/json.*Marshal"
	return json.Marshal(v)
}

func callMarshalIface(v any) ([]byte, error) {
	// amd64:"CALL.*encoding/json.*Marshal" arm64:"CALL.*encoding/json.*Marshal"
	return json.Marshal(v)
}
