// errorcheck -0 -d=defer

package p

import "iter"

//go:noinline
func closeNil() error { return nil }

func loop(n int) (err error) {
	for i := 0; i < n; i++ {
		defer closeNil()? // ERROR "pooled try defer"
	}
	return nil
}

func nested(n int) (err error) {
	for i := 0; i < n; i++ {
		for j := 0; j < n; j++ {
			defer closeNil()? // ERROR "pooled try defer"
		}
	}
	return nil
}

func gotoLoop(n int) (err error) {
	i := 0
again:
	if i < n {
		i++
		defer closeNil()? // ERROR "pooled try defer"
		goto again
	}
	return nil
}

func literal() func(int) error {
	return func(n int) (err error) {
		for i := 0; i < n; i++ {
			defer closeNil()? // ERROR "pooled try defer"
		}
		return nil
	}
}

func top() (err error) {
	defer closeNil()? // ERROR "open-coded defer"
	return nil
}

func topWithLoop(n int) (err error) {
	defer closeNil()? // ERROR "stack-allocated defer"
	for i := 0; i < n; i++ {
		defer closeNil()? // ERROR "pooled try defer"
	}
	return nil
}

func overRange(seq iter.Seq[int]) (err error) {
	for range seq {
		defer closeNil()? // ERROR "heap-allocated defer"
	}
	return nil
}

func plainLoop(n int) {
	for i := 0; i < n; i++ {
		defer func() {}() // ERROR "heap-allocated defer"
	}
}
