// errorcheck

package p

type Circle struct {
	Radius float64
}

type Square struct {
	Side float64
}

type Blob struct {
	Name string
	Tags []string
}

type ShapeVal interface {
	Circle | Square
}

type ShapeRef interface {
	Circle | Blob
}

type HolderVal struct {
	S  ShapeVal
	ID int
}

type HolderRef struct {
	S    ShapeRef
	Tags []string
}

func switchVal(xs const []HolderVal) string {
	switch xs[0].S.(type) {
	case Circle:
		return "circle"
	case Square:
		return "square"
	case nil:
		return "nil"
	default:
		return "other"
	}
}

func switchRef(xs const []HolderRef) string {
	switch xs[0].S.(type) {
	case Circle:
		return "circle"
	case Blob:
		return "blob"
	case nil:
		return "nil"
	default:
		return "other"
	}
}

func switchControl() string {
	holders := []HolderVal{
		HolderVal{S: Circle{Radius: 1}, ID: 1},
	}
	switch holders[0].S.(type) {
	case Circle:
		return "circle"
	case Square:
		return "square"
	case nil:
		return "nil"
	default:
		return "other"
	}
}

type Other struct {
	Name string
}

// Exhaustiveness still applies through the view: Square and nil are missing.
func switchValMissing(xs const []HolderVal) string {
	switch xs[0].S.(type) { // ERROR "nonexhaustive_switch"
	case Circle:
		return "circle"
	case Square:
		return "square"
	}
	return "other"
}

// A case that is not a union member still fails through the view.
func switchValNonMember(xs const []HolderVal) string {
	switch xs[0].S.(type) {
	case Circle:
		return "circle"
	case Other: // ERROR "union_nonmember"
		return "other"
	default:
		return "other"
	}
}

// A case variable for a reference-bearing member keeps the view: a
// write through it is still rejected.
func switchRefWrite(xs const []HolderRef) {
	switch u := xs[0].S.(type) {
	case Blob:
		u.Tags = nil // ERROR "const_view_mutation"
		_ = u
	case Circle:
		_ = u
	default:
	}
}
