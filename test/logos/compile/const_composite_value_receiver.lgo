// errorcheck

package p

type plain struct {
	L []int
	N int
}

type pt struct{ X, Y int }

type ints []int

func (p plain) Mutate() { p.L[0] = 99 }

func (p plain) Read() int { return p.L[0] + len(p.L) + p.N }

func (p plain) Bump() int {
	p.N++
	return p.N
}

func (q pt) Moved() pt {
	q.X++
	return q
}

func (s ints) Set() { s[0] = 7 }

func (s ints) Sum() int { return s[0] + s[1] }

const cfg = plain{L: []int{1, 2}, N: 3}

const origin = pt{X: 1, Y: 2}

const nums = ints{1, 2}

func rejectValueMutate() {
	cfg.Mutate() // ERROR "const_view_mutation"
}

func rejectValueMethodValue() {
	f := cfg.Mutate // ERROR "const_view_mutation"
	f()
}

func rejectSliceValueMutate() {
	nums.Set() // ERROR "const_view_mutation"
}

func allowValueReaders() int {
	return cfg.Read() + cfg.Bump() + origin.Moved().X + nums.Sum()
}
