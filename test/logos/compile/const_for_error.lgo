// errorcheck

package p

import "comptime"

type Point struct {
	X int
	Y int
}

func checkPoint(v Point) Point {
	var out Point
	const for _, f := range comptime.Fields[Point]() {
		out.[f] = v.[f]
		comptime.Error("no points allowed") // ERROR "\[comptime::error\] no points allowed"
	}
	return out
}
