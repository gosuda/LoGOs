// errorcheck

package p

func breakDirect[T any]() {
	const switch T {
	case int:
		break // ERROR "break is not in a loop, switch, or select"
	}
}

func continueDirect[T any]() {
	const switch T {
	case int:
		continue // ERROR "continue is not in a loop"
	}
}

func breakInLoop[T any]() {
	for {
		const switch T {
		case int:
			break
		}
	}
}

func continueInLoop[T any]() {
	for {
		const switch T {
		case int:
			continue
		}
	}
}

func breakSwitchLabel[T any]() {
L:
	const switch T {
	case int:
		break L // ERROR "invalid break label L"
	}
}

func validNestedControls[T any](ok bool) {
	const switch T {
	case int:
		for {
			if ok {
				break
			}
			continue
		}
	}
}

func validLabeledJumps[T any]() {
outer:
	for {
		const switch T {
		case int:
			break outer
		case string:
			continue outer
		}
	}
}
