// errorcheck

package p

func breakDirect[T any]() {
	const switch T {
	case int:
		break // ERROR "comptime::const_switch_jump"
	}
}

func continueDirect[T any]() {
	const switch T {
	case int:
		continue // ERROR "comptime::const_switch_jump"
	}
}

func breakInLoop[T any]() {
	for {
		const switch T {
		case int:
			break // ERROR "comptime::const_switch_jump"
		}
	}
}

func continueInLoop[T any]() {
	for {
		const switch T {
		case int:
			continue // ERROR "comptime::const_switch_jump"
		}
	}
}

func breakSwitchLabel[T any]() {
L:
	const switch T {
	case int:
		break L // ERROR "invalid break label"
	}
}

func validNestedControls[T any](ok bool) {
	const switch T {
	case int:
		for {
			if ok {
				break
			}
			continue
		}
	}
}

func validLabeledJumps[T any]() {
outer:
	for {
		const switch T {
		case int:
			break outer
		case string:
			continue outer
		}
	}
}

func plainBreakAfterConstSwitch[T any]() {
	const switch T {
	case int:
	}
	break // ERROR "is not in a loop"
}
