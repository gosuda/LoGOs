// compile

// A comptime generic, exported or not, may name the unexported
// package-level identifiers of its own package: each instance is checked
// in the defining package's scope. An instantiation in another package
// cannot reach them; logos_comptime_unexported.txt covers that refusal.

package p

import "comptime"

type hidden struct {
	name string
}

type Visible struct {
	Port int
}

func bump(n int) int { return n + 1 }

func describe(v Visible) int { return v.Port }

var hiddenCount = 1

func RunUnexportedType[T any](root *T, seed hidden) int {
	n := len(seed.name)
	const for _, f := range comptime.Fields[T]() {
		_ = f.Name
		n++
	}
	return n
}

func RunUnexportedFunc[T any](root *T) int {
	n := bump(0)
	const for _, f := range comptime.Fields[T]() {
		_ = f.Name
		n += n
	}
	return n
}

func RunUnexportedValue[T any](root *T) int {
	n := hiddenCount
	const for _, f := range comptime.Fields[T]() {
		_ = f.Name
		n += n
	}
	return n
}

func runHelper[F any](v Visible) int { return describe(v) }

func RunUnexportedGeneric[T any](root *T) int {
	n := 0
	const for _, f := range comptime.Fields[T]() {
		n += runHelper[f.Type](Visible{Port: f.Index})
	}
	return n
}

var _ = RunUnexportedType[Visible](&Visible{}, hidden{name: "seed"})
var _ = RunUnexportedFunc[Visible](&Visible{})
var _ = RunUnexportedValue[Visible](&Visible{})
var _ = RunUnexportedGeneric[Visible](&Visible{})
