// errorcheck

package p

func wrongType(xs []int) []int {
	return xs.map(x => {
		if x <= 1 {
			return x
		}
		return "big" // ERROR "cannot use .* as int value in return statement"
	})
}

func twoValues(xs []int) []int {
	return xs.map(x => {
		if x > 1 {
			return 0, 1 // ERROR "chain lambda return provides 2 values, want 1"
		}
		return x
	})
}

func bareReturn(xs []int) []int {
	return xs.map(x => {
		if x > 1 {
			return // ERROR "chain lambda return provides 0 values, want 1"
		}
		return x
	})
}

func predWrong(xs []int) []int {
	return xs.filter(x => {
		if x > 1 {
			return 0 // ERROR "cannot use 0 .* as bool value in return statement"
		}
		return true
	})
}
