// errorcheck

package p

import "encoding/json"
import "maps"

const cm = map[string]int{"a": 1, "b": 2}

func cmDelete() {
	maps.DeleteFunc(cm, func(k string, v int) bool { return true }) // ERROR "const_view_mutation"
}

func cmStore() {
	cm["c"] = 3 // ERROR "const_view_mutation"
}

func cmRead() {
	_ = maps.Clone(cm)
}
func cmOtherImported() {
	_, _ = json.Marshal(cm) // ERROR "const_view_mutation"
}

const func cmConst(m map[string]int) int {
	return m["a"] ?? 0
}

func cmConstCall() {
	_ = cmConst(cm)
}

func cmPlain(m map[string]int) {}

func cmPlainCall() {
	cmPlain(cm) // ERROR "const_view_mutation"
}
