type ownedBox struct {
	M map[string]int
}

const ownedStructMap = ownedBox{M: map[string]int{"a": 1}}

const ownedSliceMap = []map[string]int{{"a": 1}}

const ownedArrayMap = [1]map[string]int{{"a": 1}}

type ownedOuter struct {
	Inner ownedBox
}

const ownedNestedMap = ownedOuter{Inner: ownedBox{M: map[string]int{"a": 1}}}

func addrIndex(v const []int) {
	p := &v[0]
	*p = 99 // ERROR "const_view_mutation"
}

type addrPoint struct {
	X int
	Y int
}

func addrField(s const *addrPoint) {
	p := &s.X
	*p = 1 // ERROR "const_view_mutation"
}

type addrBox struct {
	N int
}

func addrIndexField(xs const []addrBox) {
	p := &xs[0].N
	*p = 2 // ERROR "const_view_mutation"
}

func addrArray(a const [3]int) {
	p := &a[0]
	*p = 3 // ERROR "const_view_mutation"
}

func addrRangePtr(v const []int) {
	for i := range v {
		p := &v[i]
		_ = i
		*p = 4 // ERROR "const_view_mutation"
	}
}

func sliceAliasWrite(v const []int) {
