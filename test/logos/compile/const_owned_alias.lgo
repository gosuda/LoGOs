	w[0] = 1 // ERROR "const_view_mutation"
}

func rangeIndexWrite(v const []int) {
	for i := range v {
		v[i] = 1 // ERROR "const_view_mutation"
	}
}

func mapIndexInc(m const map[string]int) {
	m["a"]++ // ERROR "const_view_mutation"
}

func (b *addrBox) addrSet(n int) {
	b.N = n
}

func methodPtrRecv(xs const []addrBox) {
	xs[0].addrSet(1) // ERROR "const_view_mutation"
}

