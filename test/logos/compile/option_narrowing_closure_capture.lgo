// errorcheck

package p

func captureTakeInt(i int) int { return i }

func captureReassigned(o int?) int {
	if o != nil {
		g := func() int { return captureTakeInt(o) } // ERROR "nil_deref_unproven"
		o = nil
		return g()
	}
	return -1
}

func captureDeferred(o int?) {
	if o != nil {
		defer func() { _ = captureTakeInt(o) }() // ERROR "nil_deref_unproven"
		o = nil
	}
}

func captureStable(o int?) int {
	if o != nil {
		g := func() int { return captureTakeInt(o) }
		return g()
	}
	return -1
}

func captureStableDeferred(o int?) {
	if o != nil {
		defer func() { _ = captureTakeInt(o) }()
	}
}


func switchLocalShadowStmt(o int?) int {
	g := func() int {
		switch o := 1; {
		case o == 1:
			o = 2
			return o
		}
		return 0
	}
	_ = g
	if o != nil {
		return captureTakeInt(o)
	}
	return -1
}

func switchLocalShadowNested(o int?) int {
	g := func() int {
		switch {
		case true:
			switch o := 1; {
			case o == 1:
				o = 2
				return o
			}
		}
		return 0
	}
	_ = g
	if o != nil {
		return captureTakeInt(o)
	}
	return -1
}
