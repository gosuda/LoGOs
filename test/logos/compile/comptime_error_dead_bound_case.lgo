// errorcheck

package p

import "comptime"

const N = 3

func RejectB[T any]() int {
	comptime.Error("unsupported")
	return 0
}

func ChooseB[T any]() string {
	const N = 2
	_ = comptime.SizeOf[int]()
	const switch T {
	case [N]int:
		RejectB[T]() // ERROR "\[comptime::error\] unsupported(?s:.*)instantiated here comptime_error_dead_bound_case.lgo:27:[0-9]+(?s:.*)instantiated here comptime_error_dead_bound_case.lgo:19:[0-9]+"
		return "reject"
	case int:
		return "int"
	}
	return "other"
}

var _ = ChooseB[[2]int]()
