// errorcheck

package p

import "strconv"

type efP struct {
	X int
}

func efFetch() (int, error) {
	return 1, nil
}

func efRec() (efP, error) {
	return efP{X: 1}, nil
}

func efSlice() ([]int, error) {
	return []int{1}, nil
}

func efUse(n int) {}

func efTest(n int) bool {
	return n > 0
}

func efPrintErrFirst() {
	n, err := efFetch()
	println(err, n) // ERROR "result_before_error_check"
}

func efPrintErrLast() {
	n, err := efFetch()
	println(n, err) // ERROR "result_before_error_check"
}

func efUseThenDiscard() {
	n, err := efFetch()
	efUse(n) // ERROR "result_before_error_check"
	_ = err
}

func efBlankPair() {
	n, err := efFetch()
	_, _ = n, err
}

func efBlankOnly() {
	n, err := efFetch()
	_ = n
	_ = err
}

func efReturnExpr() (int, error) {
	n, err := efFetch()
	return n + 1, err // ERROR "result_before_error_check"
}

func efReturnDropsErr() (int, error) {
	n, err := efFetch()
	_ = err
	return n, nil // ERROR "result_before_error_check"
}

func efReturnForward() (int, error) {
	n, err := efFetch()
	return n, err
}

func efForwardCall() (int, error) {
	return efFetch()
}

func efFieldRead() {
	p, err := efRec()
	println(p.X) // ERROR "result_before_error_check"
	_ = err
}

func efIndexRead() {
	s, err := efSlice()
	println(s[0]) // ERROR "result_before_error_check"
	_ = err
}

func efHeaderThenBody() {
	n, err := efFetch()
	if efTest(n) { // ERROR "result_before_error_check"
		println(err)
	}
}

func efLiteralBody() {
	n, err := efFetch()
	f := func() {
		efUse(n) // ERROR "result_before_error_check"
		_ = err
	}
	f()
}

func efCheckedFirst() {
	n, err := efFetch()
	if err != nil {
		return
	}
	println(err, n)
}

func efCheckedPositive() {
	n, err := efFetch()
	if err == nil {
		println(err, n)
	}
}

func efGoCalleeKeepsContract() {
	n, err := strconv.Atoi("7")
	println(err, n)
}

func efChainTestFirst() bool {
	n, err := efFetch()
	return err == nil && n > 0
}

func efChainTestFirstFailure() bool {
	n, err := efFetch()
	return err != nil && n == 0 // ERROR "result_before_error_check"
}

func efChainOrFirst() bool {
	n, err := efFetch()
	return err != nil || n > 0
}

func efChainTestLast() bool {
	n, err := efFetch()
	return n > 0 && err == nil // ERROR "result_before_error_check"
}

func efChainOrLast() bool {
	n, err := efFetch()
	return n > 0 || err != nil // ERROR "result_before_error_check"
}

func efChainSentinel(sentinel error) bool {
	n, err := efFetch()
	return err == sentinel && n == 0 // ERROR "result_before_error_check"
}

func efCapturedReassigned() {
	n, err := efFetch()
	if err != nil {
		return
	}
	f := func() {
		efUse(n) // ERROR "result_before_error_check"
	}
	n, err = efFetch()
	_ = err
	f()
}

func efCapturedBeforeTracked() {
	var n int
	var err error
	f := func() {
		efUse(n) // ERROR "result_before_error_check"
		_ = err
	}
	n, err = efFetch()
	_ = err
	f()
}

func efCapturedAlias() {
	n, err := efFetch()
	if err != nil {
		return
	}
	alias := &n
	f := func() {
		efUse(n) // ERROR "result_before_error_check"
	}
	*alias = 2
	f()
}

func efCapturedLoop() {
	n, err := efFetch()
	if err != nil {
		return
	}
	f := func() {
		efUse(n) // ERROR "result_before_error_check"
	}
	for range 2 {
		n, err = efFetch()
		_ = err
		f()
	}
}

type efAmount int

func (n *efAmount) touch() { *n = 2 }
func (n efAmount) value() int { return int(n) }

func efLoadAmount() (efAmount, error) {
	return 1, nil
}

func efCapturedImplicitAddress() {
	n, err := efLoadAmount()
	if err != nil {
		return
	}
	later := func() {
		println(n) // ERROR "result_before_error_check"
	}
	n.touch()
	later()
}

func efCapturedImplicitMethodValue() {
	n, err := efLoadAmount()
	if err != nil {
		return
	}
	later := func() {
		println(n) // ERROR "result_before_error_check"
	}
	touch := n.touch
	touch()
	later()
}

type efAmountFields struct {
	n efAmount
}

func efLoadAmountFields() (efAmountFields, error) {
	return efAmountFields{}, nil
}

func efCapturedImplicitFieldAddress() {
	n, err := efLoadAmountFields()
	if err != nil {
		return
	}
	later := func() {
		println(n.n) // ERROR "result_before_error_check"
	}
	touch := n.n.touch
	touch()
	later()
}

func efLoadAmountArray() ([1]efAmount, error) {
	return [1]efAmount{}, nil
}

func efCapturedImplicitArrayAddress() {
	n, err := efLoadAmountArray()
	if err != nil {
		return
	}
	later := func() {
		println(n[0]) // ERROR "result_before_error_check"
	}
	n[0].touch()
	later()
}

type efEmbeddedAmount struct {
	efAmount
}

func efLoadEmbeddedAmount() (efEmbeddedAmount, error) {
	return efEmbeddedAmount{}, nil
}

func efCapturedPromotedImplicitAddress() {
	n, err := efLoadEmbeddedAmount()
	if err != nil {
		return
	}
	later := func() {
		println(n.efAmount) // ERROR "result_before_error_check"
	}
	n.touch()
	later()
}

func efCapturedValueReceiver() {
	n, err := efLoadAmount()
	if err != nil {
		return
	}
	later := func() { println(n) }
	value := n.value
	println(n.value(), value())
	later()
}

func efLoadAmountPointer() (*efAmount, error) {
	n := efAmount(1)
	return &n, nil
}

func efCapturedPointerReceiver() {
	n, err := efLoadAmountPointer()
	if err != nil {
		return
	}
	later := func() { println(*n) }
	touch := n.touch
	n.touch()
	touch()
	later()
}

type efNamedAmountArray [1]efAmount
type efAmountArrayAlias = efNamedAmountArray

func efLoadGenericAmount[T any]() (T, error) {
	var n T
	return n, nil
}

func efCapturedNamedArrayAliasAddress() {
	n, err := efLoadGenericAmount[efAmountArrayAlias]()
	if err != nil {
		return
	}
	later := func() {
		println(n[0]) // ERROR "result_before_error_check"
	}
	n[0].touch()
	later()
}

func efCapturedGenericArrayAddress[T ~[1]efAmount]() {
	n, err := efLoadGenericAmount[T]()
	if err != nil {
		return
	}
	later := func() {
		println(n[0]) // ERROR "result_before_error_check"
	}
	n[0].touch()
	later()
}

func efCapturedGenericArrayOrSliceAddress[T ~[1]efAmount | ~[]efAmount]() {
	n, err := efLoadGenericAmount[T]()
	if err != nil {
		return
	}
	later := func() {
		println(n[0]) // ERROR "result_before_error_check"
	}
	n[0].touch()
	later()
}

func efCapturedGenericSliceAddress[T ~[]efAmount]() {
	n, err := efLoadGenericAmount[T]()
	if err != nil {
		return
	}
	later := func() { println(n[0]) }
	n[0].touch()
	later()
}

func efCapturedArrayPointerAddress() {
	n, err := efLoadGenericAmount[*[1]efAmount]()
	if err != nil {
		return
	}
	later := func() { println(n[0]) }
	n[0].touch()
	later()
}

type efStats struct {
	count int
	items [2]int
}

type efInner struct {
	stats efStats
}

type efPtr struct {
	inner efInner
	p     *efStats
}

type efHeld struct {
	stats  int
	inner  efInner
	labels map[string]int
	vals   []int
}

// SPEC 2.5/T-202 names the read of a result, not the form of the
// destination, so a result stored in a direct value-struct field, a
// nested field, an array element, or a field of a pointer is tracked
// like a plain variable. Slice and map element destinations stay
// outside the tracked forms: a write through such an element can alias
// the tracked memory in a way this pass cannot name, so tracking them
// would need a guessing rule the SPEC does not license.

func efFetchHeld() (int, error) {
	return 1, nil
}

func efFetchStats() (efStats, error) {
	return efStats{count: 1}, nil
}

func efFetchAll() (efHeld, error) {
	return efHeld{}, nil
}

func efFetchStatsPtr() (*efStats, error) {
	return &efStats{count: 1}, nil
}

func efFieldReadUnchecked() {
	h := efHeld{inner: efInner{stats: efStats{}}}
	var err error
	h.stats, err = efFetchHeld()
	println(h.stats) // ERROR "result_before_error_check"
	if err != nil {
		return
	}
	println(h.stats)
}

func efFieldReadChecked() {
	h := efHeld{inner: efInner{stats: efStats{}}}
	var err error
	h.stats, err = efFetchHeld()
	if err != nil {
		return
	}
	println(h.stats)
}

func efNestedFieldReadUnchecked() {
	h := efHeld{inner: efInner{stats: efStats{}}}
	var err error
	h.inner.stats, err = efFetchStats()
	println(h.inner.stats.count) // ERROR "result_before_error_check"
	if err != nil {
		return
	}
	println(h.inner.stats.count)
}

func efFieldArrayElementUnchecked() {
	h := efHeld{inner: efInner{stats: efStats{}}}
	var err error
	h.inner.stats.items[1], err = efFetchHeld()
	println(h.inner.stats.items[1]) // ERROR "result_before_error_check"
	if err != nil {
		return
	}
	println(h.inner.stats.items[1])
}

func efPointerFieldReadUnchecked() {
	hp := efPtr{inner: efInner{stats: efStats{}}, p: &efStats{}}
	var err error
	hp.p, err = efFetchStatsPtr()
	println(hp.p.count) // ERROR "result_before_error_check"
	if err != nil {
		return
	}
	println(hp.p.count)
}

func efFieldReassigned() {
	h := efHeld{inner: efInner{stats: efStats{}}}
	var err error
	h.stats, err = efFetchHeld()
	h.stats = 9
	println(h.stats)
	_ = err
}

// Slicing the array before the tracked call means a later write through
// the slice can overwrite the element, so the element is not tracked and
// this read stays accepted.
func efFieldSlicedBeforeWrite() {
	h := efHeld{inner: efInner{stats: efStats{}}}
	items := h.inner.stats.items[:]
	var err error
	h.inner.stats.items[0], err = efFetchHeld()
	items[0] = 9
	println(h.inner.stats.items[0])
	_ = err
}

func efSliceElementUnchecked() {
	h := efHeld{inner: efInner{stats: efStats{}}}
	var err error
	h.vals[0], err = efFetchHeld()
	println(h.vals[0])
	_ = err
}

func efMapElementUnchecked() {
	h := efHeld{inner: efInner{stats: efStats{}}}
	var err error
	h.labels["a"], err = efFetchHeld()
	println(h.labels["a"])
	_ = err
}

// A store through a pointer to the struct is outside the tracked forms,
// because another pointer to the same struct can overwrite the field
// without a write this pass sees, and a stale entry would reject honest
// code. The reads stay accepted.
func efFieldStoreThroughPointer() {
	h := efHeld{}
	hp := &h
	var err error
	hp.stats, err = efFetchHeld()
	println(hp.stats)
	if err != nil {
		return
	}
	println(hp.stats)
}

// A store in one branch only leaves the entry unproven at the join, so
// the read inside the branch, before the check, fails. A read after the
// in-branch check passes in the branch and after the join, because the
// not-taken side holds no entry and the taken side holds a proof.
func efFieldStoreOneBranchReadInside(cond bool) {
	h := efHeld{}
	var err error
	if cond {
		h.stats, err = efFetchHeld()
		println(h.stats) // ERROR "result_before_error_check"
		if err != nil {
			return
		}
	}
	println(h.stats)
	_ = err
}

func efFieldStoreOneBranchChecked(cond bool) {
	h := efHeld{}
	var err error
	if cond {
		h.stats, err = efFetchHeld()
		if err != nil {
			return
		}
		println(h.stats)
	}
	println(h.stats)
	_ = err
}

func efFieldStoreOneBranchReadAfterJoin(cond bool) {
	h := efHeld{}
	var err error
	if cond {
		h.stats, err = efFetchHeld()
	}
	println(h.stats) // ERROR "result_before_error_check"
	if err != nil {
		return
	}
	_ = err
}

// A plain assignment writes its destination; no part of the destination
// spine is a read. A write into a tracked element or field drops the
// entries of the memory it changes, so these stay accepted.
func efElementWriteBeforeProof() {
	h := efHeld{inner: efInner{stats: efStats{}}}
	var err error
	h.inner.stats, err = efFetchStats()
	h.inner.stats.items[1] = 9
	println(h.inner.stats.items[1])
	_ = err
}

func efFieldWriteWhenRootTracked() {
	h := efHeld{}
	var err error
	h, err = efFetchAll()
	h.stats = 9
	println(h)
	_ = err
}

func efPatchedFieldRead() {
	h := efHeld{inner: efInner{stats: efStats{}}}
	var err error
	h.inner.stats, err = efFetchStats()
	h.inner.stats.count = 9
	println(h.inner.stats.count)
	println(h.inner.stats.items[0])
	_ = err
}
