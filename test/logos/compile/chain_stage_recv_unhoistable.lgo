// errorcheck

package p

import "context"

func use(v int) {}

func rejectFilterAnd(ctx context.Context, xs []int, in chan int, ok bool) ([]int, error) {
	return xs.group(ctx, limit = 2).filter(x => ok && <-in > 0) // ERROR "group stage lambda"
}

func rejectFilterOr(ctx context.Context, xs []int, in chan int, ok bool) ([]int, error) {
	return xs.group(ctx, limit = 2).filter(x => ok || <-in > 0) // ERROR "group stage lambda"
}

func rejectForCond(ctx context.Context, xs []int, in chan int) ([]int, error) {
	return xs.group(ctx, limit = 2).map(x => {
		for <-in < 3 { // ERROR "group stage lambda"
		}
		return x
	})
}

func rejectIfAfterInit(ctx context.Context, xs []int, in chan int) ([]int, error) {
	return xs.group(ctx, limit = 2).map(x => {
		if v := x; <-in == v { // ERROR "group stage lambda"
		}
		return x
	})
}

func rejectDeferArg(ctx context.Context, xs []int, in chan int) ([]int, error) {
	return xs.group(ctx, limit = 2).map(x => {
		defer use(<-in) // ERROR "group stage lambda"
		return x
	})
}
