// errorcheck

package p

type efClosureHeld struct {
	stats int
	err   error
}

func efClosureFetch() (int, error) {
	return 1, nil
}

// A blank-error store inside an immediately invoked literal still leaves
// an unchecked value that reaches the deferred read: skipping the retry
// must fail.
func efClosureBlankStoreReachesDefer(cond bool) {
	h := efClosureHeld{}
	var retryErr error
	func() {
		h.stats, _ = efClosureFetch()
	}()
	defer func() {
		if retryErr == nil {
			println(h.stats) // ERROR "result_before_error_check"
		}
	}()
	if cond {
		h.stats, retryErr = efClosureFetch()
	}
	_ = retryErr
}

// A reset inside an immediately invoked literal is visible to every later
// capture: the summary must not re-export the intermediate mark, so the
// deferred read stays accepted.
func efClosureSyncResetAccepted() {
	h := efClosureHeld{}
	func() {
		h.stats, _ = efClosureFetch()
		h.stats = 0
	}()
	defer func() {
		println(h.stats)
	}()
}

// Overwriting the error inside the literal drops the pairing in the exit
// state, so a later field check cannot discharge the read even when a
// conditional retry pairs elsewhere.
func efClosureErrorOverwriteStale(cond bool) {
	h := efClosureHeld{}
	var retryErr error
	func() {
		h.stats, h.err = efClosureFetch()
		h.err = nil
	}()
	if h.err == nil {
		defer func() {
			if retryErr == nil {
				println(h.stats) // ERROR "result_before_error_check"
			}
		}()
		if cond {
			h.stats, retryErr = efClosureFetch()
		}
	}
	_ = retryErr
}

type efClosurePair struct {
	stats  int
	first  error
	second error
}

// A literal that clears the error field of a pairing it received leaves
// the stored result unchecked: the later nil check reads the cleared
// field, not the call's error.
func efClosureClearsIncomingError() {
	h := efClosureHeld{}
	h.stats, h.err = efClosureFetch()
	func() {
		h.err = nil
	}()
	if h.err == nil {
		defer func() {
			println(h.stats) // ERROR "result_before_error_check"
		}()
	}
}

// The same cleared pairing must not discharge the mark that a skipped
// retry would otherwise keep.
func efClosureClearsIncomingRetry(retry bool) {
	h := efClosureHeld{}
	h.stats, h.err = efClosureFetch()
	func() {
		h.err = nil
	}()
	if h.err != nil {
		return
	}
	var retryErr error
	defer func() {
		if retryErr == nil {
			println(h.stats) // ERROR "result_before_error_check"
		}
	}()
	if retry {
		h.stats, retryErr = efClosureFetch()
	}
}

// A literal that replaces the result and then clears the replacement's
// error exports an unpaired value: the caller's pairing with the first
// call's error no longer describes it.
func efClosureReplacementKeepsOldGuard() {
	h := efClosurePair{}
	h.stats, h.first = efClosureFetch()
	func() {
		h.stats, h.second = efClosureFetch()
		h.second = nil
	}()
	if h.first == nil {
		defer func() {
			println(h.stats) // ERROR "result_before_error_check"
		}()
	}
}

// A literal that only reads the result keeps the caller's pairing.
func efClosureReadKeepsPairing() {
	h := efClosureHeld{}
	h.stats, h.err = efClosureFetch()
	func() {
		if h.err == nil {
			println(h.stats)
		}
	}()
	if h.err == nil {
		defer func() {
			println(h.stats)
		}()
	}
}

// A literal that stores the result again with the same error field
// leaves one pairing on every path, so the check proves the read.
func efClosureSamePairingAccepted() {
	h := efClosureHeld{}
	h.stats, h.err = efClosureFetch()
	func() {
		h.stats, h.err = efClosureFetch()
	}()
	if h.err == nil {
		defer func() {
			println(h.stats)
		}()
	}
}

// A defer inside an immediately invoked literal runs when the literal
// returns, after the literal's own reset, so the stored value reaches a
// later deferred read unchecked.
func efClosureNestedDeferAfterReset() {
	h := efClosureHeld{}
	func() {
		defer func() {
			h.stats, _ = efClosureFetch()
		}()
		h.stats = 0
	}()
	defer func() {
		println(h.stats) // ERROR "result_before_error_check"
	}()
}
