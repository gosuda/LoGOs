// errorcheck

package p

import "comptime"

const BoomMsg = "named boom"

func FailNamed[T any]() int {
	comptime.Error(BoomMsg)
	return 0
}

var _ = FailNamed[int]() // ERROR "named boom"

func FailConcat[T any]() int {
	comptime.Error("concat" + " message")
	return 0
}

var _ = FailConcat[int]() // ERROR "concat message"

const SharedPrefix = "bad: "

func FailShared[T any]() int {
	const A = SharedPrefix + "a"
	const B = SharedPrefix + "b"
	comptime.Error(A + B)
	return 0
}

var _ = FailShared[int]() // ERROR "bad: abad: b"

const ShadowedMsg = "pkg"

func FailShadowed[T any]() int {
	const ShadowedMsg = "local"
	comptime.Error(ShadowedMsg)
	return 0
}

var _ = FailShadowed[int]() // ERROR "local"

const Prefix = "p"

func FailSelfShadowInit[T any]() int {
	const Prefix = Prefix + "!"
	comptime.Error(Prefix)
	return 0
}

var _ = FailSelfShadowInit[int]() // ERROR "p!"

const LaterB = "pkg"

func FailLaterShadowInit[T any]() int {
	const A = LaterB + "!"
	const LaterB = "late"
	comptime.Error(A)
	return 0
}

var _ = FailLaterShadowInit[int]() // ERROR "pkg!"

func FailCaseLocalMsg[T any]() int {
	const switch T {
	case int:
		const Msg = "bad int"
		comptime.Error(Msg)
	}
	return 0
}

var _ = FailCaseLocalMsg[int]() // ERROR "bad int"

func FailInheritedMsg[T any]() int {
	const (
		_ = "bad"
		InheritedMsg
	)
	comptime.Error(InheritedMsg)
	return 0
}

var _ = FailInheritedMsg[int]() // ERROR "bad"
