// errorcheck

package p

import "comptime"

const BoomMsg = "named boom"

func FailNamed[T any]() int {
	comptime.Error(BoomMsg)
	return 0
}

var _ = FailNamed[int]() // ERROR "named boom"

func FailConcat[T any]() int {
	comptime.Error("concat" + " message")
	return 0
}

var _ = FailConcat[int]() // ERROR "concat message"

const SharedPrefix = "bad: "

func FailShared[T any]() int {
	const A = SharedPrefix + "a"
	const B = SharedPrefix + "b"
	comptime.Error(A + B)
	return 0
}

var _ = FailShared[int]() // ERROR "bad: abad: b"

const ShadowedMsg = "pkg"

func FailShadowed[T any]() int {
	const ShadowedMsg = "local"
	comptime.Error(ShadowedMsg)
	return 0
}

var _ = FailShadowed[int]() // ERROR "local"
