// errorcheck

// run-time use. A condition that mixes it with a run-time value is not

package p

import "comptime"

type Pair struct {
	X int
	Y int
}

func outside() bool {
	return comptime.IsStruct[Pair]() // ERROR "comptime::runtime_use"
}

func RuntimeGuard[T any](ok bool) {
	const if ok && comptime.IsStruct[T]() { // ERROR "comptime::not_constant"
	}
}

func liveNonStruct() {
	const if comptime.IsStruct[Pair]() {
		const for _, f := range comptime.Fields[int]() { // ERROR "comptime::const_for_fields"
			_ = f.Name
		}
	}
}

func fieldCondition() {
	const for _, f := range comptime.Fields[Pair]() {
		const if f.Name == "X" { // ERROR "comptime::not_constant"
		}
	}
}

func fieldIndexCondition() {
	const for _, f := range comptime.Fields[Pair]() {
		const if f.Index == 0 { // ERROR "comptime::not_constant"
		}
	}
}

func fieldExportedCondition() {
	const for _, f := range comptime.Fields[Pair]() {
		const if f.Exported { // ERROR "comptime::not_constant"
		}
	}
}

func fieldVarCondition() {
	const for i, _ := range comptime.Fields[Pair]() {
		const if i == 0 { // ERROR "comptime::not_constant"
		}
	}
}

func deadNonStruct() string {
	const if comptime.IsStruct[int]() {
		const for _, f := range comptime.Fields[int]() {
			_ = f.Name
		}
	}
	return "ok"
}

func nonConstantError(msg string) {
	comptime.Error(msg) // ERROR "comptime::error_not_constant"
}

func nonConstantErrorVar() {
	msg := "dynamic message"
	comptime.Error(msg) // ERROR "comptime::error_not_constant"
}

func nonStringConstantError() {
	comptime.Error(42) // ERROR "cannot use 42"
}

func predicateValue() any {
	return comptime.IsStruct[Pair] // ERROR "comptime::runtime_use"
}

func errorValue() {
	f := comptime.Error // ERROR "comptime::runtime_use"
	_ = f
}

func fieldsValue() {
	g := comptime.Fields[Pair] // ERROR "comptime::runtime_use"
	_ = g
}
