// errorcheck

package p

import "context"

func store(p *int, v int) {
	*p = v
}

func rejectForCond(ctx context.Context, in chan int) error {
	go group (ctx) {
		go {
			for <-in < 3 { // ERROR "channel receive .* cannot lower in a go group child"
			}
		}
	}
	return nil
}

func rejectForPost(ctx context.Context, in chan int) error {
	go group (ctx) {
		go {
			for i := 0; i < 3; i += <-in { // ERROR "channel receive .* cannot lower in a go group child"
			}
		}
	}
	return nil
}

func rejectForInit(ctx context.Context, in chan int) error {
	go group (ctx) {
		go {
			for i := <-in; i < 3; i++ { // ERROR "channel receive .* cannot lower in a go group child"
			}
		}
	}
	return nil
}

func rejectRange(ctx context.Context, chch chan chan int) error {
	go group (ctx) {
		go {
			for range <-chch { // ERROR "channel receive .* cannot lower in a go group child"
			}
		}
	}
	return nil
}

func rejectAnd(ctx context.Context, in chan int, ok bool) error {
	go group (ctx) {
		go {
			if ok && <-in == 1 { // ERROR "channel receive .* cannot lower in a go group child"
			}
		}
	}
	return nil
}

func rejectOr(ctx context.Context, in chan int, ok bool) error {
	go group (ctx) {
		go {
			if !ok || <-in == 1 { // ERROR "channel receive .* cannot lower in a go group child"
			}
		}
	}
	return nil
}

func rejectCase(ctx context.Context, in chan int) error {
	go group (ctx) {
		go {
			switch {
			case <-in == 1: // ERROR "channel receive .* cannot lower in a go group child"
			}
		}
	}
	return nil
}

func rejectIfInit(ctx context.Context, in chan int) error {
	go group (ctx) {
		go {
			if v := 1; <-in == v { // ERROR "channel receive .* cannot lower in a go group child"
			}
		}
	}
	return nil
}

func rejectSwitchTag(ctx context.Context, in chan int) error {
	go group (ctx) {
		go {
			switch v := 1; <-in { // ERROR "channel receive .* cannot lower in a go group child"
			case v:
			}
		}
	}
	return nil
}


func rejectDefer(ctx context.Context, in chan int) error {
	n := 0
	go group (ctx) {
		go {
			defer store(&n, <-in) // ERROR "channel receive .* cannot lower in a go group child"
		}
	}
	return nil
}

