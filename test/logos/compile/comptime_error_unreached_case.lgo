// errorcheck

package p

import "comptime"

func pick[F any]() int {
	const switch F {
	case int:
		return 1
	}
	comptime.Error("unsupported")
	return 0
}

// For pick[int] the comptime.Error below the const switch is dead: the
// selected case returns, so no instantiation path reaches it. For
// pick[string] no case matches, the switch falls through, and the error
// fires. A panic stops control flow the same way.
var _ = pick[int]()
var _ = pick[string]() // ERROR "\[comptime::error\] unsupported"

func stop[F any]() int {
	const switch F {
	case int:
		panic("int")
	}
	comptime.Error("stop unsupported")
	return 0
}

var _ = stop[int]()

func pickChecked[F any]() int {
	const switch F {
	case int:
		return 1
	}
	return 0
}

var _ = pickChecked[int]
