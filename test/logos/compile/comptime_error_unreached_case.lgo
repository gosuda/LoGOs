// errorcheck

package p

import "comptime"

func pick[F any]() int {
	const switch F {
	case int:
		return 1
	}
	comptime.Error("unsupported")
	return 0
}

// For pick[int] the comptime.Error below the const switch is
// termination-dead: constant analysis reaches it, and only the return
// of case int stops control flow before it. Termination-dead code is
// checked, so the error fires for every instantiation. A panic stops
// control flow the same way.
var _ = pick[int]() // ERROR "\[comptime::error\] unsupported"
var _ = pick[string]() // ERROR "\[comptime::error\] unsupported"

func stop[F any]() int {
	const switch F {
	case int:
		panic("int")
	}
	comptime.Error("stop unsupported")
	return 0
}

var _ = stop[int]() // ERROR "\[comptime::error\] stop unsupported"

func pickChecked[F any]() int {
	const switch F {
	case int:
		return 1
	}
	return 0
}

var _ = pickChecked[int]
