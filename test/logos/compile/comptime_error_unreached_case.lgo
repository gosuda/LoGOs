// errorcheck

package p

import "comptime"

func pick[F any]() int {
	const switch F {
	case int:
		return 1
	}
	comptime.Error("unsupported")
	return 0
}

// Today the error fires for every instantiation, even one whose copy
// returns from the selected case before reaching comptime.Error.
var _ = pick[int]() // ERROR "\[comptime::error\] unsupported"
var _ = pick[string]() // ERROR "\[comptime::error\] unsupported"

func pickChecked[F any]() int {
	const switch F {
	case int:
		return 1
	}
	return 0
}

var _ = pickChecked[int]
