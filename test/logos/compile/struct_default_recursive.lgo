package main

// A field default whose subtree fills a missing field with the same
// factory is recursive: emitting it would make the generated factory
// call itself without end. It is rejected instead of filled.

type Node struct {
	Children []Node = []Node{{}} // ERROR "recursive"
}

func main() {
	_ = Node{}
}
