// errorcheck

package p

import "strconv"

func load() (string, error) {
	return "v", nil
}

func readBeforeCheck() {
	v, err := load()
	println(v) // ERROR "result_before_error_check"
	_ = err
}

func readAfterCheck() {
	v, err := load()
	if err != nil {
		return
	}
	_ = v
}

func goCalleeKeepsContract() {
	n, aerr := strconv.Atoi("7")
	_ = n
	_ = aerr
}

func notOptionSelect(x int) {
	_ = x?.Foo // ERROR "not_an_option"
}

func notOptionCoalesce(y int) {
	_ = y ?? 5 // ERROR "not_an_option"
}

func rejectOptionToValue(o int?) {
	var _ int = o // ERROR "nil_deref_unproven"
}

func rejectOptionReturn(o int?) int {
	return o // ERROR "nil_deref_unproven"
}

func rejectOptionAssign(o int?) {
	var v int
	v = o // ERROR "nil_deref_unproven"
	_ = v
}

func takeInt(int) {}

func rejectOptionArgument(o int?) {
	takeInt(o) // ERROR "nil_deref_unproven"
}

func allowNarrowedOption(o int?) int {
	if o != nil {
		takeInt(o)
		return o
	}
	return 0
}

func mapRead(m map[string]int) {
	var single int? = m["k"]
	_ = single
	v, ok := m["k"]
	var _ int = v
	var _ bool = ok
}
