// errorcheck

package p

import "comptime"

type Mixed struct {
	S string
	N int
}

func perField(v Mixed) {
	const for _, f := range comptime.Fields[Mixed]() {
		var s string = v.[f] // ERROR "."
		_ = s
	}
}

func take(s string) {}

func perFieldCall(v Mixed) {
	const for _, f := range comptime.Fields[Mixed]() {
		take(v.[f]) // ERROR "."
	}
}
