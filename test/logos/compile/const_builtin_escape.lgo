// errorcheck

package p

type Stream struct {
	ID int
	Ch chan int
}

func rejectPanic(v const []byte) {
	panic(v) // ERROR "const_view_escape"
}

func rejectClose(s const *Stream) {
	close(s.Ch) // ERROR "const_view_mutation"
}

func rejectCloseChan(c const chan int) {
	close(c) // ERROR "const_view_mutation"
}

func validControls(v const []byte, s const *Stream) {
	_ = len(v)
	_ = cap(v)

	_ = len(s.Ch)
	_ = cap(s.Ch)

	if len(v) > 0 {
		var b byte = v[0]
		_ = b
	}
	var id int = s.ID
	_ = id
}
