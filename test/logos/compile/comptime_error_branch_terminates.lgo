// run

package main

import (
	"comptime"
	"fmt"
)

func pick[F any](fast bool) int {
	const switch F {
	case int:
		if fast {
			return 1
		} else {
			return 2
		}
	}
	comptime.Error("unsupported")
	return 0
}

func pickNested[F any]() int {
	{
		const switch F {
		case int:
			return 1
		}
		comptime.Error("unsupported")
	}
	return 0
}

func main() {
	fmt.Println(pick[int](true), pick[int](false), pickNested[int]())
}
