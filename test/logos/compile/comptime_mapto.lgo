// errorcheck

package p

import "comptime"

type Dst struct {
	ID   int
	Name string
}

type SrcOK struct {
	ID   int
	Name string
}

type SrcBad struct {
	ID   string
	Name string
}

func MapTo[D, S any](dst *D, src *S) {
	const for _, f := range comptime.Fields[D]() {
		dst.[f] = src.[f]
	}
}

func use(d *Dst, ok *SrcOK, bad *SrcBad) {
	MapTo[Dst, SrcOK](d, ok)
	MapTo[Dst, SrcBad](d, bad) // ERROR "."
}
