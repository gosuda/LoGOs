// errorcheck

package p

import (
	"os"
	"sort"
)

type Qualified interface {
	const Name() string
}

type Ordinary interface {
	Name() string
}

type Pure struct {
	name string
}

func (p Pure) Name() string { return p.name }

type MutSlice struct {
	S []int
}

func (m MutSlice) Name() string {
	m.S[0] = 1
	return "mut"
}

type MutMap struct {
	M map[string]int
}

func (m MutMap) Name() string {
	m.M["k"] = 1
	return "mut"
}

var ptrSrc = 7

type MutPtr struct {
	P *int
}

func (m MutPtr) Name() string {
	*m.P = 1
	return "mut"
}

var _ Qualified = Pure{}
var _ Ordinary = Pure{}

var _ Ordinary = MutSlice{S: []int{1}}
var _ Ordinary = MutMap{M: map[string]int{"k": 1}}
var _ Ordinary = MutPtr{P: &ptrSrc}

var _ Qualified = MutSlice{S: []int{1}}                // ERROR "const_view_mutation"
var _ Qualified = MutMap{M: map[string]int{"k": 1}}    // ERROR "const_view_mutation"
var _ Qualified = MutPtr{P: &ptrSrc}                   // ERROR "const_view_mutation"

func takesQualified(q Qualified) string { return q.Name() }

func takesOrdinary(o Ordinary) string { return o.Name() }

func attackDynamic(o Ordinary, q Qualified) {
	takesQualified(o) // ERROR "const_view_mutation"
	takesQualified(q)
}

func attackWeakening(q Qualified, p Pure, m MutSlice) {
	takesOrdinary(q)
	takesOrdinary(p)
	takesOrdinary(m)
}

func attackCall(m const *MutSlice) {
	m.Name() // ERROR "const_view_mutation"
}

func attackCallMap(m const *MutMap) {
	m.Name() // ERROR "const_view_mutation"
}

func attackCallPtr(m const *MutPtr) {
	m.Name() // ERROR "const_view_mutation"
}

func pureCallControl(p const *Pure) string {
	return p.Name()
}

type Opaque struct {
	items []int
}

func (o Opaque) Name() string {
	sort.Ints(o.items)
	return "sort"
}

var _ Qualified = Opaque{items: []int{3, 1, 2}} // ERROR "method Name is not readonly"

var _ Qualified = &os.File{} // ERROR "method Name is not readonly"

var _ Qualified = LateDecl{tag: "x"} // ERROR "method Name is not readonly"

type LateDecl struct {
	tag   string
	items []int
}

func (l LateDecl) Name() string {
	l.items[0] = 1
	return "late:" + l.tag
}

func attackDynamicView(xs const []Ordinary) {
	_ = xs[0].Name() // ERROR "cannot call Name through const view"
}

func dynamicViewControl(qs const []Qualified) string {
	return qs[0].Name()
}
