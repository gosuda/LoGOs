// errorcheck

package p

type WFunc struct {
	Name string
	Call func(x string) string
}

func rejectFuncFieldWrite(ts const []WFunc) {
	ts[0].Call = nil // ERROR "const_view_mutation"
}

func rejectFuncElemWrite(ts const []WFunc) {
	ts[0] = WFunc{} // ERROR "const_view_mutation"
}

func rejectFuncFieldAddrWrite(ts const []WFunc) {
	p := &ts[0].Call
	*p = nil // ERROR "const_view_mutation"
}

func rejectFuncRangeAddrWrite(ts const []WFunc) {
	for _, t := range ts {
		q := &t.Call
		*q = nil // ERROR "const_view_mutation"
	}
}
