// errorcheck

package p

import "logos/sync"

type HSChild struct {
	N int
}

type HSConfig struct {
	Name  string
	N     int
	Tags  []string
	Child *HSChild
}

func hsHot() {
	h := sync.Hot[HSConfig]{}
	h.Store(&HSConfig{Name: "n", Tags: []string{"a"}, Child: &HSChild{N: 1}})
	p := h.Load()
	p.Name = "x"    // ERROR "const_view_mutation"
	p.Tags[0] = "x" // ERROR "const_view_mutation"
	_ = p
}

func hsHotUpdateOK() {
	h := sync.Hot[HSConfig]{}
	h.Store(&HSConfig{Name: "n", Tags: []string{"a"}, Child: &HSChild{N: 1}})
	h.Update(func(old const *HSConfig) *HSConfig {
		return &HSConfig{Name: old.Name, N: old.N + 1, Tags: []string{"a"}, Child: &HSChild{N: 1}}
	})
	h.Update(old => &HSConfig{N: old.N + 1, Child: &HSChild{N: 2}})
}

func hsHotUpdateReject() {
	h := sync.Hot[HSConfig]{}
	h.Update(func(old *HSConfig) *HSConfig { // ERROR "."
		return old
	})
}

func hsHotUpdateMutate() {
	h := sync.Hot[HSConfig]{}
	h.Update(func(old const *HSConfig) *HSConfig {
		old.N = 1 // ERROR "const_view_mutation"
		return &HSConfig{Name: "n", Tags: []string{"a"}, Child: &HSChild{N: 1}}
	})
	h.Update(old => {
		old.N = 1 // ERROR "const_view_mutation"
		return &HSConfig{Name: "n", Tags: []string{"a"}, Child: &HSChild{N: 1}}
	})
}
