// errorcheck

package p

import "flag"

type efrcHeld struct {
	stats int
	err   error
}

func efrcFetch() (int, error) {
	return 1, nil
}

func efrcFetchHeld() (int, error) {
	return 1, nil
}

type efrcPair struct {
	X int
	Y int
}

func efrcFetchPair() (efrcPair, error) {
	return efrcPair{X: 1, Y: -1}, nil
}

func efrcUsePair(p efrcPair) {}

// A MustNonNil store between the defer and the reset can panic and run the
// deferred body before the reset executes, so the carve stops before it.
func efrcResetAfterPlatformStore() {
	missing := flag.Lookup("no-such-flag-efrc")
	n, err := efrcFetch()
	defer func() {
		println(n) // ERROR "result_before_error_check"
	}()
	var f *flag.Flag = missing
	n = 0
	_, _ = f, err
}

// A reset before the platform-checked store still protects the deferred
// read: the check can only panic after the reset already ran, so the
// partial carve stands.
func efrcResetBeforePlatformStore() {
	missing := flag.Lookup("no-such-flag-efrc")
	n, err := efrcFetch()
	defer func() {
		println(n)
	}()
	n = 0
	var f *flag.Flag = missing
	_, _ = f, err
}

// An explicit return writes the named results after the reset, so a
// result-carrying return in the remainder cancels the carve.
func efrcResetThenNamedForward() (n int, err error) {
	n, err = efrcFetch()
	m, otherErr := efrcFetch()
	defer func() {
		println(n) // ERROR "result_before_error_check"
	}()
	n = 0
	return m, otherErr
}

// Without named results a return cannot overwrite the reset value, so the
// carve stands.
func efrcResetThenUnnamedForward() (int, error) {
	n, err := efrcFetch()
	defer func() {
		println(n)
	}()
	n = 0
	return n, err
}

// A reset inside an if body does not protect against a store after the
// enclosing block: the carve only applies at the function body's top level.
func efrcResetNestedBlock(c bool) error {
	h := efrcHeld{}
	h.stats, h.err = efrcFetchHeld()
	g := func() { h.stats, h.err = efrcFetchHeld() }
	if c {
		defer func() {
			println(h.stats) // ERROR "result_before_error_check"
		}()
		h.stats = 0
	}
	g()
	return h.err
}

// A store from an earlier-defined literal reaches the deferred read even
// with no outer store: defining the literal records its stores.
func efrcResetNestedLiteral(c bool) error {
	h := efrcHeld{}
	g := func() { h.stats, h.err = efrcFetchHeld() }
	if c {
		defer func() {
			println(h.stats) // ERROR "result_before_error_check"
		}()
		h.stats = 0
	}
	g()
	return h.err
}

// Resetting one field does not reset the whole value: the deferred read of
// the whole struct still fails.
func efrcResetPartialWhole() {
	p, err := efrcFetchPair()
	defer func() {
		efrcUsePair(p) // ERROR "result_before_error_check"
	}()
	p.X = 0
	_ = err
}
