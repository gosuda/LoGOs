// errorcheck

package p

import (
	"context"
	"logos/sync"
	"sync/atomic"
)

type Union interface {
	int | string
}

type Pair struct {
	A, B int
}

type Triple struct {
	A, B, C int
}

type OneWord struct {
	N int
}

type Padded struct {
	N int
	Z struct{}
}

type Named struct {
	Name string
	N    int
}

type Holder struct {
	P *Named
	N int
}

type TwoBytes struct {
	A, B byte
}

func stringWrittenByParent(ctx context.Context) error {
	s := "a"
	go group (ctx) {
		go { // ERROR "concurrent_multiword_race"
			println(s)
		}
		s = "b"
	}
	return nil
}

func stringWrittenByChild(ctx context.Context) error {
	s := "a"
	go group (ctx) {
		go { // ERROR "concurrent_multiword_race"
			s = "b"
		}
	}
	println(s)
	return nil
}

func sliceHeaderWritten(ctx context.Context) error {
	xs := []int{1}
	go group (ctx) {
		go { // ERROR "concurrent_multiword_race"
			xs = append(xs, 2)
		}
	}
	return nil
}

func interfaceWritten(ctx context.Context) error {
	var v any = 1
	go group (ctx) {
		go { // ERROR "concurrent_multiword_race"
			println(v != nil)
		}
		v = "x"
	}
	return nil
}

func unionWritten(ctx context.Context) error {
	var u Union = 1
	go group (ctx) {
		go { // ERROR "concurrent_multiword_race"
			println(u != nil)
		}
		u = "x"
	}
	return nil
}

func complexWritten(ctx context.Context) error {
	c := complex(1, 2)
	go group (ctx) {
		go { // ERROR "concurrent_multiword_race"
			c = complex(3, 4)
		}
	}
	println(real(c))
	return nil
}

