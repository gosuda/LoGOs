func passPointerWritten(ctx context.Context) error {
	x := 0
	y := 1
	p := &x
	go group (ctx) {
		go {
			p = &y
		}
		p = &x
	}
	println(*p)
	return nil
}

func passMapWritten(ctx context.Context) error {
