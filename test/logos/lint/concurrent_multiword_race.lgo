	s := "a"
	s = "b"
	println(s)
	return nil
}

func passSequentialWrites(ctx context.Context) error {
	s := "a"
	go group (ctx) {
		go {
			t := "x"
			println(t)
		}
	}
	s = "b"
	println(s)
	return nil
}

func segmentStringWrite(ctx context.Context, xs []int) error {
	s := "a"
	_, err := xs.group(ctx, limit = 4).map(x => { // ERROR "concurrent_multiword_race"
		s = "b"
		return x
	})
	println(s)
	return err
}

func segmentInterfaceWrite(ctx context.Context, xs []int) error {
	var v any = 1
	_, err := xs.group(ctx, limit = 4).map(x => { // ERROR "concurrent_multiword_race"
		v = "x"
		return x
	})
	println(v != nil)
	return err
}

func segmentSliceHeaderWrite(ctx context.Context, xs []int) error {
	acc := []int{1}
	_, err := xs.group(ctx, limit = 4).map(x => { // ERROR "concurrent_multiword_race"
		acc = append(acc, x)
		return x
	})
	println(len(acc))
	return err
}

func segmentFilterWrite(ctx context.Context, xs []int) error {
	s := "a"
	_, err := xs.group(ctx, limit = 4).filter(x => { // ERROR "concurrent_multiword_race"
		s = "b"
		return x > 0
	})
	println(s)
	return err
}

func segmentUnorderedWrite(ctx context.Context, xs []int) error {
	s := "a"
	_, err := xs.group(ctx, limit = 4).unordered().map(x => { // ERROR "concurrent_multiword_race"
		s = "b"
		return x
	})
	println(s)
	return err
}

func segmentSecondLambdaWrite(ctx context.Context, xs []int) error {
	s := "a"
	_, err := xs.group(ctx, limit = 4).filter(x => x > 0).map(x => { // ERROR "concurrent_multiword_race"
		s = "b"
		return x
	})
	println(s)
	return err
}

func segmentRangeWrite(ctx context.Context, xs []int) error {
	s := "a"
	for y := range xs.group(ctx, limit = 2).map(x => x + len(s)) { // ERROR "concurrent_multiword_race"
		println(y)
		s = "b"
	}
	return nil
}

func segmentSiblingLambdas(ctx context.Context, xs []int) error {
	s := "a"
	_, err := xs.group(ctx, limit = 4).map(x => { // ERROR "concurrent_multiword_race"
		s = "b"
		return x
	}).map(x => {
		println(s)
		return x
	})
	return err
}

func segmentFuncLiteralWrite(ctx context.Context, xs []int) error {
	s := "a"
	_, err := xs.group(ctx, limit = 4).map(func(x int) int { // ERROR "concurrent_multiword_race"
		s = "b"
		return x
	})
	println(s)
	return err
}

func segmentInsideGroupBlock(ctx context.Context, xs []int) error {
	s := "a"
	go group (ctx) {
		_, err := xs.group(ctx, limit = 4).map(x => { // ERROR "concurrent_multiword_race"
			s = "b"
			return x
		})
		println(err == nil, s)
	}
	return nil
}

func passSegmentLocalWrite(ctx context.Context, xs []int) error {
	_, err := xs.group(ctx, limit = 4).map(x => {
		var local string
		local = "b"
		println(local)
		return x
	})
	return err
}

