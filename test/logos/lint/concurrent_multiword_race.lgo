func passSegmentAtomic(ctx context.Context, xs []int) error {
	var n atomic.Int64
	_, err := xs.group(ctx, limit = 4).map(x => {
		n.Add(1)
		return x
	})
	println(n.Load())
	return err
}

func passSegmentLocked(ctx context.Context, xs []int) error {
	var l sync.Locked[string]
	_, err := xs.group(ctx, limit = 4).map(x => {
		l.WithLock(func(s *string) { *s = "a" })
		return x
	})
	l.WithLock(func(s *string) { *s = "b" })
	return err
}

func passSegmentConstView(ctx context.Context, xs []int, in []int) error {
	var v const []int = in
	_, err := xs.group(ctx, limit = 4).map(x => {
		println(len(v))
		return x
	})
	return err
}

func passOrdinaryChainWrite(xs []int) int {
	s := "a"
	ys := xs.map(x => {
		s = "b"
		return x
	})
	println(s)
	return len(ys)
}

type chainHost struct{}

func (chainHost) group(ctx context.Context, n int) []int { return nil }

func passMethodNamedGroup(ctx context.Context, h chainHost) int {
	s := "a"
	ys := h.group(ctx, 1).map(x => {
		s = "b"
		return x
	})
	println(s)
	return len(ys)
}
