// errorcheck

package p

import (
	"context"
	"time"
)

func work() {}

func bare(ctx context.Context) error {
	go work() // ERROR "unsupervised_goroutine"
	return nil
}

func bareLiteral(ctx context.Context) error {
	go func() { // ERROR "unsupervised_goroutine"
		work()
	}()
	return nil
}

func supervised(ctx context.Context) error {
	go group (ctx) {
		go {
			work()
		}
	}
	return nil
}

func supervisedCall(ctx context.Context) error {
	go group (ctx) {
		go work()
	}
	return nil
}

func afterFuncUnowned(ctx context.Context) error {
	ctx, cancel := context.WithCancel(ctx)
	cancel()
	context.AfterFunc(ctx, work)
	return nil
}

func timerUnowned(ctx context.Context) error {
	time.AfterFunc(time.Second, work)
	return nil
}
