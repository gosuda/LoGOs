// errorcheck

package p

import "context"

func work() {}

func bare(ctx context.Context) error {
	go work() // ERROR "unsupervised_goroutine"
	return nil
}

func bareLiteral(ctx context.Context) error {
	go func() { // ERROR "unsupervised_goroutine"
		work()
	}()
	return nil
}

func supervised(ctx context.Context) error {
	go group (ctx) {
		go {
			work()
		}
	}
	return nil
}

func supervisedCall(ctx context.Context) error {
	go group (ctx) {
		go work()
	}
	return nil
}
