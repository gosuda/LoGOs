func segmentMapRelock(ctx context.Context, xs []int) {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		_, err := xs.group(ctx, limit = 2).map(x => {
			l.WithLock(func(m *int) { *m++ }) // ERROR "reentrant_withlock_deadlock"
			return x
		})
		println(err == nil)
	})
}

func segmentUnorderedFilterRelock(ctx context.Context, xs []int) {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		_, err := xs.group(ctx, limit = 2).unordered().filter(x => {
			l.WithLock(func(m *int) { *m++ }) // ERROR "reentrant_withlock_deadlock"
			return x > 0
		})
		println(err == nil)
	})
}

