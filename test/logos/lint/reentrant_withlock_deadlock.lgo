func sink(v int) {
}

func sinkFunc(f func()) {
}

func lockAndReturn() int {
	global.WithLock(func(n *int) { *n++ })
	return 0
}

func spawnLockGlobal(ctx context.Context) error {
	go group (ctx) {
		go lockGlobal()
	}
	return nil
}

func passGoSpawnedCall(ctx context.Context) {
	global.WithLock(func(n *int) {
		err := spawnLockGlobal(ctx)
		if err != nil {
			panic(err)
		}
	})
}

func spawnDirectLock(ctx context.Context, l *sync.Locked[int]) error {
	go group (ctx) {
		go l.WithLock(func(m *int) { *m++ })
	}
	return nil
}

func passGoSpawnedDirectLock(ctx context.Context) {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		err := spawnDirectLock(ctx, &l)
		if err != nil {
			panic(err)
		}
	})
}

func spawnLiteralLock(ctx context.Context, l *sync.Locked[int]) error {
	go group (ctx) {
		go func() {
			l.WithLock(func(m *int) { *m++ })
		}()
	}
	return nil
}

func passGoSpawnedLiteral(ctx context.Context) {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		err := spawnLiteralLock(ctx, &l)
