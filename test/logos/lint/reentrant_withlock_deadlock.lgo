func segmentRangeHelper(ctx context.Context, l *sync.Locked[int], xs []int) error {
	for y := range xs.group(ctx, limit = 2).map(x => {
		l.WithLock(func(m *int) { *m++ })
		return x
	}) {
		println(y)
	}
	return nil
}

func segmentRangeRelock(ctx context.Context, xs []int) {
