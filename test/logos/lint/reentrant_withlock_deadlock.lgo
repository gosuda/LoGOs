type Node struct {
	mu   sync.Locked[int]
	next *Node?
}

func (n *Node) walk() {
	next := n.next
	if next == nil {
		return
	}
	next.walk()
	next.mu.WithLock(func(k *int) { *k++ })
}

func passRecursiveWalkTerminates() {
	n := &Node{next: &Node{}}
	n.mu.WithLock(func(k *int) {
		n.walk()
	})
}

func relockGlobal(n *int) {
