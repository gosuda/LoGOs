// errorcheck -0

package p

import "strings"

func bump(x int) int { return 2 * x }

func keyOf(x int) int { return -x }

func upper(s string) string { return strings.ToUpper(s) }

func nearest(xs []int) {
	_ = xs.map(x => bump(x)).sortBy(x => x) // ERROR "\[suspicious::side_effect_before_sort\] chain lambda with a call of unknown purity before sortBy"
}

func oneBefore(xs []int) {
	_ = xs.map(x => bump(x)).filter(x => x > 0).sortBy(x => x) // ERROR "\[suspicious::side_effect_before_sort\] chain lambda with a call of unknown purity before sortBy"
}

func twoBefore(xs []int) {
	_ = xs.map(x => bump(x)).filter(x => x > 0).take(3).sortBy(x => x) // ERROR "\[suspicious::side_effect_before_sort\] chain lambda with a call of unknown purity before sortBy"
}

func inFilter(xs []int) {
	_ = xs.filter(x => bump(x) > 0).sortBy(x => x) // ERROR "\[suspicious::side_effect_before_sort\] chain lambda with a call of unknown purity before sortBy"
}

func blockLambda(xs []int, m map[string]int) {
	_ = xs.map(x => {
		delete(m, "k")
		return x
	}).sortBy(x => x) // ERROR "\[suspicious::side_effect_before_sort\] chain lambda with a call of unknown purity before sortBy"
}

func methodCall(ws []string) {
	_ = ws.map(w => strings.ToUpper(w)).sortBy(w => w) // ERROR "\[suspicious::side_effect_before_sort\] chain lambda with a call of unknown purity before sortBy"
	_ = ws.map(w => upper(w)).sortBy(w => w) // ERROR "\[suspicious::side_effect_before_sort\] chain lambda with a call of unknown purity before sortBy"
}

func onePerSortBy(xs []int) {
	_ = xs.map(x => bump(x)).filter(x => bump(x) > 0).sortBy(x => x) // ERROR "\[suspicious::side_effect_before_sort\] chain lambda with a call of unknown purity before sortBy"
}

func pureArithmetic(xs []int) {
	_ = xs.map(x => x * 2).sortBy(x => x)
	_ = xs.filter(x => x > 0).sortBy(x => x)
	_ = xs.sortBy(x => x)
}

func pureConversion(xs []int) {
	_ = xs.map(x => int(float64(x))).sortBy(x => x)
	_ = xs.map(x => int(int64(x) + 1)).sortBy(x => x)
}

func pureBuiltin(xs []int) {
	_ = xs.map(x => len("ab") + x).sortBy(x => x)
	_ = xs.map(x => min(x, 3)).sortBy(x => x)
	_ = xs.filter(x => cap(xs) > x).sortBy(x => x)
}

func keyLambdaCall(xs []int) {
	_ = xs.sortBy(x => keyOf(x))
	_ = xs.map(x => x + 1).sortBy(x => keyOf(x))
}

func receiverBase(xs func() []int) {
	_ = xs().map(x => x + 1).sortBy(x => x)
}

func afterSort(xs []int) {
	_ = xs.map(x => x + 1).sortBy(x => x).map(x => bump(x))
}

func nestedLiteral(xs []int) {
	_ = xs.map(x => {
		later := func() int { return bump(x) }
		_ = later
		return x
	}).sortBy(x => x)
}

func noSort(xs []int) {
	_ = xs.map(x => bump(x)).filter(x => bump(x) > 0)
}
