// errorcheck

package p

import (
	"bytes"
	"crypto/sha256"
	"fmt"
	"io"
	"os"
	"strings"
)

// M9-S2 slop::discarded_error (SPEC Sec 1.2, #164): an expression statement
// or `_ =` that drops an `error` result. Callees with an AlwaysNilError
// fact, fmt.Print*, fmt.Fprint* to os.Stdout or os.Stderr, the Write*
// methods of *bytes.Buffer and *strings.Builder, Write on a receiver that
// implements hash.Hash, and fmt.Fprint* and io.WriteString directed at a
// *bytes.Buffer or *strings.Builder are exempt. The rule is deny, so
// the findings below fail the lint run.

func f() error        { return nil }
func g() (int, error) { return 0, nil }

func dropped() {
	f()         // ERROR "discarded_error"
	g()         // ERROR "discarded_error"
	_ = f()     // ERROR "discarded_error"
	_, _ = g()  // ERROR "discarded_error"
	n, _ := g() // ERROR "discarded_error"
	_ = n
	h := func() error { return f() }
	h()       // ERROR "discarded_error"
	_ = (f()) // ERROR "discarded_error"
}

func printed() {
	fmt.Print("x")
	fmt.Printf("%d", 1)
	fmt.Println("x")
	fmt.Fprintf(os.Stderr, "x")
	fmt.Fprintln(os.Stdout, "x")
}

func written() {
	var b bytes.Buffer
	b.WriteString("x")
	b.WriteByte('x')
	var sb strings.Builder
	sb.WriteString("x")
	sb.WriteByte('x')
}

func printedToBuffer() {
	var b bytes.Buffer
	fmt.Fprintf(&b, "x")
	var sb strings.Builder
	fmt.Fprintf(&sb, "x")
}

func hashWriteInfallible(data []byte) [32]byte {
	h := sha256.New()
	h.Write(data)
	s := h.Sum(nil)
	var out [32]byte
	copy(out[:], s)
	return out
}

func fprintfToBuffer() string {
	var buf bytes.Buffer
	fmt.Fprintf(&buf, "n=%d", 42)
	return buf.String()
}

func writeStringToBuilder(s string) string {
	var b strings.Builder
	io.WriteString(&b, s)
	return b.String()
}

func handled() {
	err := f()
	_ = err
	defer f()
	m, err := g()
	_, _ = m, err
}

func inErrorFunc() error {
	f() // ERROR "discarded_error"
	return nil
}

//logos:allow(slop::discarded_error)
func allowed() {
	f()
}
