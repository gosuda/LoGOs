// errorcheck

package p

import (
	"context"
	"sync/atomic"
)

type counter struct {
	total int64
	small int32

	//logos:atomic
	hits int64

	//logos:atomic
	drops uint64
}

func passthrough(*int64) {}

func loadOK(c *counter) int64 {
	return atomic.LoadInt64(&c.hits)
}

func addOK(c *counter) {
	atomic.AddUint64(&c.drops, 1)
}

func smallOK(c *counter) int32 {
	return atomic.LoadInt32(&c.small)
}

func badRead(c *counter) int64 {
	return c.hits // ERROR "\[concurrency::nonatomic_access\]"
}

func badWrite(c *counter) {
	c.hits = 1 // ERROR "\[concurrency::nonatomic_access\]"
}

func badInc(c *counter) {
	c.hits++ // ERROR "\[concurrency::nonatomic_access\]"
}

func badSwap(c *counter) uint64 {
	return atomic.SwapUint64(&c.drops, 2) + c.drops // ERROR "\[concurrency::nonatomic_access\]"
}

func badLeak(c *counter) {
	passthrough(&c.hits) // ERROR "\[concurrency::nonatomic_access\]"
}

//logos:atomic
var gtotal int64

func badGlobal() {
	gtotal = 5 // ERROR "\[concurrency::nonatomic_access\]"
}

func okGlobal() {
	atomic.StoreInt64(&gtotal, 5)
}

func use(n int64) error { return nil }

func childReadsPlain(ctx context.Context, c *counter) error {
	go group (ctx) {
		go {
			_ = c.hits // ERROR "\[concurrency::nonatomic_access\]"
		}
	}
	return nil
}

func childWritesPlain(ctx context.Context, c *counter) error {
	go group (ctx) {
		go {
			c.hits++ // ERROR "\[concurrency::nonatomic_access\]"
		}
	}
	return nil
}

func childAtomicOK(ctx context.Context, c *counter) error {
	go group (ctx) {
		go {
			atomic.AddInt64(&c.hits, 1)
		}
	}
	return nil
}

func groupBodyPlain(ctx context.Context, c *counter) error {
	go group (ctx) {
		c.hits = 1 // ERROR "\[concurrency::nonatomic_access\]"
	}
	return nil
}

func callFormArgumentPlain(ctx context.Context, c *counter) error {
	go group (ctx) {
		go use(c.hits) // ERROR "\[concurrency::nonatomic_access\]"
	}
	return nil
}

func callFormArgumentAtomic(ctx context.Context, c *counter) error {
	go group (ctx) {
		go use(atomic.LoadInt64(&c.hits))
	}
	return nil
}

func literalCallBodyPlain(ctx context.Context, c *counter) error {
	go group (ctx) {
		go func(n int64) error {
			c.hits = n // ERROR "\[concurrency::nonatomic_access\]"
			return nil
		}(atomic.LoadInt64(&c.hits))
	}
	return nil
}

func nestedGroupChildPlain(ctx context.Context, c *counter) error {
	go group (ctx) {
		go {
			go group (ctx) {
				go {
					c.hits++ // ERROR "\[concurrency::nonatomic_access\]"
				}
			}
		}
	}
	return nil
}
