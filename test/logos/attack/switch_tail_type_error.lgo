// errorcheck

package p

import "comptime"

func Pick[T any]() string {
	const switch T {
	case int:
		return "int"
	}
var s struct{ X int }
_ = s.NoSuch // ERROR "NoSuch"
comptime.Error("unsupported")
return ""
}

// For Pick[int] the trailing Error is silent (unreachable after the
// terminating case), but the tail is still type-checked, so NoSuch fires.
var _ = Pick[int]()
