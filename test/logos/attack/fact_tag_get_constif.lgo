// run

package main

import (
	"comptime"
	"fmt"
)

func Names[T any]() []string {
	var out []string
	const for _, f := range comptime.Fields[T]() {
		const if f.Tag.Get("json") != "-" {
			out = append(out, f.Name)
		}
	}
	return out
}

type Row struct {
	A int `json:"a"`
	B int `json:"-"`
}

func main() {
	fmt.Println(Names[Row]())
}
