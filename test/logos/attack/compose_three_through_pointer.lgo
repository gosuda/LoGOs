// run

package main

import (
	"comptime"
	"fmt"
	"unsafe"
)

func Width[T any]() int {
	const if comptime.IsStruct[T]() {
		return comptime.SizeOf[T]()
	}
	return comptime.SizeOf[T]()
}

func Mid[T any]() int { return Width[*T]() }

func Outer[T any]() int { return Mid[T]() }

type Triple struct {
	A int
	B int
	C int
}

func main() {
	p := &Triple{A: 1, B: 2, C: 3}
	fmt.Println(Outer[Triple]() == int(unsafe.Sizeof(p)))
}
