// run

package main

func scoreFor[T any](choice int) int {
	score := 10
	switch choice {
	case 0:
		const switch T {
		case int:
			return score + 7
		case string:
			score += 3
		}; (func() { score *= 2 })()
		var (
			bonus = 5
		)
		score += bonus
		break; case 1: score += 11
	}
	return score
}

func main() {
	if scoreFor[int](0) != 17 {
		panic("selected return did not skip the remainder of case 0")
	}
	if scoreFor[string](0) != 31 {
		panic("non-returning branch did not run the remainder of case 0")
	}
	if scoreFor[int](1) != 21 {
		panic("pruning case 0 removed its neighboring case")
	}
}
