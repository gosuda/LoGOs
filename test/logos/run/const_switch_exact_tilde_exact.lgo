// run

package main

import (
	"fmt"
	"os"
)

// run opens, so scope positions stay monotonic. The exact bodies use the

type SwitchScalar interface {
	~float32 | float64
}

type SwitchKilos float32

func switchKind[T SwitchScalar](v T) string {
	const switch T {
	case float32:
		return "exact-f32 " + fmt.Sprint(v+v)
	case ~float32:
		return "tilde-f32"
	case float64:
		return "exact-f64 " + fmt.Sprint(v+v)
	}
	return "other"
}

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func main() {
	gotF64 := switchKind(float64(3.75)) + " " + switchKind(float64(7.5))
	check("f64", gotF64 == "exact-f64 7.5 exact-f64 15", gotF64, "exact-f64 7.5 exact-f64 15")
	gotF32 := switchKind(float32(7.5)) + " " + switchKind(float32(2.0))
	check("f32", gotF32 == "exact-f32 15 exact-f32 4", gotF32, "exact-f32 15 exact-f32 4")
	check("kilos", switchKind(SwitchKilos(1.5)) == "tilde-f32", switchKind(SwitchKilos(1.5)), "tilde-f32")
	if failed {
		os.Exit(1)
	}
}
