// run

package main

import "fmt"

// run opens, so scope positions stay monotonic. The exact bodies use the

type SwitchScalar interface {
	~float32 | float64
}

type SwitchKilos float32

func switchKind[T SwitchScalar](v T) string {
	const switch T {
	case float32:
		return "exact-f32 " + fmt.Sprint(v+v)
	case ~float32:
		return "tilde-f32"
	case float64:
		return "exact-f64 " + fmt.Sprint(v+v)
	}
	return "other"
}

func main() {
	fmt.Println(switchKind(float64(3.75)), switchKind(float64(7.5)))
	fmt.Println(switchKind(float32(7.5)), switchKind(float32(2.0)))
	fmt.Println(switchKind(SwitchKilos(1.5)))
}
