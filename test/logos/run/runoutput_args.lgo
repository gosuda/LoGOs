// runoutput hello world

package main

import (
	"fmt"
	"os"
	"strings"
)

func main() {
	args := strings.Join(os.Args[1:], ",")
	fmt.Println("package main")
	fmt.Println(`import ("fmt"; "os")`)
	fmt.Printf("func main() {\n\tif got, want := %q, \"hello,world\"; got != want {\n", args)
	fmt.Println("\t\tfmt.Printf(\"FAIL runoutput-args: got %s want %s\\n\", got, want)")
	fmt.Println("\t\tos.Exit(1)\n\t}")
	fmt.Println("\tfmt.Println(\"ok runoutput-args\")\n}")
}
