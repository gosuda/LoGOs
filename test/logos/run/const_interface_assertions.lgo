// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Qualified interface {
	const Name() string
}

type QPlus interface {
	const Name() string
	Extra() int
}

type Good struct {
	name  string
	extra int
}

func (g Good) Name() string { return g.name }
func (g Good) Extra() int   { return g.extra }

type Small struct {
	name string
}

func (s Small) Name() string { return s.name }

func ViaConcrete(v any) string {
	g := v.(Good)
	var q Qualified = g
	return q.Name()
}

func Narrow(q QPlus) Qualified {
	return q.(Qualified)
}

func DescribeQualified(q Qualified) string {
	switch x := q.(type) {
	case QPlus:
		return "plus:" + x.Name()
	case Qualified:
		return "qualified:" + x.Name()
	default:
		return "other"
	}
}

func DescribePlus(q QPlus) string {
	switch x := q.(type) {
	case Good:
		return "good:" + x.Name()
	case Qualified:
		return "qualified:" + x.Name()
	default:
		return "other"
	}
}

func main() {
	var v any = Good{name: "a", extra: 7}
	check("concrete", ViaConcrete(v) == "a", ViaConcrete(v), "a")
	var qp QPlus = Good{name: "b", extra: 3}
	check("narrow", Narrow(qp).Name() == "b", Narrow(qp).Name(), "b")

	var qw Qualified = Good{name: "c", extra: 9}
	name, extra := "", 0
	if g, ok2 := qw.(QPlus); ok2 {
		name, extra = g.Name(), g.Extra()
	}
	check("assert-values", name == "c" && extra == 9, fmt.Sprint(name, " ", extra), "c 9")

	var qs Qualified = Small{name: "s"}
	_, okMiss := qs.(QPlus)
	check("assert-miss", !okMiss, okMiss, false)

	check("qualified-plus", DescribeQualified(qp) == "plus:b", DescribeQualified(qp), "plus:b")
	check("qualified-small", DescribeQualified(qs) == "qualified:s", DescribeQualified(qs), "qualified:s")
	check("plus-good", DescribePlus(qp) == "good:b", DescribePlus(qp), "good:b")
	if failed {
		os.Exit(1)
	}
}
