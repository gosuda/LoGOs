// run
package main

import (
	"fmt"
	"os"
)

func scrub(s []byte) {
	clear(s)
}

func main() {
	s := []byte{1, 2, 3, 4, 5, 6, 7, 8}
	scrub(s)
	bad := 0
	for _, v := range s {
		if v != 0 {
			bad++
		}
	}
	if bad != 0 {
		fmt.Printf("FAIL clear-zeroes-every-byte: got %d nonzero want 0\n", bad)
		os.Exit(1)
	}
	fmt.Println("ok clear-zeroes-every-byte")
}
