// run

package main

import (
	"bytes"
	"fmt"
	"io"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type UserID int

func tildeThenAny[T any](v T) string {
	_ = v
	const switch T {
	case ~int:
		return "tilde"
	case any:
		return "any"
	}
	return "none"
}

func ifaceThenExact[T any](v T) string {
	_ = v
	const switch T {
	case io.Reader:
		return "reader"
	case string:
		return "string"
	case any:
		return "any"
	}
	return "none"
}

func mixed[T any](v T) string {
	_ = v
	const switch T {
	case ~int:
		return "tilde-int"
	case string:
		return "string"
	case io.Writer:
		return "writer"
	case float64:
		return "float"
	}
	return "other"
}

func trail[T any](v T) string {
	_ = v
	out := ""
	const switch T {
	case ~int:
		out += "tilde;"
	case string:
		out += "string;"
	case any:
		out += "any;"
	}
	return out + "end"
}

func nested[T any](v T) string {
	_ = v
	out := ""
	const switch T {
	case ~int:
		const switch T {
		case int:
			out += "int;"
		case ~int:
			out += "tilde;"
		}
	case string:
		out += "string;"
	}
	return out + "end"
}

func looped[T any](items []T) string {
	out := ""
	for range items {
		const switch T {
		case ~int:
			out += "i"
		case string:
			out += "s"
		}
	}
	return out + "."
}

func main() {
	gotTilde := tildeThenAny(3) + " " + tildeThenAny(UserID(3)) + " " + tildeThenAny("s")
	check("tilde-any", gotTilde == "tilde tilde any", gotTilde, "tilde tilde any")
	gotIface := ifaceThenExact("s") + " " + ifaceThenExact(&bytes.Buffer{}) + " " + ifaceThenExact(1)
	check("iface-exact", gotIface == "string reader any", gotIface, "string reader any")
	gotMixed := mixed(3) + " " + mixed(UserID(4)) + " " + mixed("s") + " " + mixed(&bytes.Buffer{}) + " " + mixed(1.5) + " " + mixed(true)
	check("mixed", gotMixed == "tilde-int tilde-int string writer float other", gotMixed, "tilde-int tilde-int string writer float other")
	gotTrail := trail(3) + " " + trail("s") + " " + trail(1.5)
	check("trail", gotTrail == "tilde;end string;end any;end", gotTrail, "tilde;end string;end any;end")
	gotNested := nested(3) + " " + nested(UserID(1)) + " " + nested("s") + " " + nested(1.5)
	check("nested", gotNested == "int;end tilde;end string;end end", gotNested, "int;end tilde;end string;end end")
	gotLooped := looped([]int{1, 2}) + " " + looped([]string{"a"}) + " " + looped([]float64{1})
	check("looped", gotLooped == "ii. s. .", gotLooped, "ii. s. .")
	if failed {
		os.Exit(1)
	}
}
