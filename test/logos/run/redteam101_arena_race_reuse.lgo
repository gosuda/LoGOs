// run -goexperiment logosarena -race
// run -goexperiment logosarena -arena=false -race

package main

// run the gate with CGO_ENABLED=1. Companion gate: GOEXPERIMENT=logosarena

import (
	"fmt"
	"os"
)

type r101Node struct{ v int }

//go:noinline
func r101Sum(b []byte) int {
	s := 0
	for _, v := range b {
		s += int(v)
	}
	return s
}

//go:noinline
func r101Oracle(n, r int) int {
	s := 0
	for i := 0; i < n; i++ {
		s += int(byte((i*7 + r) & 0xFF))
	}
	return s
}

//go:noinline
func r101PtrSum(s []*r101Node) int {
	total := 0
	for _, p := range s {
		total += p.v
	}
	return total
}

//go:noinline
func r101PtrOracle(n, r int) int {
	total := 0
	for i := 0; i < n; i++ {
		total += r*100 + i
	}
	return total
}

var r101Failed bool

func r101Check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		r101Failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func r101Work() {
	var first [512]byte
	noscanTotal := 0
	noscanWant := 0
	ptrTotal := 0
	ptrWant := 0
	for r := 0; r < 60; r++ {
		b := make([]byte, 512)
		for i := range b {
			b[i] = byte((i*7 + r) & 0xFF)
		}
		got := r101Sum(b)
		want := r101Oracle(512, r)
		noscanTotal += got
		noscanWant += want
		if got != want {
			r101Check("arena-race-noscan-round", false, fmt.Sprint(got), fmt.Sprint(want))
			return
		}
		s := make([]*r101Node, 0, 32)
		for i := 0; i < 32; i++ {
			s = append(s, &r101Node{v: r*100 + i})
		}
		pgot := r101PtrSum(s)
		pwant := r101PtrOracle(32, r)
		ptrTotal += pgot
		ptrWant += pwant
		if pgot != pwant {
			r101Check("arena-race-scan-round", false, fmt.Sprint(pgot), fmt.Sprint(pwant))
			return
		}
		if r == 0 {
			copy(first[:], b)
		}
	}
	r101Check("arena-race-noscan-total", noscanTotal == noscanWant, fmt.Sprint(noscanTotal), fmt.Sprint(noscanWant))
	r101Check("arena-race-scan-total", ptrTotal == ptrWant, fmt.Sprint(ptrTotal), fmt.Sprint(ptrWant))
	r101Check("arena-race-first-snapshot", r101Sum(first[:]) == r101Oracle(512, 0), fmt.Sprint(r101Sum(first[:])), fmt.Sprint(r101Oracle(512, 0)))
}

func main() {
	r101Work()
	if r101Failed {
		os.Exit(1)
	}
	r101Check("arena-race-reuse", true, "reused", "reused")
	if r101Failed {
		os.Exit(1)
	}
}
