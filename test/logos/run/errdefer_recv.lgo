// run

package main

import (
	"errors"
	"fmt"
	"os"
	"strings"
)

var errRecv = errors.New("recv")

var log []string

type box struct{ tag string }

func (b box) Close() error {
	log = append(log, "close: "+b.tag)
	return nil
}

func (b box) Rollback() error {
	log = append(log, "rollback: "+b.tag)
	return nil
}

func check(s string) error {
	log = append(log, "check: "+s)
	return nil
}

func recvDefer() (err error) {
	b := box{tag: "old"}
	defer b.Close()?
	b.tag = "new"
	return nil
}

func recvErrdefer() (err error) {
	b := box{tag: "old"}
	errdefer b.Rollback()
	b.tag = "new"
	return errRecv
}

func argDefer() (err error) {
	v := "old"
	defer check(v)?
	v = "new"
	return nil
}

func firstFn() error {
	log = append(log, "call: first")
	return nil
}

func secondFn() error {
	log = append(log, "call: second")
	return errRecv
}

var fnVar = firstFn

func rebindDefer() (err error) {
	defer fnVar()?
	fnVar = secondFn
	return nil
}

func main() {
	if err := recvDefer(); err != nil {
		log = append(log, "fatal: "+err.Error())
	}
	if err := argDefer(); err != nil {
		log = append(log, "fatal: "+err.Error())
	}
	fnVar = firstFn
	if err := rebindDefer(); err != nil {
		log = append(log, "fatal: "+err.Error())
	}
	if err := recvErrdefer(); err != nil {
		log = append(log, "err: "+err.Error())
	}
	want := "close: old\ncheck: old\ncall: first\nrollback: old\nerr: recv"
	if strings.Join(log, "\n") != want {
		fmt.Println("errdefer recv: FAIL")
		os.Exit(1)
	}
	fmt.Println("errdefer recv: PASS")
}
