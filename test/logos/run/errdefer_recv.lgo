// run

package main

import (
	"errors"
	"fmt"
	"os"
	"strings"
)

var errRecv = errors.New("recv")

var log []string

var bad bool

func check(tag string, cond bool, got, want string) {
	if !cond {
		fmt.Println("FAIL "+tag+": got "+got+" want "+want)
		bad = true
		return
	}
	fmt.Println("ok", tag)
}

type box struct{ tag string }

func (b box) Close() error {
	log = append(log, "close: "+b.tag)
	return nil
}

func (b box) Rollback() error {
	log = append(log, "rollback: "+b.tag)
	return nil
}

func markCheck(s string) error {
	log = append(log, "check: "+s)
	return nil
}

func recvDefer() (err error) {
	b := box{tag: "old"}
	defer b.Close()?
	b.tag = "new"
	return nil
}

func recvErrdefer() (err error) {
	b := box{tag: "old"}
	errdefer b.Rollback()
	b.tag = "new"
	return errRecv
}

func argDefer() (err error) {
	v := "old"
	defer markCheck(v)?
	v = "new"
	return nil
}

func firstFn() error {
	log = append(log, "call: first")
	return nil
}

func secondFn() error {
	log = append(log, "call: second")
	return errRecv
}

var fnVar = firstFn

func rebindDefer() (err error) {
	defer fnVar()?
	fnVar = secondFn
	return nil
}

func main() {
	if err := recvDefer(); err != nil {
		log = append(log, "fatal: "+err.Error())
	}
	if err := argDefer(); err != nil {
		log = append(log, "fatal: "+err.Error())
	}
	fnVar = firstFn
	if err := rebindDefer(); err != nil {
		log = append(log, "fatal: "+err.Error())
	}
	if err := recvErrdefer(); err != nil {
		log = append(log, "err: "+err.Error())
	}
	check("errdefer-recv-defer-captures-at-statement", len(log) >= 2 && log[0] == "close: old" && log[1] == "check: old", strings.Join(log, ","), "close: old,check: old")
	check("errdefer-recv-defer-keeps-first-bound-func", len(log) >= 3 && log[2] == "call: first", strings.Join(log, ","), "call: first at 2")
	check("errdefer-recv-errdefer-runs-on-error", len(log) == 5 && log[3] == "rollback: old" && log[4] == "err: recv", strings.Join(log, ","), "rollback: old,err: recv")
	if bad {
		os.Exit(1)
	}
}
