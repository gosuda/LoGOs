// run

package main

import "fmt"

type U interface {
	int | string
}
type Empty struct{}
type ZU interface {
	Empty | int
}
func showZ(a any) string {
	if _, ok := a.(ZU); ok {
		return "zok"
	}
	return "znot"
}
func whichZ(a any) string {
	switch v := a.(type) {
	case ZU:
		var _ ZU = v
		return "Z"
	case nil:
		return "nil"
	default:
		return "other"
	}
}

func show(a any) string {
	if _, ok := a.(U); ok {
		return "ok"
	}
	return "not ok"
}

func mustPan(a any) (s string) {
	defer func() {
		if r := recover(); r != nil {
			s = fmt.Sprint(r)
		}
	}()
	_ = a.(U)
	return "no panic"
}

func which(a any) string {
	switch v := a.(type) {
	case U:
		var _ U = v
		return "U"
	case nil:
		return "nil"
	default:
		return "other"
	}
}

func shadow(a any) string {
	switch a.(type) {
	case int, string:
		return "m"
	case U:
		return "shadowed"
	default:
		return "other"
	}
}

func main() {
	var a any = 1.5
	fmt.Println(show(a))
	fmt.Println(mustPan(a))
	fmt.Println(which(a))
	var b any = 1
	fmt.Println(show(b))
	fmt.Println(which(b))
	var z any
	fmt.Println(which(z))
	fmt.Println(shadow(a))
	fmt.Println(shadow(b))
	var ze any = Empty{}
	fmt.Println(showZ(ze))
	fmt.Println(whichZ(ze))
	var zi any = 7
	fmt.Println(showZ(zi))
	fmt.Println(whichZ(zi))
	var zn any
	fmt.Println(whichZ(zn))
}
