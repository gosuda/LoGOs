// run

package main

import (
	"fmt"
	"os"
	"strings"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type U interface {
	int | string
}
type Empty struct{}
type ZU interface {
	Empty | int
}
func showZ(a any) string {
	if _, ok := a.(ZU); ok {
		return "zok"
	}
	return "znot"
}
func whichZ(a any) string {
	switch v := a.(type) {
	case ZU:
		var _ ZU = v
		return "Z"
	case nil:
		return "nil"
	default:
		return "other"
	}
}

func show(a any) string {
	if _, ok := a.(U); ok {
		return "ok"
	}
	return "not ok"
}

func mustPan(a any) (s string) {
	defer func() {
		if r := recover(); r != nil {
			s = fmt.Sprint(r)
		}
	}()
	_ = a.(U)
	return "no panic"
}

func which(a any) string {
	switch v := a.(type) {
	case U:
		var _ U = v
		return "U"
	case nil:
		return "nil"
	default:
		return "other"
	}
}

func shadow(a any) string {
	switch a.(type) {
	case int, string:
		return "m"
	case U:
		return "shadowed"
	default:
		return "other"
	}
}

func main() {
	var a any = 1.5
	check("non-member-assertion-reports-not-ok", show(a) == "not ok", show(a), "not ok")
	r := mustPan(a)
	check("failed-assertion-panics-naming-union", r != "no panic" && strings.Contains(r, "main.U"), r, "panic naming main.U")
	check("non-member-switch-falls-to-other", which(a) == "other", which(a), "other")
	var b any = 1
	check("member-assertion-reports-ok", show(b) == "ok", show(b), "ok")
	check("member-switch-selects-union", which(b) == "U", which(b), "U")
	var z any
	check("nil-switch-selects-nil", which(z) == "nil", which(z), "nil")
	check("concrete-case-shadows-union", shadow(a) == "other" && shadow(b) == "m", shadow(a)+"/"+shadow(b), "other/m")
	var ze any = Empty{}
	check("empty-struct-asserts-empty-union", showZ(ze) == "zok", showZ(ze), "zok")
	check("empty-struct-switch-selects-union", whichZ(ze) == "Z", whichZ(ze), "Z")
	var zi any = 7
	check("int-asserts-empty-union", showZ(zi) == "zok", showZ(zi), "zok")
	check("int-switch-selects-empty-union", whichZ(zi) == "Z", whichZ(zi), "Z")
	var zn any
	check("nil-switch-selects-nil-empty-union", whichZ(zn) == "nil", whichZ(zn), "nil")
	if failed {
		os.Exit(1)
	}
}
