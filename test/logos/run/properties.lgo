// run

package main

import (
	"fmt"
	"reflect"
)


type Creature interface {
	const Name string
	HP int
	Start() error
}

type Monster struct : Creature {
	Name string
	HP   int
}

func (m Monster) Start() error { return nil }

type Plain struct {
	X int
}

func (p Plain) Foo() string { return "foo" }

type Named interface {
	const Title string
}

type Ghost struct : Named {
}

func (g Ghost) Title() string { return "boo" }
type PointerNamed interface {
	const Title string
}

type PointerGhost struct : PointerNamed {
}

func (*PointerGhost) Title() string { return "pointer" }

type Vault interface {
	Secret int
}

type Safe struct : Vault {
	hidden int
}

func (s Safe) Secret() int { return s.hidden }

func (s *Safe) SetSecret(v int) { s.hidden = v }

type Both interface {
	const V int
	V int
}

type HasBoth struct : Both {
	V int
}

func checkBothMerge() {
	mergedValue := reflect.TypeOf(HasBoth{})
	mergedPointer := reflect.TypeOf(&HasBoth{})
	requireAccessorMethod(mergedValue, "Logos_GetV")
	forbidAccessorMethod(mergedValue, "Logos_SetV")
	requireAccessorMethod(mergedPointer, "Logos_SetV")
}

type Vec struct {
	X int
	Y int
}

func (v *Vec) Normalize() {
	if v.X < 0 {
		v.X = -v.X
	}
}

func (v Vec) Len() int {
	if v.X < 0 {
		return -v.X
	}
	return v.X
}

type Carrier interface {
	Pos Vec
}

type Bot struct : Carrier {
	Pos Vec
}

type Base struct {
	HP int
}

type Child struct : Creature {
	Base
	Name string
}

func (c Child) Start() error { return nil }

var nextCalls int

func next() int {
	nextCalls++
	return 0
}

func two() (int, int) { return 3, 4 }
func requireAccessorMethod(t reflect.Type, name string) {
	if _, ok := t.MethodByName(name); !ok {
		panic(name)
	}
}

func forbidAccessorMethod(t reflect.Type, name string) {
	if _, ok := t.MethodByName(name); ok {
		panic(name)
	}
}

func checkPropertyAccessorReceivers() {
	monsterValue := reflect.TypeOf(Monster{})
	monsterPointer := reflect.TypeOf(&Monster{})
	ghostValue := reflect.TypeOf(Ghost{})
	pointerGhostValue := reflect.TypeOf(PointerGhost{})
	pointerGhostPointer := reflect.TypeOf(&PointerGhost{})
	safeValue := reflect.TypeOf(Safe{})
	safePointer := reflect.TypeOf(&Safe{})
	requireAccessorMethod(monsterValue, "Logos_GetName")
	forbidAccessorMethod(monsterValue, "Logos_SetHP")
	requireAccessorMethod(monsterPointer, "Logos_SetHP")
	requireAccessorMethod(ghostValue, "Logos_GetTitle")
	forbidAccessorMethod(pointerGhostValue, "Logos_GetTitle")
	requireAccessorMethod(pointerGhostPointer, "Logos_GetTitle")
	requireAccessorMethod(safeValue, "Logos_GetSecret")
	requireAccessorMethod(safePointer, "Logos_SetSecret")
	forbidAccessorMethod(safeValue, "Logos_SetSecret")
}
func main() {
	checkPropertyAccessorReceivers()
	checkBothMerge()
	var m Monster
	m.Name = "gorg"
	m.HP = 100
	var c Creature = &m
	fmt.Println(c.Name)
	c.HP -= 10
	fmt.Println(m.HP)

	party := []Creature{&m}
	party[next()].HP += 10
	fmt.Println(m.HP, nextCalls)

	var b Bot
	b.Pos = Vec{X: -3, Y: 4}
	var crr Carrier = &b
	crr.Pos.Normalize()
	fmt.Println(b.Pos.X)
	fmt.Println(crr.Pos.Len())

	var g Ghost
	var n Named = g
	fmt.Println(n.Title)

	var s Safe
	s.hidden = 7
	var v Vault = &s
	v.Secret += 5
	fmt.Println(s.hidden)

	var ch Child
	ch.Name = "kid"
	ch.HP = 50
	var c2 Creature = &ch
	c2.HP -= 5
	fmt.Println(ch.HP)
	c2.HP = 60
	fmt.Println(ch.HP)

	a := 0
	a, c.HP = two()
	fmt.Println(a, m.HP)
	k := crr.Pos.Len()
	fmt.Println(k)
	var h HasBoth
	var both Both = &h
	both.V = 41
	both.V += 1
	fmt.Println(h.V)

	fmt.Println(reflect.TypeOf(Plain{}).NumMethod())
	fmt.Println(reflect.TypeOf(Monster{}).NumMethod())
	fmt.Println(reflect.TypeOf(&Monster{}).NumMethod())
}
