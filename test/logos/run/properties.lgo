// run

package main

import (
	"fmt"
	"os"
	"reflect"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func hasMethod(t reflect.Type, name string) bool {
	_, ok := t.MethodByName(name)
	return ok
}

type Creature interface {
	const Name string
	HP int
	Start() error
}

type Monster struct : Creature {
	Name string
	HP   int
}

func (m Monster) Start() error { return nil }

type Plain struct {
	X int
}

func (p Plain) Foo() string { return "foo" }

type Named interface {
	const Title string
}

type Ghost struct : Named {
}

func (g Ghost) Title() string { return "boo" }
type PointerNamed interface {
	const Title string
}

type PointerGhost struct : PointerNamed {
}

func (*PointerGhost) Title() string { return "pointer" }

type Vault interface {
	Secret int
}

type Safe struct : Vault {
	hidden int
}

func (s Safe) Secret() int { return s.hidden }

func (s *Safe) SetSecret(v int) { s.hidden = v }

type Both interface {
	const V int
	V int
}

type HasBoth struct : Both {
	V int
}

func checkBothMerge() {
	mergedValue := reflect.TypeOf(HasBoth{})
	mergedPointer := reflect.TypeOf(&HasBoth{})
	check("merged-const-getter-on-value", hasMethod(mergedValue, "Logos_GetV"), hasMethod(mergedValue, "Logos_GetV"), true)
	check("merged-const-hides-setter-on-value", !hasMethod(mergedValue, "Logos_SetV"), hasMethod(mergedValue, "Logos_SetV"), false)
	check("merged-setter-on-pointer", hasMethod(mergedPointer, "Logos_SetV"), hasMethod(mergedPointer, "Logos_SetV"), true)
}

type Vec struct {
	X int
	Y int
}

func (v *Vec) Normalize() {
	if v.X < 0 {
		v.X = -v.X
	}
}

func (v Vec) Len() int {
	if v.X < 0 {
		return -v.X
	}
	return v.X
}

type Carrier interface {
	Pos Vec
}

type Bot struct : Carrier {
	Pos Vec
}

type Base struct {
	HP int
}

type Child struct : Creature {
	Base
	Name string
}

func (c Child) Start() error { return nil }

type Rogue struct {
	Name string
	HP   int
}

func (r Rogue) Foo() string { return "foo" }

type ShallowBase struct {
	HP int
}

type ShallowOuter struct : Creature {
	ShallowBase
	HP   int
	Name string
}

func (s ShallowOuter) Start() error { return nil }

type DeepInner struct {
	HP int
}

type DeepMid struct {
	DeepInner
	HP int
}

type DeepOuter struct : Creature {
	DeepMid
	Name string
}

func (d DeepOuter) Start() error { return nil }

func checkUndeclaredAndDepth() {
	rogueValue := reflect.TypeOf(Rogue{})
	roguePointer := reflect.TypeOf(&Rogue{})
	check("unrelated-value-gains-no-accessors", rogueValue.NumMethod() == reflect.TypeOf(Plain{}).NumMethod(), rogueValue.NumMethod(), reflect.TypeOf(Plain{}).NumMethod())
	check("unrelated-pointer-gains-no-accessors", roguePointer.NumMethod() == reflect.TypeOf(&Plain{}).NumMethod(), roguePointer.NumMethod(), reflect.TypeOf(&Plain{}).NumMethod())
	check("unrelated-value-hides-getter", !hasMethod(rogueValue, "Logos_GetName"), hasMethod(rogueValue, "Logos_GetName"), false)
	check("unrelated-value-hides-hp-getter", !hasMethod(rogueValue, "Logos_GetHP"), hasMethod(rogueValue, "Logos_GetHP"), false)
	check("unrelated-pointer-hides-getter", !hasMethod(roguePointer, "Logos_GetName"), hasMethod(roguePointer, "Logos_GetName"), false)
	check("unrelated-pointer-hides-setter", !hasMethod(roguePointer, "Logos_SetHP"), hasMethod(roguePointer, "Logos_SetHP"), false)
	var so ShallowOuter
	so.HP = 5
	so.ShallowBase.HP = 9
	so.Name = "shallow"
	var sc Creature = &so
	check("outer-field-shadows-embedded-field", sc.HP == 5, sc.HP, 5)
	sc.HP = 6
	check("write-reaches-outer-field", so.HP == 6 && so.ShallowBase.HP == 9, fmt.Sprint(so.HP, so.ShallowBase.HP), "6 9")
	var dp DeepOuter
	dp.DeepMid.HP = 7
	dp.DeepMid.DeepInner.HP = 11
	dp.Name = "deep"
	var dc Creature = &dp
	check("depth-1-field-shadows-depth-2-field", dc.HP == 7, dc.HP, 7)
	dc.HP = 8
	check("write-reaches-depth-1-field", dp.DeepMid.HP == 8 && dp.DeepMid.DeepInner.HP == 11, fmt.Sprint(dp.DeepMid.HP, dp.DeepMid.DeepInner.HP), "8 11")
}

var nextCalls int

func next() int {
	nextCalls++
	return 0
}

func two() (int, int) { return 3, 4 }

func checkPropertyAccessorReceivers() {
	monsterValue := reflect.TypeOf(Monster{})
	monsterPointer := reflect.TypeOf(&Monster{})
	ghostValue := reflect.TypeOf(Ghost{})
	pointerGhostValue := reflect.TypeOf(PointerGhost{})
	pointerGhostPointer := reflect.TypeOf(&PointerGhost{})
	safeValue := reflect.TypeOf(Safe{})
	safePointer := reflect.TypeOf(&Safe{})
	check("value-getter-on-value", hasMethod(monsterValue, "Logos_GetName"), true, true)
	check("value-hides-setter-on-value", !hasMethod(monsterValue, "Logos_SetHP"), false, false)
	check("setter-on-pointer", hasMethod(monsterPointer, "Logos_SetHP"), true, true)
	check("const-getter-on-value", hasMethod(ghostValue, "Logos_GetTitle"), true, true)
	check("const-hides-getter-on-plain-value", !hasMethod(pointerGhostValue, "Logos_GetTitle"), false, false)
	check("const-getter-on-pointer", hasMethod(pointerGhostPointer, "Logos_GetTitle"), true, true)
	check("unexported-getter-on-value", hasMethod(safeValue, "Logos_GetSecret"), true, true)
	check("unexported-setter-on-pointer", hasMethod(safePointer, "Logos_SetSecret"), true, true)
	check("unexported-hides-setter-on-value", !hasMethod(safeValue, "Logos_SetSecret"), false, false)
	check("pointer-adds-only-setter", monsterPointer.NumMethod() == monsterValue.NumMethod()+1, monsterPointer.NumMethod(), monsterValue.NumMethod()+1)
	check("value-extends-plain-by-accessors", monsterValue.NumMethod() == reflect.TypeOf(Plain{}).NumMethod()+2, monsterValue.NumMethod(), reflect.TypeOf(Plain{}).NumMethod()+2)
}

func main() {
	checkPropertyAccessorReceivers()
	checkBothMerge()
	checkUndeclaredAndDepth()
	var m Monster
	m.Name = "gorg"
	m.HP = 100
	var c Creature = &m
	check("const-property-reads-field", c.Name == "gorg", c.Name, "gorg")
	c.HP -= 10
	check("compound-assign-writes-through-property", m.HP == 90, m.HP, 90)

	party := []Creature{&m}
	party[next()].HP += 10
	check("index-expr-evaluates-once", m.HP == 100 && nextCalls == 1, fmt.Sprint(m.HP, nextCalls), "100 1")

	var b Bot
	b.Pos = Vec{X: -3, Y: 4}
	var crr Carrier = &b
	crr.Pos.Normalize()
	check("pointer-method-mutates-through-property", b.Pos.X == 3, b.Pos.X, 3)
	check("value-method-reads-through-property", crr.Pos.Len() == 3, crr.Pos.Len(), 3)

	var g Ghost
	var n Named = g
	check("const-property-on-value-receiver", n.Title == "boo", n.Title, "boo")

	var s Safe
	s.hidden = 7
	var v Vault = &s
	v.Secret += 5
	check("setter-reaches-unexported-field", s.hidden == 12, s.hidden, 12)

	var ch Child
	ch.Name = "kid"
	ch.HP = 50
	var c2 Creature = &ch
	c2.HP -= 5
	check("embedded-shadow-resolves-to-outer", ch.HP == 45, ch.HP, 45)
	c2.HP = 60
	check("embedded-shadow-write-hits-outer", ch.HP == 60, ch.HP, 60)

	a := 0
	a, c.HP = two()
	check("multi-assign-reaches-property", a == 3 && c.HP == 4 && m.HP == 4, fmt.Sprint(a, c.HP, m.HP), "3 4 4")
	k := crr.Pos.Len()
	check("property-result-feeds-call", k == 3, k, 3)
	var h HasBoth
	var both Both = &h
	both.V = 41
	both.V += 1
	check("merged-getter-setter-share-slot", h.V == 42, h.V, 42)
	if failed {
		os.Exit(1)
	}
}
