// run

package jsonunion

import (
	"encoding/json"
	"errors"
	"strings"
	"testing"

	"logos/rt"
)

type TierRad struct {
	R float64 `json:"r"`
}

func (c *TierRad) UnmarshalJSON(b []byte) error {
	var v map[string]float64
	if err := json.Unmarshal(b, &v); err != nil {
		return err
	}
	r, ok := v["radius"]
	if !ok {
		return errors.New("TierRad requires radius")
	}
	c.R = r
	return nil
}

type TierAlt struct {
	A float64 `json:"a"`
}

func (c *TierAlt) UnmarshalJSON(b []byte) error {
	var v map[string]float64
	if err := json.Unmarshal(b, &v); err != nil {
		return err
	}
	a, ok := v["alt"]
	if !ok {
		return errors.New("TierAlt requires alt")
	}
	c.A = a
	return nil
}

type TierPerm struct {
	P float64 `json:"p"`
}

func (c *TierPerm) UnmarshalJSON(b []byte) error { return nil }

type TierDirty struct {
	D float64 `json:"d"`
}

func (c *TierDirty) UnmarshalJSON(b []byte) error {
	c.D = 999
	return errors.New("TierDirty always fails")
}

type TierSquare struct {
	Side float64 `json:"side"`
}

type TierShape interface {
	*TierPerm | *TierSquare
}

type TierHolder struct {
	S TierShape `json:"s"`
}

type TierStrictShape interface {
	*TierRad | *TierSquare
}

type TierStrictHolder struct {
	S TierStrictShape `json:"s"`
}

type TierPairShape interface {
	*TierRad | *TierAlt
}

type TierPairHolder struct {
	S TierPairShape `json:"s"`
}

type TierDirtyShape interface {
	*TierDirty | *TierSquare
}

type TierDirtyHolder struct {
	S TierDirtyShape `json:"s"`
}

type TierVal struct {
	V float64 `json:"v"`
}

func (c *TierVal) UnmarshalJSON(b []byte) error {
	var v map[string]float64
	if err := json.Unmarshal(b, &v); err != nil {
		return err
	}
	x, ok := v["val"]
	if !ok {
		return errors.New("TierVal requires val")
	}
	c.V = x
	return nil
}

type TierValShape interface {
	TierVal | TierSquare
}

type TierValHolder struct {
	S TierValShape `json:"s"`
}

func tierOracleRad(t *testing.T, data string) float64 {
	t.Helper()
	var oc TierRad
	if err := json.Unmarshal([]byte(data), &oc); err != nil {
		t.Fatal(err)
	}
	return oc.R
}

func TestTierKeyedBeatsPermissive(t *testing.T) {
	var h TierHolder
	if err := json.Unmarshal([]byte(`{"s":{"side":2}}`), &h); err != nil {
		t.Fatalf("keyed sibling must win, got error: %v", err)
	}
	s, ok := h.S.(*TierSquare)
	if !ok {
		t.Fatalf("expected *TierSquare, got %T: %#v", h.S, h.S)
	}
	if s.Side != 2 {
		t.Fatalf("expected Side 2, got %v", s.Side)
	}
}

func TestTierPermissiveAlone(t *testing.T) {
	var h TierHolder
	if err := json.Unmarshal([]byte(`{"s":{"zzz":1}}`), &h); err != nil {
		t.Fatalf("lone custom decoder must win, got error: %v", err)
	}
	if _, ok := h.S.(*TierPerm); !ok {
		t.Fatalf("expected *TierPerm, got %T: %#v", h.S, h.S)
	}
}

func TestTierStrictCustomAlone(t *testing.T) {
	var h TierStrictHolder
	if err := json.Unmarshal([]byte(`{"s":{"radius":3}}`), &h); err != nil {
		t.Fatal(err)
	}
	c, ok := h.S.(*TierRad)
	if !ok {
		t.Fatalf("expected *TierRad, got %T: %#v", h.S, h.S)
	}
	if want := tierOracleRad(t, `{"radius":3}`); c.R != want {
		t.Fatalf("trial R = %v, want oracle %v", c.R, want)
	}
}

func TestTierPairOneFails(t *testing.T) {
	var h TierPairHolder
	if err := json.Unmarshal([]byte(`{"s":{"alt":5}}`), &h); err != nil {
		t.Fatal(err)
	}
	a, ok := h.S.(*TierAlt)
	if !ok {
		t.Fatalf("expected *TierAlt, got %T: %#v", h.S, h.S)
	}
	if a.A != 5 {
		t.Fatalf("expected A 5, got %v", a.A)
	}
}

func TestTierPairBothSucceed(t *testing.T) {
	var h TierPairHolder
	err := json.Unmarshal([]byte(`{"s":{"radius":1,"alt":2}}`), &h)
	if err == nil {
		t.Fatalf("expected ambiguity, got %T(%v)", h.S, h.S)
	}
	var trialErr rt.UnionTrialError
	if !errors.As(err, &trialErr) {
		t.Fatalf("expected rt.UnionTrialError, got %T: %v", err, err)
	}
	if trialErr.Matched != 2 {
		t.Fatalf("expected Matched 2, got %d", trialErr.Matched)
	}
	msg := err.Error()
	if !strings.Contains(msg, "TierPairShape") {
		t.Fatalf("trial error %q must name union TierPairShape", msg)
	}
	if h.S != nil {
		t.Fatalf("failed trials left the target touched: %#v", h.S)
	}
}

func TestTierDirtyLeavesHolder(t *testing.T) {
	want := &TierSquare{Side: 7}
	h := TierDirtyHolder{S: want}
	err := json.Unmarshal([]byte(`{"s":{"bogus":1}}`), &h)
	if err == nil {
		t.Fatal("expected trial error, got nil")
	}
	var trialErr rt.UnionTrialError
	if !errors.As(err, &trialErr) {
		t.Fatalf("expected rt.UnionTrialError, got %T: %v", err, err)
	}
	if trialErr.Matched != 0 {
		t.Fatalf("expected Matched 0, got %d", trialErr.Matched)
	}
	if h.S != want {
		t.Fatalf("mutating decoder leaked into holder: %#v", h.S)
	}
	if want.Side != 7 {
		t.Fatalf("pointee modified: %v", want.Side)
	}
}

func TestTierValueMember(t *testing.T) {
	var h TierValHolder
	if err := json.Unmarshal([]byte(`{"s":{"val":9}}`), &h); err != nil {
		t.Fatal(err)
	}
	v, ok := h.S.(TierVal)
	if !ok {
		t.Fatalf("expected TierVal, got %T: %#v", h.S, h.S)
	}
	var oc TierVal
	if err := json.Unmarshal([]byte(`{"val":9}`), &oc); err != nil {
		t.Fatal(err)
	}
	if v.V != oc.V {
		t.Fatalf("trial V = %v, want oracle %v", v.V, oc.V)
	}
	var k TierValHolder
	if err := json.Unmarshal([]byte(`{"s":{"side":4}}`), &k); err != nil {
		t.Fatal(err)
	}
	s, ok := k.S.(TierSquare)
	if !ok {
		t.Fatalf("expected TierSquare, got %T: %#v", k.S, k.S)
	}
	if s.Side != 4 {
		t.Fatalf("expected Side 4, got %v", s.Side)
	}
}
