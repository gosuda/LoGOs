// run

package main

import (
	"fmt"
	"iter"
	"os"
	"strings"
	tm "time"
)

func Durs() iter.Seq[tm.Duration] {
	yield tm.Second
	yield tm.Minute
}

func Count(n int) iter.Seq[int] {
	for i := range n {
		yield i
	}
}

func Squares(n int) iter.Seq2[int, int] {
	for i := range n {
		yield i, i * i
	}
}

var glog []string

func Logged(n int) iter.Seq[int] {
	glog = append(glog, "start")
	{
		scope defer func() { glog = append(glog, "done") }()
		for i := range n {
			yield i
		}
	}
}

var steps int

func Tracked(n int) iter.Seq[int] {
	for i := range n {
		steps++
		yield i
	}
	steps += 1000
}

func ReturnSeven(n int) iter.Seq[int] {
	for i := range n {
		yield i
	}
	return 7
}

func main() {
	sum := 0
	for v := range Count(5) {
		sum += v
	}
	var pairs []string
	for k, v := range Squares(4) {
		pairs = append(pairs, fmt.Sprintf("%d:%d", k, v))
	}
	seen := 0
	for v := range Tracked(100) {
		_ = v
		seen++
		if seen == 3 {
			break
		}
	}
	var logged []int
	for v := range Logged(3) {
		logged = append(logged, v)
	}
	var durs []tm.Duration
	for d := range Durs() {
		durs = append(durs, d)
	}
	seven := 0
	for v := range ReturnSeven(3) {
		seven += v
	}
	ok := sum == 10 &&
		strings.Join(pairs, ",") == "0:0,1:1,2:4,3:9" &&
		seen == 3 && steps == 3 &&
		len(logged) == 3 && logged[0] == 0 && logged[1] == 1 && logged[2] == 2 &&
		strings.Join(glog, ",") == "start,done" &&
		len(durs) == 2 && durs[0] == tm.Second && durs[1] == tm.Minute &&
		seven == 3
	if !ok {
		fmt.Println("yield: FAIL")
		os.Exit(1)
	}
	fmt.Println("yield: PASS")
}
