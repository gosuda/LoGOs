// run

package main

import (
	"context"
	"fmt"
	"math"
	"os"
)

var bad bool

func check(tag string, cond bool, got, want string) {
	if !cond {
		fmt.Println("FAIL "+tag+": got "+got+" want "+want)
		bad = true
		return
	}
	fmt.Println("ok", tag)
}

type point (x int, y int)

// A send inside a group child spells pure values into both select arms;
// operands that carry lowering annotations or checked types must keep
// them: a fresh address lowers to new, a tuple field keeps its renamed
// selector, and an untyped constant keeps the channel element's
// contextual type.
//logos:allow(complexity::cognitive_overflow)
func sendValues(ctx context.Context) error {
	var p point = (4, 5)
	pi := make(chan *int)
	pi8 := make(chan int8)
	pf := make(chan float32)
	px := make(chan int)
	ppoint := make(chan point)
	pb := make(chan *int, 1)
	ri := make(chan *int, 1)
	ri8 := make(chan int8, 1)
	rf := make(chan float32, 1)
	rx := make(chan int, 1)
	rp := make(chan point, 1)
	go group (ctx) {
		go {
			pi <- &42
		}
		go {
			pi8 <- 1 << 3
		}
		go {
			pf <- math.Pi
		}
		go {
			px <- p.x + p.y
		}
		go {
			ppoint <- p
		}
		go {
			pb <- &7
		}
		go {
			ri <- <-pi
		}
		go {
			ri8 <- <-pi8
		}
		go {
			rf <- <-pf
		}
		go {
			rx <- <-px
		}
		go {
			rp <- <-ppoint
		}
	}
	pv := <-ri
	v8 := <-ri8
	vf := <-rf
	vx := <-rx
	vp := <-rp
	pbv := <-pb
	check("fresh-address", pv != nil && *pv == 42, fmt.Sprint(pv), "42")
	check("untyped-constant", v8 == 8, fmt.Sprint(v8), "8")
	check("untyped-float", vf > 3.14 && vf < 3.15, fmt.Sprint(vf), "3.14")
	check("tuple-field-sum", vx == 9, fmt.Sprint(vx), "9")
	check("tuple-value", vp.x == 4 && vp.y == 5, fmt.Sprint(vp.x, vp.y), "4 5")
	check("ready-channel", pbv != nil && *pbv == 7, fmt.Sprint(pbv), "7")
	return nil
}

func main() {
	if err := sendValues(context.Background()); err != nil {
		fmt.Println("FAIL group:", err)
		os.Exit(1)
	}
	if bad {
		os.Exit(1)
	}
}
