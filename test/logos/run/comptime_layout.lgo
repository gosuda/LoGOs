// run

package main

import (
	"comptime"
	"fmt"
	"unsafe"
)

type layoutMixed struct {
	A int32
	B []byte
}

type layoutPair struct {
	X *int
	Y int
}

type layoutEmpty struct{}

type layoutNode struct {
	Next *layoutNode
}

func Layout[T any]() (int, int, bool) {
	return comptime.SizeOf[T](), comptime.AlignOf[T](), comptime.HasPointers[T]()
}

func Buffer[T any]() int {
	var b [comptime.SizeOf[T]()]byte
	return len(b)
}

func Sorted[T any]() string {
	const if comptime.HasPointers[T]() {
		return "scan"
	}
	return "noscan"
}

func report(name string, ok bool) {
	if ok {
		fmt.Println(name, "ok")
		return
	}
	fmt.Println(name, "bad")
}

func main() {
	size, align, ptr := Layout[int8]()
	report("int8", size == int(unsafe.Sizeof(int8(0))) && align == int(unsafe.Alignof(int8(0))) && ptr == false)
	size, align, ptr = Layout[int64]()
	report("int64", size == int(unsafe.Sizeof(int64(0))) && align == int(unsafe.Alignof(int64(0))) && ptr == false)
	size, align, ptr = Layout[string]()
	report("string", size == int(unsafe.Sizeof("")) && align == int(unsafe.Alignof("")) && ptr == true)
	size, align, ptr = Layout[*int]()
	report("pointer", size == int(unsafe.Sizeof((*int)(nil))) && align == int(unsafe.Alignof((*int)(nil))) && ptr == true)
	size, align, ptr = Layout[[0]*int]()
	report("zero array", size == int(unsafe.Sizeof([0]*int{})) && align == int(unsafe.Alignof([0]*int{})) && ptr == false)
	size, align, ptr = Layout[layoutMixed]()
	report("mixed struct", size == int(unsafe.Sizeof(struct {
		a int32
		b []byte
	}{})) && align == int(unsafe.Alignof(struct {
		a int32
		b []byte
	}{})) && ptr == true)
	size, align, ptr = Layout[[4]float64]()
	report("float array", size == int(unsafe.Sizeof([4]float64{})) && align == int(unsafe.Alignof([4]float64{})) && ptr == false)
	size, align, ptr = Layout[layoutEmpty]()
	report("empty struct", size == int(unsafe.Sizeof(struct{}{})) && align == int(unsafe.Alignof(struct{}{})) && ptr == false)
	size, align, ptr = Layout[layoutPair]()
	report("pointer pair", size == int(unsafe.Sizeof(layoutPair{X: new(int)})) && align == int(unsafe.Alignof(layoutPair{X: new(int)})) && ptr == true)
	report("buffers", Buffer[int64]() == int(unsafe.Sizeof(int64(0))) && Buffer[layoutMixed]() == int(unsafe.Sizeof(layoutMixed{})))
	report("const if", Sorted[int64]() == "noscan" && Sorted[string]() == "scan")
	size, align, ptr = Layout[*layoutNode]()
	report("recursive pointer", size == int(unsafe.Sizeof((*layoutNode)(nil))) && align == int(unsafe.Alignof((*layoutNode)(nil))) && ptr == true)
	size, align, ptr = Layout[[0]layoutNode]()
	report("recursive zero array", size == int(unsafe.Sizeof([0]layoutNode{})) && align == int(unsafe.Alignof([0]layoutNode{})) && ptr == false)
}
