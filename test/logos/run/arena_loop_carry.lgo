// run -goexperiment logosarena
// run -goexperiment logosarena -arena=false

package main


import (
	"fmt"
	"os"
	"runtime"
)

var escapeSink []byte

//go:noinline
func sumBytes(b []byte) int {
	s := 0
	for _, v := range b {
		s += int(v)
	}
	return s
}

func carryBasic(n int) (ks, kf, kl, ls, lf, ksGC, lsGC int) {
	var kept []byte
	var last []byte
	for i := 0; i < 4; i++ {
		b := make([]byte, n)
		v := byte(i + 1)
		for j := range b {
			b[j] = v
		}
		if i == 0 {
			kept = b
		}
		last = b
	}
	ks = sumBytes(kept)
	kf = int(kept[0])
	kl = int(kept[n-1])
	ls = sumBytes(last)
	lf = int(last[0])
	runtime.GC()
	runtime.GC()
	ksGC = sumBytes(kept)
	lsGC = sumBytes(last)
	runtime.KeepAlive(kept)
	runtime.KeepAlive(last)
	return ks, kf, kl, ls, lf, ksGC, lsGC
}

func carryClosure(n int) (direct, via, after, viaAfter int) {
	var kept []byte
	for i := 0; i < 4; i++ {
		b := make([]byte, n)
		v := byte(20 + i)
		for j := range b {
			b[j] = v
		}
		if i == 0 {
			kept = b
		}
	}
	get := func() int { return sumBytes(kept) }
	direct = sumBytes(kept)
	via = get()
	runtime.GC()
	runtime.GC()
	after = sumBytes(kept)
	viaAfter = get()
	runtime.KeepAlive(kept)
	return direct, via, after, viaAfter
}

func carryCondPost(n int) (total, ks, ksGC, os, osGC int) {
	outer := make([]byte, n)
	for j := range outer {
		outer[j] = 9
	}
	var kept []byte
	for i := 0; i < 4 && len(kept) <= n && sumBytes(make([]byte, n)) == 0; i = i + 1 + sumBytes(make([]byte, n))*0 + len(kept)*0 {
		b := make([]byte, n)
		v := byte(40 + i)
		for j := range b {
			b[j] = v
		}
		if i == 0 {
			kept = b
		}
		total += int(b[0]) + int(b[n-1])
	}
	ks = sumBytes(kept)
	os = sumBytes(outer)
	runtime.GC()
	runtime.GC()
	ksGC = sumBytes(kept)
	osGC = sumBytes(outer)
	runtime.KeepAlive(kept)
	runtime.KeepAlive(outer)
	return total, ks, ksGC, os, osGC
}

func carryNested(n int) (ks, kf, innerTotal, ksGC int) {
	var kept []byte
	for i := 0; i < 3; i++ {
		for k := 0; k < 3; k++ {
			b := make([]byte, n)
			v := byte(50 + i*10 + k)
			for j := range b {
				b[j] = v
			}
			if i == 0 && k == 0 {
				kept = b
			} else {
				innerTotal += int(b[0])
			}
		}
		for k := 0; k < 3; k++ {
			t := make([]byte, n)
			v := byte(90 + k)
			for j := range t {
				t[j] = v
			}
			innerTotal += int(t[0])
		}
	}
	ks = sumBytes(kept)
	kf = int(kept[0])
	runtime.GC()
	runtime.GC()
	ksGC = sumBytes(kept)
	runtime.KeepAlive(kept)
	return ks, kf, innerTotal, ksGC
}

func carryEscape(n int) (ks, es, ksGC, esGC int) {
	var kept []byte
	for i := 0; i < 4; i++ {
		b := make([]byte, n)
		v := byte(60 + i)
		for j := range b {
			b[j] = v
		}
		if i == 0 {
			kept = b
		}
		if i == 1 {
			escapeSink = b
		}
	}
	ks = sumBytes(kept)
	es = sumBytes(escapeSink)
	runtime.GC()
	runtime.GC()
	ksGC = sumBytes(kept)
	esGC = sumBytes(escapeSink)
	runtime.KeepAlive(kept)
	runtime.KeepAlive(escapeSink)
	return ks, es, ksGC, esGC
}
func main() {
	failed := false
	eq := func(name string, got, want int) {
		if got != want {
			fmt.Printf("FAIL %s: got %d want %d\n", name, got, want)
			failed = true
			return
		}
		fmt.Printf("ok %s\n", name)
	}
	ks, kf, kl, ls, lf, ksGC, lsGC := carryBasic(1024)
	eq("basic-kept-sum-matches-fill-1-rule", ks, 1024*1)
	eq("basic-kept-first-byte-is-1", kf, 1)
	eq("basic-kept-last-byte-is-1", kl, 1)
	eq("basic-last-sum-matches-fill-4-rule", ls, 1024*4)
	eq("basic-last-first-byte-is-4", lf, 4)
	eq("basic-gc-preserves-kept-sum", ksGC, ks)
	eq("basic-gc-preserves-last-sum", lsGC, ls)
	direct, via, after, viaAfter := carryClosure(1024)
	eq("closure-direct-matches-fill-20-rule", direct, 1024*20)
	eq("closure-captured-matches-direct", via, direct)
	eq("closure-gc-preserves-direct", after, direct)
	eq("closure-gc-preserves-captured", viaAfter, direct)
	total, cks, cksGC, osum, osumGC := carryCondPost(1024)
	eq("condpost-kept-sum-matches-fill-40-rule", cks, 1024*40)
	eq("condpost-gc-preserves-kept-sum", cksGC, cks)
	eq("condpost-outer-sum-matches-fill-9-rule", osum, 1024*9)
	eq("condpost-gc-preserves-outer-sum", osumGC, osum)
	eq("condpost-endpoints-match-arithmetic-series", total, 2*(4*40+4*3/2))
	nks, nkf, ntotal, nksGC := carryNested(1024)
	eq("nested-kept-sum-matches-fill-50-rule", nks, 1024*50)
	eq("nested-kept-first-byte-is-50", nkf, 50)
	eq("nested-gc-preserves-kept-sum", nksGC, nks)
	eq("nested-consumed-fills-match-grid-and-series", ntotal, 9*50+3*10*(0+1+2)+3*(0+1+2)-50+3*(3*90+3*2/2))
	eks, ees, eksGC, eesGC := carryEscape(1024)
	eq("escape-kept-sum-matches-fill-60-rule", eks, 1024*60)
	eq("escape-sink-sum-matches-fill-61-rule", ees, 1024*61)
	eq("escape-gc-preserves-kept-sum", eksGC, eks)
	eq("escape-gc-preserves-sink-sum", eesGC, ees)
	if failed {
		os.Exit(1)
	}
}
