// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type P struct {
	O string?
}

func main() {
	q := P{O: "c"}
	check("coalesce-selects-present-literal", (q.O ?? "none") == "c", q.O ?? "none", "c")
	r := P{O: nil}
	check("coalesce-selects-fallback-for-nil", (r.O ?? "none") == "none", r.O ?? "none", "none")
	if failed {
		os.Exit(1)
	}
}
