// run

package main

import (
	"fmt"
	"os"
	"strings"
)

var failed bool
var order []string

func log(s string) {
	order = append(order, s)
}

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func call(g func(int)) { g(1) }

func callv(g func(int) int) int { return g(1) }

func outerv(n int) int {
	call(x => {
		scope defer log("s")
		log(fmt.Sprint(x + n))
	})
	return n * 2
}

func main() {
	call(x => {
		scope defer log("s")
		log(fmt.Sprint(x))
	})
	check("scope-defer-runs-after-body", fmt.Sprint(order) == "[1 s]", fmt.Sprint(order), "[1 s]")
	gotv := callv(x => {
		scope defer log("t")
		return x + 1
	})
	log(fmt.Sprint(gotv))
	check("scope-defer-runs-before-return-lands", fmt.Sprint(order) == "[1 s t 2]", fmt.Sprint(order), "[1 s t 2]")
	check("scope-defer-keeps-return-value", gotv == 2, gotv, 2)
	call(func(x int) {
		scope defer log("s")
		log(fmt.Sprint(x))
	})
	gotOuter := outerv(1)
	log(fmt.Sprint(gotOuter))
	check("scope-defer-orders-nested-lambda", strings.Join(order, " ") == "1 s t 2 1 s 2 s 2", strings.Join(order, " "), "1 s t 2 1 s 2 s 2")
	check("scope-defer-keeps-outer-return", gotOuter == 2, gotOuter, 2)
	if failed {
		os.Exit(1)
	}
}
