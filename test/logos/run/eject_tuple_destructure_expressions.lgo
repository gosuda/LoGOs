package main

import (
	"fmt"
	"strings"
)

type holder struct {
	t (int, int)
}

func show(args ...any) string {
	return strings.TrimSuffix(fmt.Sprintln(args...), "\n")
}

func cell(name string, got func() string, want string) {
	if g := got(); g != want {
		fmt.Println("FAIL", name, "got", g, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type pair = (int, int)

func mk() pair {
	return (1, 2)
}

func retVar() (int, int) {
	t := (1, 2)
	return t
}

func retParen() (int, int) {
	t := (1, 2)
	return (t)
}

func retField(h holder) (int, int) {
	return h.t
}

func retIndex(xs [](int, int)) (int, int) {
	return xs[0]
}

func retCall() (int, int) {
	return mk()
}

func plainCells() {
	t := (1, 2)
	h := holder{t: (1, 2)}
	xs := [](int, int){(1, 2)}
	cell("var__define", func() string { a, b := t; return show(a, b) }, "1 2")
	cell("var__assign", func() string { var a, b int; a, b = t; return show(a, b) }, "1 2")
	cell("var__var", func() string { var a, b = t; return show(a, b) }, "1 2")
	cell("var__return", func() string { a, b := retVar(); return show(a, b) }, "1 2")
	cell("paren__define", func() string { a, b := (t); return show(a, b) }, "1 2")
	cell("paren__assign", func() string { var a, b int; a, b = (t); return show(a, b) }, "1 2")
	cell("paren__var", func() string { var a, b = (t); return show(a, b) }, "1 2")
	cell("paren__return", func() string { a, b := retParen(); return show(a, b) }, "1 2")
	cell("field__define", func() string { a, b := h.t; return show(a, b) }, "1 2")
	cell("field__assign", func() string { var a, b int; a, b = h.t; return show(a, b) }, "1 2")
	cell("field__var", func() string { var a, b = h.t; return show(a, b) }, "1 2")
	cell("field__return", func() string { a, b := retField(h); return show(a, b) }, "1 2")
	cell("index__define", func() string { a, b := xs[0]; return show(a, b) }, "1 2")
	cell("index__assign", func() string { var a, b int; a, b = xs[0]; return show(a, b) }, "1 2")
	cell("index__var", func() string { var a, b = xs[0]; return show(a, b) }, "1 2")
	cell("index__return", func() string { a, b := retIndex(xs); return show(a, b) }, "1 2")
}

func callCells() {
	cell("call__define", func() string { a, b := mk(); return show(a, b) }, "1 2")
	cell("call__assign", func() string { var a, b int; a, b = mk(); return show(a, b) }, "1 2")
	cell("call__var", func() string { var a, b = mk(); return show(a, b) }, "1 2")
	cell("call__return", func() string { a, b := retCall(); return show(a, b) }, "1 2")
}

func main() {
	plainCells()
	callCells()
}
