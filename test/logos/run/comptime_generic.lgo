// run
package main

import (
	"comptime"
	"fmt"
	"os"
)

type Container struct {
	Port int
	Host string
}

func Resolve[T any](c *Container) T {
	var zero T
	switch any(zero).(type) {
	case int:
		return any(c.Port).(T)
	case string:
		return any(c.Host).(T)
	default:
		panic("unresolvable")
	}
}

type ServiceA struct {
	Port int
	Host string
}

type ServiceB struct {
	Host string
	Port int
}

func Autowire[T any](c *Container) *T {
	var v T
	const for _, f := range comptime.Fields[T]() {
		v.[f] = Resolve[f.Type](c)
	}
	return &v
}

func TypeKind[T any]() string {
	_ = comptime.TypeOf[T]()
	return "type"
}

var failed bool

func check(name, got, want string) {
	if got != want {
		fmt.Println("FAIL", name, "got", got, "want", want)
		failed = true
		return
	}
	fmt.Println("ok", name)
}

func main() {
	c := &Container{Port: 8080, Host: "db"}
	a := Autowire[ServiceA](c)
	check("autowire-assigns-all-fields", fmt.Sprintf("%d %s", a.Port, a.Host), "8080 db")
	b := Autowire[ServiceB](c)
	check("field-order-independent", fmt.Sprintf("%s %d", b.Host, b.Port), "db 8080")
	a2 := Autowire[ServiceA](c)
	check("autowire-repeatable", fmt.Sprintf("%d %s", a2.Port, a2.Host), "8080 db")
	check("autowire-matches-hand-struct", fmt.Sprint(*a), fmt.Sprint(ServiceA{Port: 8080, Host: "db"}))
	check("typeof-instantiates-int", TypeKind[int](), "type")
	check("typeof-instantiates-string", TypeKind[string](), "type")
	if failed {
		os.Exit(1)
	}
}
