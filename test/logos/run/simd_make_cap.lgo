// run -goexperiment simd

package main

import "fmt"

func main() {
	bad := 0
	for _, n := range []int{1, 7, 8, 9, 16, 17, 31, 32, 33, 64, 65, 129} {
		s := make([]int32, n)
		if cap(s) != n {
			bad++
			fmt.Println("int32 cap", n, cap(s))
		}
		if len(s) != n {
			bad++
			fmt.Println("int32 len", n, len(s))
		}
		b := make([]uint8, n)
		if cap(b) != n {
			bad++
			fmt.Println("uint8 cap", n, cap(b))
		}
		f := make([]float64, n)
		if cap(f) != n {
			bad++
			fmt.Println("float64 cap", n, cap(f))
		}
		w, h := 3, 11
		p := make([]int32, w*h)
		if cap(p) != w*h {
			bad++
			fmt.Println("product cap", w*h, cap(p))
		}
	}
	fmt.Println("cap ok", bad)
}
