// run

package main

import (
	"fmt"
	"os"

	"logos/sync"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type HSCounter struct {
	Name string
	N    int
}

func main() {
	h := sync.Hot[HSCounter]{}
	h.Store(&HSCounter{Name: "zero", N: 0})
	h.Update(func(old const *HSCounter) *HSCounter {
		return &HSCounter{Name: old.Name + "+lit", N: old.N + 1}
	})
	h.Update(old => &HSCounter{Name: old.Name + "+lam", N: old.N + 10})
	got := h.Load()
	check("hot", got.Name == "zero+lit+lam" && got.N == 11, fmt.Sprint(got.Name, got.N), "zero+lit+lam11")
	if failed {
		os.Exit(1)
	}
}
