// run

package main

import (
	"fmt"

	"logos/sync"
)


type HSCounter struct {
	Name string
	N    int
}

func main() {
	h := sync.Hot[HSCounter]{}
	h.Store(&HSCounter{Name: "zero", N: 0})
	h.Update(func(old const *HSCounter) *HSCounter {
		return &HSCounter{Name: old.Name + "+lit", N: old.N + 1}
	})
	h.Update(old => &HSCounter{Name: old.Name + "+lam", N: old.N + 10})
	got := h.Load()
	fmt.Println(got.Name, got.N)
}
