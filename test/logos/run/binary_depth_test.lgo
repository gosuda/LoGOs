// run

package main

import (
	"bytes"
	"encoding/binary"
	"strings"
	"testing"
)

type DepthNode struct {
	Kids []DepthNode `json:"kids"`
}

func mustDepthBytes(b []byte, err error) []byte {
	if err != nil {
		panic(err)
	}
	return b
}

func depthWire(levels int) []byte {
	w := []byte{1, 0}
	for range levels {
		w = append(append([]byte{1}, binary.AppendUvarint(nil, 1)...), w[1:]...)
	}
	return w
}

func depthOf(v DepthNode) int {
	n := 0
	for cur := &v; len(cur.Kids) == 1; cur = &cur.Kids[0] {
		n++
	}
	return n
}

func TestBinaryDepthLimit(t *testing.T) {
	shallow := depthWire(100)
	var s DepthNode
	if err := s.UnmarshalBinary(shallow); err != nil {
		t.Fatalf("100-deep payload rejected: %v", err)
	}
	if got := depthOf(s); got != 100 {
		t.Fatalf("100-deep payload decoded to depth %d", got)
	}
	if !bytes.Equal(mustDepthBytes(s.MarshalBinary()), shallow) {
		t.Fatalf("100-deep payload did not round-trip")
	}
	deep := depthWire(10001)
	var d DepthNode
	err := d.UnmarshalBinary(deep)
	if err == nil {
		t.Fatal("10001-deep payload decoded without a depth error")
	}
	if !strings.Contains(err.Error(), "depth") {
		t.Fatalf("depth error does not name depth: %v", err)
	}
}
