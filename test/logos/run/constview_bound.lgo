// run

package main


import (
	"fmt"
	"strings"
)

func main() {
	b := make([]byte, 5, 64)
	for i := range b {
		b[i] = byte('a' + i)
	}
	var v const []byte = b
	fmt.Println(len(v[:5]))
	n := 32
	func() {
		defer func() {
			r := recover()
			if r == nil {
				fmt.Println("NO-TRAP")
				return
			}
			if strings.Contains(fmt.Sprint(r), "slice bounds out of range") {
				fmt.Println("trap OK")
				return
			}
			fmt.Printf("WRONG-PANIC %v\n", r)
		}()
		_ = v[:n]
	}()
}
