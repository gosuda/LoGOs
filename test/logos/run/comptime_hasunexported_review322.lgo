// run
package main

import (
	"comptime"
	"fmt"
	"os"
)

type exportedOnly struct {
	A int32
	B float64
}

type hasHidden struct {
	A int32
	b int32
}

type nestedHidden struct {
	A int32
	In hasHidden
}

type blanked struct {
	A int32
	_ [2]byte
}

type hiddenOpt = hasHidden?
type exportedOpt = exportedOnly?
type hiddenPtrOpt = *hasHidden?

type hiddenArray [3]hasHidden

var failed bool

func check(name string, got, want bool) {
	if got != want {
		fmt.Println("FAIL", name, "got", got, "want", want)
		failed = true
		return
	}
	fmt.Println("ok", name)
}

func condHidden[T any]() bool {
	const if comptime.HasUnexported[T]() {
		return true
	}
	return false
}

func direct[T any]() bool {
	return comptime.HasUnexported[T]()
}

func condHiddenOption() bool {
	const if comptime.HasUnexported[hiddenOpt]() {
		return true
	}
	return false
}

func condHiddenView() bool {
	const if comptime.HasUnexported[const hasHidden]() {
		return true
	}
	return false
}

func main() {
	check("exported-false", direct[exportedOnly](), false)
	check("hidden-true", direct[hasHidden](), true)
	check("nested-true", direct[nestedHidden](), true)
	check("blank-true", direct[blanked](), true)
	check("array-true", direct[hiddenArray](), true)
	check("scalar-false", direct[int32](), false)
	check("cond-hidden-true", condHidden[hasHidden](), true)
	check("cond-exported-false", condHidden[exportedOnly](), false)
	check("option-true", direct[hiddenOpt](), true)
	check("view-true", direct[const hasHidden](), true)
	check("cond-option-true", condHiddenOption(), true)
	check("cond-view-true", condHiddenView(), true)
	check("ptr-false", direct[*hasHidden](), false)
	check("option-ptr-false", direct[hiddenPtrOpt](), false)
	check("option-exported-false", direct[exportedOpt](), false)
	if failed {
		os.Exit(1)
	}
}
