// run

package main

import (
	"fmt"
	"reflect"
	"unsafe"
)

type U2 interface {
	int | string
}

type U5 interface {
	int | string | float64 | bool | []byte
}

type Empty struct{}

type ZU interface {
	Empty | int
}

func check(name string, cond bool) {
	if !cond {
		panic(name)
	}
}

func main() {
	var a2 U2
	var a5 U5
	var ai any
	var zi ZU
	check("size2", unsafe.Sizeof(a2) == unsafe.Sizeof(ai))
	check("size5", unsafe.Sizeof(a5) == unsafe.Sizeof(ai))
	check("sizez", unsafe.Sizeof(zi) == unsafe.Sizeof(ai))
	check("sizecount", unsafe.Sizeof(a2) == unsafe.Sizeof(a5))
	var src any = 7
	u2 := *(*U2)(unsafe.Pointer(&src))
	check("dyntype", reflect.TypeOf(u2) == reflect.TypeOf(7))
	back := *(*any)(unsafe.Pointer(&u2))
	check("roundtrip", reflect.TypeOf(back) == reflect.TypeOf(7))
	if v, ok := back.(int); !ok || v != 7 {
		panic("roundtrip value")
	}
	fmt.Println("repr-ok")
}
