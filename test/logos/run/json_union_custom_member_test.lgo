// run

package jsonunion

import (
	"encoding/json"
	"errors"
	"strings"
	"testing"

	"logos/rt"
)

type RadCircle struct {
	R float64 `json:"r"`
}

func (c *RadCircle) UnmarshalJSON(b []byte) error {
	var v map[string]float64
	if err := json.Unmarshal(b, &v); err != nil {
		return err
	}
	r, ok := v["radius"]
	if !ok {
		return errors.New("RadCircle requires radius")
	}
	c.R = r
	return nil
}

type RadSquare struct {
	S int64 `json:"s"`
}

type RadShape interface {
	*RadCircle | *RadSquare
}

type RadHolder struct {
	Item RadShape `json:"item"`
}

func mustUnmarshalRad(t *testing.T, data []byte, dst any) {
	t.Helper()
	if err := json.Unmarshal(data, dst); err != nil {
		panic(err)
	}
}

func TestUnionCustomMemberDecoderDecides(t *testing.T) {
	var oc RadCircle
	mustUnmarshalRad(t, []byte(`{"radius":2}`), &oc)
	if oc.R != 2 {
		t.Fatalf("oracle RadCircle.R = %v, want 2", oc.R)
	}
	var h RadHolder
	err := json.Unmarshal([]byte(`{"item":{"radius":2}}`), &h)
	if err == nil {
		t.Fatalf("expected trial error for wire name without field key, got %T(%v)", h.Item, h.Item)
	}
	var trialErr rt.UnionTrialError
	if !errors.As(err, &trialErr) {
		t.Fatalf("expected rt.UnionTrialError, got %T: %v", err, err)
	}
	if trialErr.Matched != 0 {
		t.Fatalf("expected Matched 0, got %d", trialErr.Matched)
	}
	if h.Item != nil {
		t.Fatalf("failed trials left the target touched: %#v", h.Item)
	}
	if msg := err.Error(); !strings.Contains(msg, "RadShape") {
		t.Fatalf("trial error %q must name union RadShape", msg)
	}
	var hs RadHolder
	mustUnmarshalRad(t, []byte(`{"item":{"s":5}}`), &hs)
	s, ok := hs.Item.(*RadSquare)
	if !ok {
		t.Fatalf("expected *RadSquare, got %T: %#v", hs.Item, hs.Item)
	}
	if s.S != 5 {
		t.Fatalf("expected RadSquare.S = 5, got %d", s.S)
	}
	var hb RadHolder
	err = json.Unmarshal([]byte(`{"item":{"bogus":1}}`), &hb)
	if err == nil {
		t.Fatal("expected trial error on unrecognized document, got nil")
	}
	var trialErr2 rt.UnionTrialError
	if !errors.As(err, &trialErr2) {
		t.Fatalf("expected rt.UnionTrialError, got %T: %v", err, err)
	}
	if trialErr2.Matched != 0 {
		t.Fatalf("expected Matched 0, got %d", trialErr2.Matched)
	}
	if hb.Item != nil {
		t.Fatalf("failed trials left the target touched: %#v", hb.Item)
	}
	msg := err.Error()
	if !strings.Contains(msg, "RadShape") {
		t.Fatalf("trial error %q must name union RadShape", msg)
	}
}

type WireBox[T any] struct {
	V T `json:"v"`
}

func (b *WireBox[T]) UnmarshalJSON(data []byte) error {
	var m map[string]T
	if err := json.Unmarshal(data, &m); err != nil {
		return err
	}
	v, ok := m["payload"]
	if !ok {
		return errors.New("WireBox requires payload")
	}
	b.V = v
	return nil
}

type WireShape interface {
	*WireBox[int] | *RadSquare
}

type WireHolder struct {
	Item WireShape `json:"item"`
}

func TestUnionGenericInstantiationMemberDecodes(t *testing.T) {
	var h WireHolder
	if err := json.Unmarshal([]byte(`{"item":{"payload":42}}`), &h); err != nil {
		t.Fatalf("instantiation member must decode, got error: %v", err)
	}
	wb, ok := h.Item.(*WireBox[int])
	if !ok {
		t.Fatalf("expected *WireBox[int], got %T: %#v", h.Item, h.Item)
	}
	if wb.V != 42 {
		t.Fatalf("expected WireBox.V = 42 decoded from wire key payload, got %v", wb.V)
	}
}
