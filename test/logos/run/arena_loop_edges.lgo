// run -goexperiment logosarena

package main

import (
	"fmt"
	"os"
)

func fillSeq(b []byte, base int) {
	for j := range b {
		b[j] = byte(base + j)
	}
}

func sumBytes(b []byte) int {
	s := 0
	for _, v := range b {
		s += int(v)
	}
	return s
}

func ordinaryContinue(n, sz int) int {
	total := 0
	for i := 0; i < n; i++ {
		b := make([]byte, sz)
		fillSeq(b, i)
		if i%2 == 0 {
			continue
		}
		total += sumBytes(b)
	}
	return total
}

func ordinaryBreak(n, sz int) int {
	total := 0
	for i := 0; i < n; i++ {
		b := make([]byte, sz)
		fillSeq(b, 10*i)
		if i == 3 {
			break
		}
		total += sumBytes(b)
	}
	return total
}

func rangeContinue(items []int, sz int) int {
	total := 0
	for _, x := range items {
		b := make([]byte, sz)
		fillSeq(b, x)
		if x%2 == 0 {
			continue
		}
		total += sumBytes(b)
	}
	return total
}

func rangeBreak(items []int, sz int) int {
	total := 0
	for _, x := range items {
		b := make([]byte, sz)
		fillSeq(b, 10*x)
		if x == 4 {
			break
		}
		total += sumBytes(b)
	}
	return total
}

func nestedInnerBreak(n, m, sz int) int {
	total := 0
	for i := 0; i < n; i++ {
		outer := make([]byte, sz)
		fillSeq(outer, i*10)
		for k := 0; k < m; k++ {
			b := make([]byte, sz)
			fillSeq(b, i*10+k*100)
			if k == 2 {
				break
			}
			total += sumBytes(b)
		}
		total += sumBytes(outer)
	}
	return total
}

func labeledOuterBreak(n, m, sz int) (int, int) {
	total := 0
	count := 0
Outer:
	for i := 0; i < n; i++ {
		for k := 0; k < m; k++ {
			b := make([]byte, sz)
			fillSeq(b, i*10+k)
			if i == 1 && k == 2 {
				break Outer
			}
			total += sumBytes(b)
			count++
		}
	}
	return total, count
}

func labeledOuterContinue(n, m, sz int) (int, int) {
	total := 0
	count := 0
Outer:
	for i := 0; i < n; i++ {
		for k := 0; k < m; k++ {
			b := make([]byte, sz)
			fillSeq(b, i*10+k)
			if k == 1 {
				continue Outer
			}
			total += sumBytes(b)
			count++
		}
	}
	return total, count
}

func switchBreak(n, sz int) int {
	total := 0
	for i := 0; i < n; i++ {
		b := make([]byte, sz)
		fillSeq(b, i)
		switched := 0
		switch i % 3 {
		case 0:
			switched = 1
			break
		case 1:
			switched = 2
			break
		default:
			switched = 3
		}
		total += sumBytes(b) + len(b)*switched
	}
	return total
}

func siblingBoth(n, sz int) (int, [][]byte, int) {
	keep := make([]byte, sz)
	fillSeq(keep, 50)
	aTotal := 0
	for i := 0; i < n; i++ {
		b := make([]byte, sz)
		fillSeq(b, i)
		aTotal += sumBytes(b)
	}
	var out [][]byte
	for i := 0; i < n; i++ {
		b := make([]byte, sz)
		fillSeq(b, 100+i*10)
		out = append(out, b)
	}
	keepSum := sumBytes(keep)
	return aTotal, out, keepSum
}

func main() {
	failed := false
	eq := func(name string, got, want int) {
		if got != want {
			fmt.Printf("FAIL %s: got %d want %d\n", name, got, want)
			failed = true
			return
		}
		fmt.Printf("ok %s\n", name)
	}
	eq("continue-skips-even-iterations", ordinaryContinue(6, 4), 10+18+26)
	eq("break-stops-before-fourth-iteration", ordinaryBreak(6, 4), 6+46+86)
	eq("range-continue-skips-even-elements", rangeContinue([]int{1, 2, 3, 4, 5}, 4), 10+18+26)
	eq("range-break-stops-at-sentinel", rangeBreak([]int{1, 2, 3, 4, 5}, 4), 46+86+126)
	eq("inner-break-keeps-outer-accumulation", nestedInnerBreak(3, 5, 4), 1614)
	obTotal, obCount := labeledOuterBreak(4, 4, 4)
	eq("labeled-break-total", obTotal, 144)
	eq("labeled-break-count", obCount, 6)
	ocTotal, ocCount := labeledOuterContinue(4, 4, 4)
	eq("labeled-continue-total", ocTotal, 264)
	eq("labeled-continue-count", ocCount, 4)
	eq("switch-break-keeps-loop-sum", switchBreak(6, 4), 144)
	aTotal, out, keepSum := siblingBoth(4, 4)
	bTotal := 0
	for _, s := range out {
		bTotal += sumBytes(s)
	}
	eq("sibling-first-loop-sum", aTotal, 48)
	eq("sibling-kept-slices-sum", bTotal, 1864)
	eq("sibling-untouched-buffer-preserved", keepSum, 206)
	if failed {
		os.Exit(1)
	}
}
