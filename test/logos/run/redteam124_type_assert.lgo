// run -O=3

package main

import (
	"fmt"
	"io"
	"net/http"
	"os"
)


type r124Plain struct{ n int }

func (p *r124Plain) Write(b []byte) (int, error) {
	p.n += len(b)
	return len(b), nil
}

type r124Flush struct {
	n int
	f int
}

func (f *r124Flush) Write(b []byte) (int, error) {
	f.n += len(b)
	return len(b), nil
}

func (f *r124Flush) Flush() { f.f++ }

func r124Emit(w io.Writer, msg string) string {
	if _, err := w.Write([]byte(msg)); err != nil {
		return err.Error()
	}
	if f, ok := w.(http.Flusher); ok {
		f.Flush()
		return "flushed"
	}
	return "buffered"
}

var r124Failed bool

func r124Check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		r124Failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	var pw r124Plain
	var fw r124Flush
	a := r124Emit(&pw, "a")
	b := r124Emit(&fw, "bc")
	c := r124Emit(&fw, "d")
	r124Check("type-assert-direct", a == "buffered" && b == "flushed" && c == "flushed", a+" "+b+" "+c, "buffered flushed flushed")
	r124Check("type-assert-counts", pw.n == 1 && fw.n == 3 && fw.f == 2, fmt.Sprint(pw.n)+" "+fmt.Sprint(fw.n)+" "+fmt.Sprint(fw.f), "1 3 2")
	var fn func(io.Writer, string) string = r124Emit
	d := fn(&pw, "x")
	e := fn(&fw, "y")
	r124Check("type-assert-funcvalue", d == "buffered" && e == "flushed", d+" "+e, "buffered flushed")
	var dyn io.Writer = &fw
	f := r124Emit(dyn, "z")
	r124Check("type-assert-dynamic", f == "flushed" && fw.f == 4, f+" "+fmt.Sprint(fw.f), "flushed 4")
	if r124Failed {
		os.Exit(1)
	}
}
