// run

// Comptime layout calls spelled with a comment inside the argument
// list: the closing parenthesis of such a call is found over tokens,
// so a parenthesis inside the comment never ends the call early and
// the lowered text stays whole, in a plain body, in a const for body,
// and in a folded const if leaf.

package main

import (
	"comptime"
	"fmt"
	"unsafe"
)

type Pair struct {
	X *int
	Y int
}

type Nest struct {
	P Pair
	Q int
}

func Cells[T any]() int {
	var b [comptime.SizeOf[T]( /* ) */ )]byte
	return len(b)
}

func FieldCells() int {
	n := 0
	const for _, f := range comptime.Fields[Nest]() {
		var c [comptime.SizeOf[f.Type]( /* ) */ )]byte
		n += len(c)
	}
	return n
}

func ScanMark[T any]() string {
	const if comptime.HasPointers[Pair]( /* ) */ ) {
		return "scan"
	}
	return "noscan"
}

func report(name string, ok bool) {
	if ok {
		fmt.Println(name, "ok")
		return
	}
	fmt.Println(name, "bad")
}

func main() {
	report("direct", Cells[Pair]() == int(unsafe.Sizeof(Pair{X: new(int)})) && Cells[Nest]() == int(unsafe.Sizeof(Nest{P: Pair{X: new(int)}})))
	report("fields", FieldCells() == int(unsafe.Sizeof(Pair{X: new(int)}))+int(unsafe.Sizeof(int(0))))
	report("const if", ScanMark[Pair]() == "scan" && ScanMark[int]() == "scan")
}
