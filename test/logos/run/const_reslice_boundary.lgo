// run

package main


import (
	"fmt"
	"os"
	"strings"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func trapped(f func()) bool {
	did := false
	func() {
		defer func() {
			if recover() != nil {
				did = true
			}
		}()
		f()
	}()
	return did
}

func makeSecretView() const []byte {
	storage := []byte("PUBLICSECRET")
	return storage[:6]
}

func testBounds(v const []byte) {
	hi := 10

	gotTrap2 := trapped(func() {
		_ = v[:hi]
	})
	check("trap-2index", gotTrap2, gotTrap2, true)

	gotTrap3 := trapped(func() {
		_ = v[:hi:hi]
	})
	check("trap-3index", gotTrap3, gotTrap3, true)

	compoundCalls := 0
	getConstView := func() const []byte {
		compoundCalls++
		return v
	}

	gotTrapCompound := trapped(func() {
		_ = getConstView()[:hi]
	})
	check("trap-compound", gotTrapCompound, gotTrapCompound, true)
	check("compound-once", compoundCalls == 1, compoundCalls, 1)
}

func testLegalCases(v const []byte) {
	gotFull := !trapped(func() {
		s := v[:]
		if len(s) != 6 {
			panic("unexpected len")
		}
	})
	check("legal-full", gotFull, gotFull, true)

	got2 := !trapped(func() {
		s := v[:6]
		if len(s) != 6 {
			panic("unexpected len")
		}
	})
	check("legal-2index", got2, got2, true)

	got3 := !trapped(func() {
		s := v[:6:6]
		if len(s) != 6 {
			panic("unexpected len")
		}
	})
	check("legal-3index", got3, got3, true)

	compoundCalls := 0
	getConstView := func() const []byte {
		compoundCalls++
		return v
	}

	gotCompound := !trapped(func() {
		s := getConstView()[:6]
		if len(s) != 6 {
			panic("unexpected len")
		}
	})
	check("legal-compound", gotCompound, gotCompound, true)
	check("legal-compound-once", compoundCalls == 1, compoundCalls, 1)
}

func testEvaluationOrder(v const []byte) {
	var evalOrder []string

	orderItem := func(tag string, val int) int {
		evalOrder = append(evalOrder, tag)
		return val
	}

	orderBase := func() const []byte {
		evalOrder = append(evalOrder, "base")
		return v
	}

	evalOrder = nil
	_ = orderBase()[orderItem("low", 1):orderItem("high", 4)]
	check("eval-2index", strings.Join(evalOrder, " -> ") == "base -> low -> high", strings.Join(evalOrder, " -> "), "base -> low -> high")

	evalOrder = nil
	_ = orderBase()[orderItem("low", 1):orderItem("high", 4):orderItem("max", 6)]
	check("eval-3index", strings.Join(evalOrder, " -> ") == "base -> low -> high -> max", strings.Join(evalOrder, " -> "), "base -> low -> high -> max")

	evalOrder = nil
	gotPanic2 := trapped(func() {
		_ = orderBase()[orderItem("low", 1):orderItem("high", 10)]
	})
	check("eval-panic-2index-trap", gotPanic2, gotPanic2, true)
	check("eval-panic-2index-order", strings.Join(evalOrder, " -> ") == "base -> low -> high", strings.Join(evalOrder, " -> "), "base -> low -> high")

	evalOrder = nil
	gotPanic3 := trapped(func() {
		_ = orderBase()[orderItem("low", 1):orderItem("high", 4):orderItem("max", 10)]
	})
	check("eval-panic-3index-trap", gotPanic3, gotPanic3, true)
	check("eval-panic-3index-order", strings.Join(evalOrder, " -> ") == "base -> low -> high -> max", strings.Join(evalOrder, " -> "), "base -> low -> high -> max")
}

func testCallerScope(v const []byte) {
	gotCaller := !trapped(func() {
		defer func() {
			if got := len(v[0:len(fmt.Sprint(recover())):6]); got != 4 {
				panic(got)
			}
		}()
		panic("xxxx")
	})
	check("recover-caller", gotCaller, gotCaller, true)
}

func main() {
	var v const []byte = makeSecretView()
	testBounds(v)
	testLegalCases(v)
	testEvaluationOrder(v)
	testCallerScope(v)
	if failed {
		os.Exit(1)
	}
}
