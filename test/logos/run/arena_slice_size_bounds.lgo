// run -goexperiment logosarena
// run -goexperiment logosarena -arena=false

package main


import (
	"fmt"
	"reflect"
	"runtime"
)

type e16 struct {
	lo int64
	hi int64
}

var sink []e16

func panicValue(fn func()) (value any) {
	defer func() {
		value = recover()
	}()
	fn()
	return
}

//go:noinline
func arenaE16(n, c int) (int, int, int64) {
	b := make([]e16, n, c)
	if len(b) != n || cap(b) != c {
		panic("bounds: arena len/cap mismatch")
	}
	if cap(b) > 1024 {
		panic("bounds: arena backing cap unexpectedly large")
	}
	all := b[:cap(b)]
	for i := range all {
		if all[i].lo != 0 || all[i].hi != 0 {
			panic("bounds: arena backing not zeroed")
		}
	}
	var sum int64
	for i := range b {
		b[i].lo = int64(i + 1)
		b[i].hi = int64(i + 2)
	}
	for i := range b {
		if b[i].lo != int64(i+1) || b[i].hi != int64(i+2) {
			panic("bounds: arena backing not usable")
		}
		sum += b[i].lo + b[i].hi
	}
	return len(b), cap(b), sum
}

//go:noinline
func heapE16(n, c int) (int, int, int64) {
	b := make([]e16, n, c)
	sink = b
	if len(b) != n || cap(b) != c {
		panic("bounds: heap len/cap mismatch")
	}
	if cap(b) > 1024 {
		panic("bounds: heap backing cap unexpectedly large")
	}
	all := b[:cap(b)]
	for i := range all {
		if all[i].lo != 0 || all[i].hi != 0 {
			panic("bounds: heap backing not zeroed")
		}
	}
	var sum int64
	for i := range b {
		b[i].lo = int64(i + 1)
		b[i].hi = int64(i + 2)
	}
	for i := range b {
		if b[i].lo != int64(i+1) || b[i].hi != int64(i+2) {
			panic("bounds: heap backing not usable")
		}
		sum += b[i].lo + b[i].hi
	}
	return len(b), cap(b), sum
}

func checkValid(what string, n, c int) {
	al, ac, asum := arenaE16(n, c)
	hl, hc, hsum := heapE16(n, c)
	if al != hl || ac != hc || asum != hsum {
		panic("bounds: " + what + ": arena/native result mismatch")
	}
}

func checkPair(what string, n, c int) {
	native := panicValue(func() { heapE16(n, c) })
	heapError, hok := native.(runtime.Error)
	if !hok {
		panic(fmt.Sprintf("bounds: %s: native panic = %T", what, native))
	}
	actual := panicValue(func() { arenaE16(n, c) })
	arenaError, aok := actual.(runtime.Error)
	if !aok || reflect.TypeOf(actual) != reflect.TypeOf(native) || arenaError.Error() != heapError.Error() {
		panic(fmt.Sprintf("bounds: %s: arena panic = %T %v, native = %T %v", what, actual, actual, native, native))
	}
}

//go:noinline
func runtimeInt(v int) int {
	return v
}

func main() {
	zero := runtimeInt(0)
	one := runtimeInt(1)
	two := runtimeInt(2)
	three := runtimeInt(3)
	five := runtimeInt(5)
	negOne := runtimeInt(-1)
	wrap := runtimeInt(1 << 60)

	checkPair("zero/wrap cap", zero, wrap)
	checkPair("wrap/wrap len", wrap, wrap)
	checkPair("one/wrap cap", one, wrap)
	checkPair("negative len", negOne, one)
	checkPair("negative cap", one, negOne)
	checkPair("len greater than cap", two, one)

	checkValid("one/one", one, one)
	checkValid("three/five", three, five)
	_ = sink
}
