// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Qualified interface {
	const Name() string
}

type Ordinary interface {
	Name() string
}

func Early(q Qualified) string { return "early:" + q.Name() }

func Greet(q Qualified) string { return q.Name() }

func GreetOrd(o Ordinary) string { return o.Name() }

func ViaConst(p const *Rock) string { return p.Name() }

func Names(cs const []Qualified) string {
	out := ""
	for i, c := range cs {
		if i > 0 {
			out += ","
		}
		out += c.Name()
	}
	return out
}

type Rock struct {
	name string
}

func (r Rock) Name() string { return "rock:" + r.name }

type Troll struct {
	name string
}

func (t Troll) Name() string { return "troll:" + t.name }

func (r const *Rock) Title() string { return "title:" + r.name }

type Box struct {
	label string
	items []int
}

func (b Box) Name() string {
	if len(b.items) == 0 {
		return b.label + ":empty"
	}
	total := 0
	for _, x := range b.items {
		total += x
	}
	if total == 0 {
		return b.label + ":zero"
	}
	return b.label
}

type Alias = Rock

func GenericName[T Qualified](t T) string { return t.Name() }

func main() {
	r := Rock{name: "a"}
	check("greet", Greet(r) == "rock:a", Greet(r), "rock:a")
	check("greet-ord", GreetOrd(r) == "rock:a", GreetOrd(r), "rock:a")
	check("via-const", ViaConst(&r) == "rock:a", ViaConst(&r), "rock:a")
	check("title", r.Title() == "title:a", r.Title(), "title:a")

	t := Troll{name: "grok"}
	check("greet-troll", Greet(t) == "troll:grok", Greet(t), "troll:grok")
	check("greet-ord-troll", GreetOrd(t) == "troll:grok", GreetOrd(t), "troll:grok")

	b := Box{label: "box", items: []int{1, 2, 3}}
	check("box", Greet(b) == "box", Greet(b), "box")
	e := Box{label: "e", items: []int{}}
	check("box-empty", Greet(e) == "e:empty", Greet(e), "e:empty")

	check("early", Early(Late{tag: "x"}) == "early:late:x", Early(Late{tag: "x"}), "early:late:x")

	var a Alias = Alias{name: "al"}
	check("alias", Greet(a) == "rock:al", Greet(a), "rock:al")
	check("generic", GenericName(r) == "rock:a", GenericName(r), "rock:a")

	check("names-rocks", Names([]Rock{{name: "a"}, {name: "b"}}) == "rock:a,rock:b", Names([]Rock{{name: "a"}, {name: "b"}}), "rock:a,rock:b")
	check("names-troll", Names([]Troll{{name: "ug"}}) == "troll:ug", Names([]Troll{{name: "ug"}}), "troll:ug")
	check("names-alias", Names([]Alias{{name: "al"}}) == "rock:al", Names([]Alias{{name: "al"}}), "rock:al")
	if failed {
		os.Exit(1)
	}
}

type Late struct {
	tag string
}

func (l Late) Name() string { return "late:" + l.tag }
