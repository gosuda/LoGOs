// run
package main

import (
	"bytes"
	"comptime"
	"encoding/json"
	"fmt"
	"os"
)

type CJS1 struct {
	A int64  `json:"a"`
	B string `json:"b,omitempty"`
}

type CJS1Mirror CJS1

type CJS2 struct {
	X float64 `json:"x"`
	Y string  `json:"y"`
	Z int64   `json:"z,omitempty"`
}

type CJS2Mirror CJS2

var failed bool

func check(name, got, want string) {
	if got != want {
		fmt.Println("FAIL", name, "got", got, "want", want)
		failed = true
		return
	}
	fmt.Println("ok", name)
}

func FieldCount[T any]() int {
	n := 0
	const for _, f := range comptime.Fields[T]() {
		n++
		_ = f.Name
	}
	return n
}

func JMarshal[T any](v T) []byte {
	const for _, f := range comptime.Fields[T]() {
		_ = f.Name
	}
	b, err := json.Marshal(v)
	if err != nil {
		panic(err)
	}
	return b
}

func main() {
	check("field-count-cjs1", fmt.Sprint(FieldCount[CJS1]()), "2")
	check("field-count-cjs2", fmt.Sprint(FieldCount[CJS2]()), "3")
	a := CJS1{A: 1, B: "x"}
	ad, aerr := a.MarshalJSON()
	awant, awerr := json.Marshal(CJS1Mirror(a))
	check("marshal-cjs1-matches-reflective", fmt.Sprint(bytes.Equal(ad, awant), bytes.Equal(JMarshal(a), awant), aerr, awerr), "true true <nil> <nil>")
	b := CJS2{X: 1.5, Y: "a<b", Z: 0}
	bd, berr := b.MarshalJSON()
	bwant, bwerr := json.Marshal(CJS2Mirror(b))
	check("marshal-cjs2-matches-reflective", fmt.Sprint(bytes.Equal(bd, bwant), bytes.Equal(JMarshal(b), bwant), berr, bwerr), "true true <nil> <nil>")
	c := CJS2{X: -2.5, Y: "\xff\xfe\u2028end", Z: 9}
	cd, cerr := c.MarshalJSON()
	cwant, cwerr := json.Marshal(CJS2Mirror(c))
	check("marshal-cjs2-escaping-matches-reflective", fmt.Sprint(bytes.Equal(cd, cwant), bytes.Equal(JMarshal(c), cwant), cerr, cwerr), "true true <nil> <nil>")
	if failed {
		os.Exit(1)
	}
}
