// run

package main

import "fmt"


type User struct {
	Name string
	Age  int
}

func (u User) Greet() string { return "hi " + u.Name }

func (u *User) SetAge(a int) { u.Age = a }
type Team struct {
	Lead *User?
}

func firstOr(x int?, d int) int { return x ?? d }

func greet(u *User?) string { return u?.Name ?? "anon" }

func main() {
	var u *User?
	fmt.Println(greet(u))
	u = &User{Name: "ann", Age: 3}
	fmt.Println(greet(u))
	fmt.Println(u?.Name ?? "anon")
	fmt.Println(u?.Age ?? -1)
	var v *User?
	fmt.Println(v?.Name ?? "anon")
	fmt.Println(v?.Age ?? -1)
	fmt.Println(u?.Greet() ?? "nogreet")
	fmt.Println(v?.Greet() ?? "nogreet")
	u?.SetAge(5)
	fmt.Println(u?.Age ?? -1)
	v?.SetAge(5)
	fmt.Println(v?.Age ?? -1)
	var leadTeam *Team? = &Team{Lead: &User{Name: "ann"}}
	fmt.Println(leadTeam?.Lead?.Name ?? "anon")
	var emptyTeam *Team? = &Team{}
	fmt.Println(emptyTeam?.Lead?.Name ?? "anon")
	var noTeam *Team?
	fmt.Println(noTeam?.Lead?.Name ?? "anon")
	var n int?
	fmt.Println(firstOr(n, 7))
	n = 41
	fmt.Println(firstOr(n, 7))
	fmt.Println(n ?? 0)
}
