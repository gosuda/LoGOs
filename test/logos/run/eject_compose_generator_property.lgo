func c_prop_write_proplam(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	w.P = apply(x => x + w.P, v)
	r := w.P
	return r, nil
}

func c_prop_write_propr(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	w.P = w.P
	r := w.P
	return r, nil
}

func c_prop_write_sw(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	w.P = switch v {
		case 7 => 70
		default => 1
		}
	r := w.P
	return r, nil
}

func g_c_yield_op_chainc(v int, xs []int, fail bool) iter.Seq[int] {
	_ = xs
	_ = fail
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	yield xs.map(x => x + v).count()
}

func c_yield_op_chainc(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	r := 0
	for y := range g_c_yield_op_chainc(v, xs, fail) {
		r += y
	}
	return r, nil
}

