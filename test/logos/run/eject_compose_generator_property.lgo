package main

import (
	"context"
	"errors"
	"fmt"
	"iter"
	"os"
)

var _ iter.Seq[int]

type pc struct {
	id int
}

type box struct {
	o int?
	p int
}

type State struct {
	A int
	B int
}

type Prop interface {
	P int
}

type propBox struct : Prop {
	P int
}

var errLoad = errors.New("load")

var last int

func load(v int, fail bool) (int, error) {
	if fail {
		return 0, errLoad
	}
	return v, nil
}

func maybe(n int) int? {
	if n == 7 {
		return 7
	}
	return nil
}

func maybeP(n int) *pc? {
	if n == 7 {
		return &pc{id: 7}
	}
	return nil
}

func apply(f func(int) int, n int) int { return f(n) }

func viewLen(xs const []int) int { return len(xs) }

func record(n int) error {
	last = n
	return nil
}

func mkState(n int) State { return State{A: n, B: n + 1} }

func pair(n int) (int, string) { return n, "p" }

func tupA(t (int, string)) int {
	a, _ := t
	return a
}

var failed bool

func line(f func(int, bool) (int, error), fail bool) string {
	last = 0
	got, err := f(7, fail)
	if err != nil {
		return fmt.Sprintln(0, err, last)
	}
	return fmt.Sprintln(got, err, last)
}

func run(name string, f func(int, bool) (int, error), want string) {
	got := line(f, false) + line(f, true)
	if got != want {
		failed = true
		fmt.Printf("FAIL %s: got %q want %q\n", name, got, want)
		return
	}
	fmt.Println("ok", name)
}

func c_prop_write_chainc(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	w.P = xs.map(x => x + v).count()
	r := w.P
	return r, nil
}

func c_prop_write_coal(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	w.P = maybe(v) ?? -1
	r := w.P
	return r, nil
}

func c_prop_write_cv(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	w.P = viewLen(xs)
	r := w.P
	return r, nil
}

func c_prop_write_lamapply(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	w.P = apply(x => x + 1, v)
	r := w.P
	return r, nil
}

func c_prop_write_optcomp(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	w.P = box{o: maybe(v), p: 1}.p
	r := w.P
	return r, nil
}

