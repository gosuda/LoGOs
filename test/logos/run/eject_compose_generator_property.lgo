func main() {
	_ = context.Background
	run("prop-write__chainc", c_prop_write_chainc, "3 <nil> 0\n3 <nil> 0\n")
	run("prop-write__coal", c_prop_write_coal, "7 <nil> 0\n7 <nil> 0\n")
	run("prop-write__cv", c_prop_write_cv, "3 <nil> 0\n3 <nil> 0\n")
	run("prop-write__lamapply", c_prop_write_lamapply, "8 <nil> 0\n8 <nil> 0\n")
	run("prop-write__optcomp", c_prop_write_optcomp, "1 <nil> 0\n1 <nil> 0\n")
	run("prop-write__propcoal", c_prop_write_propcoal, "7 <nil> 0\n7 <nil> 0\n")
	run("prop-write__proplam", c_prop_write_proplam, "11 <nil> 0\n11 <nil> 0\n")
	run("prop-write__propr", c_prop_write_propr, "4 <nil> 0\n4 <nil> 0\n")
	run("prop-write__sw", c_prop_write_sw, "70 <nil> 0\n70 <nil> 0\n")
	run("yield-op__chainc", c_yield_op_chainc, "3 <nil> 0\n3 <nil> 0\n")
	run("yield-op__coal", c_yield_op_coal, "7 <nil> 0\n7 <nil> 0\n")
	run("yield-op__cv", c_yield_op_cv, "3 <nil> 0\n3 <nil> 0\n")
	run("yield-op__lamapply", c_yield_op_lamapply, "8 <nil> 0\n8 <nil> 0\n")
	run("yield-op__optcomp", c_yield_op_optcomp, "1 <nil> 0\n1 <nil> 0\n")
	run("yield-op__propcoal", c_yield_op_propcoal, "7 <nil> 0\n7 <nil> 0\n")
	run("yield-op__proplam", c_yield_op_proplam, "11 <nil> 0\n11 <nil> 0\n")
	run("yield-op__propr", c_yield_op_propr, "4 <nil> 0\n4 <nil> 0\n")
	run("yield-op__sw", c_yield_op_sw, "70 <nil> 0\n70 <nil> 0\n")
	run("yield-ret__chainc", c_yield_ret_chainc, "1 <nil> 0\n1 <nil> 0\n")
	run("yield-ret__coal", c_yield_ret_coal, "1 <nil> 0\n1 <nil> 0\n")
	run("yield-ret__cv", c_yield_ret_cv, "1 <nil> 0\n1 <nil> 0\n")
	run("yield-ret__lamapply", c_yield_ret_lamapply, "1 <nil> 0\n1 <nil> 0\n")
	run("yield-ret__optcomp", c_yield_ret_optcomp, "1 <nil> 0\n1 <nil> 0\n")
	run("yield-ret__propcoal", c_yield_ret_propcoal, "1 <nil> 0\n1 <nil> 0\n")
	run("yield-ret__proplam", c_yield_ret_proplam, "1 <nil> 0\n1 <nil> 0\n")
	run("yield-ret__propr", c_yield_ret_propr, "1 <nil> 0\n1 <nil> 0\n")
	run("yield-ret__sw", c_yield_ret_sw, "1 <nil> 0\n1 <nil> 0\n")
	if failed {
		os.Exit(1)
	}
}
