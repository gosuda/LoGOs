// run -goexperiment logosarena

package main


import (
	"context"
	"fmt"
	"os"
	"runtime"
	"testing"
)
var ptrN = 1024

var sinkInt int

var globalPtrSink []*Node

var ptrChan = make(chan []*Node, 1)

type Node struct {
	v int
}

type Mixed struct {
	p *Node
	v int
}

//go:noinline
func ptrSliceSum(s []*Node) int {
	sum := 0
	for _, p := range s {
		sum += p.v
	}
	return sum
}

//go:noinline
func ptrLocalSum(pool []*Node, n int) int {
	s := make([]*Node, 0, n)
	for _, p := range pool[:n] {
		s = append(s, p)
	}
	sum := 0
	for _, p := range s {
		sum += p.v
	}
	return sum
}

//go:noinline
func mixedLocalSum(pool []*Node, n int) int {
	s := make([]Mixed, 0, n)
	for i := 0; i < n; i++ {
		s = append(s, Mixed{p: pool[i], v: i})
	}
	sum := 0
	for _, m := range s {
		sum += m.v + m.p.v
	}
	return sum
}

//go:noinline
func ptrGCSum(n int) (int, bool) {
	s := make([]*Node, 0, n)
	for i := 0; i < n; i++ {
		s = append(s, &Node{v: i})
	}
	before := 0
	for _, p := range s {
		before += p.v
	}
	first := s[0]
	last := s[n-1]
	runtime.GC()
	runtime.GC()
	after := 0
	for _, p := range s {
		after += p.v
	}
	ident := s[0] == first && s[n-1] == last && before == after
	runtime.KeepAlive(s)
	return after, ident
}

//go:noinline
func mixedGCSum(n int) (int, bool) {
	s := make([]Mixed, 0, n)
	for i := 0; i < n; i++ {
		s = append(s, Mixed{p: &Node{v: i}, v: i})
	}
	before := 0
	for _, m := range s {
		before += m.v + m.p.v
	}
	first := s[0].p
	last := s[n-1].p
	runtime.GC()
	runtime.GC()
	after := 0
	for _, m := range s {
		after += m.v + m.p.v
	}
	ident := s[0].p == first && s[n-1].p == last && before == after
	runtime.KeepAlive(s)
	return after, ident
}

//go:noinline
func ptrLeakSum(pool []*Node, n int) int {
	s := make([]*Node, 0, n)
	for _, p := range pool[:n] {
		s = append(s, p)
	}
	globalPtrSink = s
	sum := 0
	for _, p := range s {
		sum += p.v
	}
	return sum
}

//go:noinline
func ptrChanSum(ctx context.Context, pool []*Node, n int) int {
	s := make([]*Node, 0, n)
	for _, p := range pool[:n] {
		s = append(s, p)
	}
	select {
	case ptrChan <- s:
	case <-ctx.Done():
		panic("arena_pointer_slice: ptrChan send canceled")
	default:
		panic("arena_pointer_slice: ptrChan send blocked (cap 1, expected empty)")
	}
	var t []*Node
	select {
	case t = <-ptrChan:
	case <-ctx.Done():
		panic("arena_pointer_slice: ptrChan recv canceled")
	default:
		panic("arena_pointer_slice: ptrChan recv blocked (cap 1, expected full)")
	}
	sum := 0
	for _, p := range t {
		sum += p.v
	}
	return sum
}

func main() {
	failed := false
	eq := func(name string, got, want int) {
		if got != want {
			fmt.Printf("FAIL %s: got %d want %d\n", name, got, want)
			failed = true
			return
		}
		fmt.Printf("ok %s\n", name)
	}
	trivSum := func(n int) int { return (n - 1) * n / 2 }
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	_ = ctx.Done()
	pool := make([]*Node, 0, ptrN)
	for i := 0; i < ptrN; i++ {
		pool = append(pool, &Node{v: i})
	}
	eq("local-pointer-slice-sum-matches-series", ptrLocalSum(pool, ptrN), trivSum(ptrN))
	eq("local-mixed-slice-sum-matches-doubled-series", mixedLocalSum(pool, ptrN), 2*trivSum(ptrN))
	gSum, gIdent := ptrGCSum(ptrN)
	eq("gc-preserves-pointer-slice-sum", gSum, trivSum(ptrN))
	if !gIdent {
		fmt.Println("FAIL gc-preserves-pointer-identity: got false want true")
		failed = true
	} else {
		fmt.Println("ok gc-preserves-pointer-identity")
	}
	mgSum, mgIdent := mixedGCSum(ptrN)
	eq("gc-preserves-mixed-slice-sum", mgSum, 2*trivSum(ptrN))
	if !mgIdent {
		fmt.Println("FAIL gc-preserves-mixed-pointer-identity: got false want true")
		failed = true
	} else {
		fmt.Println("ok gc-preserves-mixed-pointer-identity")
	}
	eq("leaked-slice-sum-matches-series", ptrLeakSum(pool, ptrN), trivSum(ptrN))
	eq("global-sink-keeps-leaked-sum", ptrSliceSum(globalPtrSink), trivSum(ptrN))
	eq("channel-roundtrip-preserves-sum", ptrChanSum(ctx, pool, ptrN), trivSum(ptrN))
	alloc := func(name string, got float64, wantZero bool) {
		if (got == 0) != wantZero {
			fmt.Printf("FAIL %s: got %v wantZero %v\n", name, got, wantZero)
			failed = true
			return
		}
		fmt.Printf("ok %s\n", name)
	}
	alloc("local-pointer-slice-avoids-alloc", testing.AllocsPerRun(100, func() { sinkInt = ptrLocalSum(pool, ptrN) }), true)
	alloc("local-mixed-slice-avoids-alloc", testing.AllocsPerRun(100, func() { sinkInt = mixedLocalSum(pool, ptrN) }), true)
	alloc("leaked-slice-forces-heap-alloc", testing.AllocsPerRun(100, func() { sinkInt = ptrLeakSum(pool, ptrN) }), false)
	alloc("channel-slice-forces-heap-alloc", testing.AllocsPerRun(100, func() { sinkInt = ptrChanSum(ctx, pool, ptrN) }), false)
	_ = sinkInt
	if failed {
		os.Exit(1)
	}
}
