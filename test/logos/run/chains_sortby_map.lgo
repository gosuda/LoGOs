// run
package main
import (
"fmt"
"os"
"slices"
)
var failed bool
func check(name string, cond bool, got, want any) {
if !cond {
failed = true
fmt.Println("FAIL", name+":", "got", got, "want", want)
return
}
fmt.Println("ok", name)
}
var calls int
func bump(x int) int {
calls++
return 10 * x
}
type pt struct {
name string
w int
}
func main() {
xs := []int{3, 1, 2}
ws := []string{"pear", "fig", "apple"}
check("sort-float", slices.Equal(xs.map(x => float64(x)).sortBy(x => x), []float64{1, 2, 3}), xs.map(x => float64(x)).sortBy(x => x), []float64{1, 2, 3})
check("sort-neg", slices.Equal(xs.map(x => float64(x) / 2).sortBy(f => -f), []float64{1.5, 1, 0.5}), xs.map(x => float64(x) / 2).sortBy(f => -f), []float64{1.5, 1, 0.5})
check("sort-filter", slices.Equal(xs.map(x => float64(x) / 2).filter(f => f > 0.75).sortBy(f => -f), []float64{1.5, 1}), xs.map(x => float64(x) / 2).filter(f => f > 0.75).sortBy(f => -f), []float64{1.5, 1})
check("sort-len", slices.Equal(ws.map(w => len(w)).filter(n => n > 3).sortBy(n => -n), []int{5, 4}), ws.map(w => len(w)).filter(n => n > 3).sortBy(n => -n), []int{5, 4})
check("count-float", xs.map(x => float64(x) / 2).count(f => f > 0.75) == 2, xs.map(x => float64(x) / 2).count(f => f > 0.75), 2)
calls = 0
fs := xs.map(x => func() int { return bump(x) }).sortBy(f => 0)
check("sort-func-len", len(fs) == 3 && calls == 0, fmt.Sprint(len(fs), calls), "3 0")
for i, f := range fs {
got := f()
want := []int{30, 10, 20}[i]
check(fmt.Sprint("sort-func-val", i), got == want, got, want)
}
check("sort-func-calls", calls == 3, calls, 3)
check("count-func", xs.map(x => func() int { return 10 * x }).count(f => f() > 15) == 2, xs.map(x => func() int { return 10 * x }).count(f => f() > 15), 2)
check("sort-str", slices.Equal(ws.map(w => w[:len(w)]).sortBy(w => w), []string{"apple", "fig", "pear"}), ws.map(w => w[:len(w)]).sortBy(w => w), []string{"apple", "fig", "pear"})
check("sort-suffix", slices.Equal(ws.map(w => w[1:]).sortBy(w => w), []string{"ear", "ig", "pple"}), ws.map(w => w[1:]).sortBy(w => w), []string{"ear", "ig", "pple"})
check("sort-trim", slices.Equal(ws.map(w => w[:len(w)-1]).sortBy(w => w), []string{"appl", "fi", "pea"}), ws.map(w => w[:len(w)-1]).sortBy(w => w), []string{"appl", "fi", "pea"})
check("sort-prefix", slices.Equal(ws.map(w => "<" + w[1:]).sortBy(w => w), []string{"<ear", "<ig", "<pple"}), ws.map(w => "<" + w[1:]).sortBy(w => w), []string{"<ear", "<ig", "<pple"})
check("sort-expr", slices.Equal(xs.map(x => x*2+len(ws[:x])).sortBy(n => n), []int{3, 6, 9}), xs.map(x => x*2+len(ws[:x])).sortBy(n => n), []int{3, 6, 9})
check("sort-comment-expr", slices.Equal(xs.map(x => x * 2).sortBy(n => n), []int{2, 4, 6}), xs.map(x => x * 2).sortBy(n => n), []int{2, 4, 6})
gotPtW := fmt.Sprint(ws.map(w => pt{w, len(w)}).sortBy(p => p.w))
check("sort-struct-w", gotPtW == "[{fig 3} {pear 4} {apple 5}]", gotPtW, "[{fig 3} {pear 4} {apple 5}]")
gotPtN := fmt.Sprint(ws.map(w => pt{w, len(w)}).sortBy(p => p.name))
check("sort-struct-name", gotPtN == "[{apple 5} {fig 3} {pear 4}]", gotPtN, "[{apple 5} {fig 3} {pear 4}]")
gotPtF := fmt.Sprint(ws.map(w => pt{w, len(w)}).filter(p => p.w > 3).sortBy(p => p.name))
check("sort-struct-filter", gotPtF == "[{apple 5} {pear 4}]", gotPtF, "[{apple 5} {pear 4}]")
check("sort-neg-int", slices.Equal(xs.sortBy(x => -x), []int{3, 2, 1}), xs.sortBy(x => -x), []int{3, 2, 1})
check("sort-len-str", slices.Equal(ws.sortBy(w => len(w)), []string{"fig", "pear", "apple"}), ws.sortBy(w => len(w)), []string{"fig", "pear", "apple"})
if failed {
os.Exit(1)
}
}
