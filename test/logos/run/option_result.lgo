// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func none() (int?)? {
	return nil
}

func someNone() (int?)? {
	var inner int? = nil
	return inner
}

func some(n int) (int?)? {
	var inner int? = n
	return inner
}

func grouped(n int) (int)? {
	return n
}

func main() {
	check("none-is-none", none() == nil, none() == nil, true)
	check("somenone-is-some", someNone() != nil, someNone() != nil, true)
	check("some-is-some", some(7) != nil, some(7) != nil, true)
	gotG := grouped(3) ?? 0
	check("grouped", gotG == 3, gotG, 3)
	if failed {
		os.Exit(1)
	}
}
