// run

package main

import (
	"fmt"
	"os"
)

func fail(tag string) {
	fmt.Println("FAIL", tag)
	os.Exit(1)
}

func shapeIndex() {
	a := [2]int{1, 2}
	m := [2][2]int{{3, 4}, {5, 6}}
	right := a + m[0]
	if right != [2]int{4, 6} {
		fail(fmt.Sprintf("index-right: got %v want %v", right, [2]int{4, 6}))
	}
	left := m[1] + a
	if left != [2]int{6, 8} {
		fail(fmt.Sprintf("index-left: got %v want %v", left, [2]int{6, 8}))
	}
	fmt.Println("ok index-operand-matches-scalar")
}

func shapeComposite() {
	a := [2]int{10, 20}
	right := a + [2]int{1, 2}
	if right != [2]int{11, 22} {
		fail(fmt.Sprintf("composite-right: got %v", right))
	}
	left := [2]int{1, 2} + a
	if left != [2]int{11, 22} {
		fail(fmt.Sprintf("composite-left: got %v", left))
	}
	fmt.Println("ok composite-operand-matches-scalar")
}

func shapePair() [2]int {
	return [2]int{3, 4}
}

func shapeCall() {
	if shapePair().sum() != 7 {
		fail("recv sum mismatch")
	}
	b := [2]int{10, 20}
	if b.dot(shapePair()) != 110 {
		fail("dotarg mismatch")
	}
	fmt.Println("ok call-operand-matches-scalar")
}

func shapeParen() {
	a := [2]int{1, 2}
	b := [2]int{3, 4}
	c := [2]int{5, 6}
	want := [2]int{9, 12}
	left := (a + b) + c
	if left != want {
		fail(fmt.Sprintf("paren-left: got %v want %v", left, want))
	}
	right := c + (a + b)
	if right != want {
		fail(fmt.Sprintf("paren-right: got %v want %v", right, want))
	}
	fmt.Println("ok paren-operand-matches-scalar")
}

func shapeAssert() {
	var v any = [2]int{1, 2}
	b := [2]int{3, 4}
	got := v.([2]int) + b
	if got != [2]int{4, 6} {
		fail(fmt.Sprintf("assert: got %v", got))
	}
	fmt.Println("ok assert-operand-matches-scalar")
}

func main() {
	shapeIndex()
	shapeComposite()
	shapeCall()
	shapeParen()
	shapeAssert()
}
