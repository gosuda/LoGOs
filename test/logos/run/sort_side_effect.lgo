// run

package main

import "fmt"


var effCalls int

func eff(x int) int {
	effCalls++
	return x
}

func main() {
	effCalls = 0
	r := []int{3, 1, 2}.map(x => eff(x)).sortBy(x => x) // ERROR "warning: \[suspicious::side_effect_before_sort\] chain lambda with a call of unknown purity before sortBy"
	fmt.Println(r)
	fmt.Println(effCalls)
	p := []int{3, 1, 2}.map(x => x * 2).sortBy(x => x)
	fmt.Println(p)
}
