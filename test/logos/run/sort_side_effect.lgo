// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

var effCalls int

func eff(x int) int {
	effCalls++
	return x
}

func main() {
	effCalls = 0
	r := []int{3, 1, 2}.map(x => eff(x)).sortBy(x => x) // ERROR "warning: \[suspicious::side_effect_before_sort\] chain lambda with a call of unknown purity before sortBy"
	check("sorted", fmt.Sprint(r) == "[1 2 3]", fmt.Sprint(r), "[1 2 3]")
	check("calls", effCalls == 3, effCalls, 3)
	p := []int{3, 1, 2}.map(x => x * 2).sortBy(x => x)
	check("scaled", fmt.Sprint(p) == "[2 4 6]", fmt.Sprint(p), "[2 4 6]")
	if failed {
		os.Exit(1)
	}
}
