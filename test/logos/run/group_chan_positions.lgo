// run

package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"time"
)

var errSib = errors.New("sibling failed")

const waitBound = 5 * time.Second

func failSibling() error { return errSib }

type env struct {
	in    chan int
	mid   chan int
	boxes chan box
	sinks []chan int
	chain chan chan int
	nums  []int
	anys  chan any
	out   int
}

type box struct {
	V int
}

type pair struct {
	A int
	B int
}

func store(p *int, v int) {
	*p = v
}

func recvParen(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			var ( v = <-e.in )
			e.out = v
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvBinop(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = <-e.in - <-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvCallarg(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			store(&e.out, <-e.in)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSendrecv(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.mid <- <-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvCond(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if <-e.in == 1 {
				e.out = 1
			} else if <-e.in == 2 {
				e.out = 2
			} else if e.out == 0 {
				e.out = -2
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvIfhoist(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if v := <-e.in + 1; v == 6 {
				e.out = v
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSwitchinit(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch v := <-e.in + 1; v {
			case 6:
				e.out = v
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvComposite(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			b := box{V: <-e.in}
			e.out = b.V
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvIfinit(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if v, ok := <-e.in; ok {
				e.out = v
			} else {
				e.out = -1
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSelect(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			select {
			case v := <-e.in:
				e.out = v
			case w := <-e.mid:
				e.out = w
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvRange(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			for v := range e.in {
				e.out += v
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSend(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.in <- 7
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSwitchtag(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch <-e.in {
			case 1:
				e.out = 1
			default:
				e.out = -1
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvIndex(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			a := [3]int{10, 20, 30}
			e.out = a[<-e.in]
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

//logos:allow(correctness::unbounded_channel_op)
func pushFive(e *env) int {
	e.in <- 5
	return 100
}

func recvCallorder(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = pushFive(e) + <-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func nilErr() error {
	return nil
}

func apply(p *int, v int, f func() error) {
	*p = v
	if f() != nil {
		*p = -1
	}
}

func recvLiteral(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			apply(&e.out, <-e.in, func() error {
				nilErr()?
				return nil
			})
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSelector(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = (<-e.boxes).V
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvUnary(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = -<-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

//logos:allow(correctness::unbounded_channel_op)
func pushMid(e *env) chan int {
	e.in <- 5
	return e.mid
}

//logos:allow(correctness::unbounded_channel_op)
func pushRows(e *env) []int {
	e.in <- 1
	return []int{10, 20, 30}
}

//logos:allow(correctness::unbounded_channel_op)
func pushAdder(e *env) func(int) int {
	e.in <- 5
	return func(v int) int { return v + 100 }
}

//logos:allow(correctness::unbounded_channel_op)
func pushIndex(e *env) int {
	e.in <- 5
	return 1
}

func inc(v int) int {
	return v + 1
}

func incErr(v int) (int, error) {
	return v + 1, nil
}

func recvSendcall(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			pushMid(e) <- <-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvMixed(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			a, b := <-e.in, inc(<-e.in)
			e.out = a*10 + b
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvMixedfirst(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			a, b := inc(<-e.in), <-e.mid
			e.out = a*10 + b
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvAssert(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = (<-e.anys).(int)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvTypeswitch(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch v := (<-e.anys).(type) {
			case int:
				e.out = v
			default:
				e.out = -1
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvNested(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = <-<-e.chain
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvNestedindex(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = <-e.sinks[<-e.in]
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvGoarg(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			go store(&e.out, <-e.in)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvKeyed(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			p := pair{A: pushFive(e), B: <-e.in}
			e.out = p.A + p.B
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvBinoperand(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = pushFive(e)*2 + <-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvIndexcall(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = pushRows(e)[<-e.in]
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvFuncall(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = pushAdder(e)(<-e.in)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvTarget(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			arr := []int{0, 0, 0}
			arr[pushIndex(e)] = <-e.in + 1
			e.out = arr[1]
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvTrycall(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			x := incErr(<-e.in)?
			e.out = x
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSlice(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = len(e.nums[<-e.in:])
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

type cell struct {
	name      string
	run       func(ctx context.Context, e *env, fail bool) error
	feed      []int
	boxes     []int
	sink      int
	nested    int
	anyv      int
	capIn     int
	closed    bool
	want      int
	left      int
	leftBoxes int
	observe   func(e *env) int
}

//logos:allow(correctness::unbounded_channel_op)
func fromMid(e *env) int {
	select {
	case v := <-e.mid:
		return v
	default:
		return -1
	}
}

//logos:allow(correctness::unbounded_channel_op)
func fromIn(e *env) int {
	select {
	case v := <-e.in:
		return v
	default:
		return -1
	}
}

func valueCells() []cell {
	return []cell{
		{name: "paren", run: recvParen, feed: []int{5, 99}, want: 5, left: 1},
		{name: "binop", run: recvBinop, feed: []int{10, 3, 99}, want: 7, left: 1},
		{name: "callarg", run: recvCallarg, feed: []int{5, 99}, want: 5, left: 1},
		{name: "callorder", run: recvCallorder, capIn: 1, want: 105},
		{name: "literal", run: recvLiteral, feed: []int{5, 99}, want: 5, left: 1},
		{name: "sendrecv", run: recvSendrecv, feed: []int{5, 99}, want: 5, left: 1, observe: fromMid},
		{name: "cond", run: recvCond, feed: []int{1, 99}, want: 1, left: 1},
		{name: "elseif", run: recvCond, feed: []int{3, 2, 99}, want: 2, left: 1},
		{name: "elseif-plain", run: recvCond, feed: []int{3, 4, 99}, want: -2, left: 1},
		{name: "composite", run: recvComposite, feed: []int{5, 99}, want: 5, left: 1},
		{name: "selector", run: recvSelector, boxes: []int{9, 99}, want: 9, leftBoxes: 1},
		{name: "unary", run: recvUnary, feed: []int{5, 99}, want: -5, left: 1},
		{name: "ifinit", run: recvIfinit, feed: []int{5, 99}, want: 5, left: 1},
		{name: "ifinit-closed", run: recvIfinit, closed: true, want: -1},
		{name: "select", run: recvSelect, feed: []int{5, 99}, want: 5, left: 1},
		{name: "range", run: recvRange, feed: []int{1, 2, 3}, closed: true, want: 6},
		{name: "send", run: recvSend, capIn: 1, want: 7, observe: fromIn},
		{name: "switchtag", run: recvSwitchtag, feed: []int{1, 99}, want: 1, left: 1},
		{name: "index", run: recvIndex, feed: []int{2, 99}, want: 30, left: 1},
		{name: "ifhoist", run: recvIfhoist, feed: []int{5, 99}, want: 6, left: 1},
		{name: "sendcall", run: recvSendcall, capIn: 1, want: 5, observe: fromMid},
		{name: "mixed", run: recvMixed, feed: []int{4, 5, 99}, want: 46, left: 1},
		{name: "nested", run: recvNested, nested: 7, want: 7},
		{name: "nestedindex", run: recvNestedindex, feed: []int{0, 99}, sink: 7, want: 7, left: 1},
		{name: "goarg", run: recvGoarg, feed: []int{5, 99}, want: 5, left: 1},
		{name: "keyed", run: recvKeyed, capIn: 1, want: 105},
		{name: "binoperand", run: recvBinoperand, capIn: 1, want: 205},
		{name: "indexcall", run: recvIndexcall, capIn: 1, want: 20},
		{name: "funcall", run: recvFuncall, capIn: 1, want: 105},
		{name: "target", run: recvTarget, capIn: 1, want: 6},
		{name: "trycall", run: recvTrycall, feed: []int{5, 99}, want: 6, left: 1},
		{name: "slice", run: recvSlice, feed: []int{1, 99}, want: 3, left: 1},
		{name: "assert", run: recvAssert, anyv: 8, want: 8},
		{name: "typeswitch", run: recvTypeswitch, anyv: 9, want: 9},
		{name: "switchinit", run: recvSwitchinit, feed: []int{5, 99}, want: 6, left: 1},
	}
}

func cancelCells() []cell {
	return []cell{
		{name: "paren-cancel", run: recvParen},
		{name: "binop-cancel", run: recvBinop},
		{name: "callarg-cancel", run: recvCallarg},
		{name: "literal-cancel", run: recvLiteral},
		{name: "sendrecv-cancel", run: recvSendrecv},
		{name: "cond-cancel", run: recvCond},
		{name: "composite-cancel", run: recvComposite},
		{name: "selector-cancel", run: recvSelector},
		{name: "unary-cancel", run: recvUnary},
		{name: "ifinit-cancel", run: recvIfinit},
		{name: "select-cancel", run: recvSelect},
		{name: "range-cancel", run: recvRange},
		{name: "send-cancel", run: recvSend},
		{name: "switchtag-cancel", run: recvSwitchtag},
		{name: "index-cancel", run: recvIndex},
		{name: "nested-cancel", run: recvNested},
		{name: "nestedindex-cancel", run: recvNestedindex},
		{name: "mixedfirst-cancel", run: recvMixedfirst},
		{name: "assert-cancel", run: recvAssert},
		{name: "typeswitch-cancel", run: recvTypeswitch},
		{name: "goarg-cancel", run: recvGoarg},
		{name: "trycall-cancel", run: recvTrycall},
		{name: "slice-cancel", run: recvSlice},
	}
}

//logos:allow(correctness::unbounded_channel_op)
func exercise(c cell, fail bool) string {
	e := &env{in: make(chan int, max(len(c.feed), c.capIn)), mid: make(chan int, 1), boxes: make(chan box, len(c.boxes))}
	e.sinks = []chan int{make(chan int, 1)}
	e.chain = make(chan chan int, 1)
	e.nums = []int{1, 2, 3, 4}
	e.anys = make(chan any, 1)
	if c.anyv != 0 {
		e.anys <- c.anyv
	}
	if c.sink != 0 {
		e.sinks[0] <- c.sink
	}
	if c.nested != 0 {
		inner := make(chan int, 1)
		inner <- c.nested
		e.chain <- inner
	}
	for _, v := range c.feed {
		e.in <- v
	}
	for _, v := range c.boxes {
		e.boxes <- box{V: v}
	}
	if c.closed {
		close(e.in)
	}
	watchdog := time.AfterFunc(waitBound, func() {
		fmt.Printf("FAIL %s: group did not return within the bound\n", c.name)
		os.Exit(1)
	})
	err := c.run(context.Background(), e, fail)
	watchdog.Stop()
	if fail != errors.Is(err, errSib) || (!fail && err != nil) {
		return fmt.Sprintf("got error %v", err)
	}
	got := e.out
	if c.observe != nil {
		got = c.observe(e)
	}
	if got != c.want {
		return fmt.Sprintf("got %d want %d", got, c.want)
	}
	if len(e.in) != c.left || len(e.boxes) != c.leftBoxes {
		return fmt.Sprintf("got %d and %d values left want %d and %d", len(e.in), len(e.boxes), c.left, c.leftBoxes)
	}
	return ""
}

func selected(name string) bool {
	return len(os.Args) < 2 || os.Args[1] == name
}

func main() {
	failed := false
	report := func(name, problem string) {
		if problem != "" {
			fmt.Printf("FAIL %s: %s\n", name, problem)
			failed = true
			return
		}
		fmt.Printf("ok %s\n", name)
	}
	for _, c := range valueCells() {
		if selected(c.name) {
			report(c.name, exercise(c, false))
		}
	}
	for _, c := range cancelCells() {
		if selected(c.name) {
			report(c.name, exercise(c, true))
		}
	}
	if failed {
		os.Exit(1)
	}
}
