// run

package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"slices"
	"time"
)

var errSib = errors.New("sibling failed")

const waitBound = 5 * time.Second

func failSibling() error { return errSib }

type env struct {
	in    chan int
	mid   chan int
	boxes chan box
	sinks []chan int
	chain chan chan int
	nums  []int
	anys  chan any
	flag  bool
	base  int
	calls int
	bad   bool
	undo  int
	out   int
}

type box struct {
	V int
}

type pair struct {
	A int
	B int
}

func store(p *int, v int) {
	*p = v
}

func recvParen(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			var ( v = <-e.in )
			e.out = v
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvBinop(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = <-e.in - <-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvCallarg(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			store(&e.out, <-e.in)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSendrecv(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.mid <- <-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvCond(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if <-e.in == 1 {
				e.out = 1
			} else if <-e.in == 2 {
				e.out = 2
			} else if e.out == 0 {
				e.out = -2
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvIfhoist(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if v := <-e.in + 1; v == 6 {
				e.out = v
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSwitchinit(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch v := <-e.in + 1; v {
			case 6:
				e.out = v
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvComposite(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			b := box{V: <-e.in}
			e.out = b.V
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvIfinit(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if v, ok := <-e.in; ok {
				e.out = v
			} else {
				e.out = -1
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSelect(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			select {
			case v := <-e.in:
				e.out = v
			case w := <-e.mid:
				e.out = w
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvRange(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			for v := range e.in {
				e.out += v
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSend(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.in <- 7
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSwitchtag(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch <-e.in {
			case 1:
				e.out = 1
			default:
				e.out = -1
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvIndex(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			a := [3]int{10, 20, 30}
			e.out = a[<-e.in]
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

//logos:allow(correctness::unbounded_channel_op)
func pushFive(e *env) int {
	e.in <- 5
	return 100
}

func recvCallorder(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = pushFive(e) + <-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func nilErr() error {
	return nil
}

func apply(p *int, v int, f func() error) {
	*p = v
	if f() != nil {
		*p = -1
	}
}

func recvLiteral(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			apply(&e.out, <-e.in, func() error {
				nilErr()?
				return nil
			})
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSelector(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = (<-e.boxes).V
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvUnary(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = -<-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

//logos:allow(correctness::unbounded_channel_op)
func pushMid(e *env) chan int {
	e.in <- 5
	return e.mid
}

//logos:allow(correctness::unbounded_channel_op)
func pushRows(e *env) []int {
	e.in <- 1
	return []int{10, 20, 30}
}

//logos:allow(correctness::unbounded_channel_op)
func pushAdder(e *env) func(int) int {
	e.in <- 5
	return func(v int) int { return v + 100 }
}

//logos:allow(correctness::unbounded_channel_op)
func pushIndex(e *env) int {
	e.in <- 5
	return 1
}

func inc(v int) int {
	return v + 1
}

func incErr(v int) (int, error) {
	return v + 1, nil
}

func recvSendcall(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			pushMid(e) <- <-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvMixed(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			a, b := <-e.in, inc(<-e.in)
			e.out = a*10 + b
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvMixedfirst(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			a, b := inc(<-e.in), <-e.mid
			e.out = a*10 + b
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvAssert(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = (<-e.anys).(int)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvTypeswitch(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch v := (<-e.anys).(type) {
			case int:
				e.out = v
			default:
				e.out = -1
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvNested(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = <-<-e.chain
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvNestedindex(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = <-e.sinks[<-e.in]
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvGoarg(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			go store(&e.out, <-e.in)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvKeyed(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			p := pair{A: pushFive(e), B: <-e.in}
			e.out = p.A + p.B
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvBinoperand(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = pushFive(e)*2 + <-e.in
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvIndexcall(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = pushRows(e)[<-e.in]
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvFuncall(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = pushAdder(e)(<-e.in)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvTarget(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			arr := []int{0, 0, 0}
			arr[pushIndex(e)] = <-e.in + 1
			e.out = arr[1]
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvTrycall(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			x := incErr(<-e.in)?
			e.out = x
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvSlice(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = len(e.nums[<-e.in:])
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func tick(e *env, v int) int {
	e.calls++
	return v
}

func record(e *env, a, b int) {
	e.out = a*10 + b
}

func setb(e *env, b bool) {
	if b {
		e.out = 1
	}
}

func b2i(b bool) int {
	if b {
		return 1
	}
	return 0
}

func condFor(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			for <-e.in < 3 {
				w := 1
				e.out += w
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condForPost(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			for i := 0; i < 6; i += <-e.in {
				if i == 2 {
					continue
				}
				e.out += i
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condForLabel(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
		outer:
			for i := 0; i < 9; i += <-e.in {
				e.out = i
				for {
					if i > 2 {
						break outer
					}
					continue outer
				}
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condAnd(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if e.flag && <-e.in == 1 {
				e.out = 1
			} else {
				e.out = 2
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condOr(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if !e.flag || <-e.in == 1 {
				e.out = 1
			} else {
				e.out = 2
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condAndCount(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if tick(e, 1) == 1 && <-e.in == 1 {
				e.out = 1
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condAndNest(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			x := e.flag && (<-e.in == 1 || <-e.in == 2)
			e.out = b2i(x)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condAndArg(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			e.out = b2i(e.flag && <-e.in == 1)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condAndIndex(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if e.flag && e.nums[<-e.in] == 3 {
				e.out = 1
			} else {
				e.out = 2
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condCase(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch {
			case e.flag:
				w := 1
				e.out = w
			case <-e.in == 2:
				w := 2
				e.out = w
			default:
				w := 3
				e.out = w
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condCaseTag(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch tick(e, 5) {
			case 1:
				e.out = 1
			case <-e.in:
				e.out = 2
			case 5, <-e.in:
				e.out = 3
			default:
				e.out = 4
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condCaseFall(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch {
			case <-e.in == 1:
				e.out = 1
				fallthrough
			case false:
				e.out += 10
			default:
				e.out = 99
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condIfInit(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if v := e.base; <-e.in == v {
				w := 1
				e.out = w
			} else if v > 0 {
				w := 2
				e.out = w
			} else {
				w := 3
				e.out = w
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condSwitchInit(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch v := e.base; <-e.in {
			case v:
				w := 1
				e.out = w
			default:
				w := v + 100
				e.out = w
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condDefer(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			defer record(e, tick(e, 4), <-e.in)
			e.out = -1
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condGo(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			go record(e, tick(e, 4), e.nums[<-e.in])
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condGoAnd(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			go setb(e, e.flag && <-e.in == 1)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condForComma(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			for v, ok := <-e.in; ok; v, ok = <-e.in {
				e.out += v
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condSwitchComma(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch v, ok := <-e.in; {
			case ok:
				e.out = v
			default:
				e.out = -1
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condNestedRange(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			for range 2 {
				for v := range e.in {
					e.out += v
				}
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condForInit(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			for i := <-e.in; i < 3; i++ {
				e.out += i
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func condRangeRecv(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			for v := range <-e.chain {
				e.out += v
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func pick(e *env) (int, error) {
	e.calls++
	if e.bad {
		return 0, errSib
	}
	return e.base, nil
}

func pickArg(e *env, a int) (int, error) {
	e.calls++
	if e.bad {
		return 0, errSib
	}
	return a, nil
}

func undo(e *env) {
	e.undo++
}

func guard(e *env) error {
	e.calls++
	if e.bad {
		return errSib
	}
	return nil
}

func tryIfExprInit(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if guard(e)?; <-e.in == 1 {
				e.out = 1
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func tryIfCond(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if v := pick(e)?; <-e.in == v {
				e.out = 1
			} else {
				e.out = 2
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func tryIfInitRecv(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			if v := pickArg(e, <-e.in)?; v > 0 {
				e.out = v
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func trySwitchTag(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch v := pick(e)?; <-e.in {
			case v:
				e.out = 1
			default:
				e.out = 2
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func trySwitchCase(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			switch v := pick(e)?; {
			case <-e.in == v:
				e.out = 1
			default:
				e.out = 2
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func tryForCond(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			for i := pick(e)?; <-e.in < i; {
				e.out++
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func tryForPost(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			for i := pick(e)?; i < 10; i += <-e.in {
				e.out++
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func tryLabeledFor(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
		loop:
			for v := pick(e)?; <-e.in < v; {
				e.out++
				if e.out == 2 {
					break loop
				}
				continue loop
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func tryLabeledSwitch(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
		sw:
			switch v := pick(e)?; <-e.in {
			case v:
				if e.flag {
					break sw
				}
				e.out = 1
			default:
				e.out = 2
			}
			e.out += 10
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func tryUndo(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			errdefer undo(e)
			if v := pick(e)?; <-e.in == v {
				e.out = 1
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvVarGroup(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			var (
				x     = tick(e, 1)
				v, ok = <-e.in
			)
			e.out = x*100 + v*10 + b2i(ok)
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvErrdeferArg(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			errdefer record(e, 1, <-e.in)
			failSibling()?
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvScopeDeferArg(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			scope defer record(e, 2, <-e.in)
			e.out = 99
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvScopeDeferLoop(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			for i := 0; i < 1; i++ {
				scope defer record(e, 2, <-e.in)
				e.out = 99
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvInterp(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			s := $"v={<-e.in}"
			if s == "v=7" {
				e.out = 1
			}
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}

func recvTupleLit(ctx context.Context, e *env, fail bool) error {
	go group (ctx) {
		go {
			t := (<-e.in, 2)
			a, b := t
			e.out = a*10 + b
		}
		go {
			if fail {
				failSibling()?
			}
		}
	}
	return nil
}
type cell struct {
	name      string
	run       func(ctx context.Context, e *env, fail bool) error
	feed      []int
	boxes     []int
	sink      int
	nested    int
	inner     []int
	anyv      int
	flag      bool
	base      int
	calls     int
	bad       bool
	undo      int
	capIn     int
	closed    bool
	want      int
	left      int
	leftBoxes int
	observe   func(e *env) int
}

//logos:allow(correctness::unbounded_channel_op)
func fromMid(e *env) int {
	select {
	case v := <-e.mid:
		return v
	default:
		return -1
	}
}

//logos:allow(correctness::unbounded_channel_op)
func fromIn(e *env) int {
	select {
	case v := <-e.in:
		return v
	default:
		return -1
	}
}

