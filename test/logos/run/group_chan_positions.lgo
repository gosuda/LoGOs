//logos:allow(correctness::unbounded_channel_op)
func newEnv(c cell) *env {
	e := &env{in: make(chan int, max(len(c.feed), c.capIn)), mid: make(chan int, 1), boxes: make(chan box, len(c.boxes))}
	e.sinks = []chan int{make(chan int, 1)}
	e.chain = make(chan chan int, 1)
	e.nums = []int{1, 2, 3, 4}
	e.anys = make(chan any, 1)
	e.flag = c.flag
	e.base = c.base
	e.bad = c.bad
	if c.anyv != 0 {
		e.anys <- c.anyv
	}
	if c.sink != 0 {
		e.sinks[0] <- c.sink
	}
	if c.inner != nil {
		inner := make(chan int, len(c.inner))
		for _, v := range c.inner {
			inner <- v
		}
		close(inner)
		e.chain <- inner
	}
	if c.nested != 0 {
		inner := make(chan int, 1)
		inner <- c.nested
		e.chain <- inner
	}
	for _, v := range c.feed {
		e.in <- v
	}
	for _, v := range c.boxes {
		e.boxes <- box{V: v}
	}
	if c.closed {
		close(e.in)
	}
	return e
}

func exercise(c cell, fail bool) string {
	e := newEnv(c)
	watchdog := time.AfterFunc(waitBound, func() {
		fmt.Printf("FAIL %s: group did not return within the bound\n", c.name)
		os.Exit(1)
	})
	err := c.run(context.Background(), e, fail)
	watchdog.Stop()
	wantErr := fail || c.bad
	if wantErr != errors.Is(err, errSib) || (!wantErr && err != nil) {
		return fmt.Sprintf("got error %v", err)
	}
	got := e.out
	if c.observe != nil {
		got = c.observe(e)
	}
	if got != c.want {
		return fmt.Sprintf("got %d want %d", got, c.want)
	}
	if e.calls != c.calls {
		return fmt.Sprintf("got %d evaluations want %d", e.calls, c.calls)
	}
	if e.undo != c.undo {
		return fmt.Sprintf("got %d undos want %d", e.undo, c.undo)
	}
	if len(e.in) != c.left || len(e.boxes) != c.leftBoxes {
		return fmt.Sprintf("got %d and %d values left want %d and %d", len(e.in), len(e.boxes), c.left, c.leftBoxes)
	}
	return ""
}

func selected(name string) bool {
	return len(os.Args) < 2 || os.Args[1] == name
}

func main() {
	failed := false
	report := func(name, problem string) {
		if problem != "" {
			fmt.Printf("FAIL %s: %s\n", name, problem)
			failed = true
			return
		}
		fmt.Printf("ok %s\n", name)
	}
	for _, c := range slices.Concat(valueCells(), condValueCells(), tryValueCells(), formValueCells()) {
		if selected(c.name) {
			report(c.name, exercise(c, false))
		}
	}
	for _, c := range slices.Concat(cancelCells(), condCancelCells(), tryCancelCells(), formCancelCells()) {
		if selected(c.name) {
			report(c.name, exercise(c, true))
		}
	}
	if failed {
		os.Exit(1)
	}
}
