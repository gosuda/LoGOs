// run

package main

import (
	"context"
	"errors"
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

var trace []string
var errOdd = errors.New("odd")

func double(x int) (int, error) {
	if x%2 == 1 {
		return 0, errOdd
	}
	return x * 2, nil
}

func eq(name, got, want string) {
	check(name, got == want, got, want)
}

func plainTop(xs []int) ([]int, error) {
	ys := xs.map(x => {
		v := double(x)?
		return v
	})
	return ys, nil
}

func plainNested(xs []int) ([]int, error) {
	ys := xs.map(x => {
		if x > 0 {
			for i := 0; i < x; i++ {
				if i == 1 {
					w := double(x + 1)?
					return w
				}
			}
		}
		return x
	})
	return ys, nil
}

func plainFilter(xs []int) ([]int, error) {
	ys := xs.filter(x => {
		keep := double(x)?
		return keep > 0
	})
	return ys, nil
}

func staged(ctx context.Context, xs []int) ([]int, error) {
	return xs.group(ctx, limit = 2).map(x => {
		v := double(x)?
		return v
	})
}

func aroundErrdefer(xs []int) (out []int, err error) {
	errdefer func() { trace = append(trace, "rollback") }()
	out = xs.map(x => {
		if x == 1 {
			return -1
		}
		return x
	})
	_, err = double(1)
	return
}

func main() {
	ys, err := plainTop([]int{2, 4})
	eq("plain-top", fmt.Sprint(ys, err), "[4 8] <nil>")
	_, err = plainTop([]int{2, 3})
	check("plain-top-err", err == errOdd, err, errOdd)
	ys, err = plainNested([]int{1, 3})
	eq("plain-nested", fmt.Sprint(ys, err), "[1 8] <nil>")
	_, err = plainNested([]int{0, 2})
	check("plain-nested-err", err == errOdd, err, errOdd)
	ys, err = plainFilter([]int{2, 4})
	eq("plain-filter", fmt.Sprint(ys, err), "[2 4] <nil>")
	ys, err = staged(context.Background(), []int{2, 4})
	eq("staged", fmt.Sprint(ys, err), "[4 8] <nil>")
	_, err = staged(context.Background(), []int{1, 2})
	check("staged-err", err == errOdd, err, errOdd)
	ys, err = aroundErrdefer([]int{1, 2})
	eq("around-errdefer", fmt.Sprint(ys, err, trace), "[-1 2] odd [rollback]")
	if failed {
		os.Exit(1)
	}
}
