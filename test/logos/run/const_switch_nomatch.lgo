// run

package main

import (
	"bytes"
	"fmt"
	"io"
	"os"
	"strconv"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func EncodeOrKeep[T any](buf []byte, items []T) ([]byte, error) {
	const switch T {
	case int64:
		for _, v := range items {
			buf = strconv.AppendInt(buf, v, 10)
		}
		return buf, nil
	case io.WriterTo:
		var b bytes.Buffer
		for _, v := range items {
			v.WriteTo(&b)?
		}
		return append(buf, b.Bytes()...), nil
	}
	return buf, nil
}

func main() {
	b, err := EncodeOrKeep([]byte("keep:"), []string{"x", "y"})
	if err != nil {
		check("keep", false, err, "keep:")
	} else {
		check("keep", string(b) == "keep:", string(b), "keep:")
	}
	check("keep-err", err == nil, err, nil)
	if failed {
		os.Exit(1)
	}
}
