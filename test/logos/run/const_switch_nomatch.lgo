// run

package main

import (
	"bytes"
	"fmt"
	"io"
	"strconv"
)


func EncodeOrKeep[T any](buf []byte, items []T) ([]byte, error) {
	const switch T {
	case int64:
		for _, v := range items {
			buf = strconv.AppendInt(buf, v, 10)
		}
		return buf, nil
	case io.WriterTo:
		var b bytes.Buffer
		for _, v := range items {
			v.WriteTo(&b)?
		}
		return append(buf, b.Bytes()...), nil
	}
	return buf, nil
}

func main() {
	b, err := EncodeOrKeep([]byte("keep:"), []string{"x", "y"})
	fmt.Printf("%s %v\n", b, err)
}
