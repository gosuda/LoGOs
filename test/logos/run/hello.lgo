// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func main() {
	s := "hello"
	check("hello", s == "hello", s, "hello")
	if failed {
		os.Exit(1)
	}
}
