// run

package main

import (
	"errors"
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

var errComment = errors.New("comment")

func parse(s string) (int, error) {
	if s == "bad" {
		return 0, errComment
	}
	return len(s), nil
}

type gate struct{ closed bool }

func (g *gate) Close() error {
	g.closed = true
	return nil
}

func rollback() error { return nil }

var g = &gate{}

func run() error {
	v := parse(
		// convert the input
		"hello",
	/* trailing block */)?
	check("value", v == 5, v, 5)
	defer g.Close(/* idempotent close */)?
	errdefer rollback(/* undo nothing */)?
	return nil
}

func main() {
	err := run()
	check("run-err", err == nil, fmt.Sprint(err), "<nil>")
	check("closed", g.closed == true, g.closed, true)
	if failed {
		os.Exit(1)
	}
}
