// run -goexperiment logosarena,logosescape -race
package main

import (
	"fmt"
	"logos/arena"
	"logos/rt"
	"os"
)

func heapOracle() int {
	sum := 0
	for i := range 4 {
		sum += i * i
	}
	return sum
}

func main() {
	sum := 0
	inside := false
	{
		r := arena.Open()
		s := arena.Make[int](r, 4)
		for i := range s {
			s[i] = i * i
		}
		for _, v := range s {
			sum += v
		}
		inside = rt.RegionBytes() > 0
	}
	if sum != heapOracle() {
		fmt.Printf("FAIL race-region-squares-match-heap-oracle: got %d want %d\n", sum, heapOracle())
		os.Exit(1)
	}
	fmt.Println("ok race-region-squares-match-heap-oracle")
	if !inside {
		fmt.Println("FAIL race-region-holds-bytes-inside-owner-block: got false want true")
		os.Exit(1)
	}
	fmt.Println("ok race-region-holds-bytes-inside-owner-block")
	if rt.RegionBytes() != 0 {
		fmt.Printf("FAIL race-region-released-after-owner-block: got %d want 0\n", rt.RegionBytes())
		os.Exit(1)
	}
	fmt.Println("ok race-region-released-after-owner-block")
}
