// run


package main

import (
	"comptime"
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Pair struct {
	X int
	Y int
}

func live(v Pair) int {
	n := 0
	const if 1 == 1 {
		const for _, f := range comptime.Fields[Pair]() {
			n += v.[f]
		}
	} else {
		const for _, f := range comptime.Fields[Pair]() {
			n -= v.[f]
			comptime.Error("dead else branch is never lowered")
		}
	}
	return n
}

func elseLive(v Pair) int {
	n := 0
	const if 1 == 2 {
		const for _, f := range comptime.Fields[Pair]() {
			n -= v.[f]
			comptime.Error("dead then branch is never lowered")
		}
	} else {
		const for _, f := range comptime.Fields[Pair]() {
			n += 2 * v.[f]
		}
	}
	return n
}

func deadOnly(v Pair) int {
	n := 0
	const if 1 == 2 {
		const for _, f := range comptime.Fields[Pair]() {
			n += v.[f]
			comptime.Error("dead branch is never lowered")
		}
	}
	return n
}

func main() {
	p := Pair{X: 3, Y: 4}
	check("live", live(p) == 7, live(p), 7)
	check("else-live", elseLive(p) == 14, elseLive(p), 14)
	check("dead-only", deadOnly(p) == 0, deadOnly(p), 0)
	if failed {
		os.Exit(1)
	}
}
