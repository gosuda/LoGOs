	shared = mk(9)
	return fmt.Sprint(idOf(ids3().map(i => shared).first()))
}

func sLast() string {
	shared = mk(9)
	return fmt.Sprint(idOf(ids3().map(i => shared).last()))
}

func sGet() string {
	shared = mk(9)
	return fmt.Sprint(idOf(ids3().map(i => shared).get(1)))
}

