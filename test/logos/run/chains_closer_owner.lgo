// run

package main

import (
	"errors"
	"fmt"
	"os"
	"slices"
)

type conn struct {
	id     int
	closes int
}

func (c *conn) Close() error {
	c.closes++
	closeLog = append(closeLog, fmt.Sprint("c", c.id))
	return errClose
}

type observed[T any] struct {
	v   T
	err error
}

func observe[T any](v T, err error) observed[T] {
	return observed[T]{v, err}
}

var (
	errClose = errors.New("close failed")
	errBoom  = errors.New("boom")
	reg      []*conn
	wreg     []*wrap
	closeLog []string
	shared   = &conn{}
	failed   bool
)

func mk(id int) *conn {
	c := &conn{id: id}
	reg = append(reg, c)
	return c
}

func identity(c *conn) *conn { return c }

type user struct{ c *conn }

func users3() []user { return []user{{mk(1)}, {mk(2)}, {mk(3)}} }

func conns3() []*conn { return []*conn{mk(1), mk(2), mk(3)} }

func ids3() []int { return []int{1, 2, 3} }

func idOf(c *conn?) int { return c?.id ?? -1 }

func idsOf(cs []*conn) []int {
	out := []int{}
	for _, c := range cs {
		out = append(out, c.id)
	}
	return out
}

func closes() string {
	out := make([]int, len(reg))
	for i, c := range reg {
		out[i] = c.closes
	}
	return fmt.Sprint(out)
}

type wrap struct {
	c      *conn
	closes int
}

func (w *wrap) Close() error {
	w.closes++
	closeLog = append(closeLog, fmt.Sprint("w", w.c.id))
	return errClose
}

func mkWrap(c *conn) *wrap {
	w := &wrap{c: c}
	wreg = append(wreg, w)
	return w
}

func wrapCloses() string {
	out := make([]int, len(wreg))
	for i, w := range wreg {
		out[i] = w.closes
	}
	return fmt.Sprint(out)
}

type vconn struct {
	id   int
	name string
}

var vtally = make([]int, 4)

func (v vconn) Close() error {
	vtally[v.id]++
	closeLog = append(closeLog, fmt.Sprint("v", v.id))
	return errClose
}

func mkv(id int) vconn { return vconn{id: id, name: "v"} }

func pass(c *conn) (bool, error) {
	if c.id == 2 {
		return false, errBoom
	}
	return true, nil
}

func tryMk(i int) (*conn, error) {
	c := mk(i)
	if i == 3 {
		return c, errBoom
	}
	return c, nil
}

func mkPair(i int) (*conn, int) {
	return mk(i), i
}

func bCount() string { return fmt.Sprint(users3().map(u => u.c).count()) }

func bCountPred() string { return fmt.Sprint(users3().map(u => u.c).count(c => c.id > 1)) }

func bFind() string { return fmt.Sprint(idOf(users3().map(u => u.c).find(c => c.id == 2))) }

func bFindMiss() string { return fmt.Sprint(idOf(users3().map(u => u.c).find(c => c.id == 99))) }

func bFirst() string { return fmt.Sprint(idOf(users3().map(u => u.c).first())) }

func bLast() string { return fmt.Sprint(idOf(users3().map(u => u.c).last())) }

func bGet() string { return fmt.Sprint(idOf(users3().map(u => u.c).get(1))) }

func bAny() string { return fmt.Sprint(users3().map(u => u.c).any(c => c.id == 2)) }

func bAnyMiss() string { return fmt.Sprint(users3().map(u => u.c).any(c => c.id == 99)) }

func bAll() string { return fmt.Sprint(users3().map(u => u.c).all(c => c.id > 0)) }

func bAllEarly() string { return fmt.Sprint(users3().map(u => u.c).all(c => c.id != 2)) }

func bTake() string { return fmt.Sprint(idsOf(users3().map(u => u.c).take(2))) }

func bCollect() string { return fmt.Sprint(idsOf(users3().map(u => u.c))) }

func bSort() string { return fmt.Sprint(idsOf(users3().map(u => u.c).sortBy(c => -c.id))) }

func tryBorrowFilter() (int, error) {
	n := users3().map(u => u.c).filter(c => pass(c)?).count()
	return n, nil
}

func bTryFilterFail() string {
	res := observe(tryBorrowFilter())
	n, err := res.v, res.err
	if err != nil {
		return fmt.Sprint(n, err == errBoom)
	}
	return fmt.Sprint(n, false)
}

