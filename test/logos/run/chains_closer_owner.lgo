func main() {
	for _, l := range legs() {
		reg = nil
		wreg = nil
		closeLog = nil
		vtally = make([]int, 4)
		got := l.run() + " " + closes()
		if got != l.want {
			failed = true
			fmt.Println("FAIL", l.name+":", "got", got, "want", l.want)
			continue
		}
		fmt.Println("ok", l.name)
	}
	if failed {
		os.Exit(1)
	}
}
