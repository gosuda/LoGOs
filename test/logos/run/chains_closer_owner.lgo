	shared = mk(9)
	return fmt.Sprint(idsOf(ids3().map(i => shared).take(2)))
}

func sCollect() string {
	shared = mk(9)
	return fmt.Sprint(idsOf(ids3().map(i => shared)))
}

func sSort() string {
	shared = mk(9)
	return fmt.Sprint(idsOf(ids3().map(i => shared).sortBy(c => c.id)))
}

func iLambdaCount() string { return fmt.Sprint(conns3().map(c => c).count()) }

func iLambdaCollect() string { return fmt.Sprint(idsOf(conns3().map(c => c))) }

func iFuncCount() string { return fmt.Sprint(conns3().map(identity).count()) }

func iFuncFind() string { return fmt.Sprint(idOf(conns3().map(identity).find(c => c.id == 2))) }

func iCallCount() string { return fmt.Sprint(conns3().map(c => identity(c)).count()) }

func srcFilterCount() string { return fmt.Sprint(conns3().filter(c => c.id > 1).count()) }

func iMadeFuncCount() string { return fmt.Sprint(ids3().map(mk).map(identity).count()) }

func iMadeFuncCollect() string { return fmt.Sprint(idsOf(ids3().map(mk).map(identity))) }

func iMadeLambdaCount() string { return fmt.Sprint(ids3().map(mk).map(c => c).count()) }

func pCount() string { return fmt.Sprint(ids3().map(mk).count()) }

func pCountPred() string { return fmt.Sprint(ids3().map(mk).count(c => c.id == 2)) }

func pAnyHit() string { return fmt.Sprint(ids3().map(mk).any(c => c.id == 2)) }

func pAnyMiss() string { return fmt.Sprint(ids3().map(mk).any(c => c.id == 99)) }

func pAllEarly() string { return fmt.Sprint(ids3().map(mk).all(c => c.id != 2)) }

func pAllFull() string { return fmt.Sprint(ids3().map(mk).all(c => c.id != 99)) }

func pFindHit() string { return fmt.Sprint(idOf(ids3().map(mk).find(c => c.id == 2))) }

func pFindMiss() string { return fmt.Sprint(idOf(ids3().map(mk).find(c => c.id == 99))) }

func pFirst() string { return fmt.Sprint(idOf(ids3().map(mk).first())) }

func pLast() string { return fmt.Sprint(idOf(ids3().map(mk).last())) }

func pGet() string { return fmt.Sprint(idOf(ids3().map(mk).get(1))) }

func pGetOob() string { return fmt.Sprint(idOf(ids3().map(mk).get(9))) }

func pCollect() string { return fmt.Sprint(idsOf(ids3().map(mk))) }

func pTake() string { return fmt.Sprint(idsOf(ids3().map(mk).take(2))) }

//logos:allow(suspicious::side_effect_before_sort)
func pSort() string { return fmt.Sprint(idsOf(ids3().map(mk).sortBy(c => -c.id))) }

func tryCollect() ([]*conn, error) {
	got := ids3().map(i => tryMk(i)?)
	return got, nil
}

func tryCount() (int, error) {
	n := ids3().map(i => tryMk(i)?).count()
	return n, nil
}

func tryCountPred() (int, error) {
	n := ids3().map(i => tryMk(i)?).count(c => c.id > 0)
	return n, nil
}

func tryFindMiss() (int, error) {
	v := ids3().map(i => tryMk(i)?).find(c => c.id == 99)
	return idOf(v), nil
}

func tryAnyMiss() (bool, error) {
	b := ids3().map(i => tryMk(i)?).any(c => c.id == 99)
	return b, nil
}

func tryAllFull() (bool, error) {
	b := ids3().map(i => tryMk(i)?).all(c => c.id != 99)
	return b, nil
}

func tryFirst() (int, error) {
	v := ids3().map(i => tryMk(i)?).first()
	return idOf(v), nil
}

func tryLast() (int, error) {
	v := ids3().map(i => tryMk(i)?).last()
	return idOf(v), nil
}

func tryGet() (int, error) {
	v := ids3().map(i => tryMk(i)?).get(2)
	return idOf(v), nil
}

func tryTake() ([]*conn, error) {
	got := ids3().map(i => tryMk(i)?).take(5)
	return got, nil
}

//logos:allow(suspicious::side_effect_before_sort)
func tryProducedSort() ([]*conn, error) {
	got := ids3().map(i => tryMk(i)?).sortBy(c => c.id)
	return got, nil
}

func tCollect() string {
	got, err := tryCollect()
	if err != nil {
		return fmt.Sprint(idsOf(got), err == errBoom)
	}
	return fmt.Sprint(idsOf(got), false)
}

