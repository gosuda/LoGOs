func fCount() string { return fmt.Sprint(ids3().map(mk).filter(c => c.id != 2).count()) }

func fCollect() string { return fmt.Sprint(idsOf(ids3().map(mk).filter(c => c.id != 2))) }

func dCount() string { return fmt.Sprint(ids3().map(mk).drop(1).count()) }

func dCollect() string { return fmt.Sprint(idsOf(ids3().map(mk).drop(1))) }

func fFirst() string { return fmt.Sprint(idOf(ids3().map(mk).filter(c => c.id != 1).first())) }

func fLast() string { return fmt.Sprint(idOf(ids3().map(mk).filter(c => c.id != 2).last())) }

func fFind() string {
	return fmt.Sprint(idOf(ids3().map(mk).filter(c => c.id != 1).find(c => c.id == 3)))
}

func fAny() string { return fmt.Sprint(ids3().map(mk).filter(c => c.id != 2).any(c => c.id == 3)) }

func fGet() string { return fmt.Sprint(idOf(ids3().map(mk).filter(c => c.id != 2).get(1))) }

func fTake() string { return fmt.Sprint(idsOf(ids3().map(mk).filter(c => c.id != 1).take(1))) }

//logos:allow(suspicious::side_effect_before_sort)
func fSort() string {
	return fmt.Sprint(idsOf(ids3().map(mk).filter(c => c.id != 2).sortBy(c => c.id)))
}

func fBetween() string { return fmt.Sprint(ids3().map(mk).filter(c => c.id != 2).map(c => c.id).count()) }

func pass2(c *conn) (bool, error) {
	switch c.id {
	case 1:
		return false, nil
	case 3:
		return false, errBoom
	}
	return true, nil
}

func tryFilter() (int, error) {
	n := ids3().map(mk).filter(c => pass(c)?).count()
	return n, nil
}

func tryFilterDrop() (int, error) {
	n := ids3().map(mk).filter(c => pass2(c)?).count()
	return n, nil
}

func tFilterFail() string {
	n, err := tryFilter()
	if err != nil {
		return fmt.Sprint(n, err == errBoom)
	}
	return fmt.Sprint(n, false)
}

func tFilterDropFail() string {
	n, err := tryFilterDrop()
	if err != nil {
		return fmt.Sprint(n, err == errBoom)
	}
	return fmt.Sprint(n, false)
}

func boomAt(c *conn, id int) bool {
	if c.id == id {
		panic("boom")
	}
	return true
}

func fPanic() (hit string) {
	defer func() { hit = fmt.Sprint(recover() != nil) }()
	_ = ids3().map(mk).filter(c => boomAt(c, 3))
	return "false"
}

func tune(c *conn) {}

func lCount() string {
	return fmt.Sprint(ids3().map(x => {
		f := mk(x)
		tune(f)
		return f
	}).count())
}

func lCollect() string {
	return fmt.Sprint(idsOf(ids3().map(x => {
		f := mk(x)
		tune(f)
		return f
	})))
}

func lFind() string {
	return fmt.Sprint(idOf(ids3().map(x => {
		f := mk(x)
		tune(f)
		return f
	}).find(c => c.id == 2)))
}

func lLast() string {
	return fmt.Sprint(idOf(ids3().map(x => {
		f := mk(x)
		tune(f)
		return f
	}).last()))
}

func lFilter() string {
	return fmt.Sprint(ids3().map(x => {
		f := mk(x)
		tune(f)
		return f
	}).filter(c => c.id != 2).count())
}

//logos:allow(suspicious::side_effect_before_sort)
func lSort() string {
	return fmt.Sprint(idsOf(ids3().map(x => {
		f := mk(x)
		tune(f)
		return f
	}).sortBy(c => -c.id)))
}

func lVarDecl() string {
	return fmt.Sprint(ids3().map(x => {
		var f = mk(x)
		tune(f)
		return f
	}).count())
}

func lTuple() string {
	return fmt.Sprint(ids3().map(x => {
		f, err := tryMk(x)
		if err != nil {
			tune(f)
		}
		return f
	}).count())
}

func lReassignOwned() string {
	return fmt.Sprint(ids3().map(x => {
		f := mk(x)
		tune(f)
		f = mk(x + 10)
		return f
	}).count())
}

func lReassignBorrowed() string {
	shared = mk(9)
	return fmt.Sprint(ids3().map(x => {
		f := mk(x)
		tune(f)
		f = shared
		return f
	}).count())
}

func lCaptured() string {
	shared = mk(9)
	return fmt.Sprint(ids3().map(x => {
		f := shared
		return f
	}).count())
}

func lParam() string {
	return fmt.Sprint(conns3().map(c => {
		f := c
		return f
	}).count())
}

func mixedChain() *conn {
	shared = mk(9)
	ids3().map(x => {
		if x == 2 {
			return shared
		}
		return mk(x)
	}).count()
	return shared
}

func lMixed() string { return fmt.Sprint(mixedChain().id) }

func madeChain() *conn {
	ids3().map(x => {
		if x == 2 {
			return mk(20)
		}
		return mk(x)
	}).count()
	return &conn{id: 7}
}

func lTwoMade() string { return fmt.Sprint(madeChain().id) }

func tryLocalFilter() (int, error) {
	n := ids3().map(x => {
		f := mk(x)
		tune(f)
		return f
	}).filter(c => pass(c)?).count()
	return n, nil
}

func lTryFail() string {
	n, err := tryLocalFilter()
	return fmt.Sprint(n, err == errBoom)
}

func lPanic() (hit string) {
	defer func() { hit = fmt.Sprint(recover() != nil) }()
	_ = ids3().map(x => {
		f := mk(x)
		tune(f)
		return f
	}).filter(c => boomAt(c, 3))
	return "false"
}

type leg struct {
	name string
	want string
	run  func() string
}

func legs() []leg {
	return slices.Concat(borrowLegs(), sharedLegs(), identityLegs(), madeLegs(), tryLegs(), dropLegs(), localLegs())
}

func borrowLegs() []leg {
	return []leg{
		{"borrow-count", "3 [0 0 0]", bCount},
		{"borrow-count-pred", "2 [0 0 0]", bCountPred},
		{"borrow-find", "2 [0 0 0]", bFind},
		{"borrow-find-miss", "-1 [0 0 0]", bFindMiss},
		{"borrow-first", "1 [0 0 0]", bFirst},
		{"borrow-last", "3 [0 0 0]", bLast},
		{"borrow-get", "2 [0 0 0]", bGet},
		{"borrow-any", "true [0 0 0]", bAny},
		{"borrow-any-miss", "false [0 0 0]", bAnyMiss},
		{"borrow-all", "true [0 0 0]", bAll},
		{"borrow-all-early", "false [0 0 0]", bAllEarly},
		{"borrow-take", "[1 2] [0 0 0]", bTake},
		{"borrow-collect", "[1 2 3] [0 0 0]", bCollect},
		{"borrow-sort", "[3 2 1] [0 0 0]", bSort},
		{"borrow-try-filter-fail", "0 true [0 0 0]", bTryFilterFail},
	}
}

func sharedLegs() []leg {
	return []leg{
		{"shared-count", "3 [0]", sCount},
		{"shared-any", "false [0]", sAny},
		{"shared-all", "true [0]", sAll},
		{"shared-find", "9 [0]", sFind},
		{"shared-first", "9 [0]", sFirst},
		{"shared-last", "9 [0]", sLast},
		{"shared-get", "9 [0]", sGet},
		{"shared-take", "[9 9] [0]", sTake},
		{"shared-collect", "[9 9 9] [0]", sCollect},
		{"shared-sort", "[9 9 9] [0]", sSort},
	}
}

func identityLegs() []leg {
	return []leg{
		{"identity-lambda-count", "3 [0 0 0]", iLambdaCount},
		{"identity-lambda-collect", "[1 2 3] [0 0 0]", iLambdaCollect},
		{"identity-func-count", "3 [0 0 0]", iFuncCount},
		{"identity-func-find", "2 [0 0 0]", iFuncFind},
		{"identity-call-count", "3 [0 0 0]", iCallCount},
		{"source-filter-count", "2 [0 0 0]", srcFilterCount},
		{"made-identity-func-count", "3 [1 1 1]", iMadeFuncCount},
		{"made-identity-func-collect", "[1 2 3] [0 0 0]", iMadeFuncCollect},
		{"made-identity-lambda-count", "3 [1 1 1]", iMadeLambdaCount},
	}
}

func madeLegs() []leg {
	return []leg{
		{"made-count", "3 [1 1 1]", pCount},
		{"made-count-pred", "1 [1 1 1]", pCountPred},
		{"made-any-hit", "true [1 1]", pAnyHit},
		{"made-any-miss", "false [1 1 1]", pAnyMiss},
		{"made-all-early", "false [1 1]", pAllEarly},
		{"made-all-full", "true [1 1 1]", pAllFull},
		{"made-find-hit", "2 [1 0]", pFindHit},
		{"made-find-miss", "-1 [1 1 1]", pFindMiss},
		{"made-first", "1 [0]", pFirst},
		{"made-last", "3 [1 1 0]", pLast},
		{"made-get", "2 [1 0 1]", pGet},
		{"made-get-oob", "-1 [1 1 1]", pGetOob},
		{"made-collect", "[1 2 3] [0 0 0]", pCollect},
		{"made-take", "[1 2] [0 0]", pTake},
		{"made-sort", "[3 2 1] [0 0 0]", pSort},
	}
}

func tryLegs() []leg {
	return []leg{
		{"try-collect-fail", "[] true [1 1 0]", tCollect},
		{"try-count-fail", "0 true [1 1 0]", tCount},
		{"try-count-pred-fail", "0 true [1 1 0]", tCountPred},
		{"try-find-fail", "0 true [1 1 0]", tFindMiss},
		{"try-any-fail", "false true [1 1 0]", tAnyMiss},
		{"try-all-fail", "false true [1 1 0]", tAllFull},
		{"try-first", "1 false [0]", tFirst},
		{"try-last-fail", "0 true [1 1 0]", tLast},
		{"try-get-fail", "0 true [1 1 0]", tGet},
		{"try-take-fail", "[] true [1 1 0]", tTake},
		{"try-sort-fail", "[] true [1 1 0]", tSort},
	}
}

func dropLegs() []leg {
	return []leg{
		{"drop-filter-count", "2 [1 1 1]", fCount},
		{"drop-filter-collect", "[1 3] [0 1 0]", fCollect},
		{"drop-drop-count", "2 [1 1 1]", dCount},
		{"drop-drop-collect", "[2 3] [1 0 0]", dCollect},
		{"drop-filter-first", "2 [1 0]", fFirst},
		{"drop-filter-last", "3 [1 1 0]", fLast},
		{"drop-filter-find", "3 [1 1 0]", fFind},
		{"drop-filter-any", "true [1 1 1]", fAny},
		{"drop-filter-get", "3 [1 1 0]", fGet},
		{"drop-filter-take", "[2] [1 0]", fTake},
		{"drop-filter-sort", "[1 3] [0 1 0]", fSort},
		{"drop-between-maps", "2 [0 1 0]", fBetween},
		{"drop-try-filter-fail", "0 true [1 1]", tFilterFail},
		{"drop-try-filter-drop-fail", "0 true [1 1 1]", tFilterDropFail},
		{"drop-filter-panic", "true [1 1 1]", fPanic},
	}
}

func localLegs() []leg {
	return []leg{
		{"local-count", "3 [1 1 1]", lCount},
		{"local-collect", "[1 2 3] [0 0 0]", lCollect},
		{"local-find", "2 [1 0]", lFind},
		{"local-last", "3 [1 1 0]", lLast},
		{"local-filter", "2 [1 1 1]", lFilter},
		{"local-sort", "[3 2 1] [0 0 0]", lSort},
		{"local-var-decl", "3 [1 1 1]", lVarDecl},
		{"local-tuple-call", "3 [1 1 1]", lTuple},
		{"local-reassign-owned", "3 [0 1 0 1 0 1]", lReassignOwned},
		{"local-reassign-borrowed", "3 [0 0 0 0]", lReassignBorrowed},
		{"local-captured", "3 [0]", lCaptured},
		{"local-param", "3 [0 0 0]", lParam},
		{"local-mixed-returns", "9 [0 0 0]", lMixed},
		{"local-two-made", "7 [1 1 1]", lTwoMade},
		{"local-try-filter-fail", "0 true [1 1]", lTryFail},
		{"local-filter-panic", "true [1 1 1]", lPanic},
	}
}

func main() {
	for _, l := range legs() {
		reg = nil
		got := l.run() + " " + closes()
		if got != l.want {
			failed = true
			fmt.Println("FAIL", l.name+":", "got", got, "want", l.want)
			continue
		}
		fmt.Println("ok", l.name)
	}
	if failed {
		os.Exit(1)
	}
}
