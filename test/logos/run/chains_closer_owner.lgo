func vIDs(vs []vconn) []int {
	out := []int{}
	for _, v := range vs {
		out = append(out, v.id)
	}
	return out
}

func vState() string { return fmt.Sprintf("%v %v", vtally[1:], closeLog) }

func vpass(c vconn) (bool, error) {
	if c.id == 2 {
		return false, errBoom
	}
	return true, nil
}

func vpass2(c vconn) (bool, error) {
	switch c.id {
	case 1:
		return false, nil
	case 3:
		return false, errBoom
	}
	return true, nil
}

func vboomAt(c vconn, id int) bool {
	if c.id == id {
		panic("boom")
	}
	return true
}

func valDrop() string {
	n := ids3().map(mkv).filter(c => c.id != 2).map(c => c.id).count()
	return fmt.Sprintf("%d %s", n, vState())
}

func valDropCollect() string {
	got := ids3().map(mkv).filter(c => c.id != 2)
	return fmt.Sprintf("%v %s", vIDs(got), vState())
}

func tryValFilter() (int, error) {
	n := ids3().map(mkv).filter(c => vpass(c)?).map(c => c.id).count()
	return n, nil
}

func valTryFail() string {
	res := observe(tryValFilter())
	n, err := res.v, res.err
	if err != nil {
		return fmt.Sprintf("%d %v %s", n, err == errBoom, vState())
	}
	return fmt.Sprintf("%d %v %s", n, false, vState())
}

func valPanic() (got string) {
	defer func() { got = fmt.Sprintf("%v %s", recover() != nil, vState()) }()
	_ = ids3().map(mkv).filter(c => vboomAt(c, 2)).map(c => c.id).count()
	return "false"
}

