func fliTryFailWrap() string {
	res := observe(tryFlightWrap())
	n, err := res.v, res.err
	if err != nil {
		return fmt.Sprintf("%d %v %s %v", n, err == errBoom, wrapCloses(), closeLog)
	}
	return fmt.Sprintf("%d %v %s %v", n, false, wrapCloses(), closeLog)
}

func fliPanicWrap() (got string) {
	defer func() { got = fmt.Sprintf("%v %s %v", recover() != nil, wrapCloses(), closeLog) }()
	_ = ids3().map(mk).filter(c => boomAt(c, 2)).map(c => mkWrap(c)).count()
	return "false"
}

