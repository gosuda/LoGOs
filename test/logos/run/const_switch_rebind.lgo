// run

package main

import (
	"context"
	"fmt"
	"os"
	"strconv"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Port int

// set converts a parsed value under a ~int case: F must admit conversion from
// the basic case type while keeping its identity (SPEC Sec 2.5).
func set[F any](raw string, dst *F) error {
	const switch F {
	case ~int:
		n := strconv.ParseInt(raw, 10, 64)?
		*dst = F(n)
		return nil
	}
	return nil
}

// inner still dispatches on the real type argument inside a ~int case: a
// defined int kind must hit the inner ~int case, not an exact int case.
func inner[F any](dst *F) string {
	out := ""
	const switch F {
	case ~int:
		*dst = F(7)
		const switch F {
		case int:
			out += "int;"
		case ~int:
			out += "tilde;"
		}
	}
	return out + "end"
}

type Part interface{ Start(ctx context.Context) error }

type W struct{ S string }

func (w W) Start(ctx context.Context) error {
	fmt.Println("start:" + w.S)
	return nil
}

// keep stores a value of the switched type into the interface under a Part
// case: the value keeps its concrete layout and gains the method set.
func keep[F any](parts []Part, field F, f2 F) []Part {
	const switch F {
	case Part:
		field = f2 // F stays concrete: assignment back to F must compile
		var p Part = field
		parts = append(parts, field, p)
	}
	return parts
}

// bump writes to a rebound value variable under a ~int case: the write must
// be stored back so it is visible after the switch.
func bump[F any](field F) F {
	const switch F {
	case ~int:
		field = F(9)
	}
	return field
}

// mask keeps a nearer binding of the same name from being rebound: inside the
// case, v resolves to the block's own v, not the parameter.
func mask[F any](v F) int {
	out := 0
	{
		v := 7
		const switch F {
		case ~int:
			out = v
		}
	}
	return out
}

// swap returns its second argument; boxing both the call and its Part
// parameter composes the nested boxes instead of overlapping them.
func swap[F any](p Part, v F) F {
	_ = p
	return v
}

// gotoOut writes a rebound variable and leaves the case early through a
// labeled jump: the write still reaches the caller's storage.
func gotoOut[F any](v F) F {
	const switch F {
	case ~int:
		v = F(9)
		goto done
	}
done:
	return v
}

// gather mixes interface boxing, nested boxing, and a two-result map read
// kept through the closure rewrite.
func gather[F any](parts []Part, field F, m map[string]F) []Part {
	const switch F {
	case Part:
		parts = append(parts, swap(field, field))
		if v, ok := m["k"]; ok {
			parts = append(parts, v)
		}
		var p Part
		var ok bool
		p, ok = m["k"]
		if ok {
			parts = append(parts, p)
		}
		p, ok = m["missing"]
		if !ok {
			parts = append(parts, field)
		}
	}
	return parts
}

// keepNil boxes a nil value of an interface-typed argument without panicking.
func keepNil[J Part](parts []Part, field J) []Part {
	const switch J {
	case Part:
		parts = append(parts, field)
	}
	return parts
}

func main() {
	var p Port
	if err := set[Port]("41", &p); err != nil {
		fmt.Println("set err:", err)
		failed = true
	}
	check("tilde-rebind", p == 41, p, 41)

	got := inner[Port](new(Port))
	check("tilde-nested", got == "tilde;end", got, "tilde;end")
	var pi Port
	inner[Port](&pi)
	check("tilde-nested-store", pi == 7, pi, 7)

	parts := keep[W](nil, W{S: "a"}, W{S: "b"})
	check("iface-box", len(parts) == 2, len(parts), 2)
	for _, part := range parts {
		if err := part.Start(context.Background()); err != nil {
			fmt.Println("start err:", err)
			failed = true
		}
	}

	check("writeback", bump[Port](Port(1)) == 9, bump[Port](Port(1)), 9)
	check("mask", mask[int](1) == 7, mask[int](1), 7)
	check("goto-writeback", gotoOut[Port](Port(1)) == 9, gotoOut[Port](Port(1)), 9)

	more := gather[W](nil, W{S: "c"}, map[string]W{"k": {S: "d"}})
	check("nested-box", len(more) == 4, len(more), 4)
	for _, part := range more {
		if err := part.Start(context.Background()); err != nil {
			fmt.Println("map err:", err)
			failed = true
		}
	}

	nilParts := keepNil[Part](nil, nil)
	check("nil-box", len(nilParts) == 1 && nilParts[0] == nil, len(nilParts), 1)

	if failed {
		os.Exit(1)
	}
}
