// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func main() {
	goto L
	fmt.Println("skipped")
L:
	hit := false
	const switch int {
	case interface{ M() }:
		hit = true
	}
	check("empty-nomatch", !hit, hit, false)
	if failed {
		os.Exit(1)
	}
}
