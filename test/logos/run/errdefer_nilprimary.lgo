// run

package main

import (
	"errors"
	"fmt"
	"os"
)

var errRollback = errors.New("rollback")

var bad bool

func check(tag string, cond bool, got, want string) {
	if !cond {
		fmt.Println("FAIL "+tag+": got "+got+" want "+want)
		bad = true
		return
	}
	fmt.Println("ok", tag)
}

func rollbackFails() error { return errRollback }

func nilPrimaryRollback() (err error) {
	defer func() {
		if recover() == nil {
			panic("missing panic")
		}
	}()
	errdefer rollbackFails()?
	panic("boom-nil")
}

func main() {
	err := nilPrimaryRollback()
	check("errdefer-nil-primary-rollback-surfaces", err == errRollback && errors.Is(err, errRollback), fmt.Sprint(err), errRollback.Error())
	if bad {
		os.Exit(1)
	}
}
