// run

package main

import (
	"errors"
	"fmt"
	"os"
)

var errRollback = errors.New("rollback")

func rollbackFails() error { return errRollback }

func nilPrimaryRollback() (err error) {
	defer func() {
		if recover() == nil {
			panic("missing panic")
		}
	}()
	errdefer rollbackFails()?
	panic("boom-nil")
}

func main() {
	err := nilPrimaryRollback()
	if err != errRollback || !errors.Is(err, errRollback) {
		fmt.Println("errdefer nil primary: FAIL")
		os.Exit(1)
	}
	fmt.Println("errdefer nil primary: PASS")
}
