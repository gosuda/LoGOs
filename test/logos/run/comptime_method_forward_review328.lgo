// run

package main

import (
	"comptime"
	"fmt"
)

type Probe struct{ X int }
type Box[T any] struct{}

func (b Box[T]) Count() int {
	n := 0
	const for _, field := range comptime.Fields[T]() {
		_ = field.Name
		n++
	}
	return n
}

func count[T any](b Box[T]) int {
	return b.Count()
}

func forward[T any](b Box[T]) int {
	return count(b)
}

func main() {
	fmt.Println("direct", Box[Probe]{}.Count())
	fmt.Println("wrapper", count(Box[Probe]{}))
	fmt.Println("forward", forward(Box[Probe]{}))
}
