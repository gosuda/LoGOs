// run -goexperiment logosarena

package main


import (
	"fmt"
	"runtime"
)

type r53Node struct {
	v int
}


//go:noinline
func r53Tree(depth, n int) []*r53Node {
	if depth == 0 {
		s := make([]*r53Node, 0, n)
		for i := 0; i < n; i++ {
			s = append(s, &r53Node{v: i + 1})
		}
		return s
	}
	s := r53Tree(depth-1, n)
	next := len(s)
	for i := 0; i < n; i++ {
		s = append(s, &r53Node{v: next + i + 1})
	}
	return s
}

//go:noinline
func r53SumNodes(s []*r53Node) int {
	total := 0
	for _, p := range s {
		total += p.v
	}
	return total
}

//go:noinline
func r53Produce(n int) []byte {
	b := make([]byte, n)
	for i := range b {
		b[i] = byte((i*7 + 3) & 0xFF)
	}
	return b
}

//go:noinline
func r53Chain(depth, n int) []byte {
	if depth <= 0 {
		return r53Produce(n)
	}
	return r53Chain(depth-1, n)
}

//go:noinline
func r53SumBytes(b []byte) int {
	s := 0
	for _, v := range b {
		s += int(v)
	}
	return s
}

//go:noinline
func r53Unrelated(n int) int {
	x := make([]byte, n)
	for i := range x {
		x[i] = 0xA5
	}
	s := r53SumBytes(x)
	runtime.KeepAlive(x)
	return s
}

func main() {
	tree := r53Tree(4, 16)
	n := len(tree)
	s := r53SumNodes(tree)
	fmt.Println("tree:", n, s)
	if n != 80 || s != 3240 {
		panic("redteam53: recursive tree lost nodes on return")
	}
	runtime.GC()
	runtime.GC()
	sGC := r53SumNodes(tree)
	fmt.Println("tree-gc:", sGC)
	if sGC != 3240 {
		panic("redteam53: recursive tree corrupted across GC")
	}
	runtime.KeepAlive(tree)

	const nb = 64
	b := r53Chain(8, nb)
	c1 := r53SumBytes(b)
	runtime.GC()
	runtime.GC()
	c2 := r53SumBytes(b)
	u := r53Unrelated(nb)
	c3 := r53SumBytes(b)
	fmt.Println("chain:", c1, c2, u)
	fmt.Println("chain-keep:", c3)
	if c1 != c2 || c2 != c3 {
		panic("redteam53: returned chain buffer corrupted after return")
	}
	runtime.KeepAlive(b)
}
