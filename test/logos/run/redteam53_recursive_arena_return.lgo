// run -goexperiment logosarena
// run -goexperiment logosarena -arena=false

package main


import (
	"fmt"
	"os"
	"runtime"
)

type r53Node struct {
	v int
}


//go:noinline
func r53Tree(depth, n int) []*r53Node {
	if depth == 0 {
		s := make([]*r53Node, 0, n)
		for i := 0; i < n; i++ {
			s = append(s, &r53Node{v: i + 1})
		}
		return s
	}
	s := r53Tree(depth-1, n)
	next := len(s)
	for i := 0; i < n; i++ {
		s = append(s, &r53Node{v: next + i + 1})
	}
	return s
}

//go:noinline
func r53SumNodes(s []*r53Node) int {
	total := 0
	for _, p := range s {
		total += p.v
	}
	return total
}

//go:noinline
func r53Produce(n int) []byte {
	b := make([]byte, n)
	for i := range b {
		b[i] = byte((i*7 + 3) & 0xFF)
	}
	return b
}

//go:noinline
func r53Chain(depth, n int) []byte {
	if depth <= 0 {
		return r53Produce(n)
	}
	return r53Chain(depth-1, n)
}

//go:noinline
func r53SumBytes(b []byte) int {
	s := 0
	for _, v := range b {
		s += int(v)
	}
	return s
}

//go:noinline
func r53Unrelated(n int) int {
	x := make([]byte, n)
	for i := range x {
		x[i] = 0xA5
	}
	s := r53SumBytes(x)
	runtime.KeepAlive(x)
	return s
}

var r53Failed bool

func r53Check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		r53Failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func r53OracleBytes(n int) int {
	s := 0
	for i := 0; i < n; i++ {
		s += int(byte((i*7 + 3) & 0xFF))
	}
	return s
}

func main() {
	tree := r53Tree(4, 16)
	n := len(tree)
	s := r53SumNodes(tree)
	wantLen := 5 * 16
	wantSum := wantLen * (wantLen + 1) / 2
	r53Check("recursive-tree-len", n == wantLen, fmt.Sprint(n), fmt.Sprint(wantLen))
	r53Check("recursive-tree-sum", s == wantSum, fmt.Sprint(s), fmt.Sprint(wantSum))
	runtime.GC()
	runtime.GC()
	sGC := r53SumNodes(tree)
	r53Check("recursive-tree-gc", sGC == wantSum, fmt.Sprint(sGC), fmt.Sprint(wantSum))
	runtime.KeepAlive(tree)
	const nb = 64
	b := r53Chain(8, nb)
	c1 := r53SumBytes(b)
	bwant := r53OracleBytes(nb)
	r53Check("recursive-chain-oracle", c1 == bwant, fmt.Sprint(c1), fmt.Sprint(bwant))
	runtime.GC()
	runtime.GC()
	c2 := r53SumBytes(b)
	u := r53Unrelated(nb)
	uwant := nb * 0xA5
	r53Check("recursive-unrelated-oracle", u == uwant, fmt.Sprint(u), fmt.Sprint(uwant))
	c3 := r53SumBytes(b)
	r53Check("recursive-chain-stable", c1 == c2 && c2 == c3, fmt.Sprint(c3), fmt.Sprint(c1))
	runtime.KeepAlive(b)
	if r53Failed {
		os.Exit(1)
	}
}
