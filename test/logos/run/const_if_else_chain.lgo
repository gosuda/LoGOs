// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func branch() string {
	const if 1 == 2 {
		return "first"
	} else const if 1 == 2 {
		return "second"
	} else {
		return "other"
	}
}
func main() {
	got := branch() + ";after"
	check("chain", got == "other;after", got, "other;after")
	if failed {
		os.Exit(1)
	}
}
