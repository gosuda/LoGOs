// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

const (
	debugOn = true
	traceOn = false
)

type point struct{ x, y int }

func flags() string {
	s := ""
	const if debugOn {
		p := point{1, 2}
		s += fmt.Sprintf("debug %d ", p.x+p.y)
	}
	const if traceOn {
		s += "trace "
	} else const if debugOn {
		s += "else-debug "
	}
	const if true {
		s += "true"
	}
	return s
}

func combined() string {
	const if debugOn && !traceOn {
		return "debug-only"
	} else {
		return "other"
	}
}

func main() {
	check("flags", flags() == "debug 3 else-debug true", flags(), "debug 3 else-debug true")
	check("combined", combined() == "debug-only", combined(), "debug-only")
	if failed {
		os.Exit(1)
	}
}
