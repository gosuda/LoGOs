// run

package main

import (
	"fmt"
	"io"
	"os"
	"strings"
	"unsafe"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type UserID int

type Word struct {
	S string
}

func (w Word) WriteTo(dst io.Writer) (int64, error) {
	n, err := io.WriteString(dst, w.S)
	return int64(n), err
}

func exactFirst() string {
	const switch UserID {
	case UserID:
		return "exact"
	case ~int:
		return "tilde"
	}
	return "after"
}

func tildeBeforeIface() string {
	const switch UserID {
	case ~int:
		return "tilde"
	case any:
		return "any"
	}
	return "after"
}

func ifaceBeforeIface() string {
	const switch Word {
	case io.WriterTo:
		return "writer-to"
	case any:
		return "any"
	}
	return "after"
}

func noMatch() string {
	const switch UserID {
	case ~string:
		return "string"
	case io.Reader:
		return "reader"
	}
	return "after"
}

//logos:allow(slop::discarded_error)
func ifaceBody(w Word) string {
	const switch Word {
	case io.WriterTo:
		var b strings.Builder
		w.WriteTo(&b)
		return b.String()
	}
	return "after"
}

var ifaceLayoutRan bool

func ifaceLayout(w Word) {
	const switch Word {
	case io.WriterTo:
		if unsafe.Sizeof(w) != unsafe.Sizeof(Word{}) {
			panic("iface layout size")
		}
		if unsafe.Alignof(w) != unsafe.Alignof(Word{}) {
			panic("iface layout align")
		}
		if unsafe.Offsetof(w.S) != unsafe.Offsetof(Word{}.S) {
			panic("iface layout offset")
		}
		var b strings.Builder
		n, err := w.WriteTo(&b)
		if err != nil || n != int64(len(w.S)) {
			panic("iface method set")
		}
		if b.String() != w.S {
			panic("iface method set")
		}
		ifaceLayoutRan = true
	}
}

func main() {
	check("exact", exactFirst() == "exact", exactFirst(), "exact")
	check("tilde", tildeBeforeIface() == "tilde", tildeBeforeIface(), "tilde")
	check("writer-to", ifaceBeforeIface() == "writer-to", ifaceBeforeIface(), "writer-to")
	check("nomatch", noMatch() == "after", noMatch(), "after")
	check("iface-body", ifaceBody(Word{"body"}) == "body", ifaceBody(Word{"body"}), "body")
	ifaceLayout(Word{"body"})
	check("iface-layout", ifaceLayoutRan, ifaceLayoutRan, true)
	if failed {
		os.Exit(1)
	}
}
