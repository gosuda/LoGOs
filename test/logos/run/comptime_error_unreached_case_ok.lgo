// run
package main

import "fmt"

// Same shape as the errorcheck fixture's positive control, but in its own
// build: the errorcheck file never finishes compilation (lowering exits on
// the two pinned errors), so only this file proves the clean generic builds
// and runs on its own.
func pickChecked[F any]() int {
	const switch F {
	case int:
		return 1
	}
	return 0
}

func main() {
	fmt.Println(pickChecked[int]())
}
