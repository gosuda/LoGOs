// run

package jsonstringstate

import (
	"encoding/json"
	"reflect"
	"strings"
	"testing"
)

type StrState struct {
	B bool    `json:"B,string"`
	I int64   `json:"I"`
	S string  `json:"S,string"`
	F float64 `json:"F,string"`
	J int64   `json:"J,string"`
}

type strStateMirror struct {
	B     bool    `json:"B,string"`
	I     int64   `json:"I"`
	S     string  `json:"S,string"`
	F     float64 `json:"F,string"`
	J     int64   `json:"J,string"`
	NoGen any     `json:"-"`
}

var stringStateDocs = []string{
	`{"B":"maybe","I":42}`,
	`{"S":123,"I":42}`,
	`{"J":"abc","I":42}`,
	`{"J":"+1","I":42}`,
	`{"B":"1","I":42}`,
	`{"B":"True","I":42}`,
	`{"F":"+1","I":42}`,
	`{"S":"\"a\\x\""}`,
	`{"S":"x","I":42}`,
	`{"B":"true","I":42}`,
	`{"B":"nul","I":42}`,
	`{"I":42,"B":"maybe"}`,
}

func decodePair(doc string) (StrState, error, strStateMirror, error) {
	var got StrState
	gotErr := json.Unmarshal([]byte(doc), &got)
	var want strStateMirror
	wantErr := json.Unmarshal([]byte(doc), &want)
	return got, gotErr, want, wantErr
}

func TestStringTagStateMatchesEncodingJSON(t *testing.T) {
	for _, doc := range stringStateDocs {
		got, gotErr, want, wantErr := decodePair(doc)
		wantState := StrState{B: want.B, I: want.I, S: want.S, F: want.F, J: want.J}
		if !reflect.DeepEqual(got, wantState) {
			t.Fatalf("%s: logos state %+v, encoding/json state %+v (logos err %v, std err %v)", doc, got, wantState, gotErr, wantErr)
		}
	}
}

func TestStringTagErrorsMatchEncodingJSON(t *testing.T) {
	for _, doc := range stringStateDocs {
		_, gotErr, _, wantErr := decodePair(doc)
		if (gotErr == nil) != (wantErr == nil) {
			t.Fatalf("%s: logos error %v, encoding/json error %v", doc, gotErr, wantErr)
		}
		if gotErr != nil && wantErr != nil {
			wantMsg := strings.ReplaceAll(wantErr.Error(), "strStateMirror", "StrState")
			if gotErr.Error() != wantMsg {
				t.Fatalf("%s: logos error %q, encoding/json error %q", doc, gotErr, wantMsg)
			}
		}
	}
}
