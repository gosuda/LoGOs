// run

package jsonunion

import (
	"encoding/json"
	"errors"
	"testing"

	"logos/rt"
)

// An anonymous struct union member promotes the UnmarshalJSON of its embedded
// field, so the generated trial calls it on the addressable scratch value.
// The sibling int has no decoder and stays untriable.
type AnonBase struct {
	X int64 `json:"x"`
}

func (b *AnonBase) UnmarshalJSON(data []byte) error {
	var v map[string]int64
	if err := json.Unmarshal(data, &v); err != nil {
		return err
	}
	x, ok := v["x"]
	if !ok {
		return errors.New("AnonBase requires x")
	}
	b.X = x
	return nil
}

type AnonNode interface {
	struct{ AnonBase } | int
}

type AnonHolder struct {
	Item   AnonNode
	Status int = 200
}

func TestAnonPromotedDecoderDecides(t *testing.T) {
	var h AnonHolder
	if err := json.Unmarshal([]byte(`{"Item":{"x":11}}`), &h); err != nil {
		t.Fatal(err)
	}
	s, ok := h.Item.(struct{ AnonBase })
	if !ok {
		t.Fatalf("expected anonymous struct member, got %T: %#v", h.Item, h.Item)
	}
	if s.X != 11 {
		t.Fatalf("expected X 11, got %d", s.X)
	}
}

func TestAnonNoMatchLeavesHolder(t *testing.T) {
	h := AnonHolder{}
	err := json.Unmarshal([]byte(`{"Item":{"bogus":1}}`), &h)
	if err == nil {
		t.Fatal("expected trial error, got nil")
	}
	var trialErr rt.UnionTrialError
	if !errors.As(err, &trialErr) {
		t.Fatalf("expected rt.UnionTrialError, got %T: %v", err, err)
	}
	if trialErr.Matched != 0 {
		t.Fatalf("expected Matched 0, got %d", trialErr.Matched)
	}
	if h.Item != nil {
		t.Fatalf("failed trials left the target touched: %#v", h.Item)
	}
}

// A decoder promoted through an embedded pointer runs on the scratch value
// only after the trial initializes that pointer. An embedded interface has
// no receiver to initialize, so the member stays untriable.
type AnonPtrNode interface {
	struct{ *AnonBase } | int
}

type AnonPtrHolder struct {
	Item   AnonPtrNode
	Status int = 200
}

func TestAnonPointerEmbeddingDecodes(t *testing.T) {
	var h AnonPtrHolder
	if err := json.Unmarshal([]byte(`{"Item":{"x":11}}`), &h); err != nil {
		t.Fatal(err)
	}
	s, ok := h.Item.(struct{ *AnonBase })
	if !ok {
		t.Fatalf("expected anonymous struct member, got %T: %#v", h.Item, h.Item)
	}
	if s.AnonBase == nil {
		t.Fatal("expected initialized embedded pointer, got nil")
	}
	if s.X != 11 {
		t.Fatalf("expected X 11, got %d", s.X)
	}
}

type AnonIfaceNode interface {
	struct{ json.Unmarshaler } | int
}

type AnonIfaceHolder struct {
	Item   AnonIfaceNode
	Status int = 200
}

func TestAnonInterfaceEmbeddingStaysUntriable(t *testing.T) {
	h := AnonIfaceHolder{}
	err := json.Unmarshal([]byte(`{"Item":{"x":11}}`), &h)
	if err == nil {
		t.Fatal("expected trial error, got nil")
	}
	var trialErr rt.UnionTrialError
	if !errors.As(err, &trialErr) {
		t.Fatalf("expected rt.UnionTrialError, got %T: %v", err, err)
	}
	if trialErr.Matched != 0 {
		t.Fatalf("expected Matched 0, got %d", trialErr.Matched)
	}
	if h.Item != nil {
		t.Fatalf("failed trials left the target touched: %#v", h.Item)
	}
}
