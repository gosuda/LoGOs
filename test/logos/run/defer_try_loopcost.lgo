// run

package main

import (
	"errors"
	"fmt"
	"os"
	"testing"
)

//go:noinline
func failNil() error {
	sink++
	return nil
}

//go:noinline
func failArg(x int) error {
	sink += x
	return nil
}

type box struct {
	v int
}

//go:noinline
func (b *box) Close() error {
	sink += b.v
	return nil
}

//go:noinline
func noteArg(x int) error {
	order = append(order, x)
	return nil
}

//go:noinline
func (b *box) CloseRec() error {
	closedVs = append(closedVs, b.v)
	return nil
}

var sink int
var sinkErr error
var order []int
var closedVs []int

func loopFn(n int) (err error) {
	for i := 0; i < n; i++ {
		defer failNil()?
	}
	return nil
}

func loopFnHand(n int) (err error) {
	for i := 0; i < n; i++ {
		defer func() {
			if e := failNil(); e != nil {
				if err == nil {
					err = e
				} else {
					err = errors.Join(err, e)
				}
			}
		}()
	}
	return nil
}

func loopArg(n int) (err error) {
	for i := 0; i < n; i++ {
		defer failArg(i)?
	}
	return nil
}

func loopArgHand(n int) (err error) {
	for i := 0; i < n; i++ {
		x := i
		defer func() {
			if e := failArg(x); e != nil {
				if err == nil {
					err = e
				} else {
					err = errors.Join(err, e)
				}
			}
		}()
	}
	return nil
}

func loopMethod(bs []*box) (err error) {
	for _, b := range bs {
		defer b.Close()?
	}
	return nil
}

func loopMethodHand(bs []*box) (err error) {
	for _, b := range bs {
		b := b
		defer func() {
			if e := b.Close(); e != nil {
				if err == nil {
					err = e
				} else {
					err = errors.Join(err, e)
				}
			}
		}()
	}
	return nil
}

func loopOrderLogos(n int) (err error) {
	for i := 0; i < n; i++ {
		defer noteArg(i)?
	}
	return nil
}

func loopOrderHand(n int) (err error) {
	for i := 0; i < n; i++ {
		x := i
		defer func() {
			if e := noteArg(x); e != nil {
				if err == nil {
					err = e
				} else {
					err = errors.Join(err, e)
				}
			}
		}()
	}
	return nil
}

func recvLogos() (err error) {
	b := &box{v: 1}
	defer b.CloseRec()?
	b = &box{v: 2}
	return nil
}

func recvHand() (err error) {
	b := &box{v: 1}
	b0 := b
	defer func() {
		if e := b0.CloseRec(); e != nil {
			if err == nil {
				err = e
			} else {
				err = errors.Join(err, e)
			}
		}
	}()
	b = &box{v: 2}
	return nil
}

func sameInts(a, c []int) bool {
	if len(a) != len(c) {
		return false
	}
	for i := range a {
		if a[i] != c[i] {
			return false
		}
	}
	return true
}

func main() {
	failed := false
	check := func(name string, logos, hand float64) {
		if logos != hand {
			fmt.Println("FAIL", name, "logos=", logos, "hand=", hand)
			failed = true
			return
		}
		fmt.Println(name, "ok")
	}
	check("fn", testing.AllocsPerRun(200, func() { sinkErr = loopFn(5) }), testing.AllocsPerRun(200, func() { sinkErr = loopFnHand(5) }))
	check("arg", testing.AllocsPerRun(200, func() { sinkErr = loopArg(5) }), testing.AllocsPerRun(200, func() { sinkErr = loopArgHand(5) }))
	bs := []*box{{v: 1}, {v: 2}, {v: 3}, {v: 4}, {v: 5}}
	check("method", testing.AllocsPerRun(200, func() { sinkErr = loopMethod(bs) }), testing.AllocsPerRun(200, func() { sinkErr = loopMethodHand(bs) }))
	if sinkErr != nil {
		fmt.Println("FAIL sinkErr not nil:", sinkErr)
		failed = true
	}
	order = nil
	sinkErr = loopOrderLogos(5)
	logosOrder := append([]int(nil), order...)
	order = nil
	sinkErr = loopOrderHand(5)
	want := []int{4, 3, 2, 1, 0}
	if sinkErr != nil || !sameInts(logosOrder, want) || !sameInts(order, want) {
		fmt.Println("FAIL order logos=", logosOrder, "hand=", order)
		failed = true
	} else {
		fmt.Println("order ok")
	}
	closedVs = nil
	sinkErr = recvLogos()
	logosRec := append([]int(nil), closedVs...)
	closedVs = nil
	sinkErr = recvHand()
	if sinkErr != nil || !sameInts(logosRec, []int{1}) || !sameInts(closedVs, []int{1}) {
		fmt.Println("FAIL recv logos=", logosRec, "hand=", closedVs)
		failed = true
	} else {
		fmt.Println("recv ok")
	}
	if failed {
		os.Exit(1)
	}
}
