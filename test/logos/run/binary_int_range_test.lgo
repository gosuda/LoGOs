package main

import (
	"bytes"
	"fmt"
	"os"
	"strings"
)

type Ints struct {
	A int8   `json:"a"`
	B uint16 `json:"b"`
	C int32  `json:"c"`
	D uint32 `json:"d"`
	E uint8  `json:"e"`
}

type rangeCase struct {
	name   string
	values [5]uint64
	field  string
	offset int
}

var failed bool

func report(name string, ok bool, format string, args ...any) {
	if ok {
		fmt.Println("ok", name)
		return
	}
	failed = true
	fmt.Println("FAIL", name+":", fmt.Sprintf(format, args...))
}

func mustBytes(b []byte, err error) []byte {
	if err != nil {
		fmt.Println("FAIL", err)
		os.Exit(1)
	}
	return b
}

func wire(values [5]uint64) []byte {
	out := []byte{1}
	for _, v := range values {
		for i := range 8 {
			out = append(out, byte(v>>(8*uint(i))))
		}
	}
	return out
}

func checkInRange() {
	values := [5]uint64{^uint64(0), 65535, ^uint64(0) - 4, 4294967295, 255}
	in := wire(values)
	var got Ints
	if err := got.UnmarshalBinary(in); err != nil {
		report("int-range-in-range", false, "rejected a value its field holds: %v", err)
		return
	}
	want := Ints{A: -1, B: 65535, C: -5, D: 4294967295, E: 255}
	report("int-range-in-range", got == want, "decoded %v, want %v", got, want)
	report("int-range-wire-stable", bytes.Equal(mustBytes(got.MarshalBinary()), in), "re-encoded %v, input %v", mustBytes(got.MarshalBinary()), in)
}

func checkRejected(c rangeCase) {
	var got Ints
	err := got.UnmarshalBinary(wire(c.values))
	if err == nil {
		report(c.name, false, "accepted %v as %v", c.values, got)
		return
	}
	msg := err.Error()
	ok := strings.Contains(msg, "Ints."+c.field) && strings.Contains(msg, fmt.Sprintf("offset %d", c.offset))
	report(c.name, ok, "error %q does not name field %s and offset %d", msg, c.field, c.offset)
}

func main() {
	checkInRange()
	for _, c := range []rangeCase{
		{"int-range-int8-above", [5]uint64{0x12c, 0, 0, 0, 0}, "A", 1},
		{"int-range-int8-positive-255", [5]uint64{255, 0, 0, 0, 0}, "A", 1},
		{"int-range-uint16-above", [5]uint64{0, 0x1ffff, 0, 0, 0}, "B", 9},
		{"int-range-int32-above", [5]uint64{0, 0, 1 << 32, 0, 0}, "C", 17},
		{"int-range-uint32-above", [5]uint64{0, 0, 0, 1<<32 + 1, 0}, "D", 25},
		{"int-range-uint8-above", [5]uint64{0, 0, 0, 0, 0x100}, "E", 33},
	} {
		checkRejected(c)
	}
	if failed {
		os.Exit(1)
	}
}
