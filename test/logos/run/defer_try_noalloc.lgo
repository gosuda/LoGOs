// run

package main

import (
	"fmt"
	"os"
	"testing"
)

func failNil() error { return nil }

func guardedNil() (err error) {
	defer failNil()?
	return nil
}

var sinkErr error

func main() {
failed := false
if err := guardedNil(); err != nil {
fmt.Println("FAIL nil:", "got", err, "want", nil)
failed = true
} else {
fmt.Println("ok nil")
}
n := testing.AllocsPerRun(100, func() { sinkErr = guardedNil() })
if n != 0 || sinkErr != nil {
fmt.Println("FAIL allocs:", "got", n, sinkErr, "want", 0)
failed = true
} else {
fmt.Println("ok allocs")
}
if failed {
os.Exit(1)
}
}
