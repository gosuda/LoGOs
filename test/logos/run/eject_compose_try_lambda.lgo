func main() {
	_ = context.Background
	run("chain-find__lamapply", c_chain_find_lamapply, "-1 <nil> 0\n-1 <nil> 0\n")
	run("chain-find__propcoal", c_chain_find_propcoal, "-1 <nil> 0\n-1 <nil> 0\n")
	run("chain-find__proplam", c_chain_find_proplam, "-1 <nil> 0\n-1 <nil> 0\n")
	run("chain-find__propr", c_chain_find_propr, "-1 <nil> 0\n-1 <nil> 0\n")
	run("chain-lam__lamapply", c_chain_lam_lamapply, "30 <nil> 0\n30 <nil> 0\n")
	run("chain-lam__propcoal", c_chain_lam_propcoal, "27 <nil> 0\n27 <nil> 0\n")
	run("chain-lam__proplam", c_chain_lam_proplam, "39 <nil> 0\n39 <nil> 0\n")
	run("chain-lam__propr", c_chain_lam_propr, "18 <nil> 0\n18 <nil> 0\n")
	run("chain-pred__lamapply", c_chain_pred_lamapply, "3 <nil> 0\n3 <nil> 0\n")
	run("chain-pred__propcoal", c_chain_pred_propcoal, "3 <nil> 0\n3 <nil> 0\n")
	run("chain-pred__proplam", c_chain_pred_proplam, "3 <nil> 0\n3 <nil> 0\n")
	run("chain-pred__propr", c_chain_pred_propr, "3 <nil> 0\n3 <nil> 0\n")
	run("chain-take__lamapply", c_chain_take_lamapply, "3 <nil> 0\n3 <nil> 0\n")
	run("chain-take__proplam", c_chain_take_proplam, "3 <nil> 0\n3 <nil> 0\n")
	run("defer-arg__lamapply", c_defer_arg_lamapply, "5 <nil> 8\n5 <nil> 8\n")
	run("defer-arg__propcoal", c_defer_arg_propcoal, "5 <nil> 7\n5 <nil> 7\n")
	run("defer-arg__proplam", c_defer_arg_proplam, "5 <nil> 11\n5 <nil> 11\n")
	run("defer-arg__propr", c_defer_arg_propr, "5 <nil> 4\n5 <nil> 4\n")
	run("group-body__propcoal", c_group_body_propcoal, "7 <nil> 0\n7 <nil> 0\n")
	run("group-body__proplam", c_group_body_proplam, "11 <nil> 0\n11 <nil> 0\n")
	run("group-body__propr", c_group_body_propr, "4 <nil> 0\n4 <nil> 0\n")
	run("lambda-body__chainc", c_lambda_body_chainc, "4 <nil> 0\n4 <nil> 0\n")
	run("lambda-body__coal", c_lambda_body_coal, "8 <nil> 0\n8 <nil> 0\n")
	run("lambda-body__cv", c_lambda_body_cv, "4 <nil> 0\n4 <nil> 0\n")
	run("lambda-body__lamapply", c_lambda_body_lamapply, "9 <nil> 0\n9 <nil> 0\n")
	run("lambda-body__propcoal", c_lambda_body_propcoal, "8 <nil> 0\n8 <nil> 0\n")
	run("lambda-body__proplam", c_lambda_body_proplam, "12 <nil> 0\n12 <nil> 0\n")
	run("lambda-body__propr", c_lambda_body_propr, "5 <nil> 0\n5 <nil> 0\n")
	run("lambda-body__sw", c_lambda_body_sw, "71 <nil> 0\n71 <nil> 0\n")
	run("seed-cvgroup", c_seed_cvgroup, "1 <nil> 0\n1 <nil> 0\n")
	run("try-arg__lamapply", c_try_arg_lamapply, "8 <nil> 0\n0 load 0\n")
	run("try-arg__propcoal", c_try_arg_propcoal, "7 <nil> 0\n0 load 0\n")
	run("try-arg__proplam", c_try_arg_proplam, "11 <nil> 0\n0 load 0\n")
	run("try-arg__propr", c_try_arg_propr, "4 <nil> 0\n0 load 0\n")
	if failed {
		os.Exit(1)
	}
}
