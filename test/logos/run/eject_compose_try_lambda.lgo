func c_group_body_propcoal(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	ctx := context.Background()
	r := 0
	go group (ctx) {
		go {
			r = (maybe(v) ?? w.P)
		}
	}
	return r, nil
}

