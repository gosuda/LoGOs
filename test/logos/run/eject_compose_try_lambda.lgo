func c_defer_arg_lamapply(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	defer record(apply(x => x + 1, v))?
	r := 5
	return r, nil
}

