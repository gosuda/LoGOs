func c_lambda_body_sw(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	r := apply(x => x + switch v {
		case 7 => 70
		default => 1
		}, 1)
	return r, nil
}

func cvs(v int, a, b const []int) int {
	r := switch v {
	case 7 => a
	default => b
	}
	return len(r)
}

func c_seed_cvgroup(v int, fail bool) (int, error) {
	return cvs(v, []int{1}, []int{2, 3}), nil
}

func c_try_arg_lamapply(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	r := load(apply(x => x + 1, v), fail)?
	return r, nil
}

