func c_lambda_body_chainc(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	r := apply(x => x + xs.map(x => x + v).count(), 1)
	return r, nil
}

