// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func main() {
	xs := []int{1, 2}
	got := xs.map(x => $"n{x}")
	var want []string
	for _, x := range xs {
		want = append(want, fmt.Sprint("n", x))
	}
	check("chain-interp-formats-elements", fmt.Sprint(got) == fmt.Sprint(want) && fmt.Sprint(got) == "[n1 n2]", fmt.Sprint(got), "[n1 n2]")
	gotBlock := xs.map(x => { return $"m{x}" })
	var wantBlock []string
	for _, x := range xs {
		wantBlock = append(wantBlock, fmt.Sprint("m", x))
	}
	check("chain-block-interp-formats-elements", fmt.Sprint(gotBlock) == fmt.Sprint(wantBlock) && fmt.Sprint(gotBlock) == "[m1 m2]", fmt.Sprint(gotBlock), "[m1 m2]")
	if failed {
		os.Exit(1)
	}
}
