// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Point struct {
	X, Y int
}

func sum(xs const []int) int {
	total := 0
	for _, x := range xs {
		total += x
	}
	return total
}

func first(xs const []int) int {
	return xs[0]
}

func norm(p const *Point) int {
	return p.X*p.X + p.Y*p.Y
}

func main() {
	xs := []int{1, 2, 3, 4}
	var view const []int = xs
	check("view-triple", sum(view) == 10 && first(view) == 1 && len(view) == 4, fmt.Sprint(sum(view), first(view), len(view)), "10 1 4")
	p := &Point{X: 3, Y: 4}
	check("norm", norm(p) == 25, norm(p), 25)
	var copied Point = *p
	copied.X = 10
	check("copy", copied.X == 10 && p.X == 3, fmt.Sprint(copied.X, p.X), "10 3")
	if failed {
		os.Exit(1)
	}
}
