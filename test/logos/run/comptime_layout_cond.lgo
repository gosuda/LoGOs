// run

// Comptime layout calls as constant `const if` leaves: a call taking no
// arguments has an EndPos short of its argument list, so the folded
// literal must splice past the closing parenthesis of every such leaf,
// alone, negated, over a concrete type argument, and as the last leaf
// of a conjunction whose earlier leaf waits for the instantiation.

package main

import (
	"comptime"
	"fmt"
)

type Pair struct {
	X *int
	Y int
}

type Flat struct {
	A int32
}

func Alone[T any]() string {
	const if comptime.HasPointers[*T]() {
		return "ptr"
	}
	return "flat"
}

func Negated[T any]() string {
	const if !comptime.HasPointers[*T]() {
		return "flat"
	}
	return "ptr"
}

func Concrete[T any]() string {
	const if comptime.HasPointers[Pair]() {
		return "scan"
	}
	return "noscan"
}

func Conjoined[T any]() string {
	const if comptime.HasPointers[*T]() && comptime.HasPointers[Pair]() {
		return "both"
	}
	return "plain"
}

func main() {
	fmt.Println(Alone[int](), Alone[Flat]())
	fmt.Println(Negated[int](), Negated[Flat]())
	fmt.Println(Concrete[int](), Concrete[Flat]())
	fmt.Println(Conjoined[int](), Conjoined[Flat]())
}
