// run

package main

import (
	"context"
	"errors"
	"fmt"
	"os"
)
var failed bool
func check(name string, cond bool, got, want any) {
if !cond {
failed = true
fmt.Println("FAIL", name+":", "got", got, "want", want)
return
}
fmt.Println("ok", name)
}
var calls int
var errNeg = errors.New("neg")

func parse(x int) (int, error) {
	calls++
	if x < 0 {
		return 0, errNeg
	}
	return 2 * x, nil
}

func isPos(x int) (bool, error) {
	calls++
	if x < 0 {
		return false, errNeg
	}
	return x > 1, nil
}

func condIter(xs []int) (int, error) {
	calls = 0
	total := 0
	for i := 0; i < len(xs.map(x => parse(x)?)); i++ {
		total++
	}
	return total, nil
}

func postIter(xs []int) (int, error) {
	calls = 0
	total := 0
	for i := 0; i < 3; i += len(xs.map(x => parse(x)?)) {
		total++
	}
	return total, nil
}

func caseGuard(k int, ys []int) (string, error) {
	calls = 0
	switch k {
	case 1:
		return fmt.Sprintf("one calls=%d", calls), nil
	case ys.count(x => isPos(x)?):
		return fmt.Sprintf("count calls=%d", calls), nil
	default:
		return fmt.Sprintf("default calls=%d", calls), nil
	}
}

var childRan int

func markRun() error {
	childRan = 1
	return nil
}

func groupChildTry(ctx context.Context, xs []int) (int, error) {
	calls = 0
	childRan = 0
	go group (ctx) {
		go markRun()
		go {
			ys := xs.map(x => parse(x)?)
			_ = ys
		}
	}
	return childRan, nil
}

func takeNested(xs []int, ys []int) ([]int, error) {
	return xs.take(ys.count()), nil
}

func contPost(xs []int) (int, error) {
	calls = 0
	total := 0
	for i := 0; i < 3; i += len(xs.map(x => parse(x)?)) {
		if i == 1 {
			continue
		}
		total += 10
	}
	return total, nil
}

func switchFall(k int, ys []int) (string, error) {
	calls = 0
	switch k {
	case ys.count(x => isPos(x)?):
		return fmt.Sprintf("hit calls=%d", calls), nil
	case 9:
		calls = 100
		fallthrough
	default:
		return fmt.Sprintf("def calls=%d", calls), nil
	}
}

func groupChildFilter(ctx context.Context, xs []int) (int, error) {
	calls = 0
	childRan = 0
	n := 0
	go group (ctx) {
		go markRun()
		go {
			ys := xs.filter(x => isPos(x)?)
			total := 0
			for _, v := range ys {
				total += v
			}
			n = total
		}
	}
	return n, nil
}

func show(name, want string, f func() (any, error)) {
	v, err := f()
	var got string
	if err != nil {
		got = "err: " + err.Error()
	} else {
		got = fmt.Sprint(v)
	}
	check(name, got == want, got, want)
}
//logos:allow(complexity::cognitive_overflow)
func main() {
total, err := condIter([]int{1, 2})
if err != nil {
check("cond", false, err, "2 6")
} else {
got := fmt.Sprint(total, calls)
check("cond", got == "2 6", got, "2 6")
}
total, err = postIter([]int{1})
if err != nil {
check("post", false, err, "3 3")
} else {
got := fmt.Sprint(total, calls)
check("post", got == "3 3", got, "3 3")
}
show("caseguard", "one calls=0", func() (any, error) { return caseGuard(1, []int{-1}) })
show("caseguardok", "count calls=3", func() (any, error) { return caseGuard(2, []int{1, 2, 3}) })
show("caseguarddefault", "default calls=1", func() (any, error) { return caseGuard(9, []int{1}) })
n, err := groupChildTry(context.Background(), []int{-1})
if err != nil {
got := fmt.Sprintf("%d err: %v %d", n, err, childRan)
check("groupchild", got == "0 err: neg 1", got, "0 err: neg 1")
} else {
check("groupchild", false, n, "0 err: neg 1")
}
show("takenested", "[1 2]", func() (any, error) { return takeNested([]int{1, 2, 3}, []int{4, 5}) })
total, err = contPost([]int{1})
if err != nil {
check("contpost", false, err, "20 3")
} else {
got := fmt.Sprint(total, calls)
check("contpost", got == "20 3", got, "20 3")
}
show("switchfall", "hit calls=3", func() (any, error) { return switchFall(2, []int{1, 2, 3}) })
show("switchfallthrough", "def calls=100", func() (any, error) { return switchFall(9, []int{1, 2, 3}) })
show("switchfalldefault", "def calls=3", func() (any, error) { return switchFall(7, []int{1, 2, 3}) })
n, err = groupChildFilter(context.Background(), []int{-1})
if err != nil {
got := fmt.Sprintf("%d err: %v %d", n, err, childRan)
check("groupfilter", got == "0 err: neg 1", got, "0 err: neg 1")
} else {
check("groupfilter", false, n, "0 err: neg 1")
}
n, err = groupChildFilter(context.Background(), []int{1, 2})
if err != nil {
check("groupfilterok", false, err, "2 <nil> 1")
} else {
got := fmt.Sprintf("%d %v %d", n, err, childRan)
check("groupfilterok", got == "2 <nil> 1", got, "2 <nil> 1")
}
if failed {
os.Exit(1)
}
}
