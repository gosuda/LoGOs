package main

import (
	"context"
	"errors"
	"fmt"
	"iter"
	"os"
)

var _ iter.Seq[int]

type pc struct {
	id int
}

type box struct {
	o int?
	p int
}

type State struct {
	A int
	B int
}

type Prop interface {
	P int
}

type propBox struct : Prop {
	P int
}

var errLoad = errors.New("load")

var last int

func load(v int, fail bool) (int, error) {
	if fail {
		return 0, errLoad
	}
	return v, nil
}

func maybe(n int) int? {
	if n == 7 {
		return 7
	}
	return nil
}

func maybeP(n int) *pc? {
	if n == 7 {
		return &pc{id: 7}
	}
	return nil
}

func apply(f func(int) int, n int) int { return f(n) }

func viewLen(xs const []int) int { return len(xs) }

func record(n int) error {
	last = n
	return nil
}

func mkState(n int) State { return State{A: n, B: n + 1} }

func pair(n int) (int, string) { return n, "p" }

func tupA(t (int, string)) int {
	a, _ := t
	return a
}

var failed bool

func line(f func(int, bool) (int, error), fail bool) string {
	last = 0
	got, err := f(7, fail)
	if err != nil {
		return fmt.Sprintln(0, err, last)
	}
	return fmt.Sprintln(got, err, last)
}

func run(name string, f func(int, bool) (int, error), want string) {
	got := line(f, false) + line(f, true)
	if got != want {
		failed = true
		fmt.Printf("FAIL %s: got %q want %q\n", name, got, want)
		return
	}
	fmt.Println("ok", name)
}

func c_coal_left_optcompo(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	r := box{o: maybe(v), p: 1}.o ?? -1
	return r, nil
}

func c_coal_left_swo(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	r := switch v {
		case 7 => maybe(7)
		default => maybe(0)
		} ?? -1
	return r, nil
}

func c_coal_right_propcoal(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	r := maybe(0) ?? (maybe(v) ?? w.P)
	return r, nil
}

func c_coal_right_proplam(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	r := maybe(0) ?? apply(x => x + w.P, v)
	return r, nil
}

func c_coal_right_propr(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	r := maybe(0) ?? w.P
	return r, nil
}

func c_coal_right_sw(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	r := maybe(0) ?? switch v {
		case 7 => 70
		default => 1
		}
	return r, nil
}

func c_optcomp_p_propcoal(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	b := box{o: maybe(v), p: (maybe(v) ?? w.P)}
	r := b.p
	return r, nil
}

func c_optcomp_p_proplam(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	b := box{o: maybe(v), p: apply(x => x + w.P, v)}
	r := b.p
	return r, nil
}

func c_optcomp_p_propr(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	b := box{o: maybe(v), p: w.P}
	r := b.p
	return r, nil
}

func c_optsel_base_swp(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	r := (switch v {
		case 7 => maybeP(7)
		default => maybeP(0)
		})?.id ?? -1
	return r, nil
}

func main() {
	_ = context.Background
	run("coal-left__optcompo", c_coal_left_optcompo, "7 <nil> 0\n7 <nil> 0\n")
	run("coal-left__swo", c_coal_left_swo, "7 <nil> 0\n7 <nil> 0\n")
	run("coal-right__propcoal", c_coal_right_propcoal, "7 <nil> 0\n7 <nil> 0\n")
	run("coal-right__proplam", c_coal_right_proplam, "11 <nil> 0\n11 <nil> 0\n")
	run("coal-right__propr", c_coal_right_propr, "4 <nil> 0\n4 <nil> 0\n")
	run("coal-right__sw", c_coal_right_sw, "70 <nil> 0\n70 <nil> 0\n")
	run("optcomp-p__propcoal", c_optcomp_p_propcoal, "7 <nil> 0\n7 <nil> 0\n")
	run("optcomp-p__proplam", c_optcomp_p_proplam, "11 <nil> 0\n11 <nil> 0\n")
	run("optcomp-p__propr", c_optcomp_p_propr, "4 <nil> 0\n4 <nil> 0\n")
	run("optsel-base__swp", c_optsel_base_swp, "7 <nil> 0\n7 <nil> 0\n")
	if failed {
		os.Exit(1)
	}
}
