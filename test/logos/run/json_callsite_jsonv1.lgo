// run -goexperiment nojsonv2

package main


import (
	"bytes"
	"encoding/json"
	"fmt"
)

type User struct {
	ID    int64  `json:"id"`
	Name  string `json:"name"`
	Email string `json:"email,omitempty"`
}

type Container struct {
	Payload any `json:"payload"`
}

func testCallSiteParityWithMarshalJSON() {
	users := []User{
		{ID: 101, Name: "Ada Lovelace", Email: "ada@example.com"},
		{ID: 102, Name: "Alan Turing"},
		{ID: 0, Name: ""},
	}

	for _, u := range users {
		direct, err := u.MarshalJSON()
		if err != nil {
			panic(err)
		}

		viaJSON, err := json.Marshal(u)
		if err != nil {
			panic(err)
		}

		if !bytes.Equal(direct, viaJSON) {
			panic(fmt.Sprintf("json.Marshal(%+v) = %s, MarshalJSON() = %s", u, viaJSON, direct))
		}
	}
}

func testPointerAndInterfaceFormsAgree() {
	u := User{ID: 202, Name: "Grace Hopper", Email: "grace@navy.mil"}

	valBytes, err := json.Marshal(u)
	if err != nil {
		panic(err)
	}

	ptrBytes, err := json.Marshal(&u)
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(ptrBytes, valBytes) {
		panic(fmt.Sprintf("json.Marshal(&v) %s != json.Marshal(v) %s", ptrBytes, valBytes))
	}

	ifaceBytes, err := json.Marshal(any(u))
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(ifaceBytes, valBytes) {
		panic(fmt.Sprintf("json.Marshal(any(v)) %s != json.Marshal(v) %s", ifaceBytes, valBytes))
	}

	ptrIfaceBytes, err := json.Marshal(any(&u))
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(ptrIfaceBytes, valBytes) {
		panic(fmt.Sprintf("json.Marshal(any(&v)) %s != json.Marshal(v) %s", ptrIfaceBytes, valBytes))
	}

	cVal := Container{Payload: u}
	cPtr := Container{Payload: &u}
	bVal, err := json.Marshal(cVal)
	if err != nil {
		panic(err)
	}
	bPtr, err := json.Marshal(cPtr)
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(bVal, bPtr) {
		panic(fmt.Sprintf("Container with interface field: val %s != ptr %s", bVal, bPtr))
	}
}

func testEncoderAddsOnlyTrailingNewline() {
	u := User{ID: 303, Name: "Edsger Dijkstra", Email: "ewd@utexas.edu"}

	marshaled, err := json.Marshal(u)
	if err != nil {
		panic(err)
	}

	var buf bytes.Buffer
	enc := json.NewEncoder(&buf)
	if err := enc.Encode(u); err != nil {
		panic(err)
	}

	encoded := buf.Bytes()
	if len(encoded) != len(marshaled)+1 {
		panic(fmt.Sprintf("Encoder len %d != Marshal len %d + 1", len(encoded), len(marshaled)))
	}
	if encoded[len(encoded)-1] != '\n' {
		panic(fmt.Sprintf("Encoder missing trailing newline: %q", encoded))
	}
	if !bytes.Equal(encoded[:len(encoded)-1], marshaled) {
		panic(fmt.Sprintf("Encoder payload %s != Marshal payload %s", encoded[:len(encoded)-1], marshaled))
	}

	buf.Reset()
	if err := enc.Encode(&u); err != nil {
		panic(err)
	}
	if !bytes.Equal(buf.Bytes(), encoded) {
		panic(fmt.Sprintf("Encoder(&v) %s != Encoder(v) %s", buf.Bytes(), encoded))
	}
}

type RichV1 struct {
	Name  string   `json:"name"`
	Esc   string   `json:"esc"`
	Omit  string   `json:"omit,omitempty"`
	F     float64  `json:"f"`
	E     float64  `json:"e"`
	N     int64    `json:"n"`
	Inner User     `json:"inner"`
	Nums  []int64  `json:"nums"`
	Raw   []byte   `json:"raw"`
}

type RichV1Mirror RichV1

func testRichParityUnderNoJSONv2() {
	vals := []RichV1{
		{Name: "plain", Esc: "x", Omit: "", F: 1.5, E: 1e21, N: 0, Inner: User{ID: 1, Name: "n"}, Nums: nil, Raw: nil},
		{Name: "Ada <Lovelace> & \"friends\"", Esc: "\xff\xfe\u2028end", Omit: "shown", F: 1e-7, E: -2.5, N: -12, Inner: User{ID: 2, Name: "a&b", Email: "e@x.y"}, Nums: []int64{-1, 0, 9}, Raw: []byte{0, 1, 255}},
		{Name: "", Esc: "", Omit: "x", F: 5e-324, E: 123456789.0, N: 42, Inner: User{}, Nums: []int64{}, Raw: []byte{}},
	}
	for _, v := range vals {
		direct, err := v.MarshalJSON()
		if err != nil {
			panic(err)
		}
		via, err := json.Marshal(RichV1Mirror(v))
		if err != nil {
			panic(err)
		}
		if !bytes.Equal(direct, via) {
			panic(fmt.Sprintf("nojsonv2 RichV1(%+v):\n got %s\nwant %s", v, direct, via))
		}
	}
}
type RichV2 struct {
	Title string            `json:"title,omitempty"`
	N     int64             `json:"n,string"`
	Flag  bool              `json:"flag,omitzero"`
	Inner User              `json:"inner"`
	Tags  []string          `json:"tags,omitempty"`
	M     map[string]int64  `json:"m,omitempty"`
}

type RichV2Mirror RichV2

func testRichV2ParityUnderNoJSONv2() {
	vals := []RichV2{
		{},
		{Title: "a<b>&\"q\"", N: -12, Flag: true, Inner: User{ID: 7, Name: "n"}, Tags: []string{"x", "y z"}, M: map[string]int64{"b": 2, "a": 1}},
		{Title: "plain", N: 1234567890, Inner: User{}, Tags: []string{}, M: map[string]int64{}},
	}
	for _, v := range vals {
		direct, err := v.MarshalJSON()
		if err != nil {
			panic(err)
		}
		via, err := json.Marshal(RichV2Mirror(v))
		if err != nil {
			panic(err)
		}
		if !bytes.Equal(direct, via) {
			panic(fmt.Sprintf("nojsonv2 RichV2(%+v):\n got %s\nwant %s", v, direct, via))
		}
	}
}

type SeparatorTags struct {
	Odd  string `json:"a\u2028b"`
	Even string `json:"c\u2029d"`
}

type SeparatorTagsMirror SeparatorTags

func testSeparatorTagNamesUnderNoJSONv2() {
	v := SeparatorTags{Odd: "x", Even: "y"}
	want, err := json.Marshal(SeparatorTagsMirror(v))
	if err != nil {
		panic(err)
	}
	got, err := json.Marshal(v)
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(got, want) {
		panic(fmt.Sprintf("nojsonv2 SeparatorTags:\n got %s\nwant %s", got, want))
	}
	var back SeparatorTags
	if err := json.Unmarshal(want, &back); err != nil {
		panic(err)
	}
	if back != v {
		panic(fmt.Sprintf("nojsonv2 SeparatorTags round trip changed %+v into %+v", v, back))
	}
}

type Tag string

func (v *Tag) UnmarshalJSON(b []byte) error {
	var s string
	if err := json.Unmarshal(b, &s); err != nil {
		return err
	}
	*v = Tag(s)
	return nil
}

type Count int64

func (v *Count) UnmarshalJSON(b []byte) error {
	var n int64
	if err := json.Unmarshal(b, &n); err != nil {
		return err
	}
	*v = Count(n)
	return nil
}

type UnionMember interface {
	User | *User | Tag | Count
}

type UnionHolder struct {
	Item UnionMember `json:"item"`
}

func testUnionMarshalUnderNoJSONv2() {
	u := &User{ID: 5, Name: "n<&>\u2028", Email: "e"}
	tag := Tag("a<b>&\u2028\u2029\xff\"\\")
	cases := []struct {
		name   string
		item   UnionMember
		member any
	}{
		{"struct", *u, *u},
		{"pointer", u, u},
		{"string", tag, tag},
		{"integer", Count(-7), Count(-7)},
		{"nil", nil, nil},
	}
	for _, c := range cases {
		memberBytes, err := json.Marshal(c.member)
		if err != nil {
			panic(err)
		}
		want := append(append([]byte(`{"item":`), memberBytes...), '}')
		h := UnionHolder{Item: c.item}
		direct, err := h.MarshalJSON()
		if err != nil {
			panic(err)
		}
		via, err := json.Marshal(h)
		if err != nil {
			panic(err)
		}
		if !bytes.Equal(direct, want) || !bytes.Equal(via, want) {
			panic(fmt.Sprintf("nojsonv2 union %s:\n direct %s\n    via %s\n   want %s", c.name, direct, via, want))
		}
	}
}

func main() {
testCallSiteParityWithMarshalJSON()
fmt.Println("ok callsite-marshal")
testPointerAndInterfaceFormsAgree()
fmt.Println("ok callsite-forms")
testEncoderAddsOnlyTrailingNewline()
fmt.Println("ok callsite-encoder")
testRichParityUnderNoJSONv2()
fmt.Println("ok callsite-richv1")
testRichV2ParityUnderNoJSONv2()
fmt.Println("ok callsite-richv2")
testSeparatorTagNamesUnderNoJSONv2()
fmt.Println("ok callsite-separator-tags")
testUnionMarshalUnderNoJSONv2()
fmt.Println("ok callsite-union")
}
