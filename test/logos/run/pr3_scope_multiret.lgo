// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func pair() (int, int) { return 1, 2 }

func f() (a, b int) {
	{
		scope defer func() { a++ }()
		return pair()
	}
}

func bare() (a int) {
	{
		scope defer func() { a++ }()
		a = 41
		return
	}
}

func main() {
	a, b := f()
	check("multi", a == 2 && b == 2, fmt.Sprint(a, b), "2 2")
	bare := bare()
	check("bare", bare == 42, bare, 42)
	if failed {
		os.Exit(1)
	}
}
