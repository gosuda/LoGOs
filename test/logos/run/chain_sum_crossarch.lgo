// run

package main

import (
	"fmt"
	"math"
)

//logos:allow(slop::discarded_error)
func main() {
	a := []float64{1e16, -1e16, 1.0}.sum()
	fmt.Printf("%x\n", math.Float64bits(a))
	b := []float64{1, 2, 3, 4}.sum()
	fmt.Printf("%x\n", math.Float64bits(b))
	c := []float64{1.0, 1e16, -1e16}.sum()
	fmt.Printf("%x\n", math.Float64bits(c))
}
