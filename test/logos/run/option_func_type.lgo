// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}
var q (func /*
	 * filler 001
	 * filler 002
	 * filler 003
	 * filler 004
	 * filler 005
	 * filler 006
	 * filler 007
	 * filler 008
	 * filler 009
	 * filler 010
	 * filler 011
	 * filler 012
	 * filler 013
	 * filler 014
	 * filler 015
	 * filler 016
	 * filler 017
	 * filler 018
	 * filler 019
	 * filler 020
	 * filler 021
	 * filler 022
	 * filler 023
	 * filler 024
	 * filler 025
	 * filler 026
	 * filler 027
	 * filler 028
	 * filler 029
	 * filler 030
	 * filler 031
	 * filler 032
	 * filler 033
	 * filler 034
	 * filler 035
	 * filler 036
	 * filler 037
	 * filler 038
	 * filler 039
	 * filler 040
	 * filler 041
	 * filler 042
	 * filler 043
	 * filler 044
	 * filler 045
	 * filler 046
	 * filler 047
	 * filler 048
	 * filler 049
	 * filler 050
	 * filler 051
	 * filler 052
	 * filler 053
	 * filler 054
	 * filler 055
	 * filler 056
	 * filler 057
	 * filler 058
	 * filler 059
	 * filler 060
	 * filler 061
	 * filler 062
	 * filler 063
	 * filler 064
	 * filler 065
	 * filler 066
	 * filler 067
	 * filler 068
	 * filler 069
	 * filler 070
	 */ (int) int)? = func(n int) int { return n + 3 }

func callOpt(f (func(int) int)?, n int) int {
	if f != nil {
		return f(n)
	}
	panic("callOpt: unexpected none option function")
}

func main() {
	var bjarne1 (func(int) int)? = func(n int) int { return (61 + n) }
	var ken2 (func(int) int)?
	check("bjarne-some", bjarne1 != nil, bjarne1 != nil, true)
	check("ken-none", ken2 == nil, ken2 == nil, true)
	if bjarne1 != nil {
		gotC8 := bjarne1(8)
		check("call-8", gotC8 == 69, gotC8, 69)
		gotCN6 := bjarne1(-6)
		check("call-neg6", gotCN6 == 55, gotCN6, 55)
	}
	bjarne1 = ken2
	check("assign-none", bjarne1 == nil, bjarne1 == nil, true)
	var rob3 ((func(int) int))? = func(n int) int { return (n + 1) }
	check("rob-some", rob3 != nil, rob3 != nil, true)
	gotRob := callOpt(rob3, 10)
	check("rob-call", gotRob == 11, gotRob, 11)
	var h (func // between keyword and parameter
	(int) int)? = func(n int) int { return n + 1 }
	var k (func /* outer /* inner */ (int) int)? = func(n int) int { return n + 2 }
	check("h-some", h != nil, h != nil, true)
	check("k-some", k != nil, k != nil, true)
	gotH := callOpt(h, 10)
	check("h-call", gotH == 11, gotH, 11)
	gotK := callOpt(k, 20)
	check("k-call", gotK == 22, gotK, 22)
	var w (func /* func */ (int) int)? = func(n int) int { return n + 5 }
	check("w-some", w != nil, w != nil, true)
	check("q-some", q != nil, q != nil, true)
	gotW := callOpt(w, 50)
	check("w-call", gotW == 55, gotW, 55)
	gotQ := callOpt(q, 30)
	check("q-call", gotQ == 33, gotQ, 33)
	if failed {
		os.Exit(1)
	}
}
