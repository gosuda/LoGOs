// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type G interface {
	Hello() string
}

type Req struct : G {
	Qty int64 = 1
}

func (r Req) Hello() string { return "hi" }

func main() {
	check("default-field-initializes-to-one", Req{}.Qty == 1, Req{}.Qty, 1)
	var g G = Req{}
	check("default-struct-satisfies-interface", g.Hello() == "hi", g.Hello(), "hi")
	if failed {
		os.Exit(1)
	}
}
