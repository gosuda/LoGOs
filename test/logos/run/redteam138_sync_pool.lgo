// run -goexperiment logosarena
// run -goexperiment logosarena -arena=false

package main

import (
	"fmt"
	"os"
	"runtime"
	"sync"
)


//go:noinline
func r138Put(p *sync.Pool, n int) {
	s := make([]byte, n)
	for i := range s {
		s[i] = byte(i + 1)
	}
	p.Put(s)
}


//go:noinline
func r138Consume(b []byte) int {
	if len(b) == 0 {
		return 0
	}
	return len(b) + int(b[0])
}

//go:noinline
func r138Clobber(n int) int {
	tmp := make([]byte, n)
	for i := range tmp {
		tmp[i] = 0
	}
	return r138Consume(tmp)
}

var r138Failed bool

func r138Check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		r138Failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func r138Sum(b []byte) int {
	s := 0
	for _, v := range b {
		s += int(v)
	}
	return s
}

func main() {
	runtime.GOMAXPROCS(1)
	var p sync.Pool
	r138Put(&p, 64)
	clob := r138Clobber(64)
	r138Check("syncpool-clobber-sane", clob == 64, fmt.Sprint(clob), "64")
	got, ok := p.Get().([]byte)
	r138Check("syncpool-type-kept", ok, fmt.Sprint(ok), "true")
	if !ok {
		os.Exit(1)
	}
	r138Check("syncpool-len-kept", len(got) == 64, fmt.Sprint(len(got)), "64")
	first := -1
	if len(got) > 0 {
		first = int(got[0])
	}
	sum := r138Sum(got)
	want := 64 * 65 / 2
	r138Check("syncpool-contents-kept", sum == want, fmt.Sprint(sum), fmt.Sprint(want))
	r138Check("syncpool-first-kept", first == 1, fmt.Sprint(first), "1")
	if r138Failed {
		os.Exit(1)
	}
}
