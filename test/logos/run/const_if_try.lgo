// run


package main

import (
	"fmt"
	"os"
	"strconv"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

const (
	on  = true
	off = false
)

func then(s string) (int, error) {
	const if on {
		n := strconv.Atoi(s)?
		return n + 1, nil
	}
	return 0, nil
}

func other(s string) (int, error) {
	const if off {
		return -1, nil
	} else {
		n := strconv.Atoi(s)?
		return n + 2, nil
	}
}

func chain(s string) (int, error) {
	const if off {
		return -1, nil
	} else const if on {
		n := strconv.Atoi(s)?
		return n + 3, nil
	} else {
		return -2, nil
	}
}

func main() {
	gotThen, errThen := then("40")
	if errThen != nil {
		check("then", false, errThen, 41)
	} else {
		check("then", gotThen == 41, gotThen, 41)
	}
	gotOther, errOther := other("40")
	if errOther != nil {
		check("other", false, errOther, 42)
	} else {
		check("other", gotOther == 42, gotOther, 42)
	}
	gotChain, errChain := chain("40")
	if errChain != nil {
		check("chain", false, errChain, 43)
	} else {
		check("chain", gotChain == 43, gotChain, 43)
	}
	_, errBad := chain("x")
	check("chain-err", errBad != nil, errBad != nil, true)
	if failed {
		os.Exit(1)
	}
}
