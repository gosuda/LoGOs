// run

package main

import (
	"fmt"
	"os"
	"unsafe"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type User struct {
	Name string
	Age  int
}

func main() {
	var p *User = &User{}
	var q *User?
	check("ptr-size", unsafe.Sizeof(p) == unsafe.Sizeof(q), unsafe.Sizeof(p) == unsafe.Sizeof(q), true)
	check("opt-size", unsafe.Sizeof(q) == 8, unsafe.Sizeof(q), 8)
	var r *int?
	check("intptr-size", unsafe.Sizeof(r) == unsafe.Sizeof(p), unsafe.Sizeof(r) == unsafe.Sizeof(p), true)
	var s *User? = nil
	check("nil-is-none", s == nil, s == nil, true)
	s = &User{Name: "ann"}
	if s != nil {
		check("deref-name", s.Name == "ann", s.Name, "ann")
	} else {
		check("deref-name", false, "none", "ann")
	}
	if failed {
		os.Exit(1)
	}
}
