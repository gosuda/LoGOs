// run -O=3

package main

import (
	"fmt"
	"os"
)


type r121Creature interface {
	const Name() string
}

type r121Monster struct{ name string }

func (m *r121Monster) Name() string { return m.name }

func r121Names(cs const []r121Creature) string {
	out := ""
	for i, c := range cs {
		if i > 0 {
			out += ","
		}
		out += c.Name()
	}
	return out
}

type r121Ordinary interface {
	Name() string
}

func r121OrdLen(cs const []r121Ordinary) int { return len(cs) }

var r121Failed bool

func r121Check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		r121Failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	ms := []*r121Monster{{name: "ash"}, {name: "birch"}, {name: "cedar"}}
	r121Check("const-slice-join", r121Names(ms) == "ash,birch,cedar", r121Names(ms), "ash,birch,cedar")
	r121Check("const-slice-nil", r121Names(nil) == "", r121Names(nil), "")
	var none []*r121Monster
	r121Check("const-slice-nil-len", len(r121Names(none)) == 0, fmt.Sprint(len(r121Names(none))), "0")
	cs := []r121Creature{&r121Monster{name: "dune"}}
	r121Check("const-slice-single", r121Names(cs) == "dune", r121Names(cs), "dune")
	r121Check("const-slice-ordinary-len", r121OrdLen(ms) == 3, fmt.Sprint(r121OrdLen(ms)), fmt.Sprint(3))
	if r121Failed {
		os.Exit(1)
	}
}
