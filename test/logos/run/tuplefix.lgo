// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func main() {
	a, b, c, d := 1, 2, 3, 4
	x := ((a+b) + (c+d))
	check("nested-paren-add", x == 10, x, 10)
	y := ((a+b) * (c+d))
	check("nested-paren-mul", y == 21, y, 21)
	z := (a+b)*c + d
	check("paren-binds-tighter-than-mul", z == 13, z, 13)
	var inc func(int) int = (a) => a + 1
	plainInc := func(a int) int { return a + 1 }
	check("paren-param-arrow-applies", inc(41) == 42 && inc(41) == plainInc(41), inc(41), 42)
	var add func(int, int) int = (a, b) => a + b
	plainAdd := func(a, b int) int { return a + b }
	check("paren-param-list-arrow-applies", add(20, 22) == 42 && add(20, 22) == plainAdd(20, 22), add(20, 22), 42)
	p, q := (a+b, c+d)
	check("paren-tuple-unpacks", p == 3 && q == 7, fmt.Sprint(p, q), "3 7")
	if failed {
		os.Exit(1)
	}
}
