// run

package main

import (
	"errors"
	"fmt"
)

var errLoad = errors.New("load")

var loads int
var slot int

func load(v int, fail bool) (int, error) {
	loads++
	if fail {
		return 0, errLoad
	}
	return v, nil
}

func classifyN(v int, fail bool) (string, error) {
	r := switch n := load(v, fail)?; n {
	case 7 => "seven"
	default => "other"
	}
	return r, nil
}

func classifyAssign(v int, fail bool) (string, error) {
	r := switch slot = load(v, fail)?; slot {
	case 7 => "seven"
	default => "other"
	}
	return r, nil
}

func probeExprInit(v int, fail bool) (string, error) {
	r := switch load(v, fail)?; v {
	case 7 => "seven"
	default => "other"
	}
	return r, nil
}

func main() {
	loads = 0
	s, err := classifyN(7, false)
	okNil := err == nil && s == "seven" && loads == 1
	fmt.Println("ok switch-expr-init-nil:", okNil)

	s, err = classifyN(9, false)
	okOther := err == nil && s == "other" && loads == 2
	fmt.Println("ok switch-expr-init-other:", okOther)

	s, err = classifyN(7, true)
	okErr := err != nil && err == errLoad && s == "" && loads == 3
	fmt.Println("ok switch-expr-init-err:", okErr)

	slot = -1
	s, err = classifyAssign(9, false)
	okAssign := err == nil && s == "other" && slot == 9
	fmt.Println("ok switch-expr-assign-nil:", okAssign)

	slot = -1
	s, err = classifyAssign(7, true)
	okAssignErr := err != nil && err == errLoad && s == "" && slot == 0
	fmt.Println("ok switch-expr-assign-err:", okAssignErr)

	loads = 0
	s, err = probeExprInit(7, false)
	okExprNil := err == nil && s == "seven" && loads == 1
	fmt.Println("ok switch-expr-expr-nil:", okExprNil)

	s, err = probeExprInit(7, true)
	okExprErr := err != nil && err == errLoad && s == "" && loads == 2
	fmt.Println("ok switch-expr-expr-err:", okExprErr)
}
