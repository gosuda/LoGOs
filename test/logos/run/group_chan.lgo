// run

package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"sync/atomic"
)

var errSib = errors.New("sibling failed")

var defaultRan, defaultLoops atomic.Int32

var bad bool

func check(tag string, cond bool, got, want string) {
	if !cond {
		fmt.Println("FAIL "+tag+": got "+got+" want "+want)
		bad = true
		return
	}
	fmt.Println("ok", tag)
}

func failSibling() error { return errSib }

//logos:allow(complexity::cognitive_overflow)
func runGroup(ctx context.Context, ch1, ch2, ch3 chan int) error {
	go group (ctx) {
		go {
			v := <-ch1
			_ = v
		}
		go {
			v, ok := <-ch1
			_, _ = v, ok
		}
		go {
			v := 0
			v = <-ch1
			_ = v
		}
		go {
			var v = <-ch1
			_ = v
		}
		go {
			var v int = <-ch1
			_ = v
		}
		go {
			var v, ok = <-ch1
			_, _ = v, ok
		}
		go {
			ch2 <- 1
		}
		go {
			for v := range ch3 {
				_ = v
			}
		}
		go {
			select {
			case v := <-ch1:
				_ = v
			}
		}
		go {
			select {
			case v := <-ch1:
				_ = v
			default:
				defaultRan.Add(1)
			}
		}
		go {
			for range 40 {
				select {
				case v := <-ch1:
					_ = v
				default:
					defaultLoops.Add(1)
				}
			}
		}
		go {
			failSibling()?
		}
	}
	return nil
}

func main() {
	ctx := context.Background()
	ch1 := make(chan int)
	ch2 := make(chan int)
	ch3 := make(chan int)
	err := runGroup(ctx, ch1, ch2, ch3)
	check("group-chan-first-error-wins", err == errSib, fmt.Sprint(err), errSib.Error())
	check("group-chan-join-unblocks-receivers", err != nil, fmt.Sprint(err), "non-nil")
	check("group-chan-select-default-unchanged", defaultRan.Load() == 1, fmt.Sprint(defaultRan.Load()), "1")
	check("group-chan-default-loop-completes", defaultLoops.Load() == 40, fmt.Sprint(defaultLoops.Load()), "40")
	if bad {
		os.Exit(1)
	}
}
