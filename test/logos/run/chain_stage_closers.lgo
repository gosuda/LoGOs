// run

package main

import (
	"context"
	"fmt"
	"os"
	"sync/atomic"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

var closes [6]atomic.Int64

type handle struct{ id int }

func (h *handle) Close() error {
	closes[h.id].Add(1)
	return nil
}

func open(id int) *handle { return &handle{id: id} }

func counts() []int64 {
	out := make([]int64, len(closes))
	for i := range closes {
		out[i] = closes[i].Load()
	}
	return out
}

func caseFilterDropClosesOnceDeliveredStayOpen(ctx context.Context) {
	got, err := []int{0, 1, 2, 3, 4, 5}.group(ctx, limit = 3).map(id => open(id)).filter(h => h.id%2 == 0)
	want := []int64{0, 1, 0, 1, 0, 1}
	if err != nil {
		check("closers-delivered-stay-open", false, err, 3)
	} else {
		check("closers-delivered-stay-open", err == nil && len(got) == 3, len(got), 3)
	}
	check("closers-filter-drop-closed-once", fmt.Sprint(counts()) == fmt.Sprint(want), counts(), want)
}

func main() {
	caseFilterDropClosesOnceDeliveredStayOpen(context.Background())
	if failed {
		os.Exit(1)
	}
}
