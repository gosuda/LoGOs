// run

package main

import (
	"bytes"
	"fmt"
	"io"
	"os"
	"strconv"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func EncodeSlice[T any](buf []byte, items []T) ([]byte, error) {
	const switch T {
	case int64:
		for _, v := range items {
			buf = strconv.AppendInt(buf, v, 10)
		}
		return buf, nil
	case io.WriterTo:
		var b bytes.Buffer
		for _, v := range items {
			v.WriteTo(&b)?
		}
		return append(buf, b.Bytes()...), nil
	}
	return buf, nil
}

type Word struct {
	S string
}

func (w Word) WriteTo(dst io.Writer) (int64, error) {
	n, err := dst.Write([]byte(w.S))
	return int64(n), err
}

type UserID int

func describe[T any](v T) string {
	const switch T {
	case int:
		return "exact-int"
	case ~int:
		return "tilde-int"
	}
	return "other"
}

func classify[T any](v T) string {
	_ = v
	const switch T {
	case int:
		return "exact"
	case ~int:
		return "tilde"
	case io.Writer:
		return "writer"
	}
	return "other"
}

func main() {
	b, err := EncodeSlice([]byte("nums:"), []int64{1, 2, 3})
	if err != nil {
		check("encode-int", false, err, nil)
	} else {
		check("encode-int", string(b) == "nums:123", string(b), "nums:123")
	}
	b, err = EncodeSlice([]byte("words:"), []Word{{"a"}, {"b"}})
	if err != nil {
		check("encode-iface", false, err, nil)
	} else {
		check("encode-iface", string(b) == "words:ab", string(b), "words:ab")
	}
	check("describe-int", describe(3) == "exact-int", describe(3), "exact-int")
	check("describe-named", describe(UserID(3)) == "tilde-int", describe(UserID(3)), "tilde-int")
	check("describe-other", describe("s") == "other", describe("s"), "other")
	check("classify-int", classify(1) == "exact", classify(1), "exact")
	check("classify-named", classify(UserID(1)) == "tilde", classify(UserID(1)), "tilde")
	check("classify-writer", classify(&bytes.Buffer{}) == "writer", classify(&bytes.Buffer{}), "writer")
	check("classify-other", classify("s") == "other", classify("s"), "other")
	if failed {
		os.Exit(1)
	}
}
