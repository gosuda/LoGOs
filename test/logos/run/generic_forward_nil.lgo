package main

type box[T any] struct {
	v    T
	done bool
}

func newBox[T any]() *box[T] {
	return new(box[T])
}

func (b *box[T]) get() T {
	return b.v
}

func (b *box[T]) set(v T) {
	b.v = v
	b.done = true
}

func main() {
	b := newBox[*int]()
	// A nil type-parameter result must reach the T parameter without
	// a MustNonNil panic: substituted parameters are generic
	// positions and take platform arguments.
	b.set(b.get())
	if !b.done || b.v != nil {
		println("forwarded nil did not reach the T slot")
	}
	println("ok")
}
