// run

package main

import (
	"fmt"
	"os"
	"reflect"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Point struct {
	X, Y int
}

const primes = []int{2, 3, 5, 7}

const origin = Point{X: 1, Y: 2}

func main() {
	check("primes-equal", reflect.DeepEqual(primes, []int{2, 3, 5, 7}), reflect.DeepEqual(primes, []int{2, 3, 5, 7}), true)
	check("origin-equal", reflect.DeepEqual(origin, Point{X: 1, Y: 2}), reflect.DeepEqual(origin, Point{X: 1, Y: 2}), true)
	check("print", fmt.Sprint(primes) == "[2 3 5 7]" && fmt.Sprint(origin) == "{1 2}", fmt.Sprint(primes, origin), "[2 3 5 7] {1 2}")
	if failed {
		os.Exit(1)
	}
}
