// run

package main

import (
	"comptime"
	"fmt"
	"net/http"
	"os"
	"reflect"
	"testing"
)

type FoldRecord struct {
	Name  string  `json:"nm" xml:"n1" GET:"g1" custom:"a\"b\\c"`
	Age   int64   `json:"age,omitempty" xml:"a2" GET:"g2"`
	Skip  bool    `json:"-"`
	Plain float64
}

const FoldKey = "xml"

func foldLit() []string {
	var out []string
	const for _, f := range comptime.Fields[FoldRecord]() {
		out = append(out, f.Tag.Get("json"))
	}
	return out
}

func foldPkg() []string {
	var out []string
	const for _, f := range comptime.Fields[FoldRecord]() {
		out = append(out, f.Tag.Get(FoldKey))
	}
	return out
}

func foldLocal() []string {
	const k = "custom"
	var out []string
	const for _, f := range comptime.Fields[FoldRecord]() {
		out = append(out, f.Tag.Get(k))
	}
	return out
}

func foldConcat() []string {
	var out []string
	const for _, f := range comptime.Fields[FoldRecord]() {
		out = append(out, f.Tag.Get("x"+"ml"))
	}
	return out
}

func foldImported() []string {
	var out []string
	const for _, f := range comptime.Fields[FoldRecord]() {
		out = append(out, f.Tag.Get(http.MethodGet))
	}
	return out
}

func foldMissing() []string {
	const k = "no" + "pe"
	var out []string
	const for _, f := range comptime.Fields[FoldRecord]() {
		out = append(out, f.Tag.Get(k))
	}
	return out
}

func foldRuntime(key string) []string {
	var out []string
	const for _, f := range comptime.Fields[FoldRecord]() {
		out = append(out, f.Tag.Get(key))
	}
	return out
}

func foldFieldKey() []string {
	var out []string
	const for _, f := range comptime.Fields[FoldRecord]() {
		out = append(out, f.Tag.Get(f.Name))
	}
	return out
}

func wantFieldKey() []string {
	var out []string
	rt := reflect.TypeOf(FoldRecord{})
	for i := 0; i < rt.NumField(); i++ {
		sf := rt.Field(i)
		out = append(out, reflect.StructTag(sf.Tag).Get(sf.Name))
	}
	return out
}

func want(key string) []string {
	var out []string
	rt := reflect.TypeOf(FoldRecord{})
	for i := 0; i < rt.NumField(); i++ {
		out = append(out, reflect.StructTag(rt.Field(i).Tag).Get(key))
	}
	return out
}

var failed bool

func check(name, key string, got []string) {
	w := want(key)
	if fmt.Sprint(got) != fmt.Sprint(w) {
		fmt.Println("FAIL", name, got, w)
		failed = true
		return
	}
	fmt.Println("ok", name)
}

type AllocRecord struct {
	A int `custom:"a\"b\\c" GET:"g\"1" xml:"x\"1"`
}

var sink string

func allocLit() {
	const for _, f := range comptime.Fields[AllocRecord]() {
		sink = f.Tag.Get("custom")
	}
}

func allocPkg() {
	const for _, f := range comptime.Fields[AllocRecord]() {
		sink = f.Tag.Get(FoldKey)
	}
}

func allocLocal() {
	const k = "custom"
	const for _, f := range comptime.Fields[AllocRecord]() {
		sink = f.Tag.Get(k)
	}
}

func allocConcat() {
	const for _, f := range comptime.Fields[AllocRecord]() {
		sink = f.Tag.Get("cus" + "tom")
	}
}

func allocImported() {
	const for _, f := range comptime.Fields[AllocRecord]() {
		sink = f.Tag.Get(http.MethodGet)
	}
}

var runtimeKey = "custom"

func allocRuntime() {
	const for _, f := range comptime.Fields[AllocRecord]() {
		sink = f.Tag.Get(runtimeKey)
	}
}

func fewestAllocs(f func()) float64 {
	best := testing.AllocsPerRun(100, f)
	for range 4 {
		if n := testing.AllocsPerRun(100, f); n < best {
			best = n
		}
	}
	return best
}

func checkAllocs(name string, f func(), folded bool) {
	n := fewestAllocs(f)
	if folded && n != 0 || !folded && n < 1 {
		fmt.Println("FAIL", name, "allocs", n)
		failed = true
		return
	}
	fmt.Println("ok", name)
}

func main() {
	checkAllocs("alloc-literal-folded", allocLit, true)
	checkAllocs("alloc-package-folded", allocPkg, true)
	checkAllocs("alloc-local-folded", allocLocal, true)
	checkAllocs("alloc-concat-folded", allocConcat, true)
	checkAllocs("alloc-imported-folded", allocImported, true)
	checkAllocs("alloc-runtime-ordinary-call", allocRuntime, false)
	check("literal", "json", foldLit())
	check("package", FoldKey, foldPkg())
	check("local", "custom", foldLocal())
	check("concat", "x"+"ml", foldConcat())
	check("imported", http.MethodGet, foldImported())
	check("missing", "nope", foldMissing())
	key := os.Getenv("TAG_GET_FOLD_KEY")
	if key == "" {
		key = "json"
	}
	check("runtime", key, foldRuntime(key))
	if fmt.Sprint(foldFieldKey()) != fmt.Sprint(wantFieldKey()) {
		fmt.Println("FAIL fieldkey", foldFieldKey(), wantFieldKey())
		os.Exit(1)
	}
	fmt.Println("ok fieldkey")
	if failed {
		os.Exit(1)
	}
}
