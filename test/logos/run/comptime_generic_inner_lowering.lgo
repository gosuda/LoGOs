// run
package main

import (
	"comptime"
	"errors"
	"fmt"
	"os"
	"strconv"
)

type Pair struct {
	X int
	Y int
}

type Triple struct {
	A int
	B int
	C int
}

var failed bool

func check(name, got, want string) {
	if got != want {
		fmt.Println("FAIL", name, "got", got, "want", want)
		failed = true
		return
	}
	fmt.Println("ok", name)
}

var calls int

var lines []string

func step(in string) (int, error) {
	calls++
	if calls == 4 {
		return 0, errors.New("stopped at step 4")
	}
	return strconv.Atoi(in)
}

func Total[T any](in string) (int, error) {
	sum := 0
	const for _, f := range comptime.Fields[T]() {
		n := step(in)?
		sum += n
		lines = append(lines, $"{f.Name}={sum}")
	}
	return sum, nil
}

func Weights[T any]() int {
	s := 0
	const for _, f := range comptime.Fields[T]() {
		s += []int{1, 2, 3}.map(x => x + f.Index).sum()
	}
	return s
}

func Grid[T any](in string) (int, error) {
	sum := 0
	const for _, f := range comptime.Fields[T]() {
		const for _, g := range comptime.Fields[T]() {
			n := step(in)?
			sum += n
			lines = append(lines, $"{f.Name}.{g.Name}={sum}")
		}
	}
	return sum, nil
}

func main() {
	calls = 0
	lines = nil
	sum, err := Total[Pair]("4")
	check("pair-sum-and-no-error", fmt.Sprint(sum, err), "8 <nil>")
	check("pair-copies-in-order", fmt.Sprint(lines), "[X=4 Y=8]")
	lines = nil
	sum, err = Total[Triple]("4")
	check("triple-error-aborts", fmt.Sprint(sum, err), "0 stopped at step 4")
	check("triple-partial-in-order", fmt.Sprint(lines), "[A=4]")
	check("index-weighted-map-sum", fmt.Sprint(Weights[Triple]()), "27")
	lines = nil
	sum, err = Grid[Pair]("1")
	check("nested-grid-sum", fmt.Sprint(sum, err), "4 <nil>")
	check("nested-grid-in-order", fmt.Sprint(lines), "[X.X=1 X.Y=2 Y.X=3 Y.Y=4]")
	if failed {
		os.Exit(1)
	}
}
