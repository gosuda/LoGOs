// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func pair() (int, error) { return 3, nil }

func main() {
	t := (pair())
	a, b := t
	pa, pb := pair()
	check("paren-around-call-keeps-tuple", a == 3 && b == nil && a == pa && b == pb, fmt.Sprint(a, b), "3 <nil>")
	u := ((pair()))
	c, d := u
	check("double-paren-around-call-keeps-tuple", c == 3 && d == nil && c == pa && d == pb, fmt.Sprint(c, d), "3 <nil>")
	var w (int, error)
	w = (pair())
	e, f := w
	check("paren-assign-keeps-tuple", e == 3 && f == nil, fmt.Sprint(e, f), "3 <nil>")
	w = ((pair()))
	g, h := w
	check("double-paren-assign-keeps-tuple", g == 3 && h == nil, fmt.Sprint(g, h), "3 <nil>")
	if failed {
		os.Exit(1)
	}
}
