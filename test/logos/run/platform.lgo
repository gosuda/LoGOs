// run

package main

import (
	"flag"
	"fmt"
	"os"
	"path/filepath"
	"runtime"
	"slices"
	"strconv"
	"strings"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}


type User struct {
	Name string
}

func First[T any](s []T) T {
	return s[0]
}

func Id[T any](v T) T {
	return v
}

func useFlag(f *flag.Flag) string {
	return f.Name
}

func tryDeclaredStore() (msg string) {
	defer func() {
		if r := recover(); r != nil {
			msg = fmt.Sprint(r)
		}
	}()
	var fl *flag.Flag = flag.Lookup("missing")
	return "no-panic:" + fl.Name
}

func tryCallStore() (msg string) {
	defer func() {
		if r := recover(); r != nil {
			msg = fmt.Sprint(r)
		}
	}()
	return useFlag(flag.Lookup("missing"))
}

func tryGenericStore() (msg string) {
	defer func() {
		if r := recover(); r != nil {
			msg = fmt.Sprint(r)
		}
	}()
	var qf *flag.Flag = Id(flag.Lookup("missing"))
	_ = qf
	return "no-panic"
}

func storeLine(file string) int {
	b, err := os.ReadFile(file)
	if err != nil {
		return -1
	}
	needle := "site" + "StoreTarget"
	for i, ln := range strings.Split(string(b), "\n") {
		if strings.Contains(ln, needle) {
			return i + 1
		}
	}
	return -1
}

func trySiteStore() (msg string) {
	defer func() {
		if r := recover(); r != nil {
			msg = fmt.Sprint(r)
		}
	}()
	var siteStoreTarget *flag.Flag = flag.Lookup("missing")
	return "no-panic:" + siteStoreTarget.Name
}

//logos:allow(correctness::unclosed_io_closer)
//logos:allow(slop::discarded_error)
func main() {
	flag.String("have", "HAVE", "")
	flag.Parse()

	f, err := os.Open(os.Args[0])
	if err != nil {
		check("file-open", false, fmt.Sprint(err), "open")
		os.Exit(1)
	}
	check("file-open", f != nil, f != nil, true)
	check("file-name", f.Name() == os.Args[0], f.Name(), os.Args[0])
	_ = f.Close()

	check("global", flag.CommandLine != nil, flag.CommandLine != nil, true)

	good := flag.Lookup("have")
	var fl *flag.Flag = good
	check("declared-store", fl.Name == "have", fl.Name, "have")

	inferred := flag.Lookup("missing")
	check("nil-branch", inferred == nil, inferred == nil, true)

	list := []*flag.Flag{good}
	lm := map[string]*flag.Flag{"have": good}
	check("opt-to-go", slices.Contains[[]*flag.Flag, *flag.Flag](list, lm["have"]), slices.Contains[[]*flag.Flag, *flag.Flag](list, lm["have"]), true)
	check("opt-nil", lm["missing"] == nil, lm["missing"] == nil, true)

	cloned := slices.Clone(list)
	check("elem", cloned[0].Name == "have" && cloned[0] != nil, fmt.Sprint(cloned[0].Name, cloned[0] == nil), "havefalse")

	alice := &User{Name: "alice"}
	got := First([]*User{alice})
	check("generic", got.Name == "alice" && got != nil, fmt.Sprint(got.Name, got == nil), "alicefalse")
	var q *User = got
	check("generic-store", q.Name == "alice", q.Name, "alice")

	check("panic-declared", strings.Contains(tryDeclaredStore(), "nil from Go value stored into non-nil *flag.Flag"), tryDeclaredStore(), "nil from Go value stored into non-nil *flag.Flag")
	check("panic-call", strings.Contains(tryCallStore(), "nil from Go value stored into non-nil *flag.Flag"), tryCallStore(), "nil from Go value stored into non-nil *flag.Flag")
	check("panic-generic", strings.Contains(tryGenericStore(), "nil from Go value stored into non-nil *flag.Flag"), tryGenericStore(), "nil from Go value stored into non-nil *flag.Flag")
	_, siteFile, _, _ := runtime.Caller(0)
	siteMsg := trySiteStore()
	wantSite := "logos: nil from Go value stored into non-nil *flag.Flag at " + filepath.Base(siteFile) + ":" + strconv.Itoa(storeLine(siteFile))
	check("panic-lgo-site", siteMsg == wantSite, siteMsg, wantSite)
	if failed {
		os.Exit(1)
	}
}
