// run

package main

import (
	"flag"
	"fmt"
	"os"
	"logos/rt"
	"slices"
	"reflect"
	"strings"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}


type User struct {
	Name string
}

func First[T any](s []T) T {
	return s[0]
}

func Id[T any](v T) T {
	return v
}

func useFlag(f *flag.Flag) string {
	return f.Name
}

func tryDeclaredStore() (value any) {
	defer func() {
		if r := recover(); r != nil {
			value = r
		}
	}()
	var fl *flag.Flag = flag.Lookup("missing")
	return "no-panic:" + fl.Name
}

func tryCallStore() (value any) {
	defer func() {
		if r := recover(); r != nil {
			value = r
		}
	}()
	return useFlag(flag.Lookup("missing"))
}

func tryGenericStore() (value any) {
	defer func() {
		if r := recover(); r != nil {
			value = r
		}
	}()
	var qf *flag.Flag = Id(flag.Lookup("missing"))
	_ = qf
	return "no-panic"
}

func nilStoreOracle() (value any) {
	defer func() { value = recover() }()
	rt.MustNonNil(flag.Lookup("missing"), &rt.Site{})
	return
}

func checkNilStore(name string, value, oracle any) {
	got, ok := value.(string)
	want, wok := oracle.(string)
	gi := strings.LastIndex(got, " ")
	wi := strings.LastIndex(want, " ")
	check(name, ok && wok && reflect.TypeOf(value) == reflect.TypeOf(oracle) && gi >= 0 && wi >= 0 && got[:gi] == want[:wi], value, oracle)
}

func trySiteStore() (value any) {
	defer func() {
		if r := recover(); r != nil {
			value = r
		}
	}()
	var siteStoreTarget *flag.Flag = flag.Lookup("missing")
	return "no-panic:" + siteStoreTarget.Name
}

//logos:allow(correctness::unclosed_io_closer)
//logos:allow(slop::discarded_error)
func main() {
	flag.String("have", "HAVE", "")
	flag.Parse()

	f, err := os.Open(os.Args[0])
	if err != nil {
		check("file-open", false, fmt.Sprint(err), "open")
		os.Exit(1)
	}
	check("file-open", f != nil, f != nil, true)
	check("file-name", f.Name() == os.Args[0], f.Name(), os.Args[0])
	_ = f.Close()

	check("global", flag.CommandLine != nil, flag.CommandLine != nil, true)

	good := flag.Lookup("have")
	var fl *flag.Flag = good
	check("declared-store", fl.Name == "have", fl.Name, "have")
	deref := *good
	check("explicit-deref", deref.Name == "have" && deref.DefValue == "HAVE", fmt.Sprint(deref.Name, deref.DefValue), "haveHAVE")

	inferred := flag.Lookup("missing")
	check("nil-branch", inferred == nil, inferred == nil, true)

	list := []*flag.Flag{good}
	lm := map[string]*flag.Flag{"have": good}
	check("opt-to-go", slices.Contains[[]*flag.Flag, *flag.Flag](list, lm["have"]), slices.Contains[[]*flag.Flag, *flag.Flag](list, lm["have"]), true)
	check("opt-nil", lm["missing"] == nil, lm["missing"] == nil, true)

	cloned := slices.Clone(list)
	check("elem", cloned[0].Name == "have" && cloned[0] != nil, fmt.Sprint(cloned[0].Name, cloned[0] == nil), "havefalse")

	alice := &User{Name: "alice"}
	got := First([]*User{alice})
	check("generic", got.Name == "alice" && got != nil, fmt.Sprint(got.Name, got == nil), "alicefalse")
	var q *User = got
	check("generic-store", q.Name == "alice", q.Name, "alice")

	oracle := nilStoreOracle()
	checkNilStore("panic-declared", tryDeclaredStore(), oracle)
	checkNilStore("panic-call", tryCallStore(), oracle)
	checkNilStore("panic-generic", tryGenericStore(), oracle)
	checkNilStore("panic-lgo-site", trySiteStore(), oracle)
	if failed {
		os.Exit(1)
	}
}
