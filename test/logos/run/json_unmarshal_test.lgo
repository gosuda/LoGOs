// run

package jsonunmarshal

import (
	"bytes"
	"encoding/json"
	"errors"
	"fmt"
	"math"
	"math/rand"
	"reflect"
	"runtime"
	"strings"
	"testing"

	"logos/rt"
)

type Profile struct {
	Bio string `json:"bio"`
}

type User struct {
	ID      int64    `json:"id"`
	Name    string   `json:"name"`
	Profile *Profile `json:"profile"`
}

type Cfg struct {
	Port int32  = 8080 `json:"port"`
	TLS  bool   = true `json:"tls"`
	Host string = "localhost" `json:"host"`
	Note string `json:"note"`
}

type Items struct {
	Items []int64 `json:"items"`
}

type Untagged struct {
	Inner *Profile
	Other int64
}

