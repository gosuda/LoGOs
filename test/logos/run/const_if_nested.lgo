// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func inRange(xs []int) string {
	out := ""
	for _, x := range xs {
		const if 1 == 1 {
			out += fmt.Sprint("live", x, ";")
		} else {
			out += "dead;"
		}
	}
	return out
}

func inSwitch(n int) string {
	switch n {
	case 1:
		const if 1 == 2 {
			return "dead"
		}
		return "one"
	default:
		const if 2 == 2 {
			return "default"
		}
	}
	return "end"
}

func inTypeSwitch(v any) string {
	switch v.(type) {
	case int:
		const if 1 == 1 {
			return "int"
		} else {
			return "dead"
		}
	}
	return "other"
}

func inSelect() string {
	c := make(chan int, 1)
	c <- 1
	select {
	case <-c:
		const if 1 == 2 {
			return "dead"
		} else {
			return "recv"
		}
	}
}

func inClosure() string {
	f := func() string {
		const if 1 == 2 {
			return "dead"
		} else const if 1 == 2 {
			return "dead"
		} else {
			return "closure"
		}
	}
	return f()
}

func inLabel() string {
	n := 0
loop:
	for {
		n++
		const if 1 == 1 {
			if n == 3 {
				break loop
			}
		}
	}
	return fmt.Sprint("n=", n)
}

func nestedLive() string {
	const if 1 == 1 {
		const if 1 == 2 {
			return "dead"
		} else {
			return "nested"
		}
	}
	return "dead"
}

func onlyStatement() string {
	const if 1 == 2 {
		return "dead"
	}
	return "kept"
}

func main() {
	check("range", inRange([]int{1, 2}) == "live1;live2;", inRange([]int{1, 2}), "live1;live2;")
	check("switch-one", inSwitch(1) == "one", inSwitch(1), "one")
	check("switch-default", inSwitch(2) == "default", inSwitch(2), "default")
	check("typeswitch-int", inTypeSwitch(3) == "int", inTypeSwitch(3), "int")
	check("typeswitch-other", inTypeSwitch("s") == "other", inTypeSwitch("s"), "other")
	check("select", inSelect() == "recv", inSelect(), "recv")
	check("closure", inClosure() == "closure", inClosure(), "closure")
	check("label", inLabel() == "n=3", inLabel(), "n=3")
	check("nested", nestedLive() == "nested", nestedLive(), "nested")
	check("kept", onlyStatement() == "kept", onlyStatement(), "kept")
	if failed {
		os.Exit(1)
	}
}
