// run


package main

import (
	"comptime"
	"context"
	"fmt"
	"os"
	"sync/atomic"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Counts struct {
	A int
	B int
	C int
}

var total atomic.Int64

func fill(ctx context.Context, c Counts) error {
	go group (ctx) {
		go {
			const for _, f := range comptime.Fields[Counts]() {
				total.Add(int64(c.[f]))
			}
		}
		go {
			const for i, f := range comptime.Fields[Counts]() {
				total.Add(int64(c.[f]) * int64(100*(i+1)))
			}
		}
	}
	return nil
}

func main() {
	if err := fill(context.Background(), Counts{A: 1, B: 2, C: 3}); err != nil {
		check("fill", false, err, nil)
		os.Exit(1)
	}
	got := total.Load()
	check("total", got == 1406, got, 1406)
	if failed {
		os.Exit(1)
	}
}
