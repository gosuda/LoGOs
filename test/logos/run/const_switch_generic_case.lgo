// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type List[T any] struct {
	head T
}

func describe[T any]() string {
	const switch T {
	case List[int]:
		return "list-int"
	}
	return "other"
}

func main() {
	check("list-int", describe[List[int]]() == "list-int", describe[List[int]](), "list-int")
	check("other", describe[string]() == "other", describe[string](), "other")
	if failed {
		os.Exit(1)
	}
}
