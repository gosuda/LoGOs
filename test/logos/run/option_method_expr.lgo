// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Box struct{ V int }

func (b Box) Add(o int?, d int) int { return b.V + (o ?? d) }

func main() {
	var o int?
	gotN := Box.Add(Box{V: 10}, o, 5)
	check("none-default", gotN == 15, gotN, 15)
	o = 3
	gotS := Box.Add(Box{V: 10}, o, 5)
	check("some-value", gotS == 13, gotS, 13)
	if failed {
		os.Exit(1)
	}
}
