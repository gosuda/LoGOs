// run

package main

import "fmt"

var n = 1

func makeMapper() func(int) int {
	n = 0
	return func(x int) int { return x }
}

var m = 1

func makeDropMapper() func(int) int {
	m = 0
	return func(x int) int { return x }
}

var (
	orderLog  []string
	dropCalls int
	mapCalls  int
	takeCalls int
)

func logDrop(v int) int {
	orderLog = append(orderLog, "drop")
	dropCalls++
	return v
}

func logMap() func(int) int {
	orderLog = append(orderLog, "map")
	mapCalls++
	return func(x int) int { return x }
}

func logTake(v int) int {
	orderLog = append(orderLog, "take")
	takeCalls++
	return v
}

func main() {
	xs := []int{10, 20, 30}

	fmt.Println(xs.take(1).map(x => x))
	fmt.Println(xs.drop(1).map(x => x))
	fmt.Println(xs.drop(1).map(x => x).take(1))

	n = 1
	fmt.Println(xs.take(n).map(makeMapper()))
	fmt.Println(n)

	m = 1
	fmt.Println(xs.drop(m).map(makeDropMapper()))
	fmt.Println(m)

	orderLog = nil
	takeCalls = 0
	mapCalls = 0
	fmt.Println(xs.take(logTake(1)).map(logMap()))
	fmt.Println(orderLog)
	fmt.Println(takeCalls, mapCalls)

	orderLog = nil
	dropCalls = 0
	mapCalls = 0
	takeCalls = 0
	fmt.Println(xs.drop(logDrop(1)).map(logMap()).take(logTake(1)))
	fmt.Println(orderLog)
	fmt.Println(dropCalls, mapCalls, takeCalls)
}
