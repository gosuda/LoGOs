// run

package main

import (
	"fmt"
	"os"
)

var n = 1

func makeMapper() func(int) int {
	n = 0
	return func(x int) int { return x }
}

var m = 1

func makeDropMapper() func(int) int {
	m = 0
	return func(x int) int { return x }
}

var (
	orderLog  []string
	dropCalls int
	mapCalls  int
	takeCalls int
)

func logDrop(v int) int {
	orderLog = append(orderLog, "drop")
	dropCalls++
	return v
}

func logMap() func(int) int {
	orderLog = append(orderLog, "map")
	mapCalls++
	return func(x int) int { return x }
}

func logTake(v int) int {
	orderLog = append(orderLog, "take")
	takeCalls++
	return v
}

var orderFailed bool

func orderCheck(name string, got any, want string) {
	if g := fmt.Sprint(got); g != want {
		fmt.Printf("FAIL %s: got %s want %s\n", name, g, want)
		orderFailed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	xs := []int{10, 20, 30}

	orderCheck("take-map", xs.take(1).map(x => x), "[10]")
	orderCheck("drop-map", xs.drop(1).map(x => x), "[20 30]")
	orderCheck("drop-map-take", xs.drop(1).map(x => x).take(1), "[20]")

	n = 1
	orderCheck("take-count-read-before-mapper", xs.take(n).map(makeMapper()), "[10]")
	orderCheck("take-mapper-ran", n, "0")

	m = 1
	orderCheck("drop-count-read-before-mapper", xs.drop(m).map(makeDropMapper()), "[20 30]")
	orderCheck("drop-mapper-ran", m, "0")

	orderLog = nil
	takeCalls = 0
	mapCalls = 0
	orderCheck("take-map-result", xs.take(logTake(1)).map(logMap()), "[10]")
	orderCheck("take-map-order", orderLog, "[take map]")
	orderCheck("take-map-calls", []int{takeCalls, mapCalls}, "[1 1]")

	orderLog = nil
	dropCalls = 0
	mapCalls = 0
	takeCalls = 0
	orderCheck("drop-map-take-result", xs.drop(logDrop(1)).map(logMap()).take(logTake(1)), "[20]")
	orderCheck("drop-map-take-order", orderLog, "[drop map take]")
	orderCheck("drop-map-take-calls", []int{dropCalls, mapCalls, takeCalls}, "[1 1 1]")
	if orderFailed {
		os.Exit(1)
	}
}
