// run -goexperiment logosarena
package main

import (
	"fmt"
	"logos/arena"
	"os"
	"runtime"
	"sync/atomic"
)

type holder struct {
	p *int
}

var ran int32

//go:noinline
func warmup() {
	cell := new(int)
	runtime.AddCleanup(cell, func(struct{}) { atomic.StoreInt32(&ran, 1) }, struct{}{})
	_ = cell
}

//go:noinline
func allocRegion() {
	r := arena.Open()
	h := arena.New[holder](r)
	cell := new(int)
	*cell = 7
	h.p = cell
	runtime.AddCleanup(cell, func(struct{}) { atomic.StoreInt32(&ran, 1) }, struct{}{})
	runtime.GC()
	runtime.GC()
	if atomic.LoadInt32(&ran) != 0 {
		fmt.Printf("FAIL cleanup-held-alive-inside-region-block: got %d want 0\n", atomic.LoadInt32(&ran))
		os.Exit(1)
	}
	fmt.Println("ok cleanup-held-alive-inside-region-block")
}

func main() {
	warmup()
	for range 200 {
		runtime.GC()
		runtime.Gosched()
		if atomic.LoadInt32(&ran) == 1 {
			break
		}
	}
	atomic.StoreInt32(&ran, 0)
	allocRegion()
	for range 200 {
		runtime.GC()
		runtime.Gosched()
		if atomic.LoadInt32(&ran) == 1 {
			break
		}
	}
	if atomic.LoadInt32(&ran) != 1 {
		fmt.Printf("FAIL cleanup-runs-after-region-exit: got %d want 1\n", atomic.LoadInt32(&ran))
		os.Exit(1)
	}
	fmt.Println("ok cleanup-runs-after-region-exit")
}
