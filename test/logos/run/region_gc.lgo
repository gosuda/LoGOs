// run -goexperiment logosarena
package main

import (
	"fmt"
	"logos/arena"
	"os"
	"runtime"
	"sync/atomic"
)

type holder struct {
	p *int
}

var ran int32
var failed bool

//go:noinline
func warmup() {
	cell := new(int)
	runtime.AddCleanup(cell, func(struct{}) { atomic.StoreInt32(&ran, 1) }, struct{}{})
	_ = cell
}

//go:noinline
func allocRegion() {
	r := arena.Open()
	h := arena.New[holder](r)
	cell := new(int)
	*cell = 7
	h.p = cell
	runtime.AddCleanup(cell, func(struct{}) { atomic.StoreInt32(&ran, 1) }, struct{}{})
	runtime.GC()
	runtime.GC()
	if atomic.LoadInt32(&ran) != 0 {
		fmt.Printf("FAIL cleanup-held-alive-inside-region-block: got %d want 0\n", atomic.LoadInt32(&ran))
		os.Exit(1)
	}
	fmt.Println("ok cleanup-held-alive-inside-region-block")
}

//go:noinline
func allocMake() {
	r := arena.Open()
	n := 8 + len(os.Args)
	s := arena.Make[*int](r, n)
	cell := new(int)
	*cell = 7
	s[2] = cell
	runtime.AddCleanup(cell, func(struct{}) { atomic.StoreInt32(&ran, 1) }, struct{}{})
	for range 20 {
		runtime.GC()
		runtime.Gosched()
	}
	if atomic.LoadInt32(&ran) != 0 {
		fmt.Printf("FAIL cleanup-held-alive-by-make-in-region: got %d want 0\n", atomic.LoadInt32(&ran))
		failed = true
		return
	}
	fmt.Println("ok cleanup-held-alive-by-make-in-region")
}

//go:noinline
func allocAppend() {
	r := arena.Open()
	cell := new(int)
	*cell = 7
	s := arena.Append[*int](r, nil, cell)
	runtime.AddCleanup(cell, func(struct{}) { atomic.StoreInt32(&ran, 1) }, struct{}{})
	for range 20 {
		runtime.GC()
		runtime.Gosched()
	}
	if atomic.LoadInt32(&ran) != 0 || len(s) != 1 {
		fmt.Printf("FAIL cleanup-held-alive-by-append-in-region: got %d want 0\n", atomic.LoadInt32(&ran))
		failed = true
		return
	}
	fmt.Println("ok cleanup-held-alive-by-append-in-region")
}

func collected() bool {
	for range 200 {
		runtime.GC()
		runtime.Gosched()
		if atomic.LoadInt32(&ran) == 1 {
			return true
		}
	}
	return false
}

func main() {
	warmup()
	for range 200 {
		runtime.GC()
		runtime.Gosched()
		if atomic.LoadInt32(&ran) == 1 {
			break
		}
	}
	atomic.StoreInt32(&ran, 0)
	allocRegion()
	for range 200 {
		runtime.GC()
		runtime.Gosched()
		if atomic.LoadInt32(&ran) == 1 {
			break
		}
	}
	if atomic.LoadInt32(&ran) != 1 {
		fmt.Printf("FAIL cleanup-runs-after-region-exit: got %d want 1\n", atomic.LoadInt32(&ran))
		os.Exit(1)
	}
	fmt.Println("ok cleanup-runs-after-region-exit")
	for _, c := range []struct {
		name  string
		alloc func()
	}{{"make", allocMake}, {"append", allocAppend}} {
		atomic.StoreInt32(&ran, 0)
		c.alloc()
		if !collected() {
			fmt.Printf("FAIL cleanup-runs-after-%s-region-exit: got %d want 1\n", c.name, atomic.LoadInt32(&ran))
			failed = true
			continue
		}
		fmt.Printf("ok cleanup-runs-after-%s-region-exit\n", c.name)
	}
	if failed {
		os.Exit(1)
	}
}
