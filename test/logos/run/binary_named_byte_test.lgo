package main

import (
	"bytes"
	"fmt"
	"os"
	"slices"
)

type MyByte uint8

type Raw []byte

type Name string

type Named struct {
	Bytes []MyByte  `json:"bytes"`
	Raw   Raw       `json:"raw"`
	Fixed [4]MyByte `json:"fixed"`
	Label Name      `json:"label"`
}

type PlainBytes struct {
	D []byte `json:"d"`
}

type NamedBytes struct {
	D []MyByte `json:"d"`
}

var failed bool

func report(name string, ok bool, format string, args ...any) {
	if ok {
		fmt.Println("ok", name)
		return
	}
	failed = true
	fmt.Println("FAIL", name+":", fmt.Sprintf(format, args...))
}

func mustBytes(b []byte, err error) []byte {
	if err != nil {
		fmt.Println("FAIL", err)
		os.Exit(1)
	}
	return b
}

func mustNil(err error) {
	if err != nil {
		fmt.Println("FAIL", err)
		os.Exit(1)
	}
}

func same(a, b Named) bool {
	return slices.Equal(a.Bytes, b.Bytes) && bytes.Equal(a.Raw, b.Raw) && a.Fixed == b.Fixed && a.Label == b.Label
}

func wantWire() []byte {
	want := []byte{1, 3, 1, 2, 3, 2, 9, 8, 4}
	for _, e := range []byte{5, 6, 7, 8} {
		want = append(want, e, 0, 0, 0, 0, 0, 0, 0)
	}
	return append(want, 2, 'h', 'i')
}

func checkWire() Named {
	v := Named{Bytes: []MyByte{1, 2, 3}, Raw: Raw{9, 8}, Fixed: [4]MyByte{5, 6, 7, 8}, Label: "hi"}
	wire := mustBytes(v.MarshalBinary())
	report("named-byte-wire", bytes.Equal(wire, wantWire()), "wire %v, want %v", wire, wantWire())
	prefix := []byte{0xAA}
	appended := mustBytes(v.AppendBinary(prefix))
	report("named-byte-append", bytes.Equal(appended, append([]byte{0xAA}, wire...)), "append %v", appended)
	return v
}

func checkRoundTrip(v Named) {
	wire := mustBytes(v.MarshalBinary())
	got := Named{Bytes: []MyByte{7}, Raw: Raw{1}, Fixed: [4]MyByte{1, 1, 1, 1}, Label: "old"}
	mustNil(got.UnmarshalBinary(wire))
	report("named-byte-roundtrip", same(got, v), "decoded %v, want %v", got, v)
}

func checkSliceWire() {
	plain := PlainBytes{D: []byte{4, 5, 6}}
	named := NamedBytes{D: []MyByte{4, 5, 6}}
	a, b := mustBytes(plain.MarshalBinary()), mustBytes(named.MarshalBinary())
	report("named-byte-same-wire-as-byte", bytes.Equal(a, b), "[]byte wire %v, []MyByte wire %v", a, b)
}

func checkEmpty() {
	var zero NamedBytes
	wire := mustBytes(zero.MarshalBinary())
	empty := NamedBytes{D: []MyByte{9}}
	mustNil(empty.UnmarshalBinary(wire))
	report("named-byte-empty", len(empty.D) == 0, "decoded %v, want empty", empty.D)
}

func main() {
	v := checkWire()
	checkRoundTrip(v)
	checkSliceWire()
	checkEmpty()
	if failed {
		os.Exit(1)
	}
}
