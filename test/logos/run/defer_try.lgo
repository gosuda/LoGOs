// run

package main

import (
	"errors"
	"fmt"
	"os"
)
var failed bool
func check(name string, cond bool, got, want any) {
if !cond {
failed = true
fmt.Println("FAIL", name+":", "got", got, "want", want)
return
}
fmt.Println("ok", name)
}

var errFirst = errors.New("first")
var errSecond = errors.New("second")

type closer struct{ err error }

func (c *closer) Close() error { return c.err }

func returnNil() (err error) {
	c := &closer{}
	defer c.Close()?
	return nil
}

func returnSecond() (err error) {
	c := &closer{err: errSecond}
	defer c.Close()?
	return nil
}

func returnBoth() (err error) {
	c := &closer{err: errSecond}
	defer c.Close()?
	return errFirst
}

func run() error {
if err := returnNil(); err != nil {
check("nil", false, err, nil)
return err
} else {
check("nil", true, nil, nil)
}
errSecondGot := returnSecond()
check("second", errSecondGot != nil && errSecondGot.Error() == "second", errSecondGot, "second")
err := returnBoth()
gotBoth := fmt.Sprint("both:", err)
check("both", err != nil && errors.Is(err, errFirst) && errors.Is(err, errSecond), gotBoth, "both: first second")
check("joined", errors.Is(err, errFirst) && errors.Is(err, errSecond), fmt.Sprint(errors.Is(err, errFirst), errors.Is(err, errSecond)), "true true")
return nil
}
func main() {
if err := run(); err != nil {
fmt.Println("FAIL defer-run:", err)
os.Exit(1)
}
if failed {
os.Exit(1)
}
}
