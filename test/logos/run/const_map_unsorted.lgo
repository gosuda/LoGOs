// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, got, want string) {
	if got == want {
		fmt.Println("ok", name)
		return
	}
	failed = true
	fmt.Println("FAIL", name+":", "got", got, "want", want)
}

// Every literal below is written in scrambled key order; range must
// still visit keys in sorted order. Each kind has a switch form (at
// most 8 keys) and, where the kind admits it, a table form (9 keys).

const strs8 = map[string]int{
	"fig": 4, "apple": 1, "date": 3, "banana": 2,
	"grape": 6, "cherry": 5, "apricot": 0, "elderberry": 7,
}

const strs9 = map[string]int{
	"kiwi": 8, "fig": 4, "apple": 1, "date": 3, "banana": 2,
	"grape": 6, "cherry": 5, "apricot": 0, "elderberry": 7,
}

const ints8 = map[int]int{
	7: 70, -5: -50, 3: 30, 0: 0, -12: -120, 12: 120, -1: -10, 1: 10,
}

const ints9 = map[int]int{
	7: 70, -5: -50, 3: 30, 0: 0, -12: -120, 12: 120, -1: -10, 1: 10, -13: -130,
}

const uints8 = map[uint8]int{
	200: 2, 3: 30, 255: 25, 0: 0, 42: 4, 7: 70, 128: 1, 19: 190,
}

const uints9 = map[uint8]int{
	200: 2, 3: 30, 255: 25, 0: 0, 42: 4, 7: 70, 128: 1, 19: 190, 201: 3,
}

const floats8 = map[float64]int{
	2.5: 25, -1.5: -15, 0.0: 0, 3.25: 32,
	-7.125: -71, 1.0: 10, 100.5: 1005, 0.25: 2,
}

const floats9 = map[float64]int{
	2.5: 25, -1.5: -15, 0.0: 0, 3.25: 32,
	-7.125: -71, 1.0: 10, 100.5: 1005, 0.25: 2, -100.5: -1005,
}

const bools = map[bool]int{true: 1, false: 0}

func main() {
	s := ""
	for k, v := range strs8 {
		s += fmt.Sprintf("%v=%v,", k, v)
	}
	check("strs8-order", s, "apple=1,apricot=0,banana=2,cherry=5,date=3,elderberry=7,fig=4,grape=6,")
	s = ""
	for k, v := range strs9 {
		s += fmt.Sprintf("%v=%v,", k, v)
	}
	check("strs9-order", s, "apple=1,apricot=0,banana=2,cherry=5,date=3,elderberry=7,fig=4,grape=6,kiwi=8,")
	s = ""
	for k, v := range ints8 {
		s += fmt.Sprintf("%v=%v,", k, v)
	}
	check("ints8-order", s, "-12=-120,-5=-50,-1=-10,0=0,1=10,3=30,7=70,12=120,")
	s = ""
	for k, v := range ints9 {
		s += fmt.Sprintf("%v=%v,", k, v)
	}
	check("ints9-order", s, "-13=-130,-12=-120,-5=-50,-1=-10,0=0,1=10,3=30,7=70,12=120,")
	s = ""
	for k, v := range uints8 {
		s += fmt.Sprintf("%v=%v,", k, v)
	}
	check("uints8-order", s, "0=0,3=30,7=70,19=190,42=4,128=1,200=2,255=25,")
	s = ""
	for k, v := range uints9 {
		s += fmt.Sprintf("%v=%v,", k, v)
	}
	check("uints9-order", s, "0=0,3=30,7=70,19=190,42=4,128=1,200=2,201=3,255=25,")
	s = ""
	for k, v := range floats8 {
		s += fmt.Sprintf("%v=%v,", k, v)
	}
	check("floats8-order", s, "-7.125=-71,-1.5=-15,0=0,0.25=2,1=10,2.5=25,3.25=32,100.5=1005,")
	s = ""
	for k, v := range floats9 {
		s += fmt.Sprintf("%v=%v,", k, v)
	}
	check("floats9-order", s, "-100.5=-1005,-7.125=-71,-1.5=-15,0=0,0.25=2,1=10,2.5=25,3.25=32,100.5=1005,")
	s = ""
	for k, v := range bools {
		s += fmt.Sprintf("%v=%v,", k, v)
	}
	check("bools-order", s, "false=0,true=1,")
	if failed {
		os.Exit(1)
	}
}
