// run

package main


import "fmt"

type Pixel struct {
	R, G, B, A uint8
}

func tryLen(w, h int) (out string) {
	defer func() {
		if r := recover(); r != nil {
			out = fmt.Sprint(r)
		}
	}()
	buf := make([]Pixel, w*h)
	out = fmt.Sprintf("len=%d", len(buf))
	return out
}

func tryCap(w, h int) (out string) {
	defer func() {
		if r := recover(); r != nil {
			out = fmt.Sprint(r)
		}
	}()
	buf := make([]Pixel, 1, w*h)
	out = fmt.Sprintf("len=%d cap=%d", len(buf), cap(buf))
	return out
}

func negativePanics(w, h int) (panicked bool) {
	defer func() {
		if recover() != nil {
			panicked = true
		}
	}()
	buf := make([]Pixel, w*h)
	_ = buf
	return false
}

func negativeSinglePanics(n int) (panicked bool) {
	defer func() {
		if recover() != nil {
			panicked = true
		}
	}()
	buf := make([]Pixel, n)
	_ = buf
	return false
}

func main() {
	fmt.Println(tryLen(1 << 32, 1 << 32))
	fmt.Println(tryLen(3, 4))
	fmt.Println(tryCap(1 << 32, 1 << 32))
	fmt.Println(tryLen(0, 1 << 32))
	fmt.Println(negativePanics(-3, 4))
	fmt.Println(negativeSinglePanics(-7))
}
