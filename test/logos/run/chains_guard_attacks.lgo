// run

package main

import (
	"context"
	"errors"
	"fmt"
	"os"
)
var failed bool
func check(name string, cond bool, got, want any) {
if !cond {
failed = true
fmt.Println("FAIL", name+":", "got", got, "want", want)
return
}
fmt.Println("ok", name)
}

var calls int
var order string
var rcvCalls int
var errNeg = errors.New("neg")
var errBoom = errors.New("boom")

func parse(x int) (int, error) {
	calls++
	if x < 0 {
		return 0, errNeg
	}
	return 2 * x, nil
}

func isPos(x int) (bool, error) {
	calls++
	if x < 0 {
		return false, errNeg
	}
	return x > 1, nil
}

func note(tag string, x int) (int, error) {
	order += fmt.Sprintf("%s%d", tag, x)
	return x, nil
}

func failAt(x int) (bool, error) {
	if x == 2 {
		return false, errBoom
	}
	return true, nil
}

var bodyRuns int

func step(tag string, v bool) bool {
	order += tag
	return v
}

func rcv(xs []int) []int {
	rcvCalls++
	return xs
}

func pickCh(c chan int, _ []int) chan int {
	return c
}

func siblingOrder(xs, ys []int) (string, error) {
	order = ""
	n := len(xs.map(x => note("S", x)?).take(9)) + len(ys.map(y => note("R", y)?))
	return fmt.Sprintf("%d %s", n, order), nil
}

func midDefault(k int, ys []int) (string, error) {
	calls = 0
	out := ""
	switch k {
	case 1:
		out = "one"
	default:
		out = "dflt"
	case ys.count(x => isPos(x)?):
		out = "count"
	}
	return fmt.Sprintf("%s calls=%d", out, calls), nil
}

func midFall(k int, ys []int) (string, error) {
	calls = 0
	out := ""
	switch k {
	case 1:
		out += "a"
	default:
		out += "d"
		fallthrough
	case ys.count(x => isPos(x)?):
		out += "c"
	}
	return fmt.Sprintf("%s calls=%d", out, calls), nil
}

func fallStops(k int, ys []int) (string, error) {
	calls = 0
	out := ""
	switch k {
	case 1:
		out += "a"
		fallthrough
	case 2:
		out += "b"
	case ys.count(x => isPos(x)?):
		out += "c"
	}
	return fmt.Sprintf("%s calls=%d", out, calls), nil
}

func switchBreak(k int, skip bool, ys []int) (string, error) {
	calls = 0
	out := ""
	switch k {
	case 1:
		if skip {
			break
		}
		out += "x"
	case ys.count(x => isPos(x)?):
		out += "y"
	}
	out += "z"
	return fmt.Sprintf("%s calls=%d", out, calls), nil
}

func tagless(xs, ys []int) (string, error) {
	calls = 0
	switch n := len(xs); {
	case n == 0:
		return "empty", nil
	case n > ys.count(x => isPos(x)?):
		return fmt.Sprintf("more calls=%d", calls), nil
	}
	return fmt.Sprintf("fewer calls=%d", calls), nil
}

func labeledBreak(ys []int) (string, error) {
	calls = 0
	out := ""
loop:
	for i := 0; i < 4; i++ {
		switch i {
		case 0:
			out += "0"
		case ys.count(x => isPos(x)?):
			out += "c"
			break loop
		default:
			out += "d"
		}
	}
	return fmt.Sprintf("%s calls=%d", out, calls), nil
}

func condCapture(xs []int) (string, error) {
	var fs []func() int
	for i := 0; i < xs.count(x => isPos(x)?); i++ {
		fs = append(fs, func() int { return i })
	}
	var got []int
	for _, f := range fs {
		got = append(got, f())
	}
	return fmt.Sprint(got), nil
}

func postLabeled(xs []int) (string, error) {
	calls = 0
	out := ""
outer:
	for i := 0; i < 3; i += xs.count(x => isPos(x)?) {
		for j := 0; j < 3; j++ {
			if j == 1 {
				continue
			}
			if j == 2 && i == 1 {
				continue outer
			}
			out += fmt.Sprintf("<%d%d>", i, j)
		}
		out += "|"
	}
	return fmt.Sprintf("%s calls=%d", out, calls), nil
}

func condFail(xs []int) (string, error) {
	total := 0
	for i := 0; i < xs.count(x => failAt(x+i)?)+3; i++ {
		total++
	}
	return fmt.Sprint(total), nil
}

func condPost(xs []int) (string, error) {
	calls = 0
	out := ""
	for i := 0; i < len(xs.map(x => parse(x)?)); i += len(xs.map(x => parse(x)?)) {
		out += "."
		if i == 0 {
			continue
		}
		out += "!"
	}
	return fmt.Sprintf("%s calls=%d", out, calls), nil
}

func condRcv(xs []int) (string, error) {
	rcvCalls = 0
	total := 0
	for i := 0; i < rcv(xs).count(x => isPos(x)?); i++ {
		total++
	}
	return fmt.Sprintf("%d %d", total, rcvCalls), nil
}

func selectOrder(ctx context.Context, xs, ys []int) (string, error) {
	order = ""
	full := make(chan int)
	ready := make(chan int, 1)
	ready <- 5
	select {
	case full <- len(xs.map(x => note("S", x)?).take(9)):
		return "sent", nil
	case v := <-pickCh(ready, ys.map(y => note("R", y)?)):
		return fmt.Sprintf("recv %d order=%s", v, order), nil
	case <-ctx.Done():
		return "done", nil
	}
}

func selectLhs(xs []int) (string, error) {
	calls = 0
	m := map[int]int{}
	idle := make(chan int)
	ready := make(chan int, 1)
	ready <- 7
	select {
	case m[xs.count(x => isPos(x)?)] = <-idle:
		return "idle", nil
	case m[0] = <-ready:
		return fmt.Sprintf("ready %d calls=%d", m[0] ?? -1, calls), nil
	}
}

func selectLhsWins(xs []int) (string, error) {
	calls = 0
	m := map[int]int{}
	ready := make(chan int, 1)
	ready <- 7
	select {
	case m[xs.count(x => isPos(x)?)] = <-ready:
		return fmt.Sprintf("won %d calls=%d", m[2] ?? -1, calls), nil
	}
}

func oneLine(xs []int) (string, error) {
	calls = 0
	total := 0
	for i := 0; i < 3; i += xs.count(x => isPos(x)?) { total++ }
	for i := 0; i < xs.count(x => isPos(x)?); i++ {total++}
	return fmt.Sprintf("%d calls=%d", total, calls), nil
}

func groupChild3(ctx context.Context, xs []int) (int, string, error) {
	n := 0
	go group (ctx) {
		go {
			ys := xs.map(x => parse(x)?)
			n = len(ys)
		}
	}
	return n, "ok", nil
}

func shortAnd(ok bool, xs []int) (string, error) {
	calls = 0
	got := ok && xs.all(x => isPos(x)?)
	return fmt.Sprintf("%v calls=%d", got, calls), nil
}

func shortOr(ok bool, xs []int) (string, error) {
	calls = 0
	got := ok || xs.any(x => isPos(x)?)
	return fmt.Sprintf("%v calls=%d", got, calls), nil
}

func shortOrder(a, b bool, xs []int) (string, error) {
	order = ""
	got := step("A", a) && (step("B", b) || len(xs.map(x => note("R", x)?)) > 1) && step("C", true)
	return fmt.Sprintf("%v %s", got, order), nil
}

func condShort(xs []int) (string, error) {
	calls = 0
	var fs []func() int
	for i := 0; i < 2 && xs.count(x => isPos(x)?) > i; i++ {
		fs = append(fs, func() int { return i })
	}
	var got []int
	for _, f := range fs {
		got = append(got, f())
	}
	return fmt.Sprintf("%v calls=%d", got, calls), nil
}

func postCapture(xs []int) (string, error) {
	var fs []func() int
	for i := 0; i < 6; i += xs.count(x => isPos(x)?) {
		fs = append(fs, func() int { return i })
	}
	var got []int
	for _, f := range fs {
		got = append(got, f())
	}
	return fmt.Sprint(got), nil
}

func postBoom(xs []int) (string, error) {
	bodyRuns = 0
	for i := 0; i < 9; i += xs.count(x => failAt(x+i)?) {
		bodyRuns++
	}
	return fmt.Sprint(bodyRuns), nil
}

func postShort(xs []int) (string, error) {
	calls = 0
	n := 0
	i := 0
	flag := true
	for ; i < 4; flag = flag && xs.all(x => isPos(x)?) {
		i++
		n++
	}
	return fmt.Sprintf("n=%d flag=%v calls=%d", n, flag, calls), nil
}

func ifInit(k int, xs []int) (string, error) {
	calls = 0
	if v := k * 2; v > 0 && xs.count(x => isPos(x+v)?) > 0 {
		return fmt.Sprintf("then calls=%d", calls), nil
	} else {
		return fmt.Sprintf("else calls=%d", calls), nil
	}
}

func elseIfInit(k int, xs []int) (string, error) {
	calls = 0
	if k == 0 {
		return "zero", nil
	} else if v := k + 1; xs.count(x => isPos(x+v)?) > 1 {
		return fmt.Sprintf("many calls=%d", calls), nil
	}
	return fmt.Sprintf("few calls=%d", calls), nil
}

func guardShort(k int, ok bool, ys []int) (string, error) {
	calls = 0
	switch {
	case k == 1:
		return "one", nil
	case ok && ys.count(x => isPos(x)?) > 0:
		return fmt.Sprintf("guard calls=%d", calls), nil
	}
	return fmt.Sprintf("none calls=%d", calls), nil
}

func tagInit(xs, ys []int) (string, error) {
	calls = 0
	switch n := len(xs); ys.count(x => isPos(x+n)?) {
	case 2:
		return fmt.Sprintf("two calls=%d", calls), nil
	default:
		return fmt.Sprintf("other calls=%d", calls), nil
	}
}

func loopJumps(xs []int) (string, error) {
	calls = 0
	out := ""
outer:
	for i := 0; i < 4; i += xs.count(x => isPos(x)?) {
		switch i {
		case 0:
			continue
		case 1:
			out += "1"
			continue outer
		case 2:
			out += "2"
			break outer
		}
		out += "x"
	}
	return fmt.Sprintf("%s calls=%d", out, calls), nil
}

func show(caseName, want string, s string, err error) {
var got string
if err != nil {
got = "err: " + err.Error()
} else {
got = s
}
check(caseName, got == want, got, want)
}

func main() {
runOrder()
runLoops()
runSelects()
runShort()
runInit()
if failed {
os.Exit(1)
}
}

func runOrder() {
s, err := siblingOrder([]int{1, 2}, []int{3})
show("sibling", "3 S1S2R3", s, err)
s, err = midDefault(1, []int{2, 3})
show("middefault1", "one calls=0", s, err)
s, err = midDefault(2, []int{2, 3})
show("middefault2", "count calls=2", s, err)
s, err = midDefault(7, []int{2, 3})
show("middefault7", "dflt calls=2", s, err)
s, err = midFall(1, []int{2, 3})
show("midfall1", "a calls=0", s, err)
s, err = midFall(7, []int{2, 3})
show("midfall7", "dc calls=2", s, err)
s, err = midFall(2, []int{2, 3})
show("midfall2", "c calls=2", s, err)
s, err = fallStops(1, []int{2, 3, 4})
show("fallstops1", "ab calls=0", s, err)
s, err = fallStops(2, []int{2, 3, 4})
show("fallstops2", "b calls=0", s, err)
s, err = fallStops(3, []int{2, 3, 4})
show("fallstops3", "c calls=3", s, err)
s, err = switchBreak(1, true, []int{2, 3})
show("switchbreak-skip", "z calls=0", s, err)
s, err = switchBreak(1, false, []int{2, 3})
show("switchbreak-run", "xz calls=0", s, err)
s, err = switchBreak(2, false, []int{2, 3})
show("switchbreak-guard", "yz calls=2", s, err)
s, err = tagless(nil, []int{2, 3})
show("tagless-empty", "empty", s, err)
s, err = tagless([]int{1, 2, 3}, []int{2, 3})
show("tagless-more", "more calls=2", s, err)
s, err = tagless([]int{1}, []int{2, 3})
show("tagless-fewer", "fewer calls=2", s, err)
}

func runLoops() {
var s string
var err error
s, err = labeledBreak([]int{2, 3})
show("labeledbreak", "0dc calls=4", s, err)
s, err = condCapture([]int{2, 3, 4})
show("condcapture", "[0 1 2]", s, err)
s, err = postLabeled([]int{2})
show("postlabeled", "<00><02>|<10><20><22>| calls=3", s, err)
s, err = condFail([]int{1})
show("condfail", "err: boom", s, err)
s, err = condPost([]int{1})
show("condpost", ". calls=3", s, err)
s, err = condRcv([]int{2, 3})
show("condrcv", "2 3", s, err)
}
func runSelects() {
var s string
var err error
s, err = selectOrder(context.Background(), []int{1, 2}, []int{3})
show("selectorder", "recv 5 order=S1S2R3", s, err)
s, err = selectLhs([]int{2, 3})
show("selectlhs", "ready 7 calls=0", s, err)
s, err = selectLhsWins([]int{2, 3})
show("selectlhswins", "won 7 calls=2", s, err)
s, err = oneLine([]int{2})
show("oneline", "4 calls=5", s, err)
n, str, err := groupChild3(context.Background(), []int{-1})
got := fmt.Sprintf("%d %q %v", n, str, err)
check("group3-neg", got == "0 \"\" neg", got, "0 \"\" neg")
n, str, err = groupChild3(context.Background(), []int{1, 2})
got = fmt.Sprintf("%d %q %v", n, str, err)
check("group3-ok", got == "2 \"ok\" <nil>", got, "2 \"ok\" <nil>")
}

func runShort() {
var s string
var err error
s, err = shortAnd(false, []int{2, 3})
show("shortand-false", "false calls=0", s, err)
s, err = shortAnd(true, []int{2, 3})
show("shortand-true", "true calls=2", s, err)
s, err = shortAnd(false, []int{-1})
show("shortand-skip", "false calls=0", s, err)
s, err = shortAnd(true, []int{-1})
show("shortand-fail", "err: neg", s, err)
s, err = shortOr(true, []int{-1})
show("shortor-skip", "true calls=0", s, err)
s, err = shortOr(false, []int{1, 2, 3})
show("shortor-run", "true calls=2", s, err)
s, err = shortOr(false, []int{-1})
show("shortor-fail", "err: neg", s, err)
s, err = shortOrder(false, true, []int{1, 2, 3})
show("shortorder-no-a", "false A", s, err)
s, err = shortOrder(true, true, []int{1, 2, 3})
show("shortorder-b", "true ABC", s, err)
s, err = shortOrder(true, false, []int{1, 2, 3})
show("shortorder-chain", "true ABR1R2R3C", s, err)
s, err = shortOrder(true, false, []int{1})
show("shortorder-short", "false ABR1", s, err)
s, err = condShort([]int{2, 3})
show("condshort", "[0 1] calls=4", s, err)
s, err = postCapture([]int{2, 3})
show("postcapture", "[0 2 4]", s, err)
s, err = postBoom([]int{1})
show("postboom", "err: boom", s, err)
got := fmt.Sprint(bodyRuns)
check("postboom-runs", got == "2", got, "2")
s, err = postShort([]int{0, 5})
show("postshort-stops", "n=4 flag=false calls=1", s, err)
s, err = postShort([]int{2, 3})
show("postshort-runs", "n=4 flag=true calls=8", s, err)
}

func runInit() {
var s string
var err error
s, err = ifInit(0, []int{1, 2})
show("ifinit-else", "else calls=0", s, err)
s, err = ifInit(1, []int{1, 2})
show("ifinit-then", "then calls=2", s, err)
s, err = ifInit(1, []int{-5})
show("ifinit-fail", "err: neg", s, err)
s, err = elseIfInit(0, []int{1, 2})
show("elseif-zero", "zero", s, err)
s, err = elseIfInit(1, []int{1, 2})
show("elseif-many", "many calls=2", s, err)
s, err = elseIfInit(1, []int{-1})
show("elseif-few", "few calls=1", s, err)
s, err = elseIfInit(1, []int{-9})
show("elseif-fail", "err: neg", s, err)
s, err = guardShort(1, true, []int{2, 3})
show("guardshort-one", "one", s, err)
s, err = guardShort(2, false, []int{2, 3})
show("guardshort-skip", "none calls=0", s, err)
s, err = guardShort(2, true, []int{2, 3})
show("guardshort-run", "guard calls=2", s, err)
s, err = guardShort(2, true, []int{-1})
show("guardshort-fail", "err: neg", s, err)
s, err = tagInit([]int{7}, []int{1, 2})
show("taginit-two", "two calls=2", s, err)
s, err = tagInit([]int{7}, []int{1, 2, 3})
show("taginit-other", "other calls=3", s, err)
s, err = tagInit([]int{7}, []int{-5})
show("taginit-fail", "err: neg", s, err)
s, err = loopJumps([]int{2})
show("loopjumps", "12 calls=2", s, err)
}
