// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type ChainM struct{ X int }

func (m *ChainM) Get(ok bool) (int, error) {
	if !ok {
		return 0, fmt.Errorf("no")
	}
	return m.X, nil
}

func mkChain(present bool) *ChainM? {
	if !present {
		return nil
	}
	return &ChainM{X: 7}
}

type ChainBox struct{ X int }

func (b ChainBox) Label(ok bool) (string, error) {
	if !ok {
		return "", fmt.Errorf("no")
	}
	return fmt.Sprintf("box-%d", b.X), nil
}

func mkBox(present bool) ChainBox? {
	if !present {
		return nil
	}
	return ChainBox{X: 7}
}

func errMsg(err error) string {
	if err != nil {
		return err.Error()
	}
	return "<nil>"
}

func tryGet(m *ChainM?, ok bool) (int?, error) {
	v := m?.Get(ok)?
	return v, nil
}

func checkBare(m *ChainM?, absentM *ChainM?) {
	v, err := m?.Get(true)
	if err != nil {
		check("bare-ok-err-nil", false, errMsg(err), "<nil>")
	} else {
		check("bare-ok-err-nil", true, "<nil>", "<nil>")
		check("bare-ok-value", (v ?? -1) == 7, v ?? -1, 7)
	}
	_, errf := m?.Get(false)
	if errf == nil {
		check("bare-fail-err", false, "<nil>", "no")
	} else {
		check("bare-fail-err", errMsg(errf) == "no", errMsg(errf), "no")
	}
	va, erra := absentM?.Get(true)
	if erra != nil {
		check("bare-absent-err-nil", false, errMsg(erra), "<nil>")
	} else {
		check("bare-absent-err-nil", true, "<nil>", "<nil>")
		check("bare-absent-value", (va ?? -1) == -1, va ?? -1, -1)
	}
}

func checkBareAbsent2(absentM *ChainM?) {
	vb, errb := absentM?.Get(false)
	if errb != nil {
		check("bare-absent2-err-nil", false, errMsg(errb), "<nil>")
	} else {
		check("bare-absent2-err-nil", true, "<nil>", "<nil>")
		check("bare-absent2-value", (vb ?? -1) == -1, vb ?? -1, -1)
	}
}

func checkBox(b ChainBox?, absentB ChainBox?) {
	s, serr := b?.Label(true)
	if serr != nil {
		check("box-ok-err-nil", false, errMsg(serr), "<nil>")
	} else {
		check("box-ok-err-nil", true, "<nil>", "<nil>")
		check("box-ok-value", (s ?? "fallback") == "box-7", s ?? "fallback", "box-7")
	}
	_, serrf := b?.Label(false)
	if serrf == nil {
		check("box-fail-err", false, "<nil>", "no")
	} else {
		check("box-fail-err", errMsg(serrf) == "no", errMsg(serrf), "no")
	}
	sa, serra := absentB?.Label(true)
	if serra != nil {
		check("box-absent-err-nil", false, errMsg(serra), "<nil>")
	} else {
		check("box-absent-err-nil", true, "<nil>", "<nil>")
		check("box-absent-value", (sa ?? "fallback") == "fallback", sa ?? "fallback", "fallback")
	}
}

func checkBoxAbsent2(absentB ChainBox?) {
	sf2, serrf2 := absentB?.Label(false)
	if serrf2 != nil {
		check("box-absent2-err-nil", false, errMsg(serrf2), "<nil>")
	} else {
		check("box-absent2-err-nil", true, "<nil>", "<nil>")
		check("box-absent2-value", (sf2 ?? "fallback") == "fallback", sf2 ?? "fallback", "fallback")
	}
}

func checkTry() {
	pv, perr := tryGet(mkChain(true), true)
	if perr != nil {
		check("try-present-err-nil", false, errMsg(perr), "<nil>")
	} else {
		check("try-present-err-nil", true, "<nil>", "<nil>")
		check("try-present-value", (pv ?? -1) == 7, pv ?? -1, 7)
	}
	_, perrf := tryGet(mkChain(true), false)
	if perrf == nil {
		check("try-present-fail", false, "<nil>", "no")
	} else {
		check("try-present-fail", errMsg(perrf) == "no", errMsg(perrf), "no")
	}
	pav, paerr := tryGet(nil, true)
	if paerr != nil {
		check("try-absent-err-nil", false, errMsg(paerr), "<nil>")
	} else {
		check("try-absent-err-nil", true, "<nil>", "<nil>")
		check("try-absent-value", (pav ?? -1) == -1, pav ?? -1, -1)
	}
}

func main() {
	checkBare(mkChain(true), nil)
	checkBareAbsent2(nil)
	checkBox(mkBox(true), nil)
	checkBoxAbsent2(nil)
	checkTry()
	if failed {
		os.Exit(1)
	}
}
