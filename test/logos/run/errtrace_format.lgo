// run

package main

import (
	"errors"
	"fmt"
	"os"
	"strings"

	"logos/rt"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func failBoom() (int, error) {
	return 0, errors.New("boom")
}

func flush() (int, error) {
	n := failBoom()?
	return n, nil
}

func load() (int, error) {
	n := flush()?
	return n, nil
}

func parse() (int, error) {
	n := load()?
	return n, nil
}

type observed[T any] struct {
	v   T
	err error
}

func observe[T any](v T, err error) observed[T] {
	return observed[T]{v, err}
}

func main() {
	if got := rt.FormatTrace(nil); got != "" {
		failed = true
		fmt.Println("FAIL manual-empty:", got)
	} else {
		fmt.Println("ok manual-empty")
	}
	res := observe(parse())
	if res.err == nil {
		failed = true
		fmt.Println("FAIL err: got nil, want boom")
	} else {
		check("err", res.err.Error() == "boom", res.err.Error(), "boom")
	}
	trace := rt.ErrorTrace()
	if len(trace) == 0 {
		fmt.Println("empty-ring")
	} else {
		check("trace-len", len(trace) == 3, len(trace), 3)
		if len(trace) == 3 {
			lines := fmt.Sprint(trace[0].Line, trace[1].Line, trace[2].Line)
			check("trace-lines", lines == "30 35 40", lines, "30 35 40")
			formatted := rt.FormatTrace(trace)
			check("format-30", strings.Contains(formatted, ":30"), formatted, ":30")
			check("format-35", strings.Contains(formatted, ":35"), formatted, ":35")
			check("format-40", strings.Contains(formatted, ":40"), formatted, ":40")
			display := strings.ReplaceAll(formatted, trace[0].File, "prog.lgo")
			fmt.Println(display)
		}
	}
	if failed {
		os.Exit(1)
	}
}
