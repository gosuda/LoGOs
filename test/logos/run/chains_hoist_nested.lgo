// run

package main

import (
	"errors"
	"fmt"
	"os"
)
var failed bool
func check(name string, cond bool, got, want any) {
if !cond {
failed = true
fmt.Println("FAIL", name+":", "got", got, "want", want)
return
}
fmt.Println("ok", name)
}

var calls int
var errNeg = errors.New("neg")

func parse(x int) (int, error) {
	calls++
	if x < 0 {
		return 0, errNeg
	}
	return 2 * x, nil
}

func ifFalse(xs []int) (string, error) {
	calls = 0
	out := "none"
	ok := false
	if ok {
		ys := xs.map(x => parse(x)?)
		out = fmt.Sprint(ys)
	}
	return fmt.Sprintf("%s calls=%d", out, calls), nil
}

func switchCase(tag int, xs []int) (string, error) {
	calls = 0
	switch tag {
	case 1:
		ys := xs.map(x => parse(x)?)
		return fmt.Sprintf("%v calls=%d", ys, calls), nil
	default:
		return fmt.Sprintf("default calls=%d", calls), nil
	}
}

func condBlock(flag bool, xs []int) (string, error) {
	calls = 0
	out := "outer"
	if flag {
		{
			ys := xs.map(x => parse(x)?)
			out = fmt.Sprint(ys)
		}
	}
	return fmt.Sprintf("%s calls=%d", out, calls), nil
}

func flatBlock(xs []int) (string, error) {
	calls = 0
	out := "outer"
	{
		ys := xs.map(x => parse(x)?)
		out = fmt.Sprint(ys)
	}
	return fmt.Sprintf("%s calls=%d", out, calls), nil
}

func loopCount(xs []int, n int) (int, int, error) {
	calls = 0
	total := 0
	for i := 0; i < n; i++ {
		ys := xs.map(x => parse(x)?)
		total += len(ys)
	}
	return total, calls, nil
}

func rangeGroups(groups [][]int) (int, error) {
	total := 0
	for _, xs := range groups {
		ys := xs.map(x => parse(x)?)
		total += len(ys)
	}
	return total, nil
}

func elseIfHeader(flag bool, xs []int) (string, error) {
	calls = 0
	if flag {
		return fmt.Sprintf("first calls=%d", calls), nil
	} else if ys := xs.map(x => parse(x)?); len(ys) > 0 {
		return fmt.Sprintf("%v calls=%d", ys, calls), nil
	}
	return fmt.Sprintf("none calls=%d", calls), nil
}

func elseIfChain(which int, xs []int) (string, error) {
	calls = 0
	if which == 1 {
		return fmt.Sprintf("one calls=%d", calls), nil
	} else if ys := xs.map(x => parse(x)?); len(ys) > 0 {
		return fmt.Sprintf("two calls=%d", calls), nil
	} else if len(xs) > 1 {
		return "three", nil
	}
	return "none", nil
}

func constIfChain(xs []int) (string, error) {
	calls = 0
	const if 1 == 1 {
		ys := xs.map(x => parse(x)?)
		return fmt.Sprintf("%v calls=%d", ys, calls), nil
	} else {
		return "dead", nil
	}
}

func show(name, want string, f func() (any, error)) {
	v, err := f()
	var got string
	if err != nil {
		got = "err: " + err.Error()
	} else {
		got = fmt.Sprint(v)
	}
	check(name, got == want, got, want)
}

func main() {
	show("if", "none calls=0", func() (any, error) { return ifFalse([]int{-1, 2}) })
	show("switch", "default calls=0", func() (any, error) { return switchCase(2, []int{-1}) })
	show("block", "outer calls=0", func() (any, error) { return condBlock(false, []int{-1}) })
	show("flat", "[2 4] calls=2", func() (any, error) { return flatBlock([]int{1, 2}) })
	total, n, err := loopCount([]int{1, 2}, 3)
	if err != nil {
		check("loop", false, err, "6 6")
	} else {
		got := fmt.Sprint(total, n)
		check("loop", got == "6 6", got, "6 6")
	}
	show("range", "3", func() (any, error) { return rangeGroups([][]int{{1, 2}, {3}}) })
	show("elseif", "first calls=0", func() (any, error) { return elseIfHeader(true, []int{-1}) })
	show("elseifchain", "one calls=0", func() (any, error) { return elseIfChain(1, []int{-1}) })
	show("elseifreach", "err: neg", func() (any, error) { return elseIfChain(2, []int{-1}) })
	show("elseifok", "two calls=2", func() (any, error) { return elseIfChain(2, []int{1, 2}) })
	show("constif", "[2 4] calls=2", func() (any, error) { return constIfChain([]int{1, 2}) })
	if failed {
		os.Exit(1)
	}
}
