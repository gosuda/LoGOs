// run

package main


import (
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"runtime"
	"strings"
)

const initSlice = []int{2, 3, 5, 7, 11, 13, 17, 19}
const initArray = [8]int{1, 2, 3, 4, 5, 6, 7, 8}

var initAlloc uint64

func init() {
	var m runtime.MemStats
	runtime.ReadMemStats(&m)
	runtime.ReadMemStats(&m)
	initAlloc = m.HeapAlloc
}
func probeSrc() string {
	var b strings.Builder
	b.WriteString("package main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"runtime\"\n)\n\nconst initArray = [8]int{1, 2, 3, 4, 5, 6, 7, 8}\n\nconst squares = map[int]int{")
	for k := range 1000 {
		b.WriteString(fmt.Sprintf("%d: %d, ", k, k*k))
	}
	b.WriteString("}\n\nvar probeInitAlloc uint64\n\nfunc init() {\n\tvar m runtime.MemStats\n\truntime.ReadMemStats(&m)\n\truntime.ReadMemStats(&m)\n\tprobeInitAlloc = m.HeapAlloc\n}\n\nfunc main() {\n\tvar m runtime.MemStats\n\truntime.ReadMemStats(&m)\n\truntime.ReadMemStats(&m)\n\tif m.HeapAlloc != probeInitAlloc {\n\t\tfmt.Printf(\"FAIL probe init heap grew: %d vs %d\\n\", probeInitAlloc, m.HeapAlloc)\n\t\tos.Exit(1)\n\t}\n\tn := 0\n\tfor range squares {\n\t\tn++\n\t}\n\tfmt.Println(initArray, squares[31] ?? -1, n)\n\tfmt.Println(\"probe init OK\")\n}\n")
	return b.String()
}

//logos:allow(complexity::cognitive_overflow)
func main() {
	var m runtime.MemStats
	runtime.ReadMemStats(&m)
	runtime.ReadMemStats(&m)
	before := m.HeapAlloc
	if before != initAlloc {
		fmt.Printf("FAIL init heap grew: %d vs %d\n", initAlloc, before)
		os.Exit(1)
	}
	sum := 0
	for _, v := range initSlice {
		sum += v
	}
	for _, v := range initArray {
		sum += v
	}
	if sum != 113 {
		fmt.Printf("FAIL sum=%d\n", sum)
		os.Exit(1)
	}
	runtime.ReadMemStats(&m)
	after := m.HeapAlloc
	fmt.Printf("heap delta=%d\n", after-before)
	if after != before {
		fmt.Println("FAIL heap grew at init")
		os.Exit(1)
	}
	binDir := filepath.Join(runtime.GOROOT(), "bin")
	goBin := filepath.Join(binDir, "go")
	logosBin := filepath.Join(binDir, "logos")
	if runtime.GOOS == "windows" {
		goBin += ".exe"
		logosBin += ".exe"
	}
	dir, err := os.MkdirTemp("", "initnm")
	if err != nil {
		fmt.Printf("FAIL tempdir: %v\n", err)
		os.Exit(1)
	}
	if err := os.WriteFile(filepath.Join(dir, "go.mod"), []byte("module probe\n\ngo 1.27\n"), 0644); err != nil {
		fmt.Printf("FAIL gomode: %v\n", err)
		os.Exit(1)
	}
	if err := os.WriteFile(filepath.Join(dir, "main.lgo"), []byte(probeSrc()), 0644); err != nil {
		fmt.Printf("FAIL source: %v\n", err)
		os.Exit(1)
	}
	cmd := exec.Command(logosBin, "build", "-o", "probe.exe", ".")
	cmd.Dir = dir
	if out, err := cmd.CombinedOutput(); err != nil {
		fmt.Printf("FAIL probe build: %v\n%s", err, out)
		os.Exit(1)
	}
	nmOut, err := exec.Command(goBin, "tool", "nm", filepath.Join(dir, "probe.exe")).CombinedOutput()
	if err != nil {
		fmt.Printf("FAIL nm: %v\n%s", err, nmOut)
		os.Exit(1)
	}
	symType := map[string]string{}
	for _, line := range strings.Split(string(nmOut), "\n") {
		if f := strings.Fields(line); len(f) >= 3 {
			symType[f[len(f)-1]] = f[1]
		}
	}
	for _, sym := range []string{"main.initArray", "main._logos_cm0_squares_sorted", "main._logos_cm0_squares_tab"} {
		kind := symType[sym] ?? ""
		fmt.Printf("%s=%s\n", sym, kind)
		if kind != "R" {
			fmt.Printf("FAIL %s not in rodata\n", sym)
			os.Exit(1)
		}
	}
	probeOut, err := exec.Command(filepath.Join(dir, "probe.exe")).CombinedOutput()
	if err != nil {
		fmt.Printf("FAIL probe run: %v\n%s", err, probeOut)
		os.Exit(1)
	}
	if !strings.Contains(string(probeOut), "probe init OK") {
		fmt.Printf("FAIL probe init heap grew:\n%s", probeOut)
		os.Exit(1)
	}

	fmt.Println("init OK")
}
