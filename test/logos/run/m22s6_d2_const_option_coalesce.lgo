// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type P struct {
	O string?
}

func (p const *P) Get() string {
	return p.O ?? "none"
}

func main() {
	p := P{}
	check("coalesce-selects-fallback-for-empty", p.Get() == "none", p.Get(), "none")
	q := P{O: "hi"}
	check("coalesce-selects-value-for-present", q.Get() == "hi", q.Get(), "hi")
	if failed {
		os.Exit(1)
	}
}
