// run

package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"sync/atomic"
	"time"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL "+name+": got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func readySend(ctx context.Context, ch chan int, v int) error {
	go group (ctx) {
		go {
			ch <- v
		}
	}
	return nil
}

var calls atomic.Int32

func next() int {
	return int(calls.Add(1))
}

func readySendCall(ctx context.Context, ch chan int) error {
	go group (ctx) {
		go {
			ch <- next()
		}
	}
	return nil
}

func blockedSend(ctx context.Context, ch chan int) error {
	go group (ctx) {
		go {
			ch <- 1
		}
	}
	return nil
}

func precancelled() context.Context {
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	return ctx
}

func bothArmsReady() {
	bad := 0
	for i := 0; i < 100; i++ {
		ch := make(chan int, 1)
		err := readySend(precancelled(), ch, i)
		got := -1
		select {
		case got = <-ch:
		default:
		}
		if err != nil || got != i {
			bad++
		}
	}
	check("send-ready-wins", bad == 0, bad, 0)
}

func callOperandOnce() {
	calls.Store(0)
	bad := 0
	for range 100 {
		ch := make(chan int, 1)
		err := readySendCall(precancelled(), ch)
		if err != nil {
			bad++
		}
	}
	check("send-call-group-nil", bad == 0, bad, 0)
	check("send-call-once", calls.Load() == 100, calls.Load(), 100)
}

func blockedStillCancels() {
	ch := make(chan int)
	err := blockedSend(precancelled(), ch)
	check("blocked-send-cancelled", errors.Is(err, context.Canceled), err, context.Canceled)
}

func main() {
	watchdog := time.AfterFunc(30*time.Second, func() {
		fmt.Println("FAIL watchdog")
		os.Exit(1)
	})
	defer watchdog.Stop()
	bothArmsReady()
	callOperandOnce()
	blockedStillCancels()
	if failed {
		os.Exit(1)
	}
}
