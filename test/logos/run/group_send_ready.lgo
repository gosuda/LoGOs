// run

package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"sync/atomic"
	"time"
	"unsafe"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL "+name+": got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func readySend(ctx context.Context, ch chan int, v int) error {
	go group (ctx) {
		go {
			ch <- v
		}
	}
	return nil
}

var calls atomic.Int32

func next() int {
	return int(calls.Add(1))
}

func readySendCall(ctx context.Context, ch chan int) error {
	go group (ctx) {
		go {
			ch <- next()
		}
	}
	return nil
}

func blockedSend(ctx context.Context, ch chan int) error {
	go group (ctx) {
		go {
			ch <- 1
		}
	}
	return nil
}

func blockedSendCall(ctx context.Context, ch chan int) error {
	go group (ctx) {
		go {
			ch <- next()
		}
	}
	return nil
}

func interpSend(ctx context.Context, ch chan string, n int) error {
	go group (ctx) {
		go {
			ch <- $"count={n}"
		}
	}
	return nil
}

var interpLookupChans = map[string]chan int{}

var interpChan chan int

func lookupChan(key string) chan int {
	ch, ok := interpLookupChans[key]
	if !ok {
		ch = make(chan int, 1)
		interpLookupChans[key] = ch
	}
	interpChan = ch
	return ch
}

func chanInterpSend(ctx context.Context, n int) error {
	go group (ctx) {
		go {
			lookupChan($"key={n}") <- 1
		}
	}
	return nil
}

var stmtSawKey = make(chan string, 1)

func recvChanLookup(key string) chan int {
	select {
	case stmtSawKey <- key:
	default:
	}
	ch := make(chan int, 1)
	ch <- len(key)
	return ch
}

func recvChanSend(ctx context.Context, out chan int, key string) error {
	go group (ctx) {
		go {
			out <- <-recvChanLookup($"k-{key}")
		}
	}
	return nil
}

var first, second chan int

func redirect() int {
	first = second
	return 7
}

func redirectSend(ctx context.Context) error {
	go group (ctx) {
		go {
			first <- redirect()
		}
	}
	return nil
}

type item struct{ N int }

func nextItem() item {
	return item{N: 9}
}

func shadowedSend(ctx context.Context, ch chan item, item int) error {
	_ = item
	go group (ctx) {
		go {
			ch <- nextItem()
		}
	}
	return nil
}

var recordCalls atomic.Int32

func record() {
	recordCalls.Add(1)
}

func gotoSend(ctx context.Context, ch chan int, skip bool) error {
	go group (ctx) {
		go {
			if skip {
				goto Done
			}
			ch <- next()
		Done:
			record()
		}
	}
	return nil
}

func precancelled() context.Context {
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	return ctx
}

func tickShadowed() time.Duration { return time.Second }

func shadowedImportSend(ctx context.Context, ch chan time.Duration, time int) error {
	_ = time
	go group (ctx) {
		go {
			ch <- tickShadowed()
		}
	}
	return nil
}

func bothArmsReady() {
	bad := 0
	for i := 0; i < 100; i++ {
		ch := make(chan int, 1)
		err := readySend(precancelled(), ch, i)
		got := -1
		select {
		case got = <-ch:
		default:
		}
		if err != nil || got != i {
			bad++
		}
	}
	check("send-ready-wins", bad == 0, bad, 0)
}

func callOperandOnce() {
	calls.Store(0)
	bad := 0
	for range 100 {
		ch := make(chan int, 1)
		err := readySendCall(precancelled(), ch)
		if err != nil {
			bad++
		}
	}
	check("send-call-group-nil", bad == 0, bad, 0)
	check("send-call-once", calls.Load() == 100, calls.Load(), 100)
}

func blockedStillCancels() {
	ch := make(chan int)
	err := blockedSend(precancelled(), ch)
	check("blocked-send-cancelled", errors.Is(err, context.Canceled), err, context.Canceled)
}

func blockedCallOnce() {
	calls.Store(0)
	ch := make(chan int)
	err := blockedSendCall(precancelled(), ch)
	check("blocked-call-cancelled", errors.Is(err, context.Canceled), err, context.Canceled)
	check("blocked-call-once", calls.Load() == 1, calls.Load(), 1)
}

func interpSendReady() {
	ch := make(chan string, 1)
	err := interpSend(precancelled(), ch, 4)
	got := ""
	select {
	case got = <-ch:
	default:
	}
	check("interp-send", err == nil && got == "count=4", fmt.Sprint(err, got), "<nil> count=4")
}

func chanInterpReady() {
	err := chanInterpSend(precancelled(), 4)
	got := -1
	select {
	case got = <-interpChan:
	default:
	}
	_, keyOK := interpLookupChans["key=4"]
	check("send-chan-interp", err == nil && got == 1 && keyOK && len(interpLookupChans) == 1, fmt.Sprint(err, got, keyOK, len(interpLookupChans)), "<nil> 1 true 1")
}

func recvChanReady() {
	// A live context: under a cancelled group the hoisted inner
	// receive races the done branch, which is unrelated to what
	// this case pins (interpolation lowering in ejected text).
	ch := make(chan int, 1)
	err := recvChanSend(context.Background(), ch, "abc")
	got := -1
	select {
	case got = <-ch:
	default:
	}
	check("recv-chan-interp", err == nil && got == 5, fmt.Sprint(err, got), "<nil> 5")
}

func recvStmtDrain(ctx context.Context, key string) error {
	go group (ctx) {
		go {
			<-recvChanLookup($"k-{key}")
		}
	}
	return nil
}

func recvStmtReady() {
	// A live context for the same reason as recvChanReady above:
	// this case pins interpolation lowering, not cancel semantics.
	// Drop the key recorded by the earlier channel test so the read
	// below observes this drain's lookup.
	select {
	case <-stmtSawKey:
	default:
	}
	err := recvStmtDrain(context.Background(), "abc")
	select {
	case got := <-stmtSawKey:
		check("recv-stmt-interp", err == nil && got == "k-abc", fmt.Sprint(err, got), "<nil> k-abc")
	case <-time.After(5 * time.Second):
		check("recv-stmt-interp", false, "lookup never ran", "<nil> k-abc")
	}
}

func chanSnapshotBeforeValue() {
	first = make(chan int, 1)
	second = make(chan int, 1)
	original := first
	err := redirectSend(precancelled())
	gotFirst, gotSecond := -1, -1
	select {
	case gotFirst = <-original:
	default:
	}
	select {
	case gotSecond = <-second:
	default:
	}
	check("send-original-chan", err == nil && gotFirst == 7 && gotSecond == -1, fmt.Sprint(err, gotFirst, gotSecond), "<nil> 7 -1")
}

func shadowedTypeName() {
	ch := make(chan item, 1)
	err := shadowedSend(precancelled(), ch, 1)
	got := item{}
	select {
	case got = <-ch:
	default:
	}
	check("shadowed-type-send", err == nil && got.N == 9, fmt.Sprint(err, got), "<nil> {9}")
}

type cargo interface{}

func cargoOutput(out chan cargo) chan cargo {
	return out
}

func shadowedIfaceSend(ctx context.Context, n int, out chan cargo) error {
	type cargo = int8
	go group (ctx) {
		go {
			cargoOutput(out) <- 1 << n
		}
	}
	return nil
}

func shadowedIfaceValue() {
	out := make(chan cargo, 1)
	err := shadowedIfaceSend(precancelled(), 3, out)
	var got any
	select {
	case got = <-out:
	default:
	}
	check("shadowed-iface-dynamic-type", err == nil && fmt.Sprintf("%T", got) == "int", fmt.Sprint(err, got), "<nil> 8")
}

func shadowedIfaceRecv(ctx context.Context, in <-chan int, n int, out chan cargo) error {
	type cargo = int8
	go group (ctx) {
		go {
			cargoOutput(out) <- (1 << n) + <-in
		}
	}
	return nil
}

func shadowedIfaceRecvValue() {
	in := make(chan int, 1)
	in <- 2
	out := make(chan cargo, 1)
	err := shadowedIfaceRecv(context.Background(), in, 3, out)
	var got any
	select {
	case got = <-out:
	default:
	}
	check("shadowed-iface-recv-hoist", err == nil && fmt.Sprintf("%T", got) == "int" && fmt.Sprint(got) == "10", fmt.Sprint(err, got), "<nil> 10")
}

func shadowedImportValue() {
	ch := make(chan time.Duration, 1)
	err := shadowedImportSend(precancelled(), ch, 0)
	got := time.Duration(0)
	select {
	case got = <-ch:
	default:
	}
	check("shadowed-import-qualifier-send", err == nil && got == time.Second, fmt.Sprint(err, got), "<nil> 1s")
}

func nextPointer() unsafe.Pointer {
	v := 7
	return unsafe.Pointer(&v)
}

func shadowedUnsafeSend(ctx context.Context, ch chan unsafe.Pointer, unsafe int) error {
	_ = unsafe
	go group (ctx) {
		go {
			ch <- nextPointer()
		}
	}
	return nil
}

func shadowedUnsafeValue() {
	ch := make(chan unsafe.Pointer, 1)
	err := shadowedUnsafeSend(precancelled(), ch, 0)
	got := unsafe.Pointer(nil)
	select {
	case got = <-ch:
	default:
	}
	check("shadowed-unsafe-qualifier-send", err == nil && got != nil, fmt.Sprint(err, got), "<nil> non-nil")
}

func gotoPastSend() {
	recordCalls.Store(0)
	calls.Store(0)
	ch := make(chan int, 1)
	err := gotoSend(precancelled(), ch, true)
	check("goto-skips-send", err == nil, err, nil)
	check("goto-send-not-evaluated", calls.Load() == 0, calls.Load(), 0)
	check("goto-record-ran", recordCalls.Load() == 1, recordCalls.Load(), 1)
}


func nilSend(ctx context.Context, ch chan []int) error {
	go group (ctx) {
		go {
			ch <- nil
		}
	}
	return nil
}

type count int

func namedElemSend(ctx context.Context, ch chan count) error {
	go group (ctx) {
		go {
			ch <- 1
		}
	}
	return nil
}

func floatConstSend(ctx context.Context, ch chan float64) error {
	go group (ctx) {
		go {
			ch <- -1
		}
	}
	return nil
}


func nilSendReady() {
	ch := make(chan []int, 1)
	err := nilSend(precancelled(), ch)
	var got []int
	got = []int{1}
	ok := false
	select {
	case got, ok = <-ch:
	default:
	}
	check("send-nil", err == nil && ok && got == nil, fmt.Sprint(err, ok, got), "<nil> true <nil>")
}

func namedElemReady() {
	ch := make(chan count, 1)
	err := namedElemSend(precancelled(), ch)
	var got count = -1
	select {
	case got = <-ch:
	default:
	}
	check("send-named-elem", err == nil && got == 1, fmt.Sprint(err, got), "<nil> 1")
}

func floatConstReady() {
	ch := make(chan float64, 1)
	err := floatConstSend(precancelled(), ch)
	got := 0.0
	select {
	case got = <-ch:
	default:
	}
	check("send-untyped-const", err == nil && got == -1, fmt.Sprint(err, got), "<nil> -1")
}

func main() {
	watchdog := time.AfterFunc(30*time.Second, func() {
		fmt.Println("FAIL watchdog")
		os.Exit(1)
	})
	defer watchdog.Stop()
	bothArmsReady()
	callOperandOnce()
	blockedStillCancels()
	blockedCallOnce()
	interpSendReady()
	chanInterpReady()
	recvChanReady()
	recvStmtReady()
	chanSnapshotBeforeValue()
	shadowedTypeName()
	shadowedIfaceValue()
	shadowedIfaceRecvValue()
	shadowedImportValue()
	shadowedUnsafeValue()
	gotoPastSend()
	nilSendReady()
	namedElemReady()
	floatConstReady()
	if failed {
		os.Exit(1)
	}
}
