// run


package main

import (
	"comptime"
	"errors"
	"fmt"
	"os"
	"strconv"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Outer struct {
	Alpha int
	Beta  int
}

type Inner struct {
	X int
	Y int
	Z int
}

var calls int

func step(in string) (int, error) {
	calls++
	if calls == 4 {
		return 0, errors.New("stopped at step 4")
	}
	return strconv.Atoi(in)
}

func grid(in string, log *[]string) (int, error) {
	sum := 0
	const for _, f := range comptime.Fields[Outer]() {
		const for _, g := range comptime.Fields[Inner]() {
			n := step(in)?
			sum += n
			*log = append(*log, $"{f.Name}.{g.Name}={sum}")
		}
	}
	return sum, nil
}

func weights() int {
	s := 0
	const for _, f := range comptime.Fields[Outer]() {
		const for _, g := range comptime.Fields[Inner]() {
			s += []int{1, 2, 3}.map(x => x + f.Index*10 + g.Index).sum()
		}
	}
	return s
}

func main() {
	calls = 0
	var log1 []string
	got1, err1 := grid("2", &log1)
	want1 := []string{"Alpha.X=2", "Alpha.Y=4", "Alpha.Z=6"}
	check("grid-lines", fmt.Sprint(log1) == fmt.Sprint(want1), log1, want1)
	if err1 == nil {
		check("grid-stopped", false, "nil error", 0)
	} else {
		check("grid-stopped", got1 == 0, got1, 0)
	}
	calls = 100
	var log2 []string
	got2, err2 := grid("2", &log2)
	want2 := []string{"Alpha.X=2", "Alpha.Y=4", "Alpha.Z=6", "Beta.X=8", "Beta.Y=10", "Beta.Z=12"}
	check("grid-full-lines", fmt.Sprint(log2) == fmt.Sprint(want2), log2, want2)
	if err2 != nil {
		check("grid-full-sum", false, err2, 12)
	} else {
		check("grid-full-sum", got2 == 12, got2, 12)
	}
	check("weights", weights() == 144, weights(), 144)
	if failed {
		os.Exit(1)
	}
}
