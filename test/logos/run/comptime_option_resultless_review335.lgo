// run

package main

import (
	"comptime"
	"fmt"
)

type Resource struct {
	closed int
}

func (r *Resource) Shut() {
	r.closed++
}

type Probe struct {
	X int
}

func shut[T any](r *Resource?) {
	var value T
	const for _, field := range comptime.Fields[T]() {
		_ = field.Name
	}
	_ = value
	r?.Shut()
}

func main() {
	r := &Resource{}
	shut[Probe](r)
	shut[Probe](nil)
	fmt.Println("closed", r.closed)
	if r.closed != 1 {
		panic("resultless optional statement did not run once")
	}
}
