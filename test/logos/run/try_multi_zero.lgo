// run

package main

import (
	"errors"
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

var errSrc = errors.New("src")

func fail3() (int, string, error) {
	return 7, "seven", errSrc
}

func get() (int, string, error) {
	a, b := fail3()?
	return a, b, nil
}

func main() {
	a, b, err := get()
	check("zero-int", a == 0, a, 0)
	check("zero-str", b == "", b == "", true)
	check("err", err == errSrc, fmt.Sprint(err), "src")
	if failed {
		os.Exit(1)
	}
}
