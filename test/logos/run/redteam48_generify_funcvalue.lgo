// run -O=3

package main


import (
	"bytes"
	"fmt"
	"io"
)

func r48Copy(w io.Writer, r io.Reader) (int64, error) {
	buf := make([]byte, 4)
	var n int64
	for {
		k, err := r.Read(buf)
		if k > 0 {
			m, werr := w.Write(buf[:k])
			n += int64(m)
			if werr != nil {
				return n, werr
			}
		}
		if err == io.EOF {
			return n, nil
		}
		if err != nil {
			return n, err
		}
	}
}

type r48Counter struct {
	writes int
	bytes  int
}

func (c *r48Counter) Write(p []byte) (int, error) {
	c.writes++
	c.bytes += len(p)
	return len(p), nil
}

func main() {
	var direct bytes.Buffer
	n1, err1 := r48Copy(&direct, bytes.NewReader([]byte("hello")))
	if err1 != nil {
		panic(err1)
	}
	var fn func(io.Writer, io.Reader) (int64, error) = r48Copy
	var via bytes.Buffer
	n2, err2 := fn(&via, bytes.NewReader([]byte("hello")))
	if err2 != nil {
		panic(err2)
	}
	fmt.Println("buf:", n1, err1, direct.String(), n2, err2, via.String())
	if direct.String() != via.String() || n1 != n2 {
		panic("redteam48: function value diverged from direct call")
	}

	var c1 r48Counter
	m1, err3 := r48Copy(&c1, bytes.NewReader([]byte("0123456789")))
	if err3 != nil {
		panic(err3)
	}
	var c2 r48Counter
	m2, err4 := fn(&c2, bytes.NewReader([]byte("0123456789")))
	if err4 != nil {
		panic(err4)
	}
	fmt.Println("counter:", m1, c1.writes, c1.bytes, m2, c2.writes, c2.bytes)
	if m1 != m2 || c1.bytes != c2.bytes {
		panic("redteam48: second concrete type diverged through function value")
	}
}
