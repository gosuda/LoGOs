// run

package main

import (
	"fmt"
	"os"

	"logos/rt"
)

type E struct{}

func (E) Error() string { return "e" }

type InnerNoMember interface{ int | string }
type InnerMember interface{ int | E }
type Mid interface{ InnerNoMember | float64 }
type MidMember interface{ InnerMember | float64 }

type EmptyU interface {
	error
	InnerNoMember | float64
}

type MemberU interface {
	error
	InnerMember | float64
}

type DeepU interface {
	error
	Mid | bool
}

type DeepMemberU interface {
	error
	MidMember | bool
}

var failed bool

func check(name string, got, want any) {
	if got != want {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func commaOk(x any, name string, want bool) {
	var got any = "panic"
	func() {
		defer func() {
			if r := recover(); r != nil {
				got = fmt.Sprintf("panic %v (%T)", r, r)
			}
		}()
		_, ok := x.(EmptyU)
		got = ok
	}()
	check(name, got, want)
}

func commaOkM(x any, name string, want bool) {
	var got any = "panic"
	func() {
		defer func() {
			if r := recover(); r != nil {
				got = fmt.Sprintf("panic %v (%T)", r, r)
			}
		}()
		_, ok := x.(MemberU)
		got = ok
	}()
	check(name, got, want)
}

func commaOkDeep(x any, name string, want bool) {
	var got any = "panic"
	func() {
		defer func() {
			if r := recover(); r != nil {
				got = fmt.Sprintf("panic %v (%T)", r, r)
			}
		}()
		_, ok := x.(DeepU)
		got = ok
	}()
	check(name, got, want)
}

func commaOkDeepM(x any, name string, want bool) {
	var got any = "panic"
	func() {
		defer func() {
			if r := recover(); r != nil {
				got = fmt.Sprintf("panic %v (%T)", r, r)
			}
		}()
		_, ok := x.(DeepMemberU)
		got = ok
	}()
	check(name, got, want)
}

func singleEmpty(x any, name, want string) {
	got := "no panic"
	func() {
		defer func() {
			r := recover()
			e, ok := r.(*rt.UnionAssertionError)
			if !ok {
				got = fmt.Sprintf("panic %v (%T)", r, r)
				return
			}
			got = e.Error()
		}()
		_ = x.(EmptyU)
	}()
	check(name, got, want)
}

func singleM(x any, name, want string) {
	got := "no panic"
	func() {
		defer func() {
			r := recover()
			e, ok := r.(*rt.UnionAssertionError)
			if !ok {
				got = fmt.Sprintf("panic %v (%T)", r, r)
				return
			}
			got = e.Error()
		}()
		_ = x.(MemberU)
	}()
	check(name, got, want)
}

func singleMemberE(x any, name string) {
	e, ok := x.(MemberU)
	_, isE := any(e).(E)
	check(name, ok && isE, true)
}

func whichEmpty(x any, name, want string) {
	got := "panic"
	func() {
		defer func() {
			if r := recover(); r != nil {
				got = fmt.Sprintf("panic %v", r)
			}
		}()
		switch x.(type) {
		case EmptyU:
			got = "member"
		default:
			got = "default"
		}
	}()
	check(name, got, want)
}

func whichM(x any, name, want string) {
	got := "panic"
	func() {
		defer func() {
			if r := recover(); r != nil {
				got = fmt.Sprintf("panic %v", r)
			}
		}()
		switch v := x.(type) {
		case MemberU:
			_, isE := any(v).(E)
			if isE {
				got = "member"
			} else {
				got = "member-wrong"
			}
		default:
			got = "default"
		}
	}()
	check(name, got, want)
}

func convertE() {
	cv := MemberU(E{})
	e, ok := any(cv).(E)
	check("convert-member-e", ok && e.Error() == "e", true)
}

func main() {
	commaOk(42, "empty-comma-int", false)
	commaOk("s", "empty-comma-string", false)
	commaOk(1.5, "empty-comma-float", false)
	var e any = E{}
	commaOk(e, "empty-comma-e", false)
	commaOkM(42, "member-comma-int", false)
	commaOkM(1.5, "member-comma-float", false)
	commaOkM(e, "member-comma-e", true)
	commaOkDeep(42, "deep-comma-int", false)
	commaOkDeep(e, "deep-comma-e", false)
	commaOkDeepM(42, "deep-member-comma-int", false)
	commaOkDeepM(e, "deep-member-comma-e", true)
	singleEmpty(42, "empty-single-int", "interface conversion: int is not a member of main.EmptyU")
	singleEmpty(e, "empty-single-e", "interface conversion: main.E is not a member of main.EmptyU")
	singleM(42, "member-single-int", "interface conversion: int is not a member of main.MemberU")
	singleMemberE(e, "member-single-e")
	whichEmpty(42, "empty-case-int", "default")
	whichEmpty(e, "empty-case-e", "default")
	whichM(42, "member-case-int", "default")
	whichM(e, "member-case-e", "member")
	convertE()
	if failed {
		os.Exit(1)
	}
}
