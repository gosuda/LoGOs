// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type S struct {
	A int
	B int
}

func main() {
	a := S{A: 1, B: 2}
	q := &S{B: 5, ..a}
	plain := &S{A: 1, B: 5}
	check("spread-pointer-literal-fills-from-base", *q == *plain, *q, *plain)
	q.A = 9
	check("spread-pointer-write-hits-literal", *q == S{A: 9, B: 5}, *q, S{A: 9, B: 5})
	check("spread-pointer-write-leaves-base-alone", a == S{A: 1, B: 2}, a, S{A: 1, B: 2})
	if failed {
		os.Exit(1)
	}
}
