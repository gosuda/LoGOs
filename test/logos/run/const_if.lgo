// run

package main

import "fmt"


func pick() string {
	const if 1 == 1 {
		return "one"
	} else {
		return "other"
	}
}

func chain() string {
	const if 1 == 2 {
		return "two"
	} else const if 1 == 1 {
		return "one"
	} else {
		return "other"
	}
}

func skipped() string {
	const if 1 == 2 {
		return "two"
	}
	return "after"
}

func main() {
	fmt.Println(pick())
	fmt.Println(chain())
	fmt.Println(skipped())
}
