// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func pick() string {
	const if 1 == 1 {
		return "one"
	} else {
		return "other"
	}
}

func chain() string {
	const if 1 == 2 {
		return "two"
	} else const if 1 == 1 {
		return "one"
	} else {
		return "other"
	}
}

func skipped() string {
	const if 1 == 2 {
		return "two"
	}
	return "after"
}

func main() {
	check("pick", pick() == "one", pick(), "one")
	check("chain", chain() == "one", chain(), "one")
	check("skipped", skipped() == "after", skipped(), "after")
	if failed {
		os.Exit(1)
	}
}
