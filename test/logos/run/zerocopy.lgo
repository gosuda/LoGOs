// run
package main

import (
	"fmt"
	"os"
	"testing"
)

var zbSinkB const []byte
var zbSinkS string
var zbSinkC string

func zbComposite() string {
	var c const []byte = []byte{7, 8, 9}
	return string(c)
}

func main() {
	failed := false
	check := func(name string, ok bool) {
		if !ok {
			fmt.Printf("FAIL %s\n", name)
			failed = true
			return
		}
		fmt.Printf("ok %s\n", name)
	}
	s := "hello world, zero copy me"
	var b const []byte = const []byte(s)
	zbSinkS = string(b)
	check("const-view-roundtrip-preserves-string", zbSinkS == s)
	check("string-to-const-needs-no-alloc", testing.AllocsPerRun(100, func() {
		zbSinkB = const []byte(s)
	}) == 0)
	check("const-to-string-needs-no-alloc", testing.AllocsPerRun(100, func() {
		zbSinkS = string(b)
	}) == 0)
	check("const-view-still-valid-after-checks", zbSinkS == s)
	var c const []byte = []byte{7, 8, 9}
	check("composite-const-to-string-needs-no-alloc", testing.AllocsPerRun(100, func() {
		zbSinkS = string(c)
	}) == 0)
	zbSinkC = zbComposite()
	check("composite-const-roundtrip-preserves-bytes", zbSinkC == string([]byte{7, 8, 9}))
	mut := []byte("hello world, zero copy me")
	var v const []byte = mut
	t := string(v)
	mut[0] = 'X'
	check("mutable-source-snapshot-is-immutable", t == s)
	check("mutated-source-conversion-allocates", testing.AllocsPerRun(100, func() {
		zbSinkS = string(v)
	}) >= 1)
	p := []byte(s)
	p[0] = 'X'
	_ = p
	check("unrelated-mutation-keeps-source-string", s == "hello world, zero copy me")
	if failed {
		os.Exit(1)
	}
}
