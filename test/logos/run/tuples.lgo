// run

package main

import (
	"fmt"
	"io"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func pair() (int, error) { return 3, nil }

func nres() (x int, y string) { return 7, "seven" }

func show(t (id int64, err error)) string {
	a, b := t
	return fmt.Sprint(a, b)
}

func two(a int, b error) bool { return a == 3 && b == nil }

func captureStdout(f func()) string {
	old := os.Stdout
	r, w, err := os.Pipe()
	if err != nil {
		fmt.Println("FAIL pipe:", err)
		os.Exit(1)
	}
	os.Stdout = w
	f()
	cerr := w.Close()
	os.Stdout = old
	out, rerr := io.ReadAll(r)
	if cerr != nil {
		fmt.Println("FAIL close:", cerr)
		os.Exit(1)
	}
	if rerr != nil {
		fmt.Println("FAIL read:", rerr)
		os.Exit(1)
	}
	return string(out)
}

func main() {
	var t (int, error)
	t = pair()
	a, b := t
	pa, pb := pair()
	check("tuple-assign-keeps-values", pb == nil && a == 3 && b == nil && a == pa && b == pb, fmt.Sprint(a, b), "3 <nil>")
	c := pair()
	d := pair()
	check("call-tuple-equals-fresh-call", c == d && c == t, fmt.Sprint(c), "{3 <nil>}")
	n := nres()
	check("named-results-keep-names", n.x == 7 && n.y == "seven", fmt.Sprint(n.x, n.y), "7 seven")
	u := (10, "ten")
	p, q := u
	check("literal-tuple-unpacks", p == 10 && q == "ten", fmt.Sprint(p, q), "10 ten")
	sp, sq := pair()
	check("direct-call-unpacks", sq == nil && sp == 3, fmt.Sprint(pair()), "3 <nil>")
	check("call-arg-unpacks", two(pair()), two(pair()), true)
	check("call-print-unpacks", fmt.Sprint(pair()) == "3 <nil>", fmt.Sprint(pair()), "3 <nil>")
	printed := captureStdout(func() { fmt.Println(pair()) })
	check("call-println-unpacks", printed == "3 <nil>\n", fmt.Sprintf("%q", printed), "\"3 <nil>\\n\"")
	ch := make(chan (int, error), 1)
	ch <- c
	v := <-ch
	check("tuple-round-trips-channel", v == c, fmt.Sprint(v), "{3 <nil>}")
	m := map[string](int, error){"k": (1, nil)}
	mv, ok := m["k"]
	mp, mq := mv
	check("tuple-round-trips-map", ok && mp == 1 && mq == nil, fmt.Sprint(ok, mp, mq), "true 1 <nil>")
	check("named-tuple-params-unpack", show((42, nil)) == "42 <nil>", show((42, nil)), "42 <nil>")
	direct()
	if failed {
		os.Exit(1)
	}
}

func direct() {
	x, y := pair()
	check("direct-unpack-keeps-values", y == nil && x == 3, fmt.Sprint(pair()), "3 <nil>")
	p, q := nres()
	check("direct-named-unpack-keeps-values", p == 7 && q == "seven", fmt.Sprint(p, q), "7 seven")
	m1, m2 := pair()
	m1, m2 = pair()
	check("reassign-keeps-values", m2 == nil && m1 == 3, fmt.Sprint(pair()), "3 <nil>")
}
