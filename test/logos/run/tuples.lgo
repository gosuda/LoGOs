// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func pair() (int, error) { return 3, nil }

func nres() (x int, y string) { return 7, "seven" }

func show(t (id int64, err error)) string {
	a, b := t
	return fmt.Sprint(a, b)
}

func main() {
	var t (int, error)
	t = pair()
	a, b := t
	pa, pb := pair()
	check("tuple-assign-keeps-values", a == 3 && b == nil && a == pa && b == pb, fmt.Sprint(a, b), "3 <nil>")
	c := pair()
	d := pair()
	check("call-tuple-equals-fresh-call", c == d && c == t, fmt.Sprint(c), "{3 <nil>}")
	n := nres()
	check("named-results-keep-names", n.x == 7 && n.y == "seven", fmt.Sprint(n.x, n.y), "7 seven")
	u := (10, "ten")
	p, q := u
	check("literal-tuple-unpacks", p == 10 && q == "ten", fmt.Sprint(p, q), "10 ten")
	sp, sq := pair()
	check("direct-call-unpacks", sp == 3 && sq == nil, fmt.Sprint(sp, sq), "3 <nil>")
	ch := make(chan (int, error), 1)
	ch <- c
	v := <-ch
	check("tuple-round-trips-channel", v == c, fmt.Sprint(v), "{3 <nil>}")
	m := map[string](int, error){"k": (1, nil)}
	mv, ok := m["k"]
	mp, mq := mv
	check("tuple-round-trips-map", ok && mp == 1 && mq == nil, fmt.Sprint(ok, mp, mq), "true 1 <nil>")
	check("named-tuple-params-unpack", show((42, nil)) == "42 <nil>", show((42, nil)), "42 <nil>")
	direct()
	if failed {
		os.Exit(1)
	}
}

func direct() {
	x, y := pair()
	check("direct-unpack-keeps-values", x == 3 && y == nil, fmt.Sprint(x, y), "3 <nil>")
	p, q := nres()
	check("direct-named-unpack-keeps-values", p == 7 && q == "seven", fmt.Sprint(p, q), "7 seven")
	m1, m2 := pair()
	m1, m2 = pair()
	check("reassign-keeps-values", m1 == 3 && m2 == nil, fmt.Sprint(m1, m2), "3 <nil>")
}
