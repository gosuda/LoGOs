// run

package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"runtime"
	"sort"
	"time"
)

var errFirst = errors.New("first")
var errSecond = errors.New("second")

var lOrder []string
var hOrder []string

func lnote(s string) { lOrder = append(lOrder, s) }
func hnote(s string) { hOrder = append(hOrder, s) }

//go:noinline
func ltry(s string) error {
	lOrder = append(lOrder, "try:"+s)
	return nil
}

//go:noinline
func htry(s string) error {
	hOrder = append(hOrder, "try:"+s)
	return nil
}

func sameStrings(a, c []string) bool {
	if len(a) != len(c) {
		return false
	}
	for i := range a {
		if a[i] != c[i] {
			return false
		}
	}
	return true
}

func sameInts(a, c []int) bool {
	if len(a) != len(c) {
		return false
	}
	for i := range a {
		if a[i] != c[i] {
			return false
		}
	}
	return true
}

var failed = false

func check(name string, ok bool, detail string) {
	if !ok {
		fmt.Println("FAIL", name, detail)
		failed = true
		return
	}
	fmt.Println(name, "ok")
}

func orderCase(name string, lfunc, hfunc func() error) {
	lOrder = nil
	lerr := lfunc()
	lgot := append([]string(nil), lOrder...)
	hOrder = nil
	herr := hfunc()
	check(name, lerr == nil && herr == nil && sameStrings(lgot, hOrder), fmt.Sprint("logos=", lgot, " hand=", hOrder))
}
func loop3Logos(n int) (err error) {
	for i := 0; i < n; i++ {
		defer ltry(fmt.Sprint(i))?
		defer lnote("defer:" + fmt.Sprint(i))
		errdefer lnote("errdefer:" + fmt.Sprint(i))
	}
	return nil
}

func loop3Hand(n int) (err error) {
	for i := 0; i < n; i++ {
		x := i
		defer func() {
			if e := htry(fmt.Sprint(x)); e != nil {
				if err == nil {
					err = e
				} else {
					err = errors.Join(err, e)
				}
			}
		}()
		defer hnote("defer:" + fmt.Sprint(x))
		errdefer hnote("errdefer:" + fmt.Sprint(x))
	}
	return nil
}

func rangeIntLogos(n int) (err error) {
	for i := range n {
		defer ltry(fmt.Sprint(i))?
	}
	return nil
}

func rangeIntHand(n int) (err error) {
	for i := range n {
		x := i
		defer func() {
			if e := htry(fmt.Sprint(x)); e != nil {
				if err == nil {
					err = e
				} else {
					err = errors.Join(err, e)
				}
			}
		}()
	}
	return nil
}

func rangeSliceLogos(vs []int) (err error) {
	for _, v := range vs {
		defer ltry(fmt.Sprint(v))?
	}
	return nil
}

func rangeSliceHand(vs []int) (err error) {
	for _, v := range vs {
		x := v
		defer func() {
			if e := htry(fmt.Sprint(x)); e != nil {
				if err == nil {
					err = e
				} else {
					err = errors.Join(err, e)
				}
			}
		}()
