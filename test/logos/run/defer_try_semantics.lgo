func gotoLogos(n int) (err error) {
	i := 0
again:
	defer ltry(fmt.Sprint(i))?
	i++
	if i < n {
		goto again
	}
	return nil
}

func gotoHand(n int) (err error) {
	i := 0
again:
	x := i
	defer func() {
		if e := htry(fmt.Sprint(x)); e != nil {
			if err == nil {
				err = e
			} else {
				err = errors.Join(err, e)
			}
		}
	}()
	i++
	if i < n {
		goto again
	}
	return nil
}

func nestedLogos(n int) (err error) {
	for i := 0; i < n; i++ {
		for j := 0; j < 2; j++ {
			defer ltry(fmt.Sprint(i)+fmt.Sprint(j))?
		}
	}
	return nil
}

func nestedHand(n int) (err error) {
	for i := 0; i < n; i++ {
		for j := 0; j < 2; j++ {
			x, y := i, j
			defer func() {
				if e := htry(fmt.Sprint(x)+fmt.Sprint(y)); e != nil {
					if err == nil {
						err = e
					} else {
						err = errors.Join(err, e)
					}
				}
			}()
		}
	}
	return nil
}

func labeledContLogos(n int) (err error) {
outer:
	for i := 0; i < n; i++ {
		for j := 0; j < n; j++ {
			if j == 1 {
				continue outer
			}
			defer ltry(fmt.Sprint(i)+fmt.Sprint(j))?
		}
	}
	return nil
}

func labeledContHand(n int) (err error) {
outer:
	for i := 0; i < n; i++ {
		for j := 0; j < n; j++ {
			if j == 1 {
				continue outer
			}
			x, y := i, j
			defer func() {
				if e := htry(fmt.Sprint(x)+fmt.Sprint(y)); e != nil {
					err = errors.Join(err, e)
				}
			}()
		}
	}
	return nil
}

func labeledBreakLogos(n int) (err error) {
outer:
	for i := 0; i < n; i++ {
		for j := 0; j < n; j++ {
			defer ltry(fmt.Sprint(i)+fmt.Sprint(j))?
			break outer
		}
	}
	return nil
}

func labeledBreakHand(n int) (err error) {
outer:
	for i := 0; i < n; i++ {
		for j := 0; j < n; j++ {
			x, y := i, j
			defer func() {
				if e := htry(fmt.Sprint(x)+fmt.Sprint(y)); e != nil {
					err = errors.Join(err, e)
				}
			}()
			break outer
		}
	}
	return nil
}

type box struct{ v int }

//go:noinline
func (b *box) ClosePtr() error {
	lOrder = append(lOrder, fmt.Sprint("closed:", b.v))
	return nil
}

//go:noinline
func (b *box) hClosePtr() error {
	hOrder = append(hOrder, fmt.Sprint("closed:", b.v))
	return nil
}

//go:noinline
func (b box) CloseVal() error {
	lOrder = append(lOrder, "valclosed")
	return nil
}

//go:noinline
func (b box) hCloseVal() error {
	hOrder = append(hOrder, "valclosed")
	return nil
}

func recvLogos() (err error) {
	b := &box{v: 1}
	defer b.ClosePtr()?
	b = &box{v: 2}
	return nil
}

func recvHand() (err error) {
	b := &box{v: 1}
	b0 := b
	defer func() {
		if e := b0.hClosePtr(); e != nil {
			if err == nil {
				err = e
			} else {
				err = errors.Join(err, e)
			}
		}
	}()
	b = &box{v: 2}
	return nil
}

//go:noinline
func lused(x int) error {
	lOrder = append(lOrder, fmt.Sprint("used:", x))
	return nil
}

//go:noinline
func hused(x int) error {
	hOrder = append(hOrder, fmt.Sprint("used:", x))
	return nil
}

func argMutLogos() (err error) {
	x := 7
	defer lused(x)?
	x = 999
	return nil
}

func argMutHand() (err error) {
	x := 7
	y := x
	defer func() {
		if e := hused(y); e != nil {
			if err == nil {
				err = e
			} else {
				err = errors.Join(err, e)
			}
		}
	}()
	x = 999
	return nil
}

func nullValLogos() (point string, recovered any, err error) {
	defer func() {
		if r := recover(); r != nil {
			recovered = r
		}
	}()
	b := (*box)(nil)
	defer b.CloseVal()?
	point = "stmt"
	return
}

func nullValHand() (point string, recovered any, err error) {
	defer func() {
		if r := recover(); r != nil {
			recovered = r
		}
	}()
	b := (*box)(nil)
	defer b.CloseVal()
	point = "stmt"
	return
}

type ifaceCloser interface{ Close() error }

type ifaceBox struct{ v int }

//go:noinline
func (b *ifaceBox) Close() error { return nil }

func nullIfaceLogos() (point string, recovered any, err error) {
	defer func() {
		if r := recover(); r != nil {
			recovered = r
		}
	}()
	c := ifaceCloser(nil)
	defer c.Close()?
	point = "stmt"
	return
}

func nullIfaceHand() (point string, recovered any, err error) {
	defer func() {
		if r := recover(); r != nil {
			recovered = r
		}
	}()
	var c ifaceCloser
	defer c.Close()
	point = "stmt"
	return
}

func nullFnLogos() (point string, recovered any, err error) {
	defer func() {
		if r := recover(); r != nil {
			recovered = r
		}
	}()
	var f func() error
	defer f()?
	point = "stmt"
	return
}

func nullFnHand() (point string, recovered any, err error) {
	defer func() {
		if r := recover(); r != nil {
			recovered = r
		}
	}()
	var f func() error
	f0 := f
	defer func() {
		if e := f0(); e != nil {
			err = e
		}
	}()
	point = "stmt"
	return
}

func nullCase(name string, lp, hp func() (string, any, error)) {
	lpnt, lrec, lerr := lp()
	hpnt, hrec, herr := hp()
	lok := lrec != nil && lerr == nil
	hok := hrec != nil && herr == nil
	check(name, lok && hok && lpnt == hpnt, fmt.Sprint("logos=", lpnt, ",", lrec != nil, " hand=", hpnt, ",", hrec != nil))
}

type bigArg struct {
	a [200]byte
	n int
}

//go:noinline
func lsumBig(b bigArg) error {
	t := 0
	for _, v := range b.a {
		t += int(v)
	}
	lOrder = append(lOrder, fmt.Sprint("big:", t+b.n))
	return nil
}

//go:noinline
func hsumBig(b bigArg) error {
	t := 0
	for _, v := range b.a {
		t += int(v)
	}
	hOrder = append(hOrder, fmt.Sprint("big:", t+b.n))
	return nil
}

func bigLogos() (err error) {
	b := bigArg{n: 3}
	for i := range b.a {
		b.a[i] = 1
	}
	defer lsumBig(b)?
	return nil
}

func bigHand() (err error) {
	b := bigArg{n: 3}
	for i := range b.a {
		b.a[i] = 1
	}
	c := b
	defer func() {
		if e := hsumBig(c); e != nil {
			if err == nil {
				err = e
			} else {
				err = errors.Join(err, e)
			}
		}
	}()
	return nil
}

//go:noinline
func lvar(a int, rest ...int) error {
	t := a
	for _, v := range rest {
		t += v
	}
	lOrder = append(lOrder, fmt.Sprint("var:", t))
	return nil
}

//go:noinline
func hvar(a int, rest ...int) error {
	t := a
	for _, v := range rest {
		t += v
	}
	hOrder = append(hOrder, fmt.Sprint("var:", t))
	return nil
}

func variadicLogos() (err error) {
