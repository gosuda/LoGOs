	func() {
		for i := 0; i < 3; i++ {
			x := i
			defer func() {
				if e := htry(fmt.Sprint(x)); e != nil {
					if err == nil {
						err = e
					} else {
						err = errors.Join(err, e)
					}
				}
			}()
		}
	}()
	return nil
}

var q1Seen any = "unset"

//go:noinline
func q1try() error {
	q1Seen = recover()
	return nil
}

func q1Logos() (err error) {
	defer q1try()?
	panic("q1")
}

func q1Hand() (err error) {
	defer func() {
		if e := q1try(); e != nil {
			if err == nil {
				err = e
			} else {
				err = errors.Join(err, e)
			}
		}
	}()
	panic("q1")
}

//logos:allow(slop::discarded_error)
func q1Case(name string, f func() error) {
	q1Seen = "unset"
	func() {
		defer func() { _ = recover() }()
		_ = f()
	}()
	check(name, q1Seen == nil, fmt.Sprint("recover() inside f returned ", q1Seen))
}

func sortedCopy(vs []string) []string {
	out := append([]string(nil), vs...)
	sort.Strings(out)
	return out
}

//logos:allow(correctness::unbounded_channel_op)
//logos:allow(slop::discarded_error)
func main() {
	orderCase("loop3", func() error { return loop3Logos(4) }, func() error { return loop3Hand(4) })
	orderCase("range-int", func() error { return rangeIntLogos(4) }, func() error { return rangeIntHand(4) })
	orderCase("range-slice", func() error { return rangeSliceLogos([]int{3, 1, 2}) }, func() error { return rangeSliceHand([]int{3, 1, 2}) })
	lOrder = nil
	_ = rangeMapLogos(map[string]int{"a": 1, "b": 2})
	lgot := sortedCopy(lOrder)
	hOrder = nil
	_ = rangeMapHand(map[string]int{"a": 1, "b": 2})
	check("range-map", sameStrings(lgot, sortedCopy(hOrder)), fmt.Sprint("logos=", lgot, " hand=", hOrder))
	mkchan := func() chan int {
		ch := make(chan int, 4)
		for _, v := range []int{7, 8, 9} {
			ch <- v
		}
		close(ch)
		return ch
	}
	orderCase("range-chan", func() error { return rangeChanLogos(mkchan()) }, func() error { return rangeChanHand(mkchan()) })
	orderCase("goto", func() error { return gotoLogos(4) }, func() error { return gotoHand(4) })
	orderCase("nested", func() error { return nestedLogos(3) }, func() error { return nestedHand(3) })
	orderCase("labeled-continue", func() error { return labeledContLogos(4) }, func() error { return labeledContHand(4) })
	orderCase("labeled-break", func() error { return labeledBreakLogos(4) }, func() error { return labeledBreakHand(4) })
	orderCase("recv-mut", recvLogos, recvHand)
	orderCase("arg-mut", argMutLogos, argMutHand)
	nullCase("null-valrecv", nullValLogos, nullValHand)
	nullCase("null-iface", nullIfaceLogos, nullIfaceHand)
	nullCase("null-funcval", nullFnLogos, nullFnHand)
	orderCase("big-arg", bigLogos, bigHand)
	orderCase("variadic", variadicLogos, variadicHand)
	orderCase("generic", genericLogos, genericHand)
	orderCase("iface-method", ifaceLogos, ifaceHand)
	orderCase("method-value", methodValLogos, methodValHand)
	joinCase("join-two-logos", joinLogos)
	joinCase("join-two-hand", joinHand)
	typedNilCase("typed-nil-logos", typedNilLogos)
	typedNilCase("typed-nil-hand", typedNilHand)
	orderCase("panic-inner", func() error { return panicInnerLogos(5) }, func() error { return panicInnerHand(5) })
	callPanics(panicCallerLogos, panicCallerHand, 4)
	_ = goexitCase("goexit-logos", func(done chan string) { _ = goexitLogos(done) })
	_ = goexitCase("goexit-hand", goexitHand)
	orderCase("nested-funclit", funclitLogos, funclitHand)
	q1Case("recover-in-f-logos", q1Logos)
	q1Case("recover-in-f-hand", q1Hand)
	if failed {
		os.Exit(1)
	}
}
