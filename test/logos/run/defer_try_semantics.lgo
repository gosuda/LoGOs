//go:noinline
func failSecond() error { return errSecond }

func joinLogos() (err error) {
	defer failSecond()?
	return errFirst
}

func joinHand() (err error) {
	defer func() {
		if e := failSecond(); e != nil {
			if err == nil {
				err = e
			} else {
				err = errors.Join(err, e)
			}
		}
	}()
	return errFirst
}

func joinCase(name string, f func() error) {
	err := f()
	check(name, errors.Is(err, errFirst) && errors.Is(err, errSecond) && err.Error() == "first\nsecond", fmt.Sprint(err))
}

type typedBox struct{ msg string }

func (e *typedBox) Error() string {
	if e == nil {
		return "typed"
	}
	return e.msg
}

//go:noinline
func typedNilErr() error {
	p := (*typedBox)(nil)
	return p
}

func typedNilLogos() (err error) {
	defer typedNilErr()?
	return nil
}

func typedNilHand() (err error) {
	defer func() {
		if e := typedNilErr(); e != nil {
			if err == nil {
				err = e
			} else {
				err = errors.Join(err, e)
			}
		}
	}()
	return nil
}

func typedNilCase(name string, f func() error) {
	err := f()
	_, isBox := err.(*typedBox)
	check(name, err != nil && isBox && err.Error() == "typed", fmt.Sprint(err))
}

func panicInnerLogos(k int) (err error) {
	defer func() {
		if r := recover(); r != nil {
			lOrder = append(lOrder, fmt.Sprint("recovered:", r))
		}
	}()
	for i := 0; i < k; i++ {
		defer ltry(fmt.Sprint(i))?
	}
	panic("boom")
}

func panicInnerHand(k int) (err error) {
	defer func() {
		if r := recover(); r != nil {
			hOrder = append(hOrder, fmt.Sprint("recovered:", r))
		}
	}()
	for i := 0; i < k; i++ {
		x := i
		defer func() {
			if e := htry(fmt.Sprint(x)); e != nil {
				if err == nil {
					err = e
				} else {
					err = errors.Join(err, e)
				}
			}
		}()
	}
	panic("boom")
}

func panicCallerLogos(k int) (err error) {
	for i := 0; i < k; i++ {
		defer ltry(fmt.Sprint(i))?
	}
	panic("outer-boom")
}

func panicCallerHand(k int) (err error) {
	for i := 0; i < k; i++ {
		x := i
		defer func() {
			if e := htry(fmt.Sprint(x)); e != nil {
				if err == nil {
					err = e
				} else {
					err = errors.Join(err, e)
				}
			}
		}()
	}
	panic("outer-boom")
}

//logos:allow(slop::discarded_error)
func callPanics(lfunc, hfunc func(int) error, k int) {
	lOrder = nil
	callAndRecover(lfunc, k)
	lgot := append([]string(nil), lOrder...)
	hOrder = nil
	callAndRecover(hfunc, k)
	check("panic-caller", sameStrings(lgot, hOrder), fmt.Sprint("logos=", lgot, " hand=", hOrder))
}

//logos:allow(slop::discarded_error)
func callAndRecover(f func(int) error, k int) {
	func() {
		defer func() { _ = recover() }()
		_ = f(k)
	}()
}

//logos:allow(correctness::unbounded_channel_op)
func goexitTry(done chan string, s string) error {
	done <- "try:" + s
	return nil
}

func goexitLogos(done chan string) (err error) {
	for i := 0; i < 3; i++ {
		defer goexitTry(done, fmt.Sprint(i))?
	}
	runtime.Goexit()
	return nil
}

func goexitHand(done chan string) {
	for i := 0; i < 3; i++ {
		x := i
		d := done
		defer func() {
			_ = goexitTry(d, fmt.Sprint(x))
		}()
	}
	runtime.Goexit()
}

//logos:allow(correctness::unbounded_channel_op)
func goexitCase(name string, f func(chan string)) (err error) {
	done := make(chan string, 8)
	go group (context.Background()) {
		go f(done)
	}
	got := make([]string, 0, 3)
	timeout := time.After(30 * time.Second)
	for i := 0; i < 3; i++ {
		select {
		case s := <-done:
			got = append(got, s)
		case <-timeout:
			check(name, false, "timeout")
			return
		}
	}
	check(name, sameStrings(got, []string{"try:2", "try:1", "try:0"}), fmt.Sprint(got))
	return nil
}

//logos:allow(slop::discarded_error)
func funclitLogos() (err error) {
	_ = func() (err error) {
		for i := 0; i < 3; i++ {
			defer ltry(fmt.Sprint(i))?
		}
		return nil
	}()
	return nil
}

