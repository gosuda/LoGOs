}

func rangeMapLogos(m map[string]int) (err error) {
	for k, v := range m {
		defer ltry(k+fmt.Sprint(v))?
	}
	return nil
}

func rangeMapHand(m map[string]int) (err error) {
	for k, v := range m {
		kk, vv := k, v
		defer func() {
			if e := htry(kk+fmt.Sprint(vv)); e != nil {
				if err == nil {
					err = e
				} else {
					err = errors.Join(err, e)
				}
			}
		}()
	}
	return nil
}

func rangeChanLogos(ch chan int) (err error) {
	for v := range ch {
		defer ltry(fmt.Sprint(v))?
	}
	return nil
}

func rangeChanHand(ch chan int) (err error) {
	for v := range ch {
		x := v
		defer func() {
			if e := htry(fmt.Sprint(x)); e != nil {
				if err == nil {
					err = e
				} else {
					err = errors.Join(err, e)
				}
			}
