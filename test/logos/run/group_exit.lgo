// run

package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"sync"
)

var errQFail = errors.New("q-fail")

var mu sync.Mutex

var order []string

func note(s string) {
	mu.Lock()
	order = append(order, s)
	mu.Unlock()
}

var bad bool

func check(tag string, cond bool, got, want string) {
	if !cond {
		fmt.Println("FAIL "+tag+": got "+got+" want "+want)
		bad = true
		return
	}
	fmt.Println("ok", tag)
}

//logos:allow(correctness::unbounded_channel_op)
func slowChild(done chan string) error {
	done <- "child-done"
	note("child-end")
	return nil
}

func earlyReturn(ctx context.Context, done chan string) error {
	go group (ctx) {
		go slowChild(done)
	}
	note("after-group")
	return nil
}

func failQ() error {
	return errQFail
}

func earlyQ(ctx context.Context, done chan string) error {
	go group (ctx) {
		go slowChild(done)
		failQ()?
	}
	return nil
}

func earlyBreak(ctx context.Context, done chan string) error {
	for i := 0; i < 3; i++ {
		go group (ctx) {
			go slowChild(done)
			break
		}
	}
	note("after-break")
	return nil
}

func bodyPanic(ctx context.Context, done chan string) (err error) {
	defer func() {
		if r := recover(); r != nil {
			note("recovered")
			if r != "body-boom" {
				err = fmt.Errorf("recovered %v, want body-boom", r)
			}
		}
	}()
	go group (ctx) {
		go slowChild(done)
		panic("body-boom")
	}
	return nil
}

var errChildFailed = errors.New("child-failed")

func failSoon() error {
	return errChildFailed
}

func returnAfterFailure(ctx context.Context) error {
	go group (ctx) {
		go failSoon()
		return nil
	}
	return nil
}

//logos:allow(correctness::unbounded_channel_op)
func main() {
	ctx := context.Background()
	done := make(chan string, 1)
	if err := earlyReturn(ctx, done); err != nil {
		check("group-exit-early-return-joins", false, fmt.Sprint(err), "nil")
	} else {
		got := <-done
		check("group-exit-early-return-joins", got == "child-done" && order[len(order)-1] == "after-group", got, "child-done then after-group last")
	}
	done = make(chan string, 1)
	order = nil
	if err := earlyQ(ctx, done); err != errQFail {
		check("group-exit-error-propagates-like-q", false, fmt.Sprint(err), errQFail.Error())
	} else {
		got := <-done
		check("group-exit-error-propagates-like-q", got == "child-done", got, "child-done")
	}
	done = make(chan string, 1)
	mark := len(order)
	_ = earlyBreak(ctx, done)
	got := <-done
	childAt, afterAt := -1, -1
	for i := mark; i < len(order); i++ {
		if order[i] == "child-end" {
			childAt = i
		}
		if order[i] == "after-break" {
			afterAt = i
		}
	}
	check("group-exit-break-joins", got == "child-done" && childAt >= 0 && afterAt > childAt, got, "child-done with child-end before after-break")
	done = make(chan string, 1)
	if err := bodyPanic(ctx, done); err != nil {
		check("group-exit-panic-joins", false, fmt.Sprint(err), "nil")
	} else {
		got := <-done
		check("group-exit-panic-joins", got == "child-done", got, "child-done")
	}
	gotErr := returnAfterFailure(ctx)
	check("group-exit-child-failure-overrides-return", gotErr == errChildFailed, fmt.Sprint(gotErr), errChildFailed.Error())
	if bad {
		os.Exit(1)
	}
}
