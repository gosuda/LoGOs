// run -goexperiment logosarena
// run -goexperiment logosarena -arena=false
package main

import (
	"fmt"
	"logos/arena"
	"os"
	"runtime"
	"sync/atomic"
)

type box struct {
	v int
}

var ran int32

func wait() {
	for range 200 {
		runtime.GC()
		runtime.Gosched()
		if atomic.LoadInt32(&ran) == 1 {
			break
		}
	}
}

//go:noinline
func warmup() {
	p := new(box)
	runtime.SetFinalizer(p, func(*box) { atomic.StoreInt32(&ran, 1) })
	_ = p
}

//go:noinline
func placeFinalizer() {
	r := arena.Open()
	p := arena.New[box](r)
	p.v = 7
	runtime.SetFinalizer(p, func(*box) { atomic.StoreInt32(&ran, 1) })
	if p.v != 7 {
		panic("bad new")
	}
}

func main() {
	warmup()
	wait()
	atomic.StoreInt32(&ran, 0)
	placeFinalizer()
	wait()
	if atomic.LoadInt32(&ran) != 1 {
		fmt.Printf("FAIL escaping-finalizer-runs-after-region-exit: got %d want 1\n", atomic.LoadInt32(&ran))
		os.Exit(1)
	}
	fmt.Println("ok escaping-finalizer-runs-after-region-exit")
}
