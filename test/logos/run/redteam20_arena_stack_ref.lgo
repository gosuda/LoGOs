// run -goexperiment logosarena

package main


import (
	"fmt"
	"os"
	"runtime"
)

//go:noinline
func r20Grow(depth int) int {
	if depth <= 0 {
		return 0
	}
	var buf [1024]byte
	buf[0] = byte(depth)
	buf[1023] = byte(depth >> 8)
	return int(buf[0]) + int(buf[1023]) + r20Grow(depth-1)
}

//go:noinline
func r20Capture(n int) int {
	x := 13579
	s := make([]*int, 0, n)
	s = append(s, &x)
	r20Grow(64)
	runtime.GC()
	runtime.GC()
	v := *s[0]
	runtime.KeepAlive(s)
	runtime.KeepAlive(&x)
	return v
}

var r20Failed bool

func r20Check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		r20Failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	got := r20Capture(64)
	want := 13579
	r20Check("arena-stack-ref-kept", got == want, fmt.Sprint(got), fmt.Sprint(want))
	if r20Failed {
		os.Exit(1)
	}
}
