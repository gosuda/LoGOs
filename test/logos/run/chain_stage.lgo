func caseCancelFilterRange(ctx context.Context) {
	xs := []int{1, 2}
	never, inTime := blocked()
	short, cancel := shortly(ctx)
	_, err := xs.group(short, limit = 2).filter(x => {
		total := 0
		for v := range never {
			total += v
		}
		return total > x
	})
	cancel()
	check("cancel-wakes-filter-range", inTime() && timedOut(err), err, context.DeadlineExceeded)
}

func total(ctx context.Context, xs, ys []int) (int, error) {
	parts, err := xs.group(ctx, limit = 2).map(x => ys.group(ctx, limit = 3).map(y => x*y).sum()?)
	if err != nil {
		return 0, err
	}
	return parts.sum(), nil
}

func tryForm(ctx context.Context, xs []int) ([]int, error) {
	ys := xs.group(ctx, limit = 8).map(x => x * 2)?
	var zs []int
	zs = xs.group(ctx, limit = 8).map(x => x + 1)?
	return append(ys, zs...), nil
}

func noErrorResult(ctx context.Context, xs []int) int {
	ys, err := xs.group(ctx, limit = 2).map(x => x * 2)
	if err != nil {
		return -1
	}
	return ys.sum()
}

func caseForms(ctx context.Context) {
	xs := []int{1, 2, 3}
	n, err := total(ctx, xs, []int{1, 2, 3})
	if err != nil {
		check("nested-stage", false, err, 36)
	} else {
		check("nested-stage", err == nil && n == 36, n, 36)
	}
	got, err := tryForm(ctx, xs)
	if err != nil {
		check("try-form", false, err, []int{2, 4, 6, 2, 3, 4})
	} else {
		check("try-form", err == nil && slices.Equal(got, []int{2, 4, 6, 2, 3, 4}), got, []int{2, 4, 6, 2, 3, 4})
	}
	check("no-error-result", noErrorResult(ctx, xs) == 12, noErrorResult(ctx, xs), 12)
	tasks := []func() (int, error){
		func() (int, error) { return 1, nil },
		func() (int, error) { return 2, nil },
	}
	rs, err := tasks.group(ctx, limit = 2).map(t => t()?)
	if err != nil {
		check("thunks", false, err, []int{1, 2})
	} else {
		check("thunks", err == nil && slices.Equal(rs, []int{1, 2}), rs, []int{1, 2})
	}
	outs, err := xs.group(ctx, limit = 2).map(x => outcome{v: x, err: failErr(x, 2)})
	if err != nil {
		check("error-in-value", false, err, "three outcomes")
	} else {
		check("error-in-value", err == nil && len(outs) == 3 && outs[1].err != nil && outs[2].err == nil, outs, "three outcomes")
	}
	pre, err := xs.filter(x => x > 1).group(ctx, limit = 2).map(x => x * 2)
	if err != nil {
		check("after-chain", false, err, []int{4, 6})
	} else {
		check("after-chain", err == nil && slices.Equal(pre, []int{4, 6}), pre, []int{4, 6})
	}
	lim, err := xs.group(ctx, limit = len(xs) * 2).map(x => x)
	if err != nil {
		check("limit-expression", false, err, xs)
	} else {
		check("limit-expression", err == nil && slices.Equal(lim, xs), lim, xs)
	}
}

func run(f func(context.Context)) {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	f(ctx)
}

func main() {
	run(caseOrdered)
	run(caseTryError)
	run(caseFilter)
	run(caseReceivers)
	run(caseRange)
	run(caseBreak)
	run(caseReturn)
	run(caseFind)
	run(caseAny)
	run(caseTake)
	run(caseFirst)
	run(caseAll)
	run(caseTerminals)
	run(caseUnordered)
	run(caseLimits)
	run(caseZeroLimit)
	run(caseCancelRecv)
	run(caseCancelSend)
	run(caseCancelStmt)
	run(caseCancelPair)
	run(caseCancelDecl)
	run(caseCancelSelect)
	run(caseCancelRange)
	run(caseCancelFilterRecv)
	run(caseCancelFilterSend)
	run(caseCancelFilterRange)
	run(caseForms)
	if failed {
		os.Exit(1)
	}
}
