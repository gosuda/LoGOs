package main

import (
	"fmt"
	"iter"
	"os"
	"slices"
)

var failed bool

func check(name string, got, want []int) {
	if !slices.Equal(got, want) {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type pair struct {
	a, b int
}

func twice(n int) int { return 2 * n }

func seven() int { return 7 }

func Calls(n int) iter.Seq[int] {
	yield twice(n)
	yield seven()
	yield twice(twice(n)) // doubled twice
}

func Indexed(xs []int, m map[string]int) iter.Seq[int] {
	yield xs[1]
	yield len(m)
	yield len(xs[1:])
}

func Literals() iter.Seq[int] {
	yield pair{a: 3, b: 4}.b
	yield len(map[string]int{"k": 6})
	yield struct{ n int }{n: 8}.n
}

func Asserted(v any) iter.Seq[int] {
	yield v.(int)
	if v != nil { yield twice(v.(int)) }
}

func Pairs(xs []int) iter.Seq2[int, int] {
	for i := range xs {
		yield twice(i), xs[i]
	}
}

func Returned(xs []int) iter.Seq[int] {
	yield xs[0]
	if len(xs) > 1 {
		return slices.Values(xs[1:]) // the value is discarded
	}
	yield seven()
}

func ReturnedLiteral(n int) iter.Seq[int] {
	yield n
	return func(yield func(int) bool) {
		for i := range n {
			if !yield(i) {
				return
			}
		}
	}
}

func main() {
	check("call-values", slices.Collect(Calls(3)), []int{6, 7, 12})
	check("index-values", slices.Collect(Indexed([]int{1, 2, 3}, map[string]int{"k": 9})), []int{2, 1, 2})
	check("literal-values", slices.Collect(Literals()), []int{4, 1, 8})
	check("assertion-values", slices.Collect(Asserted(5)), []int{5, 10})
	var keys, vals []int
	for k, v := range Pairs([]int{4, 5}) {
		keys = append(keys, k)
		vals = append(vals, v)
	}
	check("pair-keys", keys, []int{0, 2})
	check("pair-values", vals, []int{4, 5})
	check("return-with-values-ends", slices.Collect(Returned([]int{1, 2})), []int{1})
	check("return-not-reached", slices.Collect(Returned([]int{1})), []int{1, 7})
	check("return-of-literal-ends", slices.Collect(ReturnedLiteral(3)), []int{3})
	if failed {
		os.Exit(1)
	}
}
