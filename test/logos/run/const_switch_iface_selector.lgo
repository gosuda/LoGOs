// run

package main

import (
	"fmt"
	"os"
	"unsafe"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Word struct{ S string }

func (w Word) M() string { return "m:" + w.S }

func pick[T any](items []T, i int) string {
	const switch T {
	case interface{ M() string }:
		return items[i].M()
	}
	return "after"
}

type LayoutSmall struct{ X int32 }

func (s LayoutSmall) M() string { return "m" }

func layoutInIfaceCase(v LayoutSmall) (uintptr, string, int32) {
	const switch LayoutSmall {
	case interface{ M() string }:
		return unsafe.Sizeof(v), v.M(), v.X
	}
	return 0, "after", -1
}

func main() {
	ws := []Word{{S: "a"}, {S: "b"}}
	check("pick-word", pick(ws, 1) == "m:b", pick(ws, 1), "m:b")
	check("pick-miss", pick([]int{1, 2}, 0) == "after", pick([]int{1, 2}, 0), "after")
	sz, m, x := layoutInIfaceCase(LayoutSmall{X: 7})
	check("layout-size", sz == 4, sz, 4)
	check("layout-method", m == "m", m, "m")
	check("layout-field", x == 7, x, 7)
	if failed {
		os.Exit(1)
	}
}
