// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type S struct{ t (int, int) }

func pass(t (int, int)) (int, int) {
	return ((t))
}

func field(s S) (int, int) {
	return ((s.t))
}

func main() {
	t := (1, 2)
	u, v := (t)
	check("paren-unpack-splits-pair", u == 1 && v == 2, fmt.Sprint(u, v), "1 2")
	p, q := ((t))
	check("double-paren-unpack-splits-pair", p == 1 && q == 2, fmt.Sprint(p, q), "1 2")
	var m, n int
	m, n = (t)
	check("paren-assign-splits-pair", m == 1 && n == 2, fmt.Sprint(m, n), "1 2")
	m, n = ((t))
	check("double-paren-assign-splits-pair", m == 1 && n == 2, fmt.Sprint(m, n), "1 2")
	a, b := pass(t)
	check("paren-passthrough-keeps-pair", a == 1 && b == 2, fmt.Sprint(a, b), "1 2")
	s := S{t: (3, 4)}
	c, d := (s.t)
	check("paren-unpack-splits-field", c == 3 && d == 4, fmt.Sprint(c, d), "3 4")
	e, f := ((s.t))
	check("double-paren-unpack-splits-field", e == 3 && f == 4, fmt.Sprint(e, f), "3 4")
	m, n = ((s.t))
	check("double-paren-assign-splits-field", m == 3 && n == 4, fmt.Sprint(m, n), "3 4")
	g, h := field(s)
	check("paren-return-splits-field", g == 3 && h == 4, fmt.Sprint(g, h), "3 4")
	if failed {
		os.Exit(1)
	}
}
