func checkI32Reduce() {
	var a [8]int32
	for i := range a {
		a[i] = int32(i*11 - 13)
	}
	var wantSum, wantMin, wantMax int32
	wantMin = a[0]
	wantMax = a[0]
	for _, v := range a {
		wantSum += v
		if v < wantMin {
			wantMin = v
		}
		if v > wantMax {
			wantMax = v
		}
	}
	if a.sum() != wantSum {
		panic("i32 sum")
	}
	if a.min() != wantMin {
		panic("i32 min")
	}
	if a.max() != wantMax {
		panic("i32 max")
	}
	var c, d [8]int32
	for i := range c {
		c[i] = int32(i + 1)
		d[i] = int32(2*i + 1)
	}
	var wantDot int32
	for i := range c {
		wantDot += c[i] * d[i]
	}
	if c.dot(d) != wantDot {
		panic("i32 dot")
	}
}

func checkF32Reduce() {
	var a, b [8]float32
	for i := range a {
		a[i] = float32(i+1) * 0.5
		b[i] = float32(2*i + 1)
	}
	wantMin := a[0]
	wantMax := a[0]
	for _, v := range a {
		if v < wantMin {
			wantMin = v
		}
		if v > wantMax {
			wantMax = v
		}
	}
	if a.min() != wantMin {
		panic("f32 min")
	}
	if a.max() != wantMax {
		panic("f32 max")
	}
	lo := (a[0]*b[0] + a[1]*b[1]) + (a[2]*b[2] + a[3]*b[3])
	hi := (a[4]*b[4] + a[5]*b[5]) + (a[6]*b[6] + a[7]*b[7])
	if a.dot(b) != lo+hi {
		panic("f32 dot")
	}
}

func checkF64Wider() {
	var a, b [8]float64
	for i := range a {
		a[i] = float64(i+1) * 1.5
		b[i] = float64(2*i + 1)
	}
	add := a + b
	var wantSum, wantMin, wantMax float64
	wantMin = a[0]
	wantMax = a[0]
	for i := range a {
		if add[i] != a[i]+b[i] {
			panic("f64w add")
		}
		wantSum += a[i]
		if a[i] < wantMin {
			wantMin = a[i]
		}
		if a[i] > wantMax {
			wantMax = a[i]
		}
	}
	if a.sum() != wantSum {
		panic("f64w sum")
	}
	if a.min() != wantMin {
		panic("f64w min")
	}
	if a.max() != wantMax {
		panic("f64w max")
	}
	lo := (a[0]*b[0] + a[1]*b[1]) + (a[2]*b[2] + a[3]*b[3])
	hi := (a[4]*b[4] + a[5]*b[5]) + (a[6]*b[6] + a[7]*b[7])
	if a.dot(b) != lo+hi {
		panic("f64w dot")
	}
}

func main() {
	checkI8Add()
	checkI8Bit()
	checkI8Reduce()
	checkI16Add()
	checkI16Bit()
	checkI16Reduce()
	checkI32Add()
	checkI32Bit()
	checkI32Reduce()
	checkF32Reduce()
	checkF64Wider()
	fmt.Println("simd smallint vec ok")
}
