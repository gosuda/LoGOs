func checkI32Add() {
	var a, b [8]int32
	for i := range a {
		a[i] = int32(i*11 - 13)
		b[i] = int32(i%6 + 1)
	}
	add := a + b
	sub := a - b
	mul := a * b
	quo := a / b
	for i := range a {
		if add[i] != a[i]+b[i] {
			panic("i32 add")
		}
		if sub[i] != a[i]-b[i] {
			panic("i32 sub")
		}
		if mul[i] != a[i]*b[i] {
			panic("i32 mul")
		}
		if quo[i] != a[i]/b[i] {
			panic("i32 div")
		}
	}
}

func checkI32Bit() {
	var a, b [8]int32
	for i := range a {
		a[i] = int32(i*11 - 13)
		b[i] = int32(i%6 + 1)
	}
	and := a & b
	or := a | b
	xor := a ^ b
	for i := range a {
		if and[i] != a[i]&b[i] {
			panic("i32 and")
		}
		if or[i] != a[i]|b[i] {
			panic("i32 or")
		}
		if xor[i] != a[i]^b[i] {
			panic("i32 xor")
