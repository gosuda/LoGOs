// run -goexperiment simd

package main

import "fmt"

func checkI8Add() {
	var a, b [16]int8
	for i := range a {
		a[i] = int8(i*3 - 5)
		b[i] = int8(i%4 + 1)
	}
	add := a + b
	sub := a - b
	mul := a * b
	quo := a / b
	for i := range a {
		if add[i] != a[i]+b[i] {
			panic("i8 add")
		}
		if sub[i] != a[i]-b[i] {
			panic("i8 sub")
		}
		if mul[i] != a[i]*b[i] {
			panic("i8 mul")
		}
		if quo[i] != a[i]/b[i] {
			panic("i8 div")
		}
	}
}

func checkI8Bit() {
	var a, b [16]int8
	for i := range a {
		a[i] = int8(i*3 - 5)
		b[i] = int8(i%4 + 1)
	}
	and := a & b
	or := a | b
	xor := a ^ b
	for i := range a {
		if and[i] != a[i]&b[i] {
			panic("i8 and")
		}
		if or[i] != a[i]|b[i] {
			panic("i8 or")
		}
		if xor[i] != a[i]^b[i] {
			panic("i8 xor")
		}
	}
}

func checkI8Reduce() {
	var a [16]int8
	for i := range a {
		a[i] = int8(i*3 - 5)
	}
	var wantSum, wantMin, wantMax int8
	wantMin = a[0]
	wantMax = a[0]
	for _, v := range a {
		wantSum += v
		if v < wantMin {
			wantMin = v
		}
		if v > wantMax {
			wantMax = v
		}
	}
	if a.sum() != wantSum {
		panic("i8 sum")
	}
	if a.min() != wantMin {
		panic("i8 min")
	}
	if a.max() != wantMax {
		panic("i8 max")
	}
	var c, d [16]int8
	for i := range c {
		c[i] = int8(i % 3)
		d[i] = int8((i + 1) % 2)
	}
	var wantDot int8
	for i := range c {
		wantDot += c[i] * d[i]
	}
	if c.dot(d) != wantDot {
		panic("i8 dot")
	}
}

