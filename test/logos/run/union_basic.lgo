// run

package main

import "fmt"

type NumOrStr interface {
	int | string
}

type Point struct {
	X int
	Y int
}

func (p Point) Area() int { return p.X * p.Y }

type Named struct {
	Name string
}

func (n Named) Area() int { return len(n.Name) }

type Shape interface {
	Point | Named
	Area() int
}

func describe(u NumOrStr) string {
	return switch u.(type) {
	case int => "int"
	case string => "str"
	case nil => "nil"
	}
}

func word(n int) string {
	return switch n {
	case 1 => "one"
	default => "many"
	}
}

type Greeter interface {
	Greet() string
}

type Person struct : Greeter {
	Name string
}

func (p Person) Greet() string { return "hi " + p.Name }

func main() {
	var u NumOrStr = 7
	fmt.Println(describe(u))
	u = "seven"
	fmt.Println(describe(u))
	var z NumOrStr
	fmt.Println(describe(z))
	fmt.Println(word(1))
	fmt.Println(word(9))
	p := Person{Name: "ada"}
	var g Greeter = &p
	fmt.Println(g.Greet())
	var s Shape = Point{X: 3, Y: 4}
	fmt.Println(s.Area())
}
