// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type NumOrStr interface {
	int | string
}

type Point struct {
	X int
	Y int
}

func (p Point) Area() int { return p.X * p.Y }

type Named struct {
	Name string
}

func (n Named) Area() int { return len(n.Name) }

type Shape interface {
	Point | Named
	Area() int
}

func describe(u NumOrStr) string {
	return switch u.(type) {
	case int => "int"
	case string => "str"
	case nil => "nil"
	}
}

func word(n int) string {
	return switch n {
	case 1 => "one"
	default => "many"
	}
}

type Greeter interface {
	Greet() string
}

type Person struct : Greeter {
	Name string
}

func (p Person) Greet() string { return "hi " + p.Name }

func main() {
	var u NumOrStr = 7
	check("type-switch-names-int-member", describe(u) == "int", describe(u), "int")
	u = "seven"
	check("type-switch-names-string-member", describe(u) == "str", describe(u), "str")
	var z NumOrStr
	check("type-switch-names-nil-union", describe(z) == "nil", describe(z), "nil")
	check("expr-switch-matches-value", word(1) == "one", word(1), "one")
	check("expr-switch-falls-to-default", word(9) == "many", word(9), "many")
	p := Person{Name: "ada"}
	var g Greeter = &p
	check("union-member-dispatches-method", g.Greet() == "hi ada", g.Greet(), "hi ada")
	var s Shape = Point{X: 3, Y: 4}
	check("shape-union-dispatches-area", s.Area() == 12, s.Area(), 12)
	if failed {
		os.Exit(1)
	}
}
