package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, got, want any) {
	if got != want {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func number(t (int, string)) int {
	n, _ := t
	return n
}

func label(t (int, string)) string {
	_, s := t
	return s
}

func variableArm(v int) (int, string) {
	t := (v, "named")
	r := switch v {
	case 7 => t
	default => (0, "other")
	}
	return r
}

func variableDefault(v int) (int, string) {
	t := (v, "named")
	r := switch v {
	case 7 => (7, "literal")
	default => t
	}
	return r
}

func nested(v int) int {
	t := (v, "named")
	r := switch v {
	case 7 => t
	default => (0, "other")
	}
	return number(r)
}

func main() {
	n, s := variableArm(7)
	check("variable-arm-taken", fmt.Sprintf("%d %s", n, s), "7 named")
	n, s = variableArm(3)
	check("variable-arm-skipped", fmt.Sprintf("%d %s", n, s), "0 other")
	n, s = variableDefault(7)
	check("variable-default-skipped", fmt.Sprintf("%d %s", n, s), "7 literal")
	n, s = variableDefault(3)
	check("variable-default-taken", fmt.Sprintf("%d %s", n, s), "3 named")
	check("variable-arm-value", nested(7), 7)
	check("variable-arm-label", label((1, "x")), "x")
	if failed {
		os.Exit(1)
	}
}
