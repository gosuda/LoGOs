// run
package main

import (
	"fmt"
	"testing"

	"logos/rt"
	"os"
)

type Child struct {
	N    int
	Note string
}

type Config struct {
	Name   string
	N      int
	Tags   []string
	Labels map[string]string
	Child  *Child
	Other  *Child
}

func main() {
	failed := false
	check := func(name string, ok bool) {
		if !ok {
			fmt.Printf("FAIL %s\n", name)
			failed = true
			return
		}
		fmt.Printf("ok %s\n", name)
	}
	cfg := Config{
		Name:   "orig",
		N:      7,
		Tags:   []string{"a", "b"},
		Labels: map[string]string{"k": "v"},
		Child:  &Child{N: 1, Note: "c1"},
		Other:  &Child{N: 2, Note: "c2"},
	}
	f := rt.Freeze(&cfg)
	check("freeze-copies-scalar-fields", f.Name == "orig" && f.N == 7)
	check("freeze-copies-slice-elements", len(f.Tags) == 2 && f.Tags[0] == "a" && f.Tags[1] == "b")
	lk := f.Labels["k"]
	check("freeze-copies-map-entries", len(f.Labels) == 1 && (lk ?? "!") == "v")
	check("freeze-copies-pointed-to-structs", f.Child.N == 1 && f.Child.Note == "c1" && f.Other.N == 2)
	cfg.Name = "changed"
	cfg.N = 99
	cfg.Tags[0] = "CHANGED"
	cfg.Tags[1] = "CHANGED"
	cfg.Labels["k"] = "CHANGED"
	cfg.Child.N = 100
	cfg.Child.Note = "CHANGED"
	cfg.Other.N = 200
	sk := f.Labels["k"]
	check("freeze-snapshot-immune-to-source-mutation", f.Name == "orig" && f.N == 7 && f.Tags[0] == "a" && f.Tags[1] == "b" && (sk ?? "!") == "v" && f.Child.N == 1 && f.Child.Note == "c1" && f.Other.N == 2)
	allocs := testing.AllocsPerRun(100, func() {
		_ = rt.Freeze(&cfg)
	})
	check("freeze-deep-copy-allocates", allocs >= 1)
	if failed {
		os.Exit(1)
	}
}
