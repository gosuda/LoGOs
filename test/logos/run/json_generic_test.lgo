// run

package jsongeneric


import (
	"bytes"
	"encoding/json"
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"runtime"
	"strings"
	"testing"
)

type ServiceA struct {
	Port int64  `json:"port"`
	Host string `json:"host"`
}

type ServiceB struct {
	Host string `json:"host"`
	Port int64  `json:"port"`
}

type ServiceAMirror struct {
	Port  int64  `json:"port"`
	Host  string `json:"host"`
	NoGen any    `json:"-"`
}

type ServiceBMirror struct {
	Host  string `json:"host"`
	Port  int64  `json:"port"`
	NoGen any    `json:"-"`
}

type Container[T any] struct {
	Item T `json:"item"`
}

type ContainerMirror[T any] struct {
	Item  T   `json:"item"`
	NoGen any `json:"-"`
}

type Registry struct {
	A1   Container[ServiceA] `json:"a1"`
	B    Container[ServiceB] `json:"b"`
	A2   Container[ServiceA] `json:"a2"`
	Anon Container[struct {
		Count int64 `json:"count"`
	}] `json:"anon"`
}

type RegistryMirror struct {
	A1   ContainerMirror[ServiceAMirror] `json:"a1"`
	B    ContainerMirror[ServiceBMirror] `json:"b"`
	A2   ContainerMirror[ServiceAMirror] `json:"a2"`
	Anon ContainerMirror[struct {
		Count int64 `json:"count"`
	}] `json:"anon"`
	NoGen any `json:"-"`
}

func TestGenericParityWithOracle(t *testing.T) {
	instA := Container[ServiceA]{Item: ServiceA{Port: 8080, Host: "srv-a"}}
	gotA, err := json.Marshal(instA)
	if err != nil {
		panic(err)
	}
	wantA, err := json.Marshal(ContainerMirror[ServiceAMirror]{Item: ServiceAMirror{Port: 8080, Host: "srv-a"}})
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(gotA, wantA) {
		t.Fatalf("Container[ServiceA] got %s, want %s", gotA, wantA)
		return
	}

	instB := Container[ServiceB]{Item: ServiceB{Host: "srv-b", Port: 9090}}
	gotB, err := json.Marshal(instB)
	if err != nil {
		panic(err)
	}
	wantB, err := json.Marshal(ContainerMirror[ServiceBMirror]{Item: ServiceBMirror{Host: "srv-b", Port: 9090}})
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(gotB, wantB) {
		t.Fatalf("Container[ServiceB] got %s, want %s", gotB, wantB)
		return
	}
}

func TestGenericNonSpellableFallback(t *testing.T) {
	anon := Container[struct {
		Count int64 `json:"count"`
	}]{
		Item: struct {
			Count int64 `json:"count"`
		}{Count: 42},
	}
	got, err := json.Marshal(anon)
	if err != nil {
		panic(err)
	}
	oracle, err := json.Marshal(ContainerMirror[struct {
		Count int64 `json:"count"`
	}]{
		Item: struct {
			Count int64 `json:"count"`
		}{Count: 42},
	})
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(got, oracle) {
		t.Fatalf("non-spellable got %s, want reflective oracle %s", got, oracle)
		return
	}
}

const probeSource = `package main

import (
	"encoding/json"
	"fmt"
)

type ServiceA struct {
	Port int64  ` + "`json:\"port\"`" + `
	Host string ` + "`json:\"host\"`" + `
}

type ServiceB struct {
	Host string ` + "`json:\"host\"`" + `
	Port int64  ` + "`json:\"port\"`" + `
}

type Container[T any] struct {
	Item T ` + "`json:\"item\"`" + `
}

type Registry struct {
	A1   Container[ServiceA] ` + "`json:\"a1\"`" + `
	B    Container[ServiceB] ` + "`json:\"b\"`" + `
	A2   Container[ServiceA] ` + "`json:\"a2\"`" + `
	Anon Container[struct {
		Count int64 ` + "`json:\"count\"`" + `
	}] ` + "`json:\"anon\"`" + `
}

func main() {
	r := Registry{
		A1: Container[ServiceA]{Item: ServiceA{Port: 1, Host: "h1"}},
		B:  Container[ServiceB]{Item: ServiceB{Host: "h2", Port: 2}},
		A2: Container[ServiceA]{Item: ServiceA{Port: 3, Host: "h3"}},
	}
	b, err := json.Marshal(r)
	if err != nil {
		panic(err)
	}
	fmt.Println(string(b))
}
`

func parseNMSymbols(out []byte) []string {
	seen := make(map[string]bool)
	var syms []string
	for _, line := range strings.Split(string(out), "\n") {
		f := strings.Fields(line)
		if len(f) >= 3 && strings.Contains(f[len(f)-1], "_logos_h") {
			name := f[len(f)-1]
			if strings.Contains(name, ".deferwrap") || strings.Contains(name, ".abi") {
				continue
			}
			if _, ok := seen[name]; !ok {
				seen[name] = true
				syms = append(syms, name)
			}
		}
	}
	return syms
}

//logos:allow(complexity::cognitive_overflow)
func findHelperSymbols() ([]string, error) {
	binDir := filepath.Join(runtime.GOROOT(), "bin")
	goBin := filepath.Join(binDir, "go")
	logosBin := filepath.Join(binDir, "logos")
	if runtime.GOOS == "windows" {
		goBin += ".exe"
		logosBin += ".exe"
	}
	if _, err := os.Stat(goBin); err != nil {
		if p, err := exec.LookPath("go"); err == nil {
			goBin = p
		}
	}
	if _, err := os.Stat(logosBin); err != nil {
		if p, err := exec.LookPath("logos"); err == nil {
			logosBin = p
		}
	}

	if exe, err := os.Executable(); err == nil {
		if out, err := exec.Command(goBin, "tool", "nm", exe).CombinedOutput(); err == nil {
			syms := parseNMSymbols(out)
			if len(syms) >= 4 {
				return syms, nil
			}
		}
	}

	dir, err := os.MkdirTemp("", "jsongenericnm")
	if err != nil {
		return nil, err
	}
	defer os.RemoveAll(dir)
	if err := os.WriteFile(filepath.Join(dir, "go.mod"), []byte("module probe\n\ngo 1.27\n"), 0644); err != nil {
		return nil, err
	}
	if err := os.WriteFile(filepath.Join(dir, "main.lgo"), []byte(probeSource), 0644); err != nil {
		return nil, err
	}
	probeExe := filepath.Join(dir, "probe.exe")
	cmd := exec.Command(logosBin, "build", "-o", probeExe, ".")
	cmd.Dir = dir
	if out, err := cmd.CombinedOutput(); err != nil {
		return nil, fmt.Errorf("probe build failed: %w\n%s", err, out)
	}
	nmOut, err := exec.Command(goBin, "tool", "nm", probeExe).CombinedOutput()
	if err != nil {
		return nil, fmt.Errorf("probe nm failed: %w\n%s", err, nmOut)
	}
	return parseNMSymbols(nmOut), nil
}

func TestGenericHelperSetsNM(t *testing.T) {
	r := Registry{
		A1: Container[ServiceA]{Item: ServiceA{Port: 10, Host: "host1"}},
		B:  Container[ServiceB]{Item: ServiceB{Host: "host2", Port: 20}},
		A2: Container[ServiceA]{Item: ServiceA{Port: 30, Host: "host3"}},
	}
	b, err := json.Marshal(r)
	if err != nil {
		panic(err)
	}
	if len(b) == 0 {
		t.Fatal("empty marshal output")
		return
	}

	syms, err := findHelperSymbols()
	if err != nil {
		panic(err)
	}

	if len(syms) != 5 {
		t.Fatalf("expected exactly 5 helper symbols (proving distinct instantiations and memo reuse), got %d: %v", len(syms), syms)
		return
	}

	for _, sym := range syms {
		if !strings.Contains(sym, "_logos_h") {
			t.Fatalf("unexpected helper symbol name: %s", sym)
			return
		}
	}
}
