// run

package jsongeneric


import (
	"bytes"
	"encoding/json"
	"runtime"
	"slices"
	"strings"
	"testing"
)

type ServiceA struct {
	Port int64  `json:"port"`
	Host string `json:"host"`
}

type ServiceB struct {
	Host string `json:"host"`
	Port int64  `json:"port"`
}

type ServiceAMirror struct {
	Port  int64  `json:"port"`
	Host  string `json:"host"`
	NoGen any    `json:"-"`
}

type ServiceBMirror struct {
	Host  string `json:"host"`
	Port  int64  `json:"port"`
	NoGen any    `json:"-"`
}

type Container[T any] struct {
	Item T `json:"item"`
}

type ContainerMirror[T any] struct {
	Item  T   `json:"item"`
	NoGen any `json:"-"`
}

type Registry struct {
	A1   Container[ServiceA] `json:"a1"`
	B    Container[ServiceB] `json:"b"`
	A2   Container[ServiceA] `json:"a2"`
	Anon Container[struct {
		Count int64 `json:"count"`
	}] `json:"anon"`
}

type RegistryMirror struct {
	A1   ContainerMirror[ServiceAMirror] `json:"a1"`
	B    ContainerMirror[ServiceBMirror] `json:"b"`
	A2   ContainerMirror[ServiceAMirror] `json:"a2"`
	Anon ContainerMirror[struct {
		Count int64 `json:"count"`
	}] `json:"anon"`
	NoGen any `json:"-"`
}

func TestGenericParityWithOracle(t *testing.T) {
	instA := Container[ServiceA]{Item: ServiceA{Port: 8080, Host: "srv-a"}}
	gotA, err := json.Marshal(instA)
	if err != nil {
		panic(err)
	}
	wantA, err := json.Marshal(ContainerMirror[ServiceAMirror]{Item: ServiceAMirror{Port: 8080, Host: "srv-a"}})
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(gotA, wantA) {
		t.Fatalf("Container[ServiceA] got %s, want %s", gotA, wantA)
		return
	}

	instB := Container[ServiceB]{Item: ServiceB{Host: "srv-b", Port: 9090}}
	gotB, err := json.Marshal(instB)
	if err != nil {
		panic(err)
	}
	wantB, err := json.Marshal(ContainerMirror[ServiceBMirror]{Item: ServiceBMirror{Host: "srv-b", Port: 9090}})
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(gotB, wantB) {
		t.Fatalf("Container[ServiceB] got %s, want %s", gotB, wantB)
		return
	}
}

func TestGenericNonSpellableFallback(t *testing.T) {
	anon := Container[struct {
		Count int64 `json:"count"`
	}]{
		Item: struct {
			Count int64 `json:"count"`
		}{Count: 42},
	}
	got, err := json.Marshal(anon)
	if err != nil {
		panic(err)
	}
	oracle, err := json.Marshal(ContainerMirror[struct {
		Count int64 `json:"count"`
	}]{
		Item: struct {
			Count int64 `json:"count"`
		}{Count: 42},
	})
	if err != nil {
		panic(err)
	}
	if !bytes.Equal(got, oracle) {
		t.Fatalf("non-spellable got %s, want reflective oracle %s", got, oracle)
		return
	}
}

type Probe struct{ N int64 }

var chains [][]uintptr

func (p Probe) MarshalJSON() ([]byte, error) {
	self, _, _, _ := runtime.Caller(0)
	prefix := strings.TrimSuffix(runtime.FuncForPC(self).Name(), "Probe.MarshalJSON")
	pcs := make([]uintptr, 64)
	frames := runtime.CallersFrames(pcs[:runtime.Callers(2, pcs)])
	var chain []uintptr
	for {
		fr, more := frames.Next()
		if strings.HasPrefix(fr.Function, prefix) {
			chain = append(chain, fr.Entry)
		}
		if !more {
			break
		}
	}
	chains = append(chains, chain)
	return []byte("1"), nil
}

type HelperA struct {
	Port int64 `json:"port"`
	P    Probe `json:"p"`
}

type HelperB struct {
	Host string `json:"host"`
	P    Probe  `json:"p"`
}

type HelperRegistry struct {
	A1 Container[HelperA] `json:"a1"`
	B  Container[HelperB] `json:"b"`
	A2 Container[HelperA] `json:"a2"`
}

func TestGenericHelperIdentity(t *testing.T) {
	chains = nil
	_, err := json.Marshal(HelperRegistry{})
	if err != nil {
		panic(err)
	}
	if len(chains) != 3 {
		t.Fatalf("probe ran %d times, want 3", len(chains))
		return
	}
	a1, b, a2 := chains[0], chains[1], chains[2]
	if !slices.Equal(a1, a2) {
		t.Fatalf("one instantiation reached two helper chains %v and %v", a1, a2)
		return
	}
	if len(a1) != len(b) {
		t.Fatalf("chains of different depth %d and %d", len(a1), len(b))
		return
	}
	differ := 0
	for i := range a1 {
		if a1[i] != b[i] {
			differ++
		}
	}
	if differ == 0 {
		t.Fatalf("Container[HelperA] and Container[HelperB] share every helper: %v", a1)
		return
	}
}
