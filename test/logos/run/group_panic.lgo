// run

package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"strings"

	"logos/rt"
)

var bad bool

func check(tag string, cond bool, got, want string) {
	if !cond {
		fmt.Println("FAIL "+tag+": got "+got+" want "+want)
		bad = true
		return
	}
	fmt.Println("ok", tag)
}

func run(ctx context.Context, ch chan int) error {
	go group (ctx) {
		go {
			<-ch
		}
		go {
			panic("boom")
		}
	}
	return nil
}

func main() {
	err := run(context.Background(), make(chan int))
	pe, ok := errors.AsType[*rt.PanicError](err)
	check("group-panic-becomes-panicerror", ok, fmt.Sprintf("%T", err), "*rt.PanicError")
	if !ok {
		os.Exit(1)
	}
	check("group-panic-value", pe.Value == "boom", fmt.Sprint(pe.Value), "boom")
	stack := string(pe.Stack)
	check("group-panic-stack", strings.Contains(stack, "goroutine") && strings.Contains(stack, "group_panic.lgo"), fmt.Sprintf("%d bytes", len(stack)), "stack naming goroutine and group_panic.lgo")
	check("group-panic-text", strings.Contains(pe.Error(), "boom"), pe.Error(), "text containing boom")
	if bad {
		os.Exit(1)
	}
}
