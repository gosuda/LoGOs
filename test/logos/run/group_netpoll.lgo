// run -t 60

package main

import (
	"context"
	"errors"
	"fmt"
	"net"
	"os"
	"slices"
	"time"
)

var errBoom = errors.New("boom")

var bad bool

var errWins int

var timeoutHits int

var imminent = make(chan struct{}, 1)

var failedAt, wokeAt time.Time

const (
	specBound = 100 * time.Millisecond
	rounds    = 20
)

var holdFor time.Duration

func check(tag string, cond bool, got, want string) {
	if !cond {
		fmt.Println("FAIL "+tag+": got "+got+" want "+want)
		bad = true
		return
	}
	fmt.Println("ok", tag)
}
//logos:allow(correctness::unbounded_channel_op)
func readChild(conn net.Conn, res chan string) error {
	imminent <- struct{}{}
	_, err := conn.Read(make([]byte, 1))
	wokeAt = time.Now()
	if !os.IsTimeout(err) {
		res <- "not-timeout"
		return err
	}
	res <- "timeout"
	return nil
}

//logos:allow(correctness::unbounded_channel_op)
func sibling() error {
	<-imminent
	time.Sleep(holdFor)
	failedAt = time.Now()
	return errBoom
}

func run(conn net.Conn, res chan string) error {
	go group (context.Background()) {
		go readChild(conn, res)
		go sibling()
	}
	return nil
}

//logos:allow(correctness::unbounded_channel_op)
func oneRound(ln net.Listener) time.Duration {
	cli, err := net.Dial("tcp", ln.Addr().String())
	if err != nil {
		fmt.Println("FAIL group-netpoll-setup: got", err, "want dial")
		os.Exit(1)
	}
//logos:allow(slop::discarded_error)
	defer cli.Close()
	srv, err := ln.Accept()
	if err != nil {
		fmt.Println("FAIL group-netpoll-setup: got", err, "want accept")
		os.Exit(1)
	}
//logos:allow(slop::discarded_error)
	defer srv.Close()
	res := make(chan string, 1)
	if run(srv, res) == errBoom {
		errWins++
	}
	if <-res == "timeout" {
		timeoutHits++
	}
	return wokeAt.Sub(failedAt)
}

//logos:allow(correctness::unbounded_channel_op)
func main() {
	ln, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		fmt.Println("FAIL group-netpoll-setup: got", err, "want listener")
		os.Exit(1)
	}
//logos:allow(slop::discarded_error)
	defer ln.Close()
	watch := time.AfterFunc(30*time.Second, func() {
		fmt.Println("FAIL group-netpoll-cancel-deadline: group with a parked network read did not finish within 30s")
		os.Exit(1)
	})
	defer watch.Stop()
	var wakes []time.Duration
	holdFor = 5 * specBound
	wakes = append(wakes, oneRound(ln))
	holdFor = 20 * time.Millisecond
	for range rounds - 1 {
		wakes = append(wakes, oneRound(ln))
	}
	wantAll := fmt.Sprintf("%d of %d", rounds, rounds)
	check("group-netpoll-first-error-wins", errWins == rounds, fmt.Sprint(errWins), wantAll)
	check("group-netpoll-cancel-wakes-with-timeout", timeoutHits == rounds, fmt.Sprint(timeoutHits), wantAll)
	spread := fmt.Sprintf("min %v max %v of %d rounds", slices.Min(wakes), slices.Max(wakes), len(wakes))
	check("group-netpoll-read-held-until-cancel", slices.Min(wakes) >= 0, spread, "no read returned before the cancel, the first round held 5x the bound")
	check("group-netpoll-wake-prompt", slices.Max(wakes) <= specBound, spread, "every wake within the 100ms SPEC bound")
	if bad {
		os.Exit(1)
	}
}
