// run

package main

import (
	"context"
	"errors"
	"fmt"
	"net"
	"os"
	"time"
)

var errBoom = errors.New("boom")

var bad bool

func check(tag string, cond bool, got, want string) {
	if !cond {
		fmt.Println("FAIL "+tag+": got "+got+" want "+want)
		bad = true
		return
	}
	fmt.Println("ok", tag)
}
//logos:allow(correctness::unbounded_channel_op)
func readChild(conn net.Conn, res chan string) error {
	_, err := conn.Read(make([]byte, 1))
	if !os.IsTimeout(err) {
		res <- "not-timeout"
		return err
	}
	res <- "timeout"
	return nil
}

func sibling() error {
	return errBoom
}

func run(conn net.Conn, res chan string) error {
	go group (context.Background()) {
		go readChild(conn, res)
		go sibling()
	}
	return nil
}

//logos:allow(correctness::unbounded_channel_op)
func main() {
	ln, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		fmt.Println("FAIL group-netpoll-setup: got", err, "want listener")
		os.Exit(1)
	}
	defer ln.Close()
	cli, err := net.Dial("tcp", ln.Addr().String())
	if err != nil {
		fmt.Println("FAIL group-netpoll-setup: got", err, "want dial")
		os.Exit(1)
	}
	defer cli.Close()
	srv, err := ln.Accept()
	if err != nil {
		fmt.Println("FAIL group-netpoll-setup: got", err, "want accept")
		os.Exit(1)
	}
	defer srv.Close()
	res := make(chan string, 1)
	start := time.Now()
	gotErr := run(srv, res)
	check("group-netpoll-first-error-wins", gotErr == errBoom, fmt.Sprint(gotErr), errBoom.Error())
	got := <-res
	check("group-netpoll-cancel-wakes-with-timeout", got == "timeout", got, "timeout")
	took := time.Since(start)
	check("group-netpoll-wake-prompt", took < 5*time.Second, took.String(), "under 5s for the 100ms SPEC bound")
	if bad {
		os.Exit(1)
	}
}
