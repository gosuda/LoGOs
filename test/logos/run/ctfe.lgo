// run
package main

import (
	"fmt"
	"os"
)

const func Fib(n int) int {
	a, b := 0, 1
	for i := 0; i < n; i++ {
		a, b = b, a+b
	}
	return a
}

const fib20 = Fib(20)

const primes = []int{2, 3, 5}

const func Sum(xs []int) int {
	total := 0
	for _, v := range xs {
		total += v
	}
	return total
}

const total = Sum(primes)

type Point struct{ X, Y int }

const origin = Point{X: 3, Y: 4}

const func Norm(p Point) int {
	return p.X*p.X + p.Y*p.Y
}

const norm25 = Norm(origin)

const scores = map[string]int{"a": 1, "b": 2}

const presentIdx = scores["a"] ?? -1

const missingIdx = scores["z"] ?? -7
const dims = [2]string{"x", "y"}

const (
	grouped = []int{9, 8}
	glen = len(grouped)
)

var afterGrouped = grouped[0]

var failed bool

func check(name, got, want string) {
	if got != want {
		fmt.Println("FAIL", name, "got", got, "want", want)
		failed = true
		return
	}
	fmt.Println("ok", name)
}

func main() {
	check("fib20-matches-runtime", fmt.Sprint(Fib(20)), fmt.Sprint(fib20))
	check("fib20-is-6765", fmt.Sprint(fib20), "6765")
	check("primes-match-hand", fmt.Sprint(primes[0], primes[1], primes[2], len(primes)), "2 3 5 3")
	check("sum-matches-runtime", fmt.Sprint(Sum([]int{2, 3, 5})), fmt.Sprint(total))
	check("norm-matches-runtime", fmt.Sprint(Norm(Point{X: 3, Y: 4})), fmt.Sprint(norm25))
	check("const-coalesce-present", fmt.Sprint(presentIdx), "1")
	check("const-coalesce-missing", fmt.Sprint(missingIdx), "-7")
	check("const-array-index", dims[0]+" "+dims[1], "x y")
	check("grouped-const-block", fmt.Sprint(afterGrouped, glen, len(scores)), "9 2 2")
	if failed {
		os.Exit(1)
	}
}
