// run


package main

import (
	"comptime"
	"fmt"
	"os"
	"strings"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Account struct {
	Name    string `json:"name"`
	balance int64
	Active  bool `json:"active"`
}

func names() []string {
	var out []string
	const for _, f := range comptime.Fields[Account]() {
		out = append(out, f.Name)
	}
	return out
}

func tags() []string {
	var out []string
	const for _, f := range comptime.Fields[Account]() {
		out = append(out, f.Tag.Get("json"))
	}
	return out
}

func indexes() []int {
	var out []int
	const for i, f := range comptime.Fields[Account]() {
		_ = f.Name
		out = append(out, i+f.Index)
	}
	return out
}

func foreignNames() []string {
	var out []string
	const for _, f := range comptime.Fields[strings.Builder]() {
		out = append(out, f.Name)
	}
	return out
}

func copyAccount(a Account) Account {
	var b Account
	const for _, f := range comptime.Fields[Account]() {
		b.[f] = a.[f]
	}
	return b
}

func nameLenSum(a Account) int {
	n := 0
	const for _, f := range comptime.Fields[Account]() {
		n += len(f.Name)
		_ = a.[f]
	}
	return n
}

func main() {
	gotNames := names()
	check("names", fmt.Sprint(gotNames) == "[Name balance Active]", gotNames, "[Name balance Active]")
	gotTags := tags()
	check("tags", fmt.Sprint(gotTags) == "[name  active]", gotTags, "[name  active]")
	gotIndexes := indexes()
	check("indexes", fmt.Sprint(gotIndexes) == "[0 2 4]", gotIndexes, "[0 2 4]")
	src := Account{Name: "ann", Active: true}
	gotCopy := copyAccount(src)
	check("copy", gotCopy == src, gotCopy, src)
	check("namelensum", nameLenSum(src) == 17, nameLenSum(src), 17)
	gotForeign := foreignNames()
	check("foreign", fmt.Sprint(gotForeign) == "[]", gotForeign, "[]")
	if failed {
		os.Exit(1)
	}
}
