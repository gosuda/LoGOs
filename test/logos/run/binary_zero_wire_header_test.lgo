package main

import (
	"bytes"
	"fmt"
	"os"
	"strings"
)

type Empty struct{}

type Holder struct {
	Items []Empty `json:"items"`
}

var failed bool

func report(name string, ok bool, format string, args ...any) {
	if ok {
		fmt.Println("ok", name)
		return
	}
	failed = true
	fmt.Println("FAIL", name+":", fmt.Sprintf(format, args...))
}

func checkBound() {
	h := Holder{Items: make([]Empty, 1<<20)}
	out, err := h.AppendBinary(nil)
	if err != nil {
		report("zero-wire-bound-encodes", false, "rejected the lawful count 1<<20: %v", err)
		return
	}
	report("zero-wire-bound-encodes", bytes.Equal(out, []byte{1, 0x80, 0x80, 0x40}), "encoded %v", out)
}

func checkAbove() {
	h := Holder{Items: make([]Empty, 1<<20+1)}
	prefix := []byte{0xAA}
	out, err := h.AppendBinary(prefix)
	if err == nil {
		report("zero-wire-above-bound-rejected", false, "accepted the count %d", len(h.Items))
		return
	}
	report("zero-wire-above-bound-rejected", strings.Contains(err.Error(), "out of range"), "error %q is not count out of range", err)
	report("zero-wire-error-writes-no-count", len(out) <= len(prefix)+1, "error return holds %d bytes %v, version byte only expected", len(out), out)
}

func main() {
	checkBound()
	checkAbove()
	if failed {
		os.Exit(1)
	}
}
