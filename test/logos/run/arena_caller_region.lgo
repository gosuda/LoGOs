// run -goexperiment logosarena

package main


import (
	"fmt"
	"os"
	"testing"
)

var callSize = 64

var sinkInt int

var globalSink []byte

var produceFn func(int) []byte = produce

func sumBytes(b []byte) int {
	s := 0
	for _, v := range b {
		s += int(v)
	}
	return s
}

//go:noinline
func produce(n int) []byte {
	b := make([]byte, n)
	for i := range b {
		b[i] = 3
	}
	return b
}

//go:noinline
func produceB(n int) []byte {
	b := make([]byte, n)
	for i := range b {
		b[i] = 7
	}
	return b
}

//go:noinline
func middle(n int) []byte {
	return produce(n)
}

//go:noinline
func outerMiddle(n int) []byte {
	return middle(n)
}

//go:noinline
func consumeLocal(n int) int {
	b := produce(n)
	return sumBytes(b)
}

//go:noinline
func consumeChain(n int) int {
	b := middle(n)
	return sumBytes(b)
}

//go:noinline
func consumeNested(n int) int {
	b := outerMiddle(n)
	return sumBytes(b)
}

//go:noinline
func retainOverwrite(n int) (int, int) {
	a := produce(n)
	_ = sumBytes(a)
	b := produceB(n)
	sa := sumBytes(a)
	sb := sumBytes(b)
	return sa, sb
}

//go:noinline
func retainTotal(n int) int {
	a, b := retainOverwrite(n)
	return a + b
}

//go:noinline
func callViaValue(n int) int {
	b := produceFn(n)
	return sumBytes(b)
}

//go:noinline
func consumeLeak(n int) int {
	b := produce(n)
	globalSink = b
	return sumBytes(b)
}

//go:noinline
func unrelatedBetween(n int) int {
	x := make([]byte, n)
	for i := range x {
		x[i] = 11
	}
	y := make([]byte, n)
	for i := range y {
		y[i] = 13
	}
	v := callViaValue(n)
	s1 := sumBytes(x)
	s2 := sumBytes(y)
	return s1 + v + s2
}

//go:noinline
func deferRecover(n int) (sum int, rec any) {
	defer func() {
		rec = recover()
	}()
	b := produce(n)
	sum = sumBytes(b)
	if n == callSize {
		panic("boom")
	}
	return sum, nil
}

func main() {
	failed := false
	check := func(name string, got, want int) {
		if got != want {
			fmt.Printf("FAIL %s: got %d want %d\n", name, got, want)
			failed = true
			return
		}
		fmt.Printf("ok %s\n", name)
	}
	checkAlloc := func(name string, got float64, wantZero bool) {
		zero := got == 0
		if wantZero != zero {
			fmt.Printf("FAIL %s: got %v wantZero %v\n", name, got, wantZero)
			failed = true
			return
		}
		fmt.Printf("ok %s\n", name)
	}
	check("local-result-matches-fill-3-rule", consumeLocal(callSize), 3*callSize)
	check("chain-result-matches-fill-3-rule", consumeChain(callSize), 3*callSize)
	check("nested-result-matches-fill-3-rule", consumeNested(callSize), 3*callSize)
	aSum, bSum := retainOverwrite(callSize)
	check("retained-first-buffer-keeps-fill-3", aSum, 3*callSize)
	check("retained-second-buffer-holds-fill-7", bSum, 7*callSize)
	check("func-value-call-matches-fill-3-rule", callViaValue(callSize), 3*callSize)
	check("leaked-buffer-value-matches-fill-3-rule", consumeLeak(callSize), 3*callSize)
	check("global-sink-keeps-leaked-value", sumBytes(globalSink), 3*callSize)
	check("unrelated-live-buffers-do-not-corrupt-result", unrelatedBetween(callSize), 11*callSize+3*callSize+13*callSize)
	dSum, dRec := deferRecover(callSize)
	check("deferred-panic-path-keeps-value", dSum, 3*callSize)
	if dRec != "boom" {
		fmt.Printf("FAIL deferred-panic-value-survives: got %v want boom\n", dRec)
		failed = true
	} else {
		fmt.Println("ok deferred-panic-value-survives")
	}
	checkAlloc("local-alloc-avoided", testing.AllocsPerRun(100, func() { sinkInt = consumeLocal(callSize) }), true)
	checkAlloc("chain-alloc-avoided", testing.AllocsPerRun(100, func() { sinkInt = consumeChain(callSize) }), true)
	checkAlloc("nested-alloc-avoided", testing.AllocsPerRun(100, func() { sinkInt = consumeNested(callSize) }), true)
	checkAlloc("retain-alloc-avoided", testing.AllocsPerRun(100, func() { sinkInt = retainTotal(callSize) }), true)
	checkAlloc("leak-forces-heap-alloc", testing.AllocsPerRun(100, func() { sinkInt = consumeLeak(callSize) }), false)
	checkAlloc("func-value-forces-heap-alloc", testing.AllocsPerRun(100, func() { sinkInt = callViaValue(callSize) }), false)
	checkAlloc("unrelated-live-buffer-forces-heap-alloc", testing.AllocsPerRun(100, func() { sinkInt = unrelatedBetween(callSize) }), false)
	_ = sinkInt
	if failed {
		os.Exit(1)
	}
}
