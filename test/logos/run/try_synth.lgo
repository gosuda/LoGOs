// run

package main

import (
	"errors"
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

var errSyn = errors.New("syn")
var order []string

func note(s string) { order = append(order, s) }
func cleanup() error { return nil }

func rollback() error {
	note("rollback")
	return nil
}

func unnamedOK() (int, error) {
	defer cleanup()?
	return 7, nil
}

func unnamedFail() (int, error) {
	defer cleanup()?
	return 0, errSyn
}

func shadowed() (int, error) {
	err := 40
	r0 := 2
	defer cleanup()?
	return r0 + err, nil
}

func shadowedErrdefer(fail bool) (int, error) {
	err := 1
	r0 := 2
	errdefer rollback()
	if fail {
		return 0, errSyn
	}
	return err + r0, nil
}

func blankRes(fail bool) (_ int, _ error) {
	v := 9
	if fail {
		return 0, errSyn
	}
	defer cleanup()?
	return v, nil
}

func main() {
	v, err := unnamedOK()
	okOKValue := err == nil && v == 7
	check("ok-value", okOKValue, okOKValue, true)
	okOKErr := err == nil
	check("ok-err", okOKErr, okOKErr, true)
	v, err = unnamedFail()
	okFailValue := err != nil && err == errSyn && v == 0
	check("fail-value", okFailValue, okFailValue, true)
	okFailErr := err == errSyn
	check("fail-err", okFailErr, okFailErr, true)
	v, err = shadowed()
	okShadowValue := err == nil && v == 42
	check("shadow-value", okShadowValue, okShadowValue, true)
	okShadowErr := err == nil
	check("shadow-err", okShadowErr, okShadowErr, true)
	v, err = shadowedErrdefer(false)
	okEdOKValue := err == nil && v == 3
	check("ed-ok-value", okEdOKValue, okEdOKValue, true)
	okEdOKErr := err == nil
	check("ed-ok-err", okEdOKErr, okEdOKErr, true)
	v, err = shadowedErrdefer(true)
	okEdFailValue := err != nil && err == errSyn && v == 0
	check("ed-fail-value", okEdFailValue, okEdFailValue, true)
	okEdFailErr := err == errSyn
	check("ed-fail-err", okEdFailErr, okEdFailErr, true)
	v, err = blankRes(false)
	okBlankOKValue := err == nil && v == 9
	check("blank-ok-value", okBlankOKValue, okBlankOKValue, true)
	okBlankOKErr := err == nil
	check("blank-ok-err", okBlankOKErr, okBlankOKErr, true)
	v, err = blankRes(true)
	okBlankFailValue := err != nil && err == errSyn && v == 0
	check("blank-fail-value", okBlankFailValue, okBlankFailValue, true)
	okBlankFailErr := err == errSyn
	check("blank-fail-err", okBlankFailErr, okBlankFailErr, true)
	check("order-len", len(order) == 1, len(order), 1)
	if len(order) == 1 {
		check("order-entry", order[0] == "rollback", order[0], "rollback")
	} else {
		check("order-entry", false, fmt.Sprint(order), "[rollback]")
	}
	if failed {
		os.Exit(1)
	}
}
