func checkI32Add() {
	var a, b [8]int32
	for i := range a {
		a[i] = int32(i*11 - 13)
		b[i] = int32(i%6 + 1)
	}
	add := a + b
	sub := a - b
	mul := a * b
	quo := a / b
	for i := range a {
		if add[i] != a[i]+b[i] {
			fail(fmt.Sprintf("i32 add lane %d: got %v want %v", i, add[i], a[i]+b[i]))
		}
		if sub[i] != a[i]-b[i] {
			fail(fmt.Sprintf("i32 sub lane %d: got %v want %v", i, sub[i], a[i]-b[i]))
		}
		if mul[i] != a[i]*b[i] {
