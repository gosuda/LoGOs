	}
	fmt.Println("ok i32-arith-matches-scalar")
}

func checkI32Bit() {
	var a, b [8]int32
	for i := range a {
		a[i] = int32(i*11 - 13)
		b[i] = int32(i%6 + 1)
	}
	and := a & b
	or := a | b
	xor := a ^ b
	for i := range a {
		if and[i] != a[i]&b[i] {
