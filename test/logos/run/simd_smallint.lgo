// run

package main

import (
	"fmt"
	"os"
)

func fail(tag string) {
	fmt.Println("FAIL", tag)
	os.Exit(1)
}

func checkI8Add() {
	var a, b [16]int8
	for i := range a {
		a[i] = int8(i*3 - 5)
		b[i] = int8(i%4 + 1)
	}
	add := a + b
	sub := a - b
	mul := a * b
	quo := a / b
	for i := range a {
		if add[i] != a[i]+b[i] {
			fail(fmt.Sprintf("i8 add lane %d: got %v want %v", i, add[i], a[i]+b[i]))
		}
		if sub[i] != a[i]-b[i] {
			fail(fmt.Sprintf("i8 sub lane %d: got %v want %v", i, sub[i], a[i]-b[i]))
		}
		if mul[i] != a[i]*b[i] {
			fail(fmt.Sprintf("i8 mul lane %d: got %v want %v", i, mul[i], a[i]*b[i]))
		}
		if quo[i] != a[i]/b[i] {
			fail(fmt.Sprintf("i8 div lane %d: got %v want %v", i, quo[i], a[i]/b[i]))
		}
	}
	fmt.Println("ok i8-arith-matches-scalar")
}

func checkI8Bit() {
	var a, b [16]int8
	for i := range a {
		a[i] = int8(i*3 - 5)
		b[i] = int8(i%4 + 1)
	}
	and := a & b
	or := a | b
	xor := a ^ b
	for i := range a {
		if and[i] != a[i]&b[i] {
			fail(fmt.Sprintf("i8 and lane %d: got %v want %v", i, and[i], a[i]&b[i]))
		}
		if or[i] != a[i]|b[i] {
			fail(fmt.Sprintf("i8 or lane %d: got %v want %v", i, or[i], a[i]|b[i]))
		}
		if xor[i] != a[i]^b[i] {
			fail(fmt.Sprintf("i8 xor lane %d: got %v want %v", i, xor[i], a[i]^b[i]))
		}
	}
	fmt.Println("ok i8-bits-match-scalar")
}

func checkI8Reduce() {
	var a [16]int8
	for i := range a {
		a[i] = int8(i*3 - 5)
	}
	var wantSum, wantMin, wantMax int8
	wantMin = a[0]
	wantMax = a[0]
	for _, v := range a {
		wantSum += v
		if v < wantMin {
			wantMin = v
		}
		if v > wantMax {
			wantMax = v
		}
	}
	if a.sum() != wantSum {
		fail(fmt.Sprintf("i8 sum: got %v want %v", a.sum(), wantSum))
	}
	if a.min() != wantMin {
		fail(fmt.Sprintf("i8 min: got %v want %v", a.min(), wantMin))
	}
	if a.max() != wantMax {
		fail(fmt.Sprintf("i8 max: got %v want %v", a.max(), wantMax))
	}
	var c, d [16]int8
	for i := range c {
		c[i] = int8(i % 3)
		d[i] = int8((i + 1) % 2)
	}
	var wantDot int8
	for i := range c {
		wantDot += c[i] * d[i]
	}
	if c.dot(d) != wantDot {
		fail(fmt.Sprintf("i8 dot: got %v want %v", c.dot(d), wantDot))
	}
	fmt.Println("ok i8-reductions-match-scalar")
}

func checkI16Add() {
