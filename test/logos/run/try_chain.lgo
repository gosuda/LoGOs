// run

package main

import (
	"errors"
	"fmt"
	"os"
	"strings"

	"logos/rt"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

var errChain = errors.New("chain")

func source(fail bool) (int, error) {
	if fail {
		return 0, errChain
	}
	return 3, nil
}

func leaf(fail bool) (int, error) {
	n := source(fail)?
	return n, nil
}

func middle(fail bool) (int, error) {
	n := leaf(fail)?
	return 2 * n, nil
}

func top(fail bool) (int, error) {
	n := middle(fail)?
	return 10 + n, nil
}

func run() error {
	n := top(false)?
	check("value", n == 16, n, 16)
	n2, err := top(true)
	okZero := err != nil && n2 == 0
	check("zero", okZero, okZero, true)
	okErr := err != nil && err.Error() == "chain"
	check("err", okErr, okErr, true)
	if err == nil {
		return nil
	}
	trace := rt.ErrorTrace()
	check("trace-len", len(trace) == 3, len(trace), 3)
	if len(trace) == 3 {
		okFiles := true
		for _, s := range trace {
			if !strings.HasSuffix(s.File, "try_chain.lgo") {
				okFiles = false
			}
		}
		check("trace-files", okFiles, fmt.Sprint(trace), "try_chain.lgo x3")
		ordered := trace[0].Line < trace[1].Line && trace[1].Line < trace[2].Line
		check("trace-order", ordered, fmt.Sprint(trace[0].Line, trace[1].Line, trace[2].Line), "increasing")
		positive := trace[0].Line > 0 && trace[1].Line > 0 && trace[2].Line > 0
		check("trace-lines", positive, fmt.Sprint(trace[0].Line, trace[1].Line, trace[2].Line), "positive")
	}
	return err
}

func main() {
	err := run()
	check("run-err", err != nil && err.Error() == "chain", fmt.Sprint(err), "chain")
	if failed {
		os.Exit(1)
	}
}
