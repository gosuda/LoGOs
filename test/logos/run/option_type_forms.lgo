func view_ofGeneric() bool {
	var a viewOf[int]
	var s (const []int)?
	a = s
	s = a
	return same[viewOf[int]]("view-of-generic", unsafe.Sizeof(s))
}

type funcOf[T any] = (func(T?))?

func func_ofGeneric() bool {
	var a funcOf[int]
	var s (func(int?))?
	a = s
	s = a
	return same[funcOf[int]]("func-of-generic", unsafe.Sizeof(s))
}

var cases = []func() bool{
	tuple_optionsAlias,
	tuple_optionsDefined,
	tuple_nestedAlias,
	tuple_nestedDefined,
	slice_of_tupleAlias,
	slice_of_tupleDefined,
	map_of_tupleAlias,
	map_of_tupleDefined,
	func_tupleAlias,
	func_tupleDefined,
	tuple_constAlias,
	tuple_constDefined,
	option_constAlias,
	option_constDefined,
	const_optionAlias,
	const_optionDefined,
	paren_constAlias,
	paren_constDefined,
	slice_option_constAlias,
	slice_option_constDefined,
	map_option_constAlias,
	map_option_constDefined,
	option_funcAlias,
	option_funcDefined,
	option_func_argsAlias,
	option_func_argsDefined,
	option_func_optionsAlias,
	option_func_optionsDefined,
	option_tupleAlias,
	option_tupleDefined,
	option_tuple_optionsAlias,
	option_tuple_optionsDefined,
	option_double_parenAlias,
	option_double_parenDefined,
	chan_optionAlias,
	chan_optionDefined,
	array_option_funcAlias,
	array_option_funcDefined,
	pair_ofGeneric,
	opt_ofGeneric,
	view_ofGeneric,
	func_ofGeneric,
}

func main() {
	failed := false
	for _, run := range cases {
		failed = !run() || failed
	}
	if failed {
		os.Exit(1)
	}
}
