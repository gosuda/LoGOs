// run

package main

import (
	"comptime"
	"fmt"
	"os"
	"unsafe"
)

func same[A any](name string, direct uintptr) bool {
	var a A
	if comptime.SizeOf[A]() == int(direct) && unsafe.Sizeof(a) == direct {
		fmt.Println("ok", name)
		return true
	}
	fmt.Println("FAIL", name, "layout differs from the directly spelled type")
	return false
}

type aliasTupleOptions = (int?, string?)
type definedTupleOptions (int?, string?)

func tuple_optionsAlias() bool {
	var a aliasTupleOptions
	var s (int?, string?)
	a = s
	s = a
	return same[aliasTupleOptions]("tuple-options-alias", unsafe.Sizeof(s))
}

func tuple_optionsDefined() bool {
	var s (int?, string?)
	return same[definedTupleOptions]("tuple-options-defined", unsafe.Sizeof(s))
}

