type pairOf[T any] = (T, T?)

func pair_ofGeneric() bool {
	var a pairOf[int]
	var s (int, int?)
	a = s
	s = a
	return same[pairOf[int]]("pair-of-generic", unsafe.Sizeof(s))
}

type optOf[T any] = T?

func opt_ofGeneric() bool {
	var a optOf[int]
	var s int?
	a = s
	s = a
	return same[optOf[int]]("opt-of-generic", unsafe.Sizeof(s))
}

