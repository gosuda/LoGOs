// run

package main

import (
	"errors"
	"fmt"
	"os"
	"strings"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

var log []string

var errBoom = errors.New("boom")

func mustFail() (int, error) { return 0, errBoom }

func note(s string) {
	log = append(log, s)
}

func reset() {
	log = nil
}

func show(tag, want string) {
	got := strings.Join(log, ",")
	check(tag, got == want, got, want)
	reset()
}

func basic() {
	note("work")
	{
		note("lock")
		scope defer note("unlock")
		note("body")
	}
	note("after")
	show("basic:", "work,lock,body,unlock,after")
}

func lifo() {
	{
		scope defer note("first")
		scope defer note("second")
		scope defer note("third")
		note("body")
	}
	show("lifo:", "body,third,second,first")
}

func argEval() {
	x := 1
	{
		scope defer note(fmt.Sprint("arg:", x))
		x = 2
		note("body")
	}
	show("argeval:", "body,arg:1")
}

func earlyReturn(n int) int {
	{
		scope defer note("cleanup")
		if n > 0 {
			return 1
		}
		note("fallthrough")
	}
	return 0
}

func breakOut() {
	for i := 0; i < 5; i++ {
		{
			scope defer note(fmt.Sprint("iter:", i))
			if i == 2 {
				break
			}
			note(fmt.Sprint("body:", i))
		}
	}
	show("break:", "body:0,iter:0,body:1,iter:1,iter:2")
}

func continueOut() {
	for i := 0; i < 3; i++ {
		{
			scope defer note(fmt.Sprint("citer:", i))
			if i == 1 {
				continue
			}
			note(fmt.Sprint("cbody:", i))
		}
	}
	show("continue:", "cbody:0,citer:0,citer:1,cbody:2,citer:2")
}

func labeledBreak() {
Outer:
	for i := 0; i < 5; i++ {
		for j := 0; j < 5; j++ {
			{
				scope defer note(fmt.Sprint("lbl:", i, j))
				if j == 1 {
					break Outer
				}
			}
		}
	}
	show("labeled:", "lbl:0 0,lbl:0 1")
}

func labeledContinue() {
Outer:
	for i := 0; i < 3; i++ {
		{
			scope defer note(fmt.Sprint("lc:", i))
			if i == 1 {
				continue Outer
			}
			note(fmt.Sprint("lb:", i))
		}
	}
	show("labeled-continue:", "lb:0,lc:0,lc:1,lb:2,lc:2")
}

func gotoOut() {
	{
		scope defer note("gcleanup")
		goto Done
	}
Done:
	show("goto:", "gcleanup")
}

func panicOut() {
	defer func() {
		_ = recover()
		show("panic:", "pcleanup")
	}()
	{
		scope defer note("pcleanup")
		panic("boom")
	}
}

func loopIter() {
	for i := 0; i < 3; i++ {
		scope defer note(fmt.Sprint("loop:", i))
		note(fmt.Sprint("work:", i))
	}
	show("loop:", "work:0,loop:0,work:1,loop:1,work:2,loop:2")
}

func panicInLoop() {
	defer func() {
		_ = recover()
		show("ploop:", "pwork:0,ploop:0,ploop:1")
	}()
	for i := 0; i < 3; i++ {
		scope defer note(fmt.Sprint("ploop:", i))
		if i == 1 {
			panic("boom")
		}
		note(fmt.Sprint("pwork:", i))
	}
}

func nestedLoopPanic() {
	defer func() {
		_ = recover()
		show("nploop:", "work:0 0,inner:0 0,work:0 1,inner:0 1,outer:0,work:1 0,inner:1 0,inner:1 1,outer:1")
	}()
	for i := 0; i < 2; i++ {
		scope defer note(fmt.Sprint("outer:", i))
		for j := 0; j < 2; j++ {
			scope defer note(fmt.Sprint("inner:", i, j))
			if i == 1 && j == 1 {
				panic("boom")
			}
			note(fmt.Sprint("work:", i, j))
		}
	}
}

func gotoLabel() {
	{
		note("start")
		goto Re
	Re:
		scope defer note("relbl")
		note("after")
	}
	show("rellbl:", "start,after,relbl")
}

func switchOut(x int) {
	{
		scope defer note("swcleanup")
		switch x {
		case 1:
			note("one")
		case 2:
			note("two")
			fallthrough
		case 3:
			note("three")
		}
		note("swafter")
	}
	if x == 1 {
		show("switch-1:", "one,swafter,swcleanup")
	} else {
		show("switch-2:", "two,three,swafter,swcleanup")
	}
}

func switchInner(x int) {
	switch x {
	case 1:
		scope defer note("c1cleanup")
		note("cone")
		fallthrough
	case 2:
		note("ctwo")
	}
	note("innerafter")
	show("swinner:", "cone,c1cleanup,ctwo,innerafter")
}

func tryInTail() (int, error) {
	{
		scope defer note("trycleanup")
		v := mustFail()?
		_ = v
		note("unreached")
	}
	return 0, nil
}

func funcVarDefer() {
	f := func(s string) { note("f1:" + s) }
	{
		scope defer f("done")
		f = func(s string) { note("f2:" + s) }
		note("body")
	}
	show("funcvar:", "body,f1:done")
}

type rec struct{ id int }

func (r *rec) mark(s string) { note(fmt.Sprintf("r%d:%s", r.id, s)) }

func recvDefer() {
	r := &rec{id: 1}
	{
		scope defer r.mark("done")
		r = &rec{id: 2}
		note("body")
	}
	show("recv:", "body,r1:done")
}

func nested() {
	{
		scope defer note("outer")
		note("o1")
		{
			scope defer note("inner")
			note("i1")
		}
		note("o2")
	}
	show("nested:", "o1,i1,inner,o2,outer")
}

func namedResult() (x int) {
	{
		scope defer func() { note(fmt.Sprint("saw:", x)) }()
		x = 41
		return 42
	}
}

func main() {
	basic()
	lifo()
	argEval()
	r1 := earlyReturn(1)
	check("return-1:", r1 == 1 && fmt.Sprint(log) == "[cleanup]", fmt.Sprint(r1, log), "1 [cleanup]")
	reset()
	r0 := earlyReturn(0)
	check("return-0:", r0 == 0 && fmt.Sprint(log) == "[fallthrough cleanup]", fmt.Sprint(r0, log), "0 [fallthrough cleanup]")
	reset()
	breakOut()
	continueOut()
	labeledBreak()
	labeledContinue()
	gotoOut()
	gotoLabel()
	panicOut()
	nested()
	switchOut(1)
	switchOut(2)
	switchInner(1)
	_, te := tryInTail()
	check("trytail:", te == errBoom && fmt.Sprint(log) == "[trycleanup]", fmt.Sprint(te, log), "boom [trycleanup]")
	reset()
	loopIter()
	panicInLoop()
	nestedLoopPanic()
	namedResult()
	show("named:", "saw:42")
	funcVarDefer()
	recvDefer()
	if failed {
		os.Exit(1)
	}
}
