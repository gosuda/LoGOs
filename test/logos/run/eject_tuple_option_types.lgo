package main

import (
	"fmt"
	"strings"
)

type P struct {
	N int
}

type holder struct {
	t  (int, int?)
	pt (int, *P?)
	ot (int, int)?
}

func show(args ...any) string {
	return strings.TrimSuffix(fmt.Sprintln(args...), "\n")
}

func cell(name string, got func() string, want string) {
	if g := got(); g != want {
		fmt.Println("FAIL", name, "got", g, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func takesInt(p (int, int?)) string {
	a, b := p
	return show(a, b ?? -1)
}

func takesPtr(p (int, *P?)) string {
	a, b := p
	return show(a, b?.N ?? -1)
}

func takesTup(o (int, int)?) string {
	t := o ?? (3, 4)
	return show(t)
}

func optTup(m map[string](int, int)) ((int, int))? {
	return m["k"]
}

func intCells() {
	m := map[string]int{"a": 1}
	cell("int__param", func() string { return takesInt((5, m["a"])) }, "5 1")
	cell("int__var", func() string { var t (int, int?) = (5, m["a"]); a, b := t; return show(a, b ?? -1) }, "5 1")
	cell("int__slice", func() string { xs := [](int, int?){(5, m["a"])}; a, b := xs[0]; return show(a, b ?? -1) }, "5 1")
	cell("int__array", func() string { xs := [1](int, int?){(5, m["a"])}; a, b := xs[0]; return show(a, b ?? -1) }, "5 1")
	cell("int__field", func() string { h := holder{t: (5, m["a"])}; a, b := h.t; return show(a, b ?? -1) }, "5 1")
	cell("int__nested", func() string { var n ((int, int?), int) = ((5, m["a"]), 6); a, c := n; x, y := a; return show(x, y ?? -1, c) }, "5 1 6")
	cell("int__named", func() string { var t (x int, y int?) = (5, m["a"]); return show(t.x, t.y ?? -1) }, "5 1")
	cell("int__mapvalue", func() string {
		ms := map[string](int, int?){"k": (5, m["a"])}
		for _, v := range ms {
			a, b := v
			return show(a, b ?? -1)
		}
		return "empty"
	}, "5 1")
}

func ptrCells() {
	var p *P? = &P{N: 4}
	cell("ptr__param", func() string { return takesPtr((5, p)) }, "5 4")
	cell("ptr__var", func() string { var t (int, *P?) = (5, p); a, b := t; return show(a, b?.N ?? -1) }, "5 4")
	cell("ptr__slice", func() string { xs := [](int, *P?){(5, p)}; a, b := xs[0]; return show(a, b?.N ?? -1) }, "5 4")
	cell("ptr__array", func() string { xs := [1](int, *P?){(5, p)}; a, b := xs[0]; return show(a, b?.N ?? -1) }, "5 4")
	cell("ptr__field", func() string { h := holder{pt: (5, p)}; a, b := h.pt; return show(a, b?.N ?? -1) }, "5 4")
	cell("ptr__nested", func() string { var n ((int, *P?), int) = ((5, p), 6); a, c := n; x, y := a; return show(x, y?.N ?? -1, c) }, "5 4 6")
	cell("ptr__named", func() string { var t (x int, y *P?) = (5, p); return show(t.x, t.y?.N ?? -1) }, "5 4")
	cell("ptr__mapvalue", func() string {
		ms := map[string](int, *P?){"k": (5, p)}
		for _, v := range ms {
			a, b := v
			return show(a, b?.N ?? -1)
		}
		return "empty"
	}, "5 4")
}

func tupCells() {
	m := map[string](int, int){"k": (7, 8)}
	var none (int, int)?
	var grouped ((int, int))?
	cell("tup__var", func() string { t := none ?? (3, 4); return show(t) }, "{3 4}")
	cell("tup__grouped", func() string { t := grouped ?? (3, 4); return show(t) }, "{3 4}")
	cell("tup__param_none", func() string { return takesTup(none) }, "{3 4}")
	cell("tup__param_some", func() string { return takesTup(m["k"]) }, "{7 8}")
	cell("tup__field", func() string { var h holder; t := h.ot ?? (3, 4); return show(t) }, "{3 4}")
	cell("tup__result", func() string { t := optTup(m) ?? (3, 4); return show(t) }, "{7 8}")
}

func main() {
	intCells()
	ptrCells()
	tupCells()
}
