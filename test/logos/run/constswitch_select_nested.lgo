// run

package main

import (
	"comptime"
	"fmt"
)

type Holder struct {
	Ptr *bool
}

func (h Holder) M() *bool { return h.Ptr }

func pick[A any, B any](a A, b B) A {
	return a
}

var nextSeq int
var mSeq int

func next() int {
	nextSeq++
	return 0
}

func m() int {
	mSeq++
	return 0
}

type Two struct {
	A int
	B int
}

func recvFor[T any](s []T, t []int, ch chan T) {
	const for _, f := range comptime.Fields[Two]() {
		const switch T {
		case interface{ M() *bool }:
			var p interface{ M() *bool }
			select {
			case p, *pick(s[next()+t[m()]+len(f.Name)], 0).M() = <-ch:
				_ = p
			default:
			}
		}
	}
}

func main() {
	ch := make(chan Holder, 2)
	ch <- Holder{Ptr: new(bool)}
	ch <- Holder{Ptr: new(bool)}
	hs := []Holder{{Ptr: new(bool)}, {Ptr: new(bool)}}
	ts := []int{0}
	recvFor[Holder](hs, ts, ch)
	fmt.Println("next", nextSeq)
	fmt.Println("m", mSeq)
}
