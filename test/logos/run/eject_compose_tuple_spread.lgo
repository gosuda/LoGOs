package main

import (
	"context"
	"errors"
	"fmt"
	"iter"
	"os"
)

var _ iter.Seq[int]

type pc struct {
	id int
}

type box struct {
	o int?
	p int
}

type State struct {
	A int
	B int
}

type Prop interface {
	P int
}

type propBox struct : Prop {
	P int
}

var errLoad = errors.New("load")

var last int

func load(v int, fail bool) (int, error) {
	if fail {
		return 0, errLoad
	}
	return v, nil
}

func maybe(n int) int? {
	if n == 7 {
		return 7
	}
	return nil
}

func maybeP(n int) *pc? {
	if n == 7 {
		return &pc{id: 7}
	}
	return nil
}

func apply(f func(int) int, n int) int { return f(n) }

func viewLen(xs const []int) int { return len(xs) }

func record(n int) error {
	last = n
	return nil
}

func mkState(n int) State { return State{A: n, B: n + 1} }

func pair(n int) (int, string) { return n, "p" }

func tupA(t (int, string)) int {
	a, _ := t
	return a
}

var failed bool

func line(f func(int, bool) (int, error), fail bool) string {
	last = 0
	got, err := f(7, fail)
	if err != nil {
		return fmt.Sprintln(0, err, last)
	}
	return fmt.Sprintln(got, err, last)
}

func run(name string, f func(int, bool) (int, error), want string) {
	got := line(f, false) + line(f, true)
	if got != want {
		failed = true
		fmt.Printf("FAIL %s: got %q want %q\n", name, got, want)
		return
	}
	fmt.Println("ok", name)
}

func c_spread_base_spread(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	s := State{A: 1, ..State{B: 20, ..mkState(v)}}
	r := s.A*100 + s.B
	return r, nil
}

func c_spread_elem_chainc(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	s := State{A: xs.map(x => x + v).count(), ..mkState(v)}
	r := s.A*100 + s.B
	return r, nil
}

func c_spread_elem_coal(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	s := State{A: (maybe(v) ?? -1), ..mkState(v)}
	r := s.A*100 + s.B
	return r, nil
}

func c_spread_elem_lamapply(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	s := State{A: apply(x => x + 1, v), ..mkState(v)}
	r := s.A*100 + s.B
	return r, nil
}

func c_spread_elem_optcomp(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	s := State{A: box{o: maybe(v), p: 1}.p, ..mkState(v)}
	r := s.A*100 + s.B
	return r, nil
}

func c_spread_elem_propcoal(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	s := State{A: (maybe(v) ?? w.P), ..mkState(v)}
	r := s.A*100 + s.B
	return r, nil
}

func c_spread_elem_proplam(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	s := State{A: apply(x => x + w.P, v), ..mkState(v)}
	r := s.A*100 + s.B
	return r, nil
}

func c_spread_elem_propr(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	s := State{A: w.P, ..mkState(v)}
	r := s.A*100 + s.B
	return r, nil
}

func c_spread_elem_sw(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	s := State{A: switch v {
		case 7 => 70
		default => 1
		}, ..mkState(v)}
	r := s.A*100 + s.B
	return r, nil
}

func c_tuple_elem_chainc(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	t := (xs.map(x => x + v).count(), "a")
	r := tupA(t)
	return r, nil
}

func c_tuple_elem_coal(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	t := ((maybe(v) ?? -1), "a")
	r := tupA(t)
	return r, nil
}

func c_tuple_elem_cv(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	t := (viewLen(xs), "a")
	r := tupA(t)
	return r, nil
}

func c_tuple_elem_lamapply(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	t := (apply(x => x + 1, v), "a")
	r := tupA(t)
	return r, nil
}

func c_tuple_elem_propcoal(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	t := ((maybe(v) ?? w.P), "a")
	r := tupA(t)
	return r, nil
}

func c_tuple_elem_proplam(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	t := (apply(x => x + w.P, v), "a")
	r := tupA(t)
	return r, nil
}

func c_tuple_elem_propr(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	t := (w.P, "a")
	r := tupA(t)
	return r, nil
}

func c_tuple_elem_sw(v int, fail bool) (int, error) {
	xs := []int{1, 2, 3}
	_ = xs
	var wb propBox
	wb.P = 4
	var w Prop = &wb
	_ = w
	t := (switch v {
		case 7 => 70
		default => 1
		}, "a")
	r := tupA(t)
	return r, nil
}

func main() {
	_ = context.Background
	run("spread-base__spread", c_spread_base_spread, "120 <nil> 0\n120 <nil> 0\n")
	run("spread-elem__chainc", c_spread_elem_chainc, "308 <nil> 0\n308 <nil> 0\n")
	run("spread-elem__coal", c_spread_elem_coal, "708 <nil> 0\n708 <nil> 0\n")
	run("spread-elem__lamapply", c_spread_elem_lamapply, "808 <nil> 0\n808 <nil> 0\n")
	run("spread-elem__optcomp", c_spread_elem_optcomp, "108 <nil> 0\n108 <nil> 0\n")
	run("spread-elem__propcoal", c_spread_elem_propcoal, "708 <nil> 0\n708 <nil> 0\n")
	run("spread-elem__proplam", c_spread_elem_proplam, "1108 <nil> 0\n1108 <nil> 0\n")
	run("spread-elem__propr", c_spread_elem_propr, "408 <nil> 0\n408 <nil> 0\n")
	run("spread-elem__sw", c_spread_elem_sw, "7008 <nil> 0\n7008 <nil> 0\n")
	run("tuple-elem__chainc", c_tuple_elem_chainc, "3 <nil> 0\n3 <nil> 0\n")
	run("tuple-elem__coal", c_tuple_elem_coal, "7 <nil> 0\n7 <nil> 0\n")
	run("tuple-elem__cv", c_tuple_elem_cv, "3 <nil> 0\n3 <nil> 0\n")
	run("tuple-elem__lamapply", c_tuple_elem_lamapply, "8 <nil> 0\n8 <nil> 0\n")
	run("tuple-elem__propcoal", c_tuple_elem_propcoal, "7 <nil> 0\n7 <nil> 0\n")
	run("tuple-elem__proplam", c_tuple_elem_proplam, "11 <nil> 0\n11 <nil> 0\n")
	run("tuple-elem__propr", c_tuple_elem_propr, "4 <nil> 0\n4 <nil> 0\n")
	run("tuple-elem__sw", c_tuple_elem_sw, "70 <nil> 0\n70 <nil> 0\n")
	if failed {
		os.Exit(1)
	}
}
