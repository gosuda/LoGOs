// run -goexperiment simd -godebug cpu.avx=off,cpu.avx2=off,cpu.avx512f=off -goamd64=v1

package main

import "fmt"

func checkFallbackArith() {
	a := [4]float32{1, 2, 3, 4}
	b := [4]float32{5, 6, 7, 8}
	var wantAdd [4]float32
	for i := range wantAdd {
		wantAdd[i] = a[i] + b[i]
	}
	if got := a + b; got != wantAdd {
		panic("fallback f32 add")
	}
	var c, d [8]uint32
	for i := range c {
		c[i] = uint32(i + 1)
		d[i] = uint32(2*i + 1)
	}
	var wantMul [8]uint32
	for i := range wantMul {
		wantMul[i] = c[i] * d[i]
	}
	if got := c * d; got != wantMul {
		panic("fallback u32 mul")
	}
}

func checkFallbackReduce() {
	a := [4]float32{1, 2, 3, 4}
	var wantSum float32
	wantMin := a[0]
	wantMax := a[0]
	for _, v := range a {
		wantSum += v
		if v < wantMin {
			wantMin = v
		}
		if v > wantMax {
			wantMax = v
		}
	}
	if a.sum() != wantSum {
		panic("fallback f32 sum")
	}
	if a.min() != wantMin {
		panic("fallback f32 min")
	}
	if a.max() != wantMax {
		panic("fallback f32 max")
	}
	b := [4]float32{5, 6, 7, 8}
	var wantDot float32
	for i := range a {
		wantDot += a[i] * b[i]
	}
	if a.dot(b) != wantDot {
		panic("fallback f32 dot")
	}
}

func main() {
	checkFallbackArith()
	checkFallbackReduce()
	fmt.Println("simd fallback ok")
}
