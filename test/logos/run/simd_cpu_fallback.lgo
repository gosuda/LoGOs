// run -goexperiment simd -godebug cpu.avx=off,cpu.avx2=off,cpu.avx512f=off -goamd64=v1

package main

import (
	"fmt"
	"os"
)

func fail(tag string) {
	fmt.Println("FAIL", tag)
	os.Exit(1)
}

func checkFallbackArith() {
	a := [4]float32{1, 2, 3, 4}
	b := [4]float32{5, 6, 7, 8}
	var wantAdd [4]float32
	for i := range wantAdd {
		wantAdd[i] = a[i] + b[i]
	}
	if got := a + b; got != wantAdd {
		fail(fmt.Sprintf("fallback f32 add: got %v want %v", got, wantAdd))
	}
	var c, d [8]uint32
	for i := range c {
		c[i] = uint32(i + 1)
		d[i] = uint32(2*i + 1)
	}
	var wantMul [8]uint32
	for i := range wantMul {
		wantMul[i] = c[i] * d[i]
	}
	if got := c * d; got != wantMul {
		fail(fmt.Sprintf("fallback u32 mul: got %v want %v", got, wantMul))
	}
	fmt.Println("ok fallback-arith-matches-scalar")
}

func checkFallbackReduce() {
	a := [4]float32{1, 2, 3, 4}
	var wantSum float32
	wantMin := a[0]
	wantMax := a[0]
	for _, v := range a {
		wantSum += v
		if v < wantMin {
			wantMin = v
		}
		if v > wantMax {
			wantMax = v
		}
	}
	if a.sum() != wantSum {
		fail(fmt.Sprintf("fallback f32 sum: got %v want %v", a.sum(), wantSum))
	}
	if a.min() != wantMin {
		fail(fmt.Sprintf("fallback f32 min: got %v want %v", a.min(), wantMin))
	}
	if a.max() != wantMax {
		fail(fmt.Sprintf("fallback f32 max: got %v want %v", a.max(), wantMax))
	}
	b := [4]float32{5, 6, 7, 8}
	var wantDot float32
	for i := range a {
		wantDot += a[i] * b[i]
	}
	if a.dot(b) != wantDot {
		fail(fmt.Sprintf("fallback f32 dot: got %v want %v", a.dot(b), wantDot))
	}
	fmt.Println("ok fallback-reduce-matches-scalar")
}

func main() {
	checkFallbackArith()
	checkFallbackReduce()
}
