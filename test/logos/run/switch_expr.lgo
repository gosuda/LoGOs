// run

package main

import (
	"fmt"
	"os"
	"strings"
	"unsafe"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type U interface {
	int | string
}

var calls int

var ran string

func next() U {
	calls++
	return 7
}

func arm1() string {
	ran = "arm1"
	return "one"
}

func arm2() string {
	ran = "arm2"
	return "two"
}

func pick(n int, u U) U {
	return switch n {
	case 1 => u
	case 2 => 0
	default => "s"
	}
}

func provoke() (rec any) {
	defer func() { rec = recover() }()
	var u U = 1
	*(*any)(unsafe.Pointer(&u)) = 1.5
	_ = switch u.(type) {
	case int => "int"
	case string => "str"
	case nil => "nil"
	}
	return nil
}

func main() {
	r := switch next() {
	case 7 => "seven"
	default => "other"
	}
	check("result", r == "seven", r, "seven")
	check("calls", calls == 1, calls, 1)

	s := switch 2 {
	case 1 => arm1()
	case 2 => arm2()
	default => "other"
	}
	check("chosen", s == "two", s, "two")
	check("arm", ran == "arm2", ran, "arm2")

	check("pick1", fmt.Sprint(pick(1, 7)) == "7", fmt.Sprint(pick(1, 7)), "7")
	check("pick2", fmt.Sprint(pick(2, 7)) == "0", fmt.Sprint(pick(2, 7)), "0")
	check("pick9", fmt.Sprint(pick(9, 7)) == "s", fmt.Sprint(pick(9, 7)), "s")

	rec := provoke()
	check("recovered", rec != nil && strings.Contains(fmt.Sprint(rec), "matched no arm"), fmt.Sprint(rec), "matched no arm")
	if failed {
		os.Exit(1)
	}
}
