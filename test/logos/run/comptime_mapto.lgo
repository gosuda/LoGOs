// run


package main

import (
	"comptime"
	"fmt"
)

type Dst struct {
	ID   int
	Name string
}

type Src struct {
	ID    int
	Name  string
	Extra bool
}

func MapTo[D, S any](dst *D, src *S) {
	const for _, f := range comptime.Fields[D]() {
		dst.[f] = src.[f]
	}
}

func main() {
	var d Dst
	MapTo[Dst, Src](&d, &Src{ID: 7, Name: "x", Extra: true})
	fmt.Println(d.ID, d.Name)
}
