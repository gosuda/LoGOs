// run
package main

import (
	"comptime"
	"fmt"
	"os"
)

type Dst struct {
	ID   int
	Name string
}

type Src struct {
	ID    int
	Name  string
	Extra bool
}

var failed bool

func check(name, got, want string) {
	if got != want {
		fmt.Println("FAIL", name, "got", got, "want", want)
		failed = true
		return
	}
	fmt.Println("ok", name)
}

func MapTo[D, S any](dst *D, src *S) {
	const for _, f := range comptime.Fields[D]() {
		dst.[f] = src.[f]
	}
}

func main() {
	var d Dst
	MapTo[Dst, Src](&d, &Src{ID: 7, Name: "x", Extra: true})
	check("mapto-copies-shared-fields", fmt.Sprintf("%d %s", d.ID, d.Name), "7 x")
	check("mapto-matches-hand-struct", fmt.Sprint(d), fmt.Sprint(Dst{ID: 7, Name: "x"}))
	if failed {
		os.Exit(1)
	}
}
