// run

package main

import (
	"fmt"
	"os"
)

type Cfg struct {
	Port int = 8080
	Host string = "localhost"
}

func main() {
	a := Cfg{}
	b := &Cfg{}
	c := Cfg{Host: "x"}
	if a.Port != 8080 || a.Host != "localhost" || b.Port != 8080 || b.Host != "localhost" || c.Port != 8080 || c.Host != "x" {
		fmt.Println("struct defaults: FAIL")
		os.Exit(1)
	}
	fmt.Println("struct defaults: PASS")
}
