// run

package main

import (
	"context"
	"errors"
	"fmt"
)

var errLoad = errors.New("load")

var calls int
var order []int

func load(v int) (int, error) {
	calls++
	return v, nil
}

func loadFail(v int) (int, error) {
	calls++
	return 0, errLoad
}

func shortFalse(v int) (bool, error) {
	calls = 0
	ok := false && (switch n := load(v)?; n { case 7 => true; default => false })
	if calls != 0 {
		return false, nil
	}
	return ok == false, nil
}

func loopCond() (bool, error) {
	calls = 0
	c := 0
	prev := 0
	for i := 0; (switch k := nextOK(i)?; k { case 3 => false; default => true }); i++ {
		c++
		prev = i
		_ = prev
	}
	return c == 2 && calls == 3, nil
}

var postCalls int

func nextOK(v int) (int, error) {
	calls++
	return v + 1, nil
}

func g() int {
	order = append(order, 1)
	return 10
}

func loadOrd(v int) (int, error) {
	order = append(order, 2)
	return v, nil
}

func operandOrder() (bool, error) {
	order = nil
	r := g() + (switch n := loadOrd(7)?; n { case 7 => 1; default => 2 })
	return r == 11 && len(order) == 2 && order[0] == 1 && order[1] == 2, nil
}

func scopeKeep() (bool, error) {
	n := 10
	r := n + (switch n := load(7)?; n { case 7 => 1; default => 2 })
	_ = r
	return n == 10 && r == 11, nil
}


func nestedPick(v int) (int, error) {
	r := switch 1 { case 1 => switch n := load(v)?; n { case 7 => 1; default => 2 }; default => 3 }
	return r, nil
}

func nestedOK() (bool, error) {
	r, err := nestedPick(7)
	return err == nil && r == 1, nil
}

func closureOK() (bool, error) {
	f := func() (int, error) {
		r := switch n := load(7)?; n { case 7 => 1; default => 2 }
		return r, nil
	}
	r, err := f()
	return err == nil && r == 1, nil
}

func groupOK() (bool, error) {
	out, err := batchGroup(context.Background())
	return err == nil && out == 1, nil
}

func batchGroup(ctx context.Context) (int, error) {
	out := 0
	go group (ctx) {
		go {
			r := switch n := load(7)?; n { case 7 => 1; default => 2 }
			out = r
		}
	}
	return out, nil
}


func ifCondOK() (bool, error) {
	if (switch n := load(7)?; n { case 7 => true; default => false }) {
		return true, nil
	}
	return false, nil
}

func main() {
	ok, err := shortFalse(7)
	fmt.Println("ok short-false:", ok && err == nil)
	ok, err = loopCond()
	fmt.Println("ok loop-cond:", ok && err == nil)
	ok, err = operandOrder()
	fmt.Println("ok operand-order:", ok && err == nil)
	ok, err = scopeKeep()
	fmt.Println("ok scope:", ok && err == nil)
	ok, err = nestedOK()
	fmt.Println("ok nested:", ok && err == nil)
	ok, err = closureOK()
	fmt.Println("ok closure:", ok && err == nil)
	ok, err = groupOK()
	fmt.Println("ok group:", ok && err == nil)
	ok, err = ifCondOK()
	fmt.Println("ok if-cond:", ok && err == nil)
}
