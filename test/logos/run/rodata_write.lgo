// run

package main

import (
	"bytes"
	"fmt"
	"os"
	"os/exec"
	"strings"
	"unsafe"
)

const faultSlice = []int{11, 22, 33}

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func main() {
	if len(os.Args) > 1 && os.Args[1] == "child" {
		p := unsafe.SliceData(faultSlice)
		*p = 0xDEAD
		fmt.Println("STORE-SUCCEEDED")
		return
	}
	self, err := os.Executable()
	if err != nil {
		fmt.Printf("FAIL self=%v\n", err)
		os.Exit(1)
	}
	cmd := exec.Command(self, "child")
	var buf bytes.Buffer
	cmd.Stdout = &buf
	cmd.Stderr = &buf
	runErr := cmd.Run()
	code := -1
	if ee, ok := runErr.(*exec.ExitError); ok {
		code = ee.ExitCode()
	}
	out := buf.String()
	check("fault-code", runErr != nil && code == 2, code, 2)
	check("fault-output", strings.Contains(out, "fault") && !strings.Contains(out, "STORE-SUCCEEDED"), out, "fault without STORE-SUCCEEDED")
	if failed {
		os.Exit(1)
	}
}
