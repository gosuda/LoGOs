// run

package main

import (
	"context"
	"errors"
	"fmt"
)

func group(n int) error {
	if n < 0 {
		return errors.New("negative")
	}
	return nil
}

func runPlain(ctx context.Context, input int) error {
	go group (ctx) {
		go group(input)
	}
	return nil
}

func main() {
	ctx := context.Background()
	if err := runPlain(ctx, -1); err != nil {
		fmt.Println("got err")
	} else {
		fmt.Println("no err")
	}
}
