// run
package main

import (
	"comptime"
	"fmt"
	"os"
	"reflect"
)

const debugOn = true

const typedOn bool = true

const traceOff = false

type Pair struct {
	X int
	Y int
}

type Outer struct {
	ID    int
	Inner Pair
	Tag   string
}

type Base struct {
	N int
}

type Defined Base

type AliasBase = Base

type OverInt int

type AliasInt = int

var failed bool

func check(name, got, want string) {
	if got != want {
		fmt.Println("FAIL", name, "got", got, "want", want)
		failed = true
		return
	}
	fmt.Println("ok", name)
}

func kindWant[T any]() string {
	var v T
	if reflect.TypeOf(v).Kind() == reflect.Struct {
		return "struct"
	}
	return "scalar"
}

func Walk[T any](val T) string {
	const if comptime.IsStruct[T]() {
		n := 0
		const for _, f := range comptime.Fields[T]() {
			_ = val.[f]
			n++
		}
		return fmt.Sprintf("struct with %d fields", n)
	}
	return "not a struct"
}

func walkWant[T any]() string {
	if kindWant[T]() == "struct" {
		var v T
		return fmt.Sprintf("struct with %d fields", reflect.TypeOf(v).NumField())
	}
	return "not a struct"
}

func Kind[T any]() string {
	const if comptime.IsStruct[T]() {
		return "struct"
	} else {
		return "scalar"
	}
}

func Negated[T any]() string {
	const if !comptime.IsStruct[T]() {
		return "plain"
	}
	return "composite"
}

func negWant[T any]() string {
	if kindWant[T]() == "struct" {
		return "composite"
	}
	return "plain"
}

func Combined[T any]() string {
	const if debugOn && comptime.IsStruct[T]() {
		return "debug struct"
	} else const if debugOn {
		return "debug other"
	}
	return "release"
}

func combinedWant(isStruct bool) string {
	if debugOn && isStruct {
		return "debug struct"
	} else if debugOn {
		return "debug other"
	}
	return "release"
}

func Typed[T any]() string {
	const if typedOn && comptime.IsStruct[T]() {
		return "typed struct"
	}
	return "typed other"
}

func typedWant(isStruct bool) string {
	if typedOn && isStruct {
		return "typed struct"
	}
	return "typed other"
}

func Release[T any]() string {
	const if traceOff && comptime.IsStruct[T]() {
		return "trace struct"
	} else const if traceOff {
		return "trace other"
	}
	return "release"
}

func OrConn[T any]() string {
	const if comptime.IsStruct[T]() || traceOff {
		return "or struct"
	}
	return "or other"
}

func orWant(isStruct bool) string {
	if isStruct || traceOff {
		return "or struct"
	}
	return "or other"
}

func EqConn[T any]() string {
	const if comptime.IsStruct[T]() == true {
		return "eq struct"
	}
	return "eq other"
}

func NeConn[T any]() string {
	const if comptime.IsStruct[T]() != false {
		return "ne struct"
	}
	return "ne other"
}

func Shape[T any]() []string {
	var out []string
	const for _, f := range comptime.Fields[T]() {
		const if comptime.IsStruct[f.Type]() {
			out = append(out, f.Name+"{}")
		} else {
			out = append(out, f.Name)
		}
	}
	return out
}

func ShapeOr[T any]() []string {
	var out []string
	const for _, f := range comptime.Fields[T]() {
		const if comptime.IsStruct[f.Type]() || traceOff {
			out = append(out, f.Name+"{}")
		} else {
			out = append(out, f.Name)
		}
	}
	return out
}

func ShapeNe[T any]() []string {
	var out []string
	const for _, f := range comptime.Fields[T]() {
		const if comptime.IsStruct[f.Type]() != false {
			out = append(out, f.Name+"{}")
		} else {
			out = append(out, f.Name)
		}
	}
	return out
}

func concrete() string {
	const if comptime.IsStruct[Pair]() {
		return "Pair is a struct"
	} else {
		return "Pair is not a struct"
	}
}

func concreteOther() string {
	const if comptime.IsStruct[int]() {
		const for _, f := range comptime.Fields[int]() {
			_ = f
		}
		return "int is a struct"
	}
	return "int is not a struct"
}

func main() {
	check("walk-counts-pair-fields", Walk(Pair{X: 1, Y: 2}), walkWant[Pair]())
	check("walk-counts-outer-fields", Walk(Outer{}), walkWant[Outer]())
	check("walk-rejects-int", Walk(7), walkWant[int]())
	check("walk-rejects-string", Walk("s"), walkWant[string]())
	check("kind-struct", Kind[Pair](), kindWant[Pair]())
	check("kind-scalar", Kind[int](), kindWant[int]())
	check("kind-pointer-scalar", Kind[*Pair](), kindWant[*Pair]())
	check("negated-struct-composite", Negated[Pair](), negWant[Pair]())
	check("negated-scalar-plain", Negated[int](), negWant[int]())
	check("combined-struct", Combined[Pair](), combinedWant(true))
	check("combined-scalar", Combined[int](), combinedWant(false))
	check("typed-struct", Typed[Pair](), typedWant(true))
	check("typed-scalar", Typed[int](), typedWant(false))
	check("release-struct", Release[Pair](), "release")
	check("release-scalar", Release[int](), "release")
	check("or-struct", OrConn[Pair](), orWant(true))
	check("or-scalar", OrConn[int](), orWant(false))
	check("eq-struct", EqConn[Pair](), "eq struct")
	check("eq-scalar", EqConn[int](), "eq other")
	check("ne-struct", NeConn[Pair](), "ne struct")
	check("ne-scalar", NeConn[int](), "ne other")
	check("shape-marks-struct-fields", fmt.Sprint(Shape[Outer]()), "[ID Inner{} Tag]")
	check("shape-or-marks-struct-fields", fmt.Sprint(ShapeOr[Outer]()), "[ID Inner{} Tag]")
	check("shape-ne-marks-struct-fields", fmt.Sprint(ShapeNe[Outer]()), "[ID Inner{} Tag]")
	check("concrete-type-is-struct", concrete(), "Pair is a struct")
	check("concrete-type-not-struct", concreteOther(), "int is not a struct")
	check("kind-defined-over-struct", Kind[Defined](), kindWant[Defined]())
	check("kind-alias-of-struct", Kind[AliasBase](), kindWant[AliasBase]())
	check("kind-defined-over-int", Kind[OverInt](), kindWant[OverInt]())
	check("kind-alias-of-int", Kind[AliasInt](), kindWant[AliasInt]())
	check("walk-counts-defined-over-struct", Walk(Defined{N: 3}), walkWant[Defined]())
	check("walk-counts-alias-of-struct", Walk(AliasBase{N: 4}), walkWant[AliasBase]())
	if failed {
		os.Exit(1)
	}
}
