// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Qualified interface {
	const Name() string
}

type Good struct {
	name string
}

func (g Good) Name() string { return g.name }

func Identity[T any](x T) T { return x }

func GenericAs[T any](x any) T { return x.(T) }

func WrapAs[T any](x any) T { return GenericAs[T](x) }

type StoreBox[T any] struct {
	V T
}

func (b StoreBox[T]) Get() T { return b.V }

func ViaConcrete(v any) string {
	g := v.(Good)
	var q Qualified = g
	return q.Name()
}

func main() {
	g := Good{name: "ada"}
	check("w1", Identity[Qualified](g).Name() == "ada", Identity[Qualified](g).Name(), "ada")
	check("w2", Identity[int](7) == 7, Identity[int](7), 7)
	check("w3", GenericAs[int](any(41)) == 41, GenericAs[int](any(41)), 41)
	check("w4", GenericAs[Good](any(Good{name: "good"})).Name() == "good", GenericAs[Good](any(Good{name: "good"})).Name(), "good")
	check("w5", WrapAs[int](any(7))+1 == 8, WrapAs[int](any(7))+1, 8)
	b := StoreBox[Qualified]{V: Good{name: "box"}}
	check("w6", b.Get().Name() == "box", b.Get().Name(), "box")
	c := StoreBox[int]{V: 41}
	check("w7", c.Get()+1 == 42, c.Get()+1, 42)
	var v any = Good{name: "via"}
	check("w8", ViaConcrete(v) == "via", ViaConcrete(v), "via")
	d := StoreBox[Good]{V: Good{name: "held"}}
	var q Qualified = d.V
	check("w9", q.Name() == "held", q.Name(), "held")
	if failed {
		os.Exit(1)
	}
}
