// run -O=1

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}


type Creature interface {
	const Name() string
}

type Named interface {
	Creature
	const Weight() int
}

type Monster struct{ name string }

func (m *Monster) Name() string {
	if m == nil {
		return "<nil>"
	}
	return m.name
}

type Rock struct{ name string }

func (r Rock) Name() string { return "rock:" + r.name }

type Troll struct{ name string }

func (t Troll) Name() string { return "troll:" + t.name }
func (t Troll) Weight() int  { return len(t.name) }

type Monsters []*Monster

func Names(cs const []Creature) string {
	out := ""
	for i, c := range cs {
		if i > 0 {
			out += ","
		}
		out += c.Name()
	}
	return out
}

func Weights(ns const []Named) int {
	total := 0
	for _, n := range ns {
		total += n.Weight()
	}
	return total
}

func View(cs const []Creature) const []Creature { return cs }

var evals int

func monsters() []*Monster {
	evals++
	return []*Monster{{name: "orc"}, {name: "imp"}}
}

func main() {
	ms := []*Monster{{name: "orc"}, {name: "troll"}, {name: "goblin"}, {name: "imp"}}
	check("names-ms", Names(ms) == "orc,troll,goblin,imp", Names(ms), "orc,troll,goblin,imp")
	check("names-rocks", Names([]Rock{{name: "a"}, {name: "b"}}) == "rock:a,rock:b", Names([]Rock{{name: "a"}, {name: "b"}}), "rock:a,rock:b")

	trolls := []Troll{{name: "grok"}, {name: "ug"}}
	check("names-trolls", Names(trolls) == "troll:grok,troll:ug" && Weights(trolls) == 6, fmt.Sprint(Names(trolls), Weights(trolls)), "troll:grok,troll:ug 6")

	ns := []Named{Troll{name: "grok"}, Troll{name: "ug"}}
	check("names-named", Names(ns) == "troll:grok,troll:ug", Names(ns), "troll:grok,troll:ug")
	check("names-monsters", Names(Monsters{{name: "gnoll"}}) == "gnoll", Names(Monsters{{name: "gnoll"}}), "gnoll")

	var none []*Monster
	check("names-empty", len(Names(none)) == 0 && len(Names([]*Monster{})) == 0 && len(Names(nil)) == 0, fmt.Sprint(len(Names(none)), len(Names([]*Monster{})), len(Names(nil))), "0 0 0")

	s := Names(monsters())
	check("eval-once", s == "orc,imp" && evals == 1, fmt.Sprint(s, evals), "orc,imp 1")

	kept := View(ms)
	ms[0] = &Monster{name: "ogre"}
	check("view-snapshot", Names(kept) == "orc,troll,goblin,imp", Names(kept), "orc,troll,goblin,imp")
	ms[1].name = "TROLL"
	check("view-pointee", Names(kept) == "orc,TROLL,goblin,imp", Names(kept), "orc,TROLL,goblin,imp")
	check("view-source", Names(ms) == "ogre,TROLL,goblin,imp", Names(ms), "ogre,TROLL,goblin,imp")

	cs := []Creature{&Monster{name: "elf"}}
	shared := View(cs)
	cs[0] = &Monster{name: "dwarf"}
	check("view-shared", Names(shared) == "dwarf", Names(shared), "dwarf")
	if failed {
		os.Exit(1)
	}
}
