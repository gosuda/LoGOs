// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type A interface {
	const ID int64
	const Name string
}

type R struct : A {
	ID   int64
	Name string
}

func audit(a A) string {
	return $"{a.ID} {a.Name}"
}

func main() {
	got := audit(&R{ID: 1, Name: "n"})
	check("interp-const-props-format", got == fmt.Sprintf("%d %s", 1, "n") && got == "1 n", got, "1 n")
	if failed {
		os.Exit(1)
	}
}
