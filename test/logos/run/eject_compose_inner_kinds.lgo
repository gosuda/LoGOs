func chainArgTup() (string, string) {
	xs := []int{1, 2, 3}
	got := xs.take(tupA((2, "s"))).count()
	tmp := tupA((2, "s"))
	want := xs.take(tmp).count()
	return fmt.Sprint(got), fmt.Sprint(want)
}

func chainArgInterp() (string, string) {
	xs := []int{1, 2, 3}
	n := 7
	got := xs.take(len($"a{n}")).count()
	tmp := len($"a{n}")
	want := xs.take(tmp).count()
	return fmt.Sprint(got), fmt.Sprint(want)
}

func chainArgInterp2() (string, string) {
	xs := []int{1, 2, 3}
	n := 7
	got := xs.take(len($"{len($"a{n}")}")).count()
	tmp := len($"{len($"a{n}")}")
	want := xs.take(tmp).count()
	return fmt.Sprint(got), fmt.Sprint(want)
}

func chainArgMklen() (string, string) {
	xs := []int{1, 2, 3}
	v := 1
	got := xs.take(len(make([]int, v*2))).count()
	tmp := len(make([]int, v*2))
	want := xs.take(tmp).count()
	return fmt.Sprint(got), fmt.Sprint(want)
}

func propWriteInterp() (string, string) {
	n := 7
	var wb propBox
	var w Prop = &wb
	w.P = len($"a{n}")
	got := wb.P
	tmp := len($"a{n}")
	w.P = tmp
	return fmt.Sprint(got), fmt.Sprint(wb.P)
}

func propWriteMklen() (string, string) {
	v := 7
	var wb propBox
	var w Prop = &wb
	w.P = len(make([]int, v*2+2))
	got := wb.P
	tmp := len(make([]int, v*2+2))
	w.P = tmp
	return fmt.Sprint(got), fmt.Sprint(wb.P)
}

func propWriteSw() (string, string) {
	v := 7
	var wb propBox
	var w Prop = &wb
	w.P = (switch v {
	case 7 => 70
	default => 1
	})
	got := wb.P
	tmp := (switch v {
	case 7 => 70
	default => 1
	})
	w.P = tmp
	return fmt.Sprint(got), fmt.Sprint(wb.P)
}

func propWriteOptsel() (string, string) {
	v := 7
	var wb propBox
	var w Prop = &wb
	w.P = (maybeP(v)?.id ?? 0)
	got := wb.P
	tmp := (maybeP(v)?.id ?? 0)
	w.P = tmp
	return fmt.Sprint(got), fmt.Sprint(wb.P)
}

func propWriteSpread() (string, string) {
	v := 7
	st := State{A: 1, B: 2}
	var wb propBox
	var w Prop = &wb
	w.P = State{A: v, ..st}.A
	got := wb.P
	tmp := State{A: v, ..st}.A
	w.P = tmp
	return fmt.Sprint(got), fmt.Sprint(wb.P)
}

func propOpInterp() (string, string) {
	n := 7
	var wb propBox
	var w Prop = &wb
	w.P = 4
	w.P += len($"a{n}")
	got := wb.P
	tmp := len($"a{n}")
	w.P = 4
	w.P += tmp
	return fmt.Sprint(got), fmt.Sprint(wb.P)
}

