func propOpSw() (string, string) {
	v := 7
	var wb propBox
	var w Prop = &wb
	w.P = 4
	w.P += (switch v {
	case 7 => 70
	default => 1
	})
	got := wb.P
	tmp := (switch v {
	case 7 => 70
	default => 1
	})
	w.P = 4
	w.P += tmp
	return fmt.Sprint(got), fmt.Sprint(wb.P)
