package main

import (
	"errors"
	"fmt"
	"os"
)

var failed bool

func check(name string, got, want string) {
	if got != want {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type D struct {
	N int = 5
}

type Prop interface {
	P int
}

type propBox struct : Prop {
	P int
}

type State struct {
	A int
	B int
}

type pc struct {
	id int
}

func maybeP(n int) *pc? {
	if n == 7 {
		return &pc{id: 7}
	}
	return nil
}

var last int

func note(n int) { last = n }

func apply(f func(int) int, n int) int { return f(n) }

type cell struct {
	name string
	run  func() (string, string)
}

func stmtSdef() (string, string) {
	got := D{}.N
	return fmt.Sprint(got), fmt.Sprint(5)
}

func stmtInterp2() (string, string) {
	n := 7
	got := len($"{len($"a{n}")}")
	tmp := len($"a{n}")
	want := len($"{tmp}")
	return fmt.Sprint(got), fmt.Sprint(want)
}

func chainFilterSdef() (string, string) {
	xs := []int{1, 2, 3}
	got := xs.filter(x => x > D{}.N).count()
	tmp := D{}.N
	want := xs.filter(x => x > tmp).count()
	return fmt.Sprint(got), fmt.Sprint(want)
}

func chainBlockSdef() (string, string) {
	xs := []int{1, 2, 3}
	got := xs.map(x => {
		y := x + D{}.N
		return y
	}).sum()
	tmp := D{}.N
	want := xs.map(x => {
		y := x + tmp
		return y
	}).sum()
	return fmt.Sprint(got), fmt.Sprint(want)
}

func chainArgSdef() (string, string) {
	xs := []int{1, 2, 3}
	got := xs.take(D{}.N % 3).count()
	tmp := D{}.N
	want := xs.take(tmp % 3).count()
	return fmt.Sprint(got), fmt.Sprint(want)
}

func lambdaSdef() (string, string) {
	got := apply(y => y + D{}.N, 1)
	tmp := D{}.N
	want := apply(y => y + tmp, 1)
	return fmt.Sprint(got), fmt.Sprint(want)
}

func propWriteSdef() (string, string) {
	var wb propBox
	var w Prop = &wb
	w.P = D{}.N
	got := wb.P
	tmp := D{}.N
	w.P = tmp
	return fmt.Sprint(got), fmt.Sprint(wb.P)
}

func propOpSdef() (string, string) {
	var wb propBox
	var w Prop = &wb
	w.P = 4
	w.P += D{}.N
	got := wb.P
	tmp := D{}.N
	w.P = 4
	w.P += tmp
	return fmt.Sprint(got), fmt.Sprint(wb.P)
}

func deferSdef() (string, string) {
	last = 0
	func() {
		defer note(D{}.N)
	}()
	got := last
	last = 0
	tmp := D{}.N
	func() {
		defer note(tmp)
	}()
	return fmt.Sprint(got), fmt.Sprint(last)
}

func errdeferHostSdef() (err error) {
	errdefer note(D{}.N)
	return errors.New("failed")
}

func errdeferHostRef(tmp int) (err error) {
	errdefer note(tmp)
	return errors.New("failed")
}

func errdeferSdef() (string, string) {
	last = 0
	if errdeferHostSdef() == nil {
		return "no error", ""
	}
	got := last
	last = 0
	if errdeferHostRef(D{}.N) == nil {
		return "no error", ""
	}
	return fmt.Sprint(got), fmt.Sprint(last)
}

func tupA(t (int, string)) int {
	a, _ := t
	return a
}

func stmtTup() (string, string) {
	got := tupA((1, "s"))
	return fmt.Sprint(got), fmt.Sprint(1)
}

func stmtInterp() (string, string) {
	n := 7
	got := len($"a{n}")
	return fmt.Sprint(got), fmt.Sprint(2)
}

func stmtMklen() (string, string) {
	v := 7
	got := len(make([]int, v*2+2))
	return fmt.Sprint(got), fmt.Sprint(16)
}

func chainFilterTup() (string, string) {
	xs := []int{1, 2, 3}
	got := xs.filter(x => x > tupA((1, "s"))).count()
	tmp := tupA((1, "s"))
	want := xs.filter(x => x > tmp).count()
	return fmt.Sprint(got), fmt.Sprint(want)
}

func chainFilterInterp() (string, string) {
	xs := []int{1, 2, 3}
	n := 7
	got := xs.filter(x => x > len($"a{n}")).count()
	tmp := len($"a{n}")
	want := xs.filter(x => x > tmp).count()
	return fmt.Sprint(got), fmt.Sprint(want)
}

func chainFilterInterp2() (string, string) {
	xs := []int{1, 2, 3}
	n := 7
	got := xs.filter(x => x > len($"{len($"a{n}")}")).count()
	tmp := len($"{len($"a{n}")}")
	want := xs.filter(x => x > tmp).count()
	return fmt.Sprint(got), fmt.Sprint(want)
}

func chainFilterMklen() (string, string) {
	xs := []int{1, 2, 3}
	v := 7
	got := xs.filter(x => x < len(make([]int, v*2+2))).count()
	tmp := len(make([]int, v*2+2))
	want := xs.filter(x => x < tmp).count()
	return fmt.Sprint(got), fmt.Sprint(want)
}

func chainBlockTup() (string, string) {
	xs := []int{1, 2, 3}
	got := xs.map(x => {
		y := x + tupA((1, "s"))
		return y
	}).sum()
	tmp := tupA((1, "s"))
	want := xs.map(x => {
		y := x + tmp
		return y
	}).sum()
	return fmt.Sprint(got), fmt.Sprint(want)
}

