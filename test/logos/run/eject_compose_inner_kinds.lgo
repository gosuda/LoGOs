func propOpOptsel() (string, string) {
	v := 7
	var wb propBox
	var w Prop = &wb
	w.P = 4
	w.P += (maybeP(v)?.id ?? 0)
	got := wb.P
	tmp := (maybeP(v)?.id ?? 0)
	w.P = 4
	w.P += tmp
	return fmt.Sprint(got), fmt.Sprint(wb.P)
}

func propOpSpread() (string, string) {
	v := 7
	st := State{A: 1, B: 2}
	var wb propBox
	var w Prop = &wb
	w.P = 4
	w.P += State{A: v, ..st}.A
	got := wb.P
	tmp := State{A: v, ..st}.A
	w.P = 4
	w.P += tmp
	return fmt.Sprint(got), fmt.Sprint(wb.P)
}

func lambdaMklen() (string, string) {
	v := 7
	got := apply(y => y + len(make([]int, v*2+2)), 1)
	tmp := len(make([]int, v*2+2))
	want := apply(y => y + tmp, 1)
	return fmt.Sprint(got), fmt.Sprint(want)
}

func optionTupleDecl() (string, string) {
	var got (int, int)? = (5, 6)
	tmp := (5, 6)
	var want (int, int)? = tmp
	return fmt.Sprint(got), fmt.Sprint(want)
}

func optionTupleSlice() (string, string) {
	got := []((int, int)?){(1, 2), nil}
	tmp := (1, 2)
	want := []((int, int)?){tmp, nil}
	return fmt.Sprint(got), fmt.Sprint(want)
}

var cells = []cell{
	{"stmt__sdef", stmtSdef},
	{"stmt__interp2", stmtInterp2},
	{"chainfilter__sdef", chainFilterSdef},
	{"chainblock__sdef", chainBlockSdef},
	{"chainarg__sdef", chainArgSdef},
	{"lambda__sdef", lambdaSdef},
	{"propwrite__sdef", propWriteSdef},
	{"propop__sdef", propOpSdef},
	{"defer__sdef", deferSdef},
	{"errdefer__sdef", errdeferSdef},
	{"stmt__tup", stmtTup},
	{"stmt__interp", stmtInterp},
	{"stmt__mklen", stmtMklen},
	{"chainfilter__tup", chainFilterTup},
	{"chainfilter__interp", chainFilterInterp},
	{"chainfilter__interp2", chainFilterInterp2},
	{"chainfilter__mklen", chainFilterMklen},
	{"chainblock__tup", chainBlockTup},
	{"chainblock__interp", chainBlockInterp},
	{"chainblock__interp2", chainBlockInterp2},
	{"chainblock__mklen", chainBlockMklen},
	{"chainarg__tup", chainArgTup},
	{"chainarg__interp", chainArgInterp},
	{"chainarg__interp2", chainArgInterp2},
	{"chainarg__mklen", chainArgMklen},
	{"propwrite__interp", propWriteInterp},
	{"propwrite__mklen", propWriteMklen},
	{"propwrite__sw", propWriteSw},
	{"propwrite__optsel", propWriteOptsel},
	{"propwrite__spread", propWriteSpread},
	{"propop__interp", propOpInterp},
	{"propop__mklen", propOpMklen},
	{"propop__sw", propOpSw},
	{"propop__optsel", propOpOptsel},
	{"propop__spread", propOpSpread},
	{"lambda__mklen", lambdaMklen},
	{"option__tuple_decl", optionTupleDecl},
	{"option__tuple_slice", optionTupleSlice},
}

func main() {
	for _, c := range cells {
		got, want := c.run()
		check(c.name, got, want)
	}
	if failed {
		os.Exit(1)
	}
}
