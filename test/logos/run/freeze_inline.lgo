// run
package main

import (
	"fmt"
	"os"

	"logos/rt"
)

type Config struct {
	Name string
	N    int
}

func main() {
	cfg := Config{Name: "orig", N: 7}
	if rt.Freeze(&cfg).Name != "orig" {
		fmt.Println("FAIL freeze-inline-preserves-name-field: got mismatch want orig")
		os.Exit(1)
	}
	fmt.Println("ok freeze-inline-preserves-name-field")
	if rt.Freeze(&cfg).N != 7 {
		fmt.Println("FAIL freeze-inline-preserves-int-field: got mismatch want 7")
		os.Exit(1)
	}
	fmt.Println("ok freeze-inline-preserves-int-field")
}
