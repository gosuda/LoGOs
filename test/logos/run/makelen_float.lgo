// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Count int

func main() {
	f, g := 3.0, 4.0
	a := make([]byte, int(f*g))
	var w, h Count = 3, 4
	b := make([]byte, w*h)
	check("lens", len(a) == 12 && len(b) == 12, fmt.Sprint(len(a), len(b)), "12 12")
	if failed {
		os.Exit(1)
	}
}
