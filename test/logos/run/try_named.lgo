// run

package main

import (
	"errors"
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type observed[T any] struct {
	v   T
	err error
}

func observe[T any](v T, err error) observed[T] {
	return observed[T]{v, err}
}

var errNamed = errors.New("named")

func getVal(fail bool, v int) (int, error) {
	if fail {
		return 99, errNamed
	}
	return v, nil
}

func namedOK() (v int, err error) {
	v = getVal(false, 7)?
	return v, nil
}

func namedFail() (v int, err error) {
	v = getVal(true, 7)?
	return v, nil
}

func namedDefer() (v int, err error) {
	defer func() {
		okDef := err == errNamed && v == 0
		check("deferred", okDef, okDef, true)
	}()
	v = getVal(true, 7)?
	return v, nil
}

//logos:allow(slop::discarded_error)
func main() {
	v, err := namedOK()
	okOKValue := err == nil && v == 7
	check("ok-value", okOKValue, okOKValue, true)
	okOKErr := err == nil
	check("ok-err", okOKErr, okOKErr, true)
	res := observe(namedFail())
	okFailValue := res.err != nil && res.err == errNamed && res.v == 0
	check("fail-value", okFailValue, okFailValue, true)
	okFailErr := res.err == errNamed
	check("fail-err", okFailErr, okFailErr, true)
	_, _ = namedDefer()
	if failed {
		os.Exit(1)
	}
}
