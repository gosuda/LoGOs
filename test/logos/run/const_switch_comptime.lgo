// run

package main

import (
	"bytes"
	"comptime"
	"fmt"
	"io"
	"strconv"
)

func EncodeSwitch[T any](buf []byte, items []T) ([]byte, error) {
	const switch T {
	case int64:
		for _, v := range items {
			buf = strconv.AppendInt(buf, v, 10)
		}
		return buf, nil
	case io.WriterTo:
		var b bytes.Buffer
		for _, v := range items {
			v.WriteTo(&b)?
		}
		return append(buf, b.Bytes()...), nil
	}
	const if comptime.IsStruct[T]() {
		buf = append(buf, 'S')
	}
	return buf, nil
}

type Word struct {
	S string
}

func (w Word) WriteTo(dst io.Writer) (int64, error) {
	n, err := dst.Write([]byte(w.S))
	return int64(n), err
}

type Point struct {
	X int
	Y int
}

func check(name string, got []byte, gotErr error, want string) {
	if gotErr != nil || string(got) != want {
		fmt.Println("FAIL", name, "got", string(got), gotErr, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func main() {
	b, err := EncodeSwitch([]byte("nums:"), []int64{1, 2, 3})
	want := []byte("nums:")
	for _, v := range []int64{1, 2, 3} {
		want = strconv.AppendInt(want, v, 10)
	}
	check("exact", b, err, string(want))

	b, err = EncodeSwitch([]byte("words:"), []Word{{"a"}, {"b"}})
	var wb bytes.Buffer
	for _, w := range []Word{{"a"}, {"b"}} {
		wb.WriteString(w.S)
	}
	check("iface", b, err, "words:"+wb.String())

	b, err = EncodeSwitch([]byte("point:"), []Point{{1, 2}})
	check("struct-default", b, err, "point:S")

	b, err = EncodeSwitch([]byte("keep:"), []string{"x", "y"})
	check("plain-default", b, err, "keep:")
}
