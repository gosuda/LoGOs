package main

import (
	"fmt"
	"strings"
)

type P struct {
	N int
}

func id(n int) int {
	return n
}

func show(args ...any) string {
	return strings.TrimSuffix(fmt.Sprintln(args...), "\n")
}

func cell(name string, got func() string, want string) {
	if g := got(); g != want {
		fmt.Println("FAIL", name, "got", g, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func takesInt(p (int, int)) string {
	a, b := p
	return show(a, b)
}

func takesStr(p (int, string)) string {
	a, b := p
	return show(a, b)
}

func retFirstCoal(o int?) (int, int) {
	return (o ?? 7, 5)
}

func retSecondCoal(o int?) (int, int) {
	return (5, o ?? 7)
}

func retSecondMap(m map[string]int) (int, int) {
	return (5, m["zz"] ?? 8)
}

func retSecondIdx(m map[string]int) (int, int?) {
	return (5, m["a"])
}

func retSecondSel(p *P?) (int, int?) {
	return (5, p?.N)
}

func retSecondInterp(n int) (int, string) {
	return (5, $"n={n}")
}

func retSecondArg(o int?) (int, int) {
	return (5, id(o ?? 3))
}

func coalCells() {
	var o int? = nil
	cell("coal__first", func() string { a, b := (o ?? 7, 5); return show(a, b) }, "7 5")
	cell("coal__second", func() string { a, b := (5, o ?? 7); return show(a, b) }, "5 7")
	cell("coal__assign", func() string { t := (5, o ?? 7); return show(t) }, "{5 7}")
	cell("coal__nested_first", func() string { t := ((o ?? 7, 2), (3, 4)); a, b := t; return show(a, b) }, "{7 2} {3 4}")
	cell("coal__nested_second", func() string { t := ((1, 2), (3, o ?? 7)); a, b := t; return show(a, b) }, "{1 2} {3 7}")
	cell("coal__triple", func() string { a, b, c := (1, o ?? 7, 3); return show(a, b, c) }, "1 7 3")
	cell("coal__return", func() string { a, b := retFirstCoal(o); c, d := retSecondCoal(o); return show(a, b, c, d) }, "7 5 5 7")
	cell("coal__argument", func() string { return takesInt((5, o ?? 7)) }, "5 7")
	cell("coal__element", func() string { xs := [](int, int){(5, o ?? 7)}; a, b := xs[0]; return show(a, b) }, "5 7")
}

func mapcoalCells() {
	m := map[string]int{"a": 1}
	cell("mapcoal__first", func() string { a, b := (m["zz"] ?? 8, 5); return show(a, b) }, "8 5")
	cell("mapcoal__second", func() string { a, b := (5, m["zz"] ?? 8); return show(a, b) }, "5 8")
	cell("mapcoal__assign", func() string { t := (5, m["zz"] ?? 8); return show(t) }, "{5 8}")
	cell("mapcoal__nested_first", func() string { t := ((m["zz"] ?? 8, 2), (3, 4)); a, b := t; return show(a, b) }, "{8 2} {3 4}")
	cell("mapcoal__nested_second", func() string { t := ((1, 2), (3, m["zz"] ?? 8)); a, b := t; return show(a, b) }, "{1 2} {3 8}")
	cell("mapcoal__triple", func() string { a, b, c := (1, m["zz"] ?? 8, 3); return show(a, b, c) }, "1 8 3")
	cell("mapcoal__return", func() string { a, b := retSecondMap(m); return show(a, b) }, "5 8")
	cell("mapcoal__argument", func() string { return takesInt((5, m["zz"] ?? 8)) }, "5 8")
	cell("mapcoal__element", func() string { xs := [](int, int){(5, m["zz"] ?? 8)}; a, b := xs[0]; return show(a, b) }, "5 8")
}

func mapidxCells() {
	m := map[string]int{"a": 1}
	cell("mapidx__first", func() string { a, b := (m["a"], 5); return show(a ?? -1, b) }, "1 5")
	cell("mapidx__second", func() string { a, b := (5, m["a"]); return show(a, b ?? -1) }, "5 1")
	cell("mapidx__assign", func() string { t := (5, m["a"]); a, b := t; return show(a, b ?? -1) }, "5 1")
	cell("mapidx__nested_first", func() string { t := ((m["a"], 2), (3, 4)); a, b := t; x, y := a; return show(x ?? -1, y, b) }, "1 2 {3 4}")
	cell("mapidx__nested_second", func() string { t := ((1, 2), (3, m["a"])); a, b := t; x, y := b; return show(a, x, y ?? -1) }, "{1 2} 3 1")
	cell("mapidx__triple", func() string { a, b, c := (1, m["a"], 3); return show(a, b ?? -1, c) }, "1 1 3")
	cell("mapidx__return", func() string { a, b := retSecondIdx(m); return show(a, b ?? -1) }, "5 1")
}

func optselCells() {
	var p *P? = &P{N: 4}
	cell("optsel__first", func() string { a, b := (p?.N, 5); return show(a ?? -1, b) }, "4 5")
	cell("optsel__second", func() string { a, b := (5, p?.N); return show(a, b ?? -1) }, "5 4")
	cell("optsel__assign", func() string { t := (5, p?.N); a, b := t; return show(a, b ?? -1) }, "5 4")
	cell("optsel__nested_first", func() string { t := ((p?.N, 2), (3, 4)); a, b := t; x, y := a; return show(x ?? -1, y, b) }, "4 2 {3 4}")
	cell("optsel__nested_second", func() string { t := ((1, 2), (3, p?.N)); a, b := t; x, y := b; return show(a, x, y ?? -1) }, "{1 2} 3 4")
	cell("optsel__triple", func() string { a, b, c := (1, p?.N, 3); return show(a, b ?? -1, c) }, "1 4 3")
	cell("optsel__return", func() string { a, b := retSecondSel(p); return show(a, b ?? -1) }, "5 4")
}

func interpCells() {
	n := 3
	cell("interp__first", func() string { a, b := ($"n={n}", 5); return show(a, b) }, "n=3 5")
	cell("interp__second", func() string { a, b := (5, $"n={n}"); return show(a, b) }, "5 n=3")
	cell("interp__assign", func() string { t := (5, $"n={n}"); return show(t) }, "{5 n=3}")
	cell("interp__nested_first", func() string { t := (($"n={n}", 2), (3, 4)); a, b := t; return show(a, b) }, "{n=3 2} {3 4}")
	cell("interp__nested_second", func() string { t := ((1, 2), (3, $"n={n}")); a, b := t; return show(a, b) }, "{1 2} {3 n=3}")
	cell("interp__triple", func() string { a, b, c := (1, $"n={n}", 3); return show(a, b, c) }, "1 n=3 3")
	cell("interp__return", func() string { a, b := retSecondInterp(n); return show(a, b) }, "5 n=3")
	cell("interp__argument", func() string { return takesStr((5, $"n={n}")) }, "5 n=3")
	cell("interp__element", func() string { xs := [](int, string){(5, $"n={n}")}; a, b := xs[0]; return show(a, b) }, "5 n=3")
}

func callargCells() {
	var o int? = nil
	cell("callarg__first", func() string { a, b := (id(o ?? 3), 5); return show(a, b) }, "3 5")
	cell("callarg__second", func() string { a, b := (5, id(o ?? 3)); return show(a, b) }, "5 3")
	cell("callarg__assign", func() string { t := (5, id(o ?? 3)); return show(t) }, "{5 3}")
	cell("callarg__nested_first", func() string { t := ((id(o ?? 3), 2), (3, 4)); a, b := t; return show(a, b) }, "{3 2} {3 4}")
	cell("callarg__nested_second", func() string { t := ((1, 2), (3, id(o ?? 3))); a, b := t; return show(a, b) }, "{1 2} {3 3}")
	cell("callarg__triple", func() string { a, b, c := (1, id(o ?? 3), 3); return show(a, b, c) }, "1 3 3")
	cell("callarg__return", func() string { a, b := retSecondArg(o); return show(a, b) }, "5 3")
	cell("callarg__argument", func() string { return takesInt((5, id(o ?? 3))) }, "5 3")
	cell("callarg__element", func() string { xs := [](int, int){(5, id(o ?? 3))}; a, b := xs[0]; return show(a, b) }, "5 3")
}

func main() {
	coalCells()
	mapcoalCells()
	mapidxCells()
	optselCells()
	interpCells()
	callargCells()
	cell("plain__nested", func() string { t := ((1, 2), (3, 4)); a, b := t; return show(a, b) }, "{1 2} {3 4}")
}
