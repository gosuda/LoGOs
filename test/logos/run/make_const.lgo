// run
package main

import (
	"fmt"
	"os"
)

const K = 3

func main() {
	failed := false
	eq := func(name string, got, want int) {
		if got != want {
			fmt.Printf("FAIL %s: got %d want %d\n", name, got, want)
			failed = true
			return
		}
		fmt.Printf("ok %s\n", name)
	}
	a := make([]int, 2.0*3.0)
	b := make([]int, K*K)
	n := 4
	c := make([]int, 2.0*n)
	d := make([]int, (2.0*3.0)*n)
	xs := []int{1, 2, 3}
	e := make([]int, len(xs)*n)
	f := make([]int, n*(n*2))
	g := make([]int, n*xs[1])
	h := make([]int, (n)*len(xs))
	i := make([]int, n* /* gap */ n)
	eq("constant-product-stays-constant", len(a), 6)
	eq("named-constant-product-stays-constant", len(b), 9)
	eq("float-constant-times-variable", len(c), 8)
	eq("parenthesized-constant-product-times-variable", len(d), 24)
	eq("index-expression-times-variable", len(e), 12)
	eq("variable-times-nested-product", len(f), 32)
	eq("variable-times-element", len(g), 8)
	eq("variable-times-builtin-len", len(h), 12)
	eq("variable-squared", len(i), 16)
	if failed {
		os.Exit(1)
	}
}
