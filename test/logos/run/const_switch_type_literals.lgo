// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func kind[T any]() string {
	const switch T {
	case func():
		return "func"
	case interface{}:
		return "any"
	}
	return "other"
}

func shape[T any]() string {
	const switch T {
	case struct{ X int }:
		return "struct"
	case interface{}:
		return "any"
	}
	return "other"
}

func main() {
	check("kind-func", kind[func()]() == "func", kind[func()](), "func")
	check("kind-any", kind[int]() == "any", kind[int](), "any")
	check("shape-struct", shape[struct{ X int }]() == "struct", shape[struct{ X int }](), "struct")
	check("shape-any", shape[int]() == "any", shape[int](), "any")
	if failed {
		os.Exit(1)
	}
}
