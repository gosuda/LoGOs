// run

package main

import "fmt"


func kind[T any]() string {
	const switch T {
	case func():
		return "func"
	case interface{}:
		return "any"
	}
	return "other"
}

func shape[T any]() string {
	const switch T {
	case struct{ X int }:
		return "struct"
	case interface{}:
		return "any"
	}
	return "other"
}

func main() {
	fmt.Println(kind[func()]())
	fmt.Println(kind[int]())
	fmt.Println(shape[struct{ X int }]())
	fmt.Println(shape[int]())
}
