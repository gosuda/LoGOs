// run -goexperiment logosarena

package main


import (
	"fmt"
	"os"
	"runtime"
)

type r46Node struct {
	v int
}

//go:noinline
func r46Sum(s []*r46Node) int {
	total := 0
	for _, p := range s {
		total += p.v
	}
	return total
}

//go:noinline
func r46Build(n int) []*r46Node {
	s := make([]*r46Node, 0, n)
	for i := 0; i < n; i++ {
		s = append(s, &r46Node{v: i})
	}
	return s
}

var r46Failed bool

func r46Check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		r46Failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	n := 64
	s := r46Build(n)
	before := r46Sum(s)
	runtime.GC()
	runtime.GC()
	after := r46Sum(s)
	runtime.KeepAlive(s)
	want := n * (n - 1) / 2
	r46Check("arena-scan-gc-before", before == want, fmt.Sprint(before), fmt.Sprint(want))
	r46Check("arena-scan-gc-after", after == want, fmt.Sprint(after), fmt.Sprint(want))
	r46Check("arena-scan-gc-stable", before == after, fmt.Sprint(after), fmt.Sprint(before))
	if r46Failed {
		os.Exit(1)
	}
}
