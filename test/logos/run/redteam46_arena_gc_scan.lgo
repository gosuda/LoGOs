// run -goexperiment logosarena

package main


import (
	"fmt"
	"runtime"
)

type r46Node struct {
	v int
}

//go:noinline
func r46Sum(s []*r46Node) int {
	total := 0
	for _, p := range s {
		total += p.v
	}
	return total
}

//go:noinline
func r46Build(n int) []*r46Node {
	s := make([]*r46Node, 0, n)
	for i := 0; i < n; i++ {
		s = append(s, &r46Node{v: i})
	}
	return s
}

func main() {
	n := 64
	s := r46Build(n)
	before := r46Sum(s)
	runtime.GC()
	runtime.GC()
	after := r46Sum(s)
	runtime.KeepAlive(s)
	fmt.Println("scan-gc:", before, after)
	if before != 2016 || after != 2016 {
		panic("redteam46: scan-region referents lost across GC")
	}
}
