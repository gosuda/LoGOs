// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type P struct {
	N int64
	O string?
}

func main() {
	xs := []P{{N: 1}, {N: 2}}
	xs[1].O = "b"
	got := xs.map(x => x.O ?? "none")
	check("chain-coalesce-fills-missing", fmt.Sprint(got) == "[none b]", fmt.Sprint(got), "[none b]")
	if failed {
		os.Exit(1)
	}
}
