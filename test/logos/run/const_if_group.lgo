// run


package main

import (
	"context"
	"fmt"
	"os"
	"sync/atomic"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

const on = true

var total atomic.Int64

func bump(n int) error {
	total.Add(int64(n))
	return nil
}

func fill(ctx context.Context) error {
	go group (ctx) {
		const if on {
			go bump(1)
		} else {
			go bump(100)
		}
		go {
			const if !on {
				total.Add(10000)
			} else {
				total.Add(20)
			}
		}
	}
	return nil
}

func main() {
	if err := fill(context.Background()); err != nil {
		check("fill", false, err, nil)
		os.Exit(1)
	}
	got := total.Load()
	check("total", got == 21, got, 21)
	if failed {
		os.Exit(1)
	}
}
