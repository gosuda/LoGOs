// run

package main

import "fmt"

const m = map[int]string{1: "a", 2: "b", 3: "c"}

var _ [len(m)]int

var _ = [len(m)]int{1, 2, 3}

var fwd [len(m2)]int

func take(a [len(m)]int) [len(m)]int {
	return a
}

type strct struct {
	f [len(m)]int
}

type arr [len(m)]int

type box[T any] struct {
	v T
}

var _ box[[len(m)]int]

var _ [len(m)*2 + 1]int

const sh = 1 << len(m)

func check(cond bool, name string) {
	if cond {
		fmt.Println("ok " + name)
	} else {
		fmt.Println("FAIL " + name)
	}
}

func main() {
	a := take([len(m)]int{1, 2, 3})
	check(len(a) == 3, "len-sig")
	s := strct{f: [len(m)]int{1, 2, 3}}
	check(len(s.f) == 3, "len-field")
	var r arr
	check(len(r) == 3, "len-type")
	b := box[[len(m)]int]{v: [len(m)]int{1, 2, 3}}
	check(len(b.v) == 3, "len-generic")
	var big [len(m)*2 + 1]int
	check(len(big) == 7, "len-expr")
	check(sh == 8, "len-shift")
	switch len(m) {
	case len(m):
		fmt.Println("ok len-case")
	default:
		fmt.Println("FAIL len-case")
	}
	var lv [len(m)]int
	lv[2] = 1
	check(len(lv) == 3 && lv[2] == 1, "len-local")
	cv := ([len(m)]int)([3]int{1, 2, 3})
	check(len(cv) == 3 && cv[0] == 1, "len-conv")
	np := new([len(m)]int)
	np[1] = 2
	check(len(np) == 3 && np[1] == 2, "len-new")
	ms := make([][len(m)]int, 2)
	ms[0][2] = 3
	check(len(ms) == 2 && len(ms[0]) == 3 && ms[0][2] == 3, "len-make")
	var nn [len(m)][len(m)]int
	var no [2][len(m)]int
	var ni [len(m)][2]int
	nn[2][2] = 1
	no[1][0] = 2
	ni[0][1] = 3
	check(len(nn) == 3 && len(nn[2]) == 3 && len(no[1]) == 3 && len(ni) == 3 && nn[2][2]+no[1][0]+ni[0][1] == 6, "len-nested")
	cl := func(a [len(m)]int) [len(m)]int {
		var w [len(m)]int
		w = a
		return w
	}
	cr := cl([len(m)]int{9, 8, 7})
	check(len(cr) == 3 && cr[0] == 9 && cr[2] == 7, "len-closure")
	var tc any = [len(m)]int{5, 5, 5}
	switch v := tc.(type) {
	case [len(m)]int:
		check(len(v) == 3 && v[1] == 5, "len-typecase")
	default:
		check(false, "len-typecase")
	}
	const lm = map[string]int{"a": 1, "b": 2}
	var lc [len(lm)]int
	check(len(lc) == 2, "len-localconst")
	fwd[3] = 4
	check(len(fwd) == 4 && fwd[3] == 4, "len-forward")
}

const m2 = map[string]int{"a": 1, "b": 2, "c": 3, "d": 4}
