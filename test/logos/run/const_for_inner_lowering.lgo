// run


package main

import (
	"comptime"
	"errors"
	"fmt"
	"os"
	"strconv"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Row struct {
	Name  string
	Count int
	Ok    bool
}

func parse(s string) (int, error) {
	n, err := strconv.Atoi(s)
	if err != nil {
		return 0, errors.New("bad " + s)
	}
	return n, nil
}

func total(in string, log *[]string) (int, error) {
	sum := 0
	const for _, f := range comptime.Fields[Row]() {
		n := parse(in)?
		sum += n
		*log = append(*log, $"{f.Name}={sum}")
	}
	return sum, nil
}

func summed() int {
	s := 0
	const for _, f := range comptime.Fields[Row]() {
		s += []int{1, 2, 3}.map(x => x + f.Index).sum()
	}
	return s
}

func main() {
	var log []string
	got, err := total("5", &log)
	wantLog := []string{"Name=5", "Count=10", "Ok=15"}
	check("total-lines", fmt.Sprint(log) == fmt.Sprint(wantLog), log, wantLog)
	if err != nil {
		check("total-sum", false, err, 15)
	} else {
		check("total-sum", got == 15, got, 15)
	}
	var badLog []string
	gotBad, errBad := total("z", &badLog)
	if errBad != nil {
		check("total-bad-err", errBad.Error() == "bad z", errBad.Error(), "bad z")
		check("total-bad-sum", gotBad == 0, gotBad, 0)
	} else {
		check("total-bad-err", false, nil, "bad z")
		check("total-bad-sum", false, gotBad, 0)
	}
	check("summed", summed() == 27, summed(), 27)
	if failed {
		os.Exit(1)
	}
}
