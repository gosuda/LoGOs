// run
package main

import (
	"fmt"
	"os"
)

type User struct {
	Name string
}

var failed = false

func eq(name string, got, want int) {
	if got != want {
		fmt.Printf("FAIL %s: got %d want %d\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func bs(name string, got, want bool) {
	if got != want {
		fmt.Printf("FAIL %s: got %v want %v\n", name, got, want)
		failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func checkScalars() {
	m := map[string]int{"a": 0, "b": 5}
	eq("missing-key-falls-back-to-default", m["zzz"] ?? -1, -1)
	eq("present-zero-key-yields-zero", m["a"] ?? -1, 0)
	eq("present-nonzero-key-yields-value", m["b"] ?? -1, 5)
	va := m["a"]
	eq("direct-index-of-present-binds-value", va ?? 99, 0)
	vz, okz := m["zzz"]
	eq("direct-index-of-missing-binds-zero", vz, 0)
	bs("direct-index-of-missing-reports-not-ok", !okz, true)
	x := m["a"]
	eq("bound-present-value-falls-back-to-itself", x ?? -1, 0)
	y := m["zzz"]
	eq("bound-missing-value-falls-back-to-default", y ?? -1, -1)
	v, ok := m["a"]
	eq("comma-ok-value", v, 0)
	bs("comma-ok-present", ok, true)
	m["c"] = 42
	m["c"]++
	m["c"] += 1
	eq("write-read-modify-cycle", m["c"] ?? -1, 44)
	delete(m, "c")
	eq("deleted-key-falls-back-to-default", m["c"] ?? -1, -1)
}

func checkSlices() {
	ms := map[string][]int{"n": nil, "e": {1, 2}}
	dflt := []int{9}
	bs("present-nil-payload-keeps-nil-against-default", (ms["n"] ?? dflt) == nil, true)
	if ms["n"] == nil {
		fmt.Println("FAIL direct-index-of-nil-payload-is-present: got nil")
		failed = true
	} else {
		fmt.Println("ok direct-index-of-nil-payload-is-present")
	}
	eq("missing-key-yields-default-length", len(ms["zzz"] ?? dflt), 1)
	if ms["zzz"] != nil {
		fmt.Println("FAIL direct-index-of-missing-slice-is-nil: got non-nil")
		failed = true
	} else {
		fmt.Println("ok direct-index-of-missing-slice-is-nil")
	}
	vn, okn := ms["n"]
	bs("comma-ok-keeps-nil-payload-with-ok", vn == nil && okn, true)
	bs("nil-payload-coalesces-to-nil-not-default", (ms["n"] ?? dflt) == nil, true)
	eq("present-slice-length-ignores-default", len(ms["e"] ?? dflt), 2)
}

func checkPointers() {
	mu := map[string]*User{"u": &User{Name: "ann"}}
	guest := &User{Name: "guest"}
	bs("present-pointer-selects-field", (mu["u"] ?? guest).Name == "ann", true)
	bs("missing-pointer-falls-back-to-guest", (mu["zzz"] ?? guest).Name == "guest", true)
}

func main() {
	checkScalars()
	checkSlices()
	checkPointers()
	if failed {
		os.Exit(1)
	}
}
