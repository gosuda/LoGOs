// run

package main

import "fmt"

type RO interface {
	const ID int
	const Start() error
}

type Gadget struct : RO {
	ID int
}

func (m Gadget) Start() error { return nil }

type Probe struct : RO {
	ID int
}

func (m *Probe) Start() error { return nil }

func show[T RO](x T) T { return x }

func get() RO { return Gadget{ID: 3} }

func main() {
	var r RO = Gadget{ID: 1}
	r = Gadget{ID: 2}
	fmt.Println(r.ID)
	fmt.Println(get().ID)
	rs := []RO{Gadget{ID: 5}}
	fmt.Println(rs[0].ID)
	m := map[string]RO{"a": Gadget{ID: 6}}
	if mv, ok := m["a"]; ok {
		fmt.Println(mv.ID)
	}
	ch := make(chan RO, 1)
	ch <- Gadget{ID: 7}
	fmt.Println((<-ch).ID)
	fmt.Println(show(Gadget{ID: 8}).ID)
	var p RO = &Probe{ID: 9}
	fmt.Println(p.ID)
}
