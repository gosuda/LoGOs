// run

package main


import "fmt"

func main() {
	buf := make([]byte, 0, 64)
	total := 0
	for i := 0; i < 10; i++ {
		buf = buf[:0]
		buf = append(buf, byte(i), byte(i+1))
		total += len(buf)
	}
	s := []int{1, 2, 3, 4, 5}
	s = s[:0]
	s = append(s, 9)
	b := make([]byte, 4, 8)
	b = b[:cap(b)]
	fmt.Println(total, s, len(b), cap(b))
}
