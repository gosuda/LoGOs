// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

func main() {
	buf := make([]byte, 0, 64)
	total := 0
	for i := 0; i < 10; i++ {
		buf = buf[:0]
		buf = append(buf, byte(i), byte(i+1))
		total += len(buf)
	}
	s := []int{1, 2, 3, 4, 5}
	s = s[:0]
	s = append(s, 9)
	b := make([]byte, 4, 8)
	b = b[:cap(b)]
	check("total", total == 20, total, 20)
	check("reslice", len(s) == 1 && s[0] == 9, fmt.Sprint(s), "[9]")
	check("cap", len(b) == 8 && cap(b) == 8, fmt.Sprint(len(b), cap(b)), "8 8")
	if failed {
		os.Exit(1)
	}
}
