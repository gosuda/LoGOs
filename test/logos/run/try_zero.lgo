// run

package main

import (
	"errors"
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

var errZero = errors.New("zero")

type Point struct{ X, Y int }

var payloadInt = 42

func failPoint() (Point, error) { return Point{X: 5, Y: 6}, errZero }
func failArray() ([3]int, error) { return [3]int{1, 2, 3}, errZero }
func failPtr() (*int, error) { return &payloadInt, errZero }
func failSlice() ([]int, error) { return []int{1, 2}, errZero }
func failMap() (map[string]int, error) { return map[string]int{"k": 1}, errZero }
func failString() (string, error) { return "payload", errZero }

func failGeneric[T any](v T) (T, error) { return v, errZero }

func takePoint() (Point, error) {
	p := failPoint()?
	return p, nil
}

func takeArray() ([3]int, error) {
	a := failArray()?
	return a, nil
}

func takePtr() (*int, error) {
	p := failPtr()?
	return p, nil
}

func takeSlice() ([]int, error) {
	s := failSlice()?
	return s, nil
}

func takeMap() (map[string]int, error) {
	m := failMap()?
	return m, nil
}

func takeString() (string, error) {
	s := failString()?
	return s, nil
}

func takeGen[T any](v T) (T, error) {
	g := failGeneric[T](v)?
	return g, nil
}

var observedAssign Point

func takeAssign() (Point, error) {
	observedAssign = Point{X: 9, Y: 9}
	observedAssign = failPoint()?
	return observedAssign, nil
}

func main() {
	p, errP := takePoint()
	check("point", p == (Point{}) && errP == errZero, fmt.Sprint(p, errP), "{0 0} zero")
	a, errA := takeArray()
	check("array", a == ([3]int{}) && errA == errZero, fmt.Sprint(a, errA), "[0 0 0] zero")
	pt, errPt := takePtr()
	check("ptr", pt == nil && errPt == errZero, fmt.Sprint(pt, errPt), "<nil> zero")
	s, errS := takeSlice()
	check("slice", s == nil && errS == errZero, fmt.Sprint(s, errS), "[] zero")
	m, errM := takeMap()
	check("map", len(m) == 0 && errM == errZero, fmt.Sprint(m, errM), "map[] zero")
	st, errSt := takeString()
	check("str", st == "" && errSt == errZero, fmt.Sprint(st, errSt), " zero")
	g, errG := takeGen(7)
	check("gen", g == 0 && errG == errZero, fmt.Sprint(g, errG), "0 zero")
	_, errAssign := takeAssign()
	want, wantErr := failPoint()
	check("assign", errAssign != nil && wantErr != nil && observedAssign == want, fmt.Sprint(observedAssign, errAssign), "{5 6} zero")
	if failed {
		os.Exit(1)
	}
}
