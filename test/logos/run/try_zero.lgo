// run

package main

import (
	"errors"
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

var errZero = errors.New("zero")

type Point struct{ X, Y int }

var payloadInt = 42

func failPoint() (Point, error) { return Point{X: 5, Y: 6}, errZero }
func failArray() ([3]int, error) { return [3]int{1, 2, 3}, errZero }
func failPtr() (*int, error) { return &payloadInt, errZero }
func failSlice() ([]int, error) { return []int{1, 2}, errZero }
func failMap() (map[string]int, error) { return map[string]int{"k": 1}, errZero }
func failString() (string, error) { return "payload", errZero }

func failGeneric[T any](v T) (T, error) { return v, errZero }

func takePoint() (Point, error) {
	p := failPoint()?
	return p, nil
}

func takeArray() ([3]int, error) {
	a := failArray()?
	return a, nil
}

func takePtr() (*int, error) {
	p := failPtr()?
	return p, nil
}

func takeSlice() ([]int, error) {
	s := failSlice()?
	return s, nil
}

func takeMap() (map[string]int, error) {
	m := failMap()?
	return m, nil
}

func takeString() (string, error) {
	s := failString()?
	return s, nil
}

func takeGen[T any](v T) (T, error) {
	g := failGeneric[T](v)?
	return g, nil
}

var observedAssign Point

func takeAssign() (Point, error) {
	observedAssign = Point{X: 9, Y: 9}
	observedAssign = failPoint()?
	return observedAssign, nil
}

func zeroCase[T any](name string, f func() (T, error), zero func(T) bool, want string) {
	v, err := f()
	if err == nil {
		check(name, false, "nil error", want)
		return
	}
	check(name, zero(v) && err == errZero, fmt.Sprint(v, err), want)
}

func main() {
	zeroCase("point", takePoint, func(p Point) bool { return p == (Point{}) }, "{0 0} zero")
	zeroCase("array", takeArray, func(a [3]int) bool { return a == ([3]int{}) }, "[0 0 0] zero")
	zeroCase("ptr", takePtr, func(p *int) bool { return p == nil }, "<nil> zero")
	zeroCase("slice", takeSlice, func(s []int) bool { return s == nil }, "[] zero")
	zeroCase("map", takeMap, func(m map[string]int) bool { return len(m) == 0 }, "map[] zero")
	zeroCase("str", takeString, func(s string) bool { return s == "" }, " zero")
	zeroCase("gen", func() (int, error) { return takeGen(7) }, func(g int) bool { return g == 0 }, "0 zero")
	_, errAssign := takeAssign()
	want, wantErr := failPoint()
	if wantErr == nil {
		check("assign", false, "nil error", "{5 6} zero")
	} else {
		check("assign", errAssign != nil && observedAssign == want, fmt.Sprint(observedAssign, errAssign), "{5 6} zero")
	}
	if failed {
		os.Exit(1)
	}
}
