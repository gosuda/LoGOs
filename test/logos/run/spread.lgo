// run

package main

import (
	"fmt"
	"os"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type State struct {
	A int
	B int
}

type Named struct {
	A     int
	Label string
}

type Only struct {
	Z int
}

type Big struct {
	X   int
	Y   int
	Pad [4080]byte
}

var evals int

func src() State {
	evals++
	return State{A: 1, B: 2}
}

type Tri struct {
	A int
	B int
	C int
}

func bumpC(p *Tri) int {
	p.C = 99
	return 7
}

func boomInt() int {
	panic("boom")
}

func headerSelfUpdates() {
	hi := Tri{A: 1, B: 2, C: 3}
	if hi = (Tri{A: bumpC(&hi), ..hi}); hi.A == 7 {
		check("spread-self-update-in-if-header", hi == Tri{A: 7, B: 2, C: 99}, hi, Tri{A: 7, B: 2, C: 99})
	}
	hs := Tri{A: 1, B: 2, C: 3}
	switch hs = (Tri{A: 5, C: bumpC(&hs), ..hs}); hs.A {
	case 5:
		check("spread-self-update-in-switch-header", hs == Tri{A: 5, B: 2, C: 7}, hs, Tri{A: 5, B: 2, C: 7})
	}
	hf := Tri{A: 1, B: 2, C: 3}
	steps := 0
	for hf = (Tri{A: 0, ..hf}); hf.A < 2; hf = (Tri{A: hf.A + 1, ..hf}) {
		steps++
	}
	check("spread-self-update-in-for-header", hf == Tri{A: 2, B: 2, C: 3} && steps == 2, fmt.Sprint(hf, steps), "{2 2 3} 2")
	he := Tri{A: 1, B: 2, C: 3}
	branch := "none"
	if he.A == 0 {
		branch = "first"
	} else if he = (Tri{B: 8, ..he}); he.B == 8 {
		branch = "second"
	}
	check("spread-self-update-in-else-if-header", branch == "second" && he == Tri{A: 1, B: 8, C: 3}, fmt.Sprint(branch, he), "second {1 8 3}")
}

func main() {
	s := State{A: 10, ..State{A: 1, B: 2}}
	check("spread-explicit-field-wins", s == State{A: 10, B: 2}, s, State{A: 10, B: 2})
	t := State{..State{A: 3, B: 4}, B: 40}
	check("spread-base-fills-missing-field", t == State{A: 3, B: 40}, t, State{A: 3, B: 40})
	evals = 0
	u := State{B: 20, ..src()}
	check("spread-base-evaluated-once", evals == 1 && u == State{A: 1, B: 20}, fmt.Sprint(u.A, u.B, evals), "1 20 1")
	v := State{A: 3, B: 4}
	v = State{A: v.B, B: v.A, ..v}
	check("spread-rhs-snapshots-before-assign", v == State{A: 4, B: 3}, v, State{A: 4, B: 3})
	n := Named{Label: "a", ..State{A: 7, B: 8}}
	check("spread-base-matches-by-name", n == Named{A: 7, Label: "a"}, n, Named{A: 7, Label: "a"})
	m := Named{..State{A: 9, B: 10}, Label: "b"}
	check("spread-base-position-independent", m == Named{A: 9, Label: "b"}, m, Named{A: 9, Label: "b"})
	w := State{A: 11, B: 12}
	w = State{..w}
	check("spread-self-base-keeps-fields", w == State{A: 11, B: 12}, w, State{A: 11, B: 12})
	evals = 0
	z := Only{Z: 5, ..src()}
	check("spread-unused-base-still-evaluated-once", evals == 1 && z == Only{Z: 5}, fmt.Sprint(z.Z, evals), "5 1")
	evals = 0
	_ = State{A: 1, B: 2, ..src()}
	check("spread-fully-shadowed-base-still-evaluated-once", evals == 1, evals, 1)
	var b Big
	b.X = 5
	b.Y = 6
	b.Pad[0] = 7
	b.Pad[4079] = 8
	b = Big{X: b.Y, ..b}
	check("spread-self-base-preserves-padding", b.X == 6 && b.Y == 6 && b.Pad[0] == 7 && b.Pad[4079] == 8, fmt.Sprint(b.X, b.Y, b.Pad[0], b.Pad[4079]), "6 6 7 8")
	tri := Tri{A: 1, B: 2, C: 3}
	tri = Tri{..tri, A: bumpC(&tri)}
	check("spread-self-update-leaves-unlisted-fields-untouched", tri == Tri{A: 7, B: 2, C: 99}, tri, Tri{A: 7, B: 2, C: 99})
	keep := State{A: 1, B: 2}
	hit := func() (recovered bool) {
		defer func() { recovered = recover() != nil }()
		keep = State{A: 10, B: boomInt(), ..keep}
		return false
	}()
	check("spread-self-update-writes-nothing-when-an-explicit-expression-panics", hit && keep == State{A: 1, B: 2}, fmt.Sprint(hit, keep), "true {1 2}")
	headerSelfUpdates()
	if failed {
		os.Exit(1)
	}
}
