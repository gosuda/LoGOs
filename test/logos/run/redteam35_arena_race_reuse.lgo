// run -goexperiment logosarena -race

package main


import "fmt"

//go:noinline
func r35Sum(b []byte) int {
	s := 0
	for _, v := range b {
		s += int(v)
	}
	return s
}

//go:noinline
func r35Oracle(n, r int) int {
	s := 0
	for i := 0; i < n; i++ {
		s += int(byte((i + r) & 0xFF))
	}
	return s
}

//go:noinline
func r35Work(n, rounds int) int {
	total := 0
	for r := 0; r < rounds; r++ {
		b := make([]byte, n)
		for i := range b {
			b[i] = byte((i + r) & 0xFF)
		}
		got := r35Sum(b)
		want := r35Oracle(n, r)
		if got != want {
			panic("redteam35: round reuse corrupted data")
		}
		total += got
	}
	return total
}

//go:noinline
func r35Interleave(n int) int {
	var kept []byte
	last := 0
	for r := 0; r < 4; r++ {
		b := make([]byte, n)
		for i := range b {
			b[i] = byte(r + 1)
		}
		if r == 0 {
			kept = b
		}
		last = r35Sum(b)
	}
	first := r35Sum(kept)
	if first != n*1 {
		panic("redteam35: carried buffer aliased by later reuse")
	}
	if last != n*4 {
		panic("redteam35: last buffer has wrong contents")
	}
	return first + last
}

func main() {
	total := r35Work(1024, 200)
	fmt.Println("reuse:", total)
	fmt.Println("interleave:", r35Interleave(1024))
}
