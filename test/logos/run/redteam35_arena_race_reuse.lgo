// run -goexperiment logosarena -race

package main


import (
	"fmt"
	"os"
)

//go:noinline
func r35Sum(b []byte) int {
	s := 0
	for _, v := range b {
		s += int(v)
	}
	return s
}

//go:noinline
func r35Oracle(n, r int) int {
	s := 0
	for i := 0; i < n; i++ {
		s += int(byte((i + r) & 0xFF))
	}
	return s
}

//go:noinline
func r35Work(n, rounds int) (int, int) {
	total := 0
	want := 0
	for r := 0; r < rounds; r++ {
		b := make([]byte, n)
		for i := range b {
			b[i] = byte((i + r) & 0xFF)
		}
		got := r35Sum(b)
		w := r35Oracle(n, r)
		want += w
		if got != w {
			return got, w
		}
		total += got
	}
	return total, want
}

func r35Interleave(n int) (int, int, int) {
	var kept []byte
	last := 0
	for r := 0; r < 4; r++ {
		b := make([]byte, n)
		for i := range b {
			b[i] = byte(r + 1)
		}
		if r == 0 {
			kept = b
		}
		last = r35Sum(b)
	}
	first := r35Sum(kept)
	return first, last, first + last
}

var r35Failed bool

func r35Check(name string, cond bool, got, want string) {
	if !cond {
		fmt.Printf("FAIL %s: got %s want %s\n", name, got, want)
		r35Failed = true
		return
	}
	fmt.Printf("ok %s\n", name)
}

func main() {
	total, want := r35Work(1024, 200)
	r35Check("arena-reuse-rounds", total == want, fmt.Sprint(total), fmt.Sprint(want))
	first, last, both := r35Interleave(1024)
	r35Check("arena-reuse-carried", first == 1024*1, fmt.Sprint(first), fmt.Sprint(1024*1))
	r35Check("arena-reuse-last", last == 1024*4, fmt.Sprint(last), fmt.Sprint(1024*4))
	r35Check("arena-reuse-interleave", both == 1024*5, fmt.Sprint(both), fmt.Sprint(1024*5))
	if r35Failed {
		os.Exit(1)
	}
}
