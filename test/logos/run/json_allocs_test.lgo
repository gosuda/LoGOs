type sizeCase struct {
	n            int
	load         func(data []byte) error
	marshalGen   func() ([]byte, error)
	marshalStd   func() ([]byte, error)
	unmarshalGen func(data []byte) error
	unmarshalStd func(data []byte) error
}

var (
	failed    bool
	sinkBytes []byte
)

func report(name string, ok bool, format string, args ...any) {
	if ok {
		fmt.Println("ok", name)
		return
	}
	failed = true
	fmt.Println("FAIL", name+":", fmt.Sprintf(format, args...))
}

func must(b []byte, err error) []byte {
	if err != nil {
		fmt.Println("FAIL", err)
		os.Exit(1)
	}
	return b
}

func mustNil(err error) {
	if err != nil {
		fmt.Println("FAIL", err)
		os.Exit(1)
	}
}

func distinctValue(field, run int) string {
	return fmt.Sprintf("v%03d_%03d", field, run)
}

func oneByteValue(field, run int) string {
	return "x"
}

func payloadSet(n, count int, value func(field, run int) string) [][]byte {
	set := make([][]byte, count)
	for run := range set {
		var sb strings.Builder
		sb.WriteString("{")
		for field := range n {
			if field > 0 {
				sb.WriteString(",")
			}
			fmt.Fprintf(&sb, "%q:%q", fmt.Sprintf("F%03d", field), value(field, run))
		}
		sb.WriteString("}")
		set[run] = []byte(sb.String())
	}
	return set
}

func allocsOver(set [][]byte, fn func(data []byte)) float64 {
	next := 0
	return testing.AllocsPerRun(len(set)-1, func() {
		fn(set[next])
		next++
	})
}

func loadBoth(data []byte, gen, std any) error {
	if err := json.Unmarshal(data, gen); err != nil {
		return err
	}
	return json.Unmarshal(data, std)
}

func case5() sizeCase {
	var g S5
	var r R5
	return sizeCase{
		n:          5,
		load:       func(data []byte) error { return loadBoth(data, &g, &r) },
		marshalGen: func() ([]byte, error) { return g.MarshalJSON() },
		marshalStd: func() ([]byte, error) { return json.Marshal(&r) },
		unmarshalGen: func(data []byte) error {
			var v S5
			return v.UnmarshalJSON(data)
		},
		unmarshalStd: func(data []byte) error {
			var v R5
			return json.Unmarshal(data, &v)
		},
	}
}

func case20() sizeCase {
	var g S20
	var r R20
	return sizeCase{
		n:          20,
		load:       func(data []byte) error { return loadBoth(data, &g, &r) },
		marshalGen: func() ([]byte, error) { return g.MarshalJSON() },
		marshalStd: func() ([]byte, error) { return json.Marshal(&r) },
		unmarshalGen: func(data []byte) error {
			var v S20
			return v.UnmarshalJSON(data)
		},
		unmarshalStd: func(data []byte) error {
			var v R20
			return json.Unmarshal(data, &v)
		},
	}
}

func case100() sizeCase {
	var g S100
	var r R100
	return sizeCase{
		n:          100,
		load:       func(data []byte) error { return loadBoth(data, &g, &r) },
		marshalGen: func() ([]byte, error) { return g.MarshalJSON() },
		marshalStd: func() ([]byte, error) { return json.Marshal(&r) },
		unmarshalGen: func(data []byte) error {
			var v S100
			return v.UnmarshalJSON(data)
		},
		unmarshalStd: func(data []byte) error {
			var v R100
			return json.Unmarshal(data, &v)
		},
	}
}

func checkSize(c sizeCase) {
	label := func(what string) string { return fmt.Sprintf("%s-%d", what, c.n) }
	distinct := payloadSet(c.n, 201, distinctValue)
	mustNil(c.load(distinct[0]))
	report(label("marshal-bytes"), string(must(c.marshalGen())) == string(must(c.marshalStd())), "generated and reflective output differ")
	marshal := testing.AllocsPerRun(200, func() { sinkBytes = must(c.marshalGen()) })
	report(label("marshal-single-make"), marshal == 1, "MarshalJSON allocated %v times, SPEC 10.1 fixes one make", marshal)
	gen := allocsOver(distinct, func(data []byte) { mustNil(c.unmarshalGen(data)) })
	std := allocsOver(distinct, func(data []byte) { mustNil(c.unmarshalStd(data)) })
	report(label("unmarshal-vs-reflective"), gen <= std, "generated %v allocations, encoding/json %v", gen, std)
	report(label("unmarshal-per-value"), gen <= float64(c.n), "generated %v allocations for %d string values", gen, c.n)
	single := payloadSet(c.n, 201, oneByteValue)
	perKey := allocsOver(single, func(data []byte) { mustNil(c.unmarshalGen(data)) })
	report(label("unmarshal-per-key"), perKey == 0, "generated %v allocations for %d one-byte values", perKey, c.n)
}

func main() {
	for _, c := range []sizeCase{case5(), case20(), case100()} {
		checkSize(c)
	}
	if failed {
		os.Exit(1)
	}
}
