// run

package main

import (
	"context"
	"errors"
	"fmt"
	"io"
	"log/slog"
	"maps"
	"os"
	"slices"

	"logos/sync"
)

var failed bool

func check(name string, cond bool, got, want any) {
	if !cond {
		failed = true
		fmt.Println("FAIL", name+":", "got", got, "want", want)
		return
	}
	fmt.Println("ok", name)
}

type Auditable interface {
	const ID int64
	const Author string
	Validate() error
}

type Filled struct {
	TxID  string
	Price int64
}

type Rejected struct {
	Reason string
	Code   int
}

type Pending struct{}

type OrderResult interface {
	Filled | Rejected | Pending
}

const feeTierBps = map[string]int64{
	"VIP":      2,
	"STANDARD": 10,
	"GUEST":    25,
}

const quoteCents = map[string]int64{
	"ACME":    12000,
	"GLOBEX":  34000,
	"INITECH": 7500,
}

type CreateOrderReq struct : Auditable {
	ID       int64
	Author   string
	Symbol   string
	Qty      int64  = 1
	Tier     string = "STANDARD"
	PromoTag string?
}

func (r const *CreateOrderReq) Validate() error {
	if r.Qty <= 0 {
		return errors.New($"invalid quantity {r.Qty} for order {r.ID}")
	}
	return nil
}

type RiskConfig struct {
	HoldQty int64 = 500
	MaxQty  int64 = 1000
}

type dbStats struct {
	Trades    int
	Commits   int
	Rollbacks int
	Closes    int
}

type Database struct {
	stats sync.Locked[dbStats]
}

type Tx struct {
	db *Database
}

func NewDatabase() *Database {
	return &Database{}
}

func (d *Database) Begin(ctx context.Context) (*Tx, error) {
	return &Tx{db: d}, ctx.Err()
}

func (d *Database) Stats() dbStats {
	var snap dbStats
	d.stats.WithLock(s => {
		snap = *s
	})
	return snap
}

func (t *Tx) ExecuteTrade(symbol string, qty, bps int64) (int64, error) {
	quote, ok := quoteCents[symbol]
	if !ok {
		return 0, errors.New($"no quote for symbol {symbol}")
	}
	t.db.stats.WithLock(s => {
		s.Trades++
	})
	gross := quote * qty
	return gross + gross*bps/10000, nil
}

func (t *Tx) Commit() error {
	t.db.stats.WithLock(s => {
		s.Commits++
	})
	return nil
}

func (t *Tx) Rollback() error {
	t.db.stats.WithLock(s => {
		s.Rollbacks++
	})
	return nil
}

func (t *Tx) Close() error {
	t.db.stats.WithLock(s => {
		s.Closes++
	})
	return nil
}

type OrderService struct {
	db     *Database
	logger *slog.Logger
	ledger sync.Locked[map[int64]OrderResult]
	config sync.Hot[RiskConfig]
}

func NewOrderService(db *Database, logger *slog.Logger) *OrderService {
	svc := &OrderService{db: db, logger: logger}
	svc.ledger.WithLock(m => {
		*m = map[int64]OrderResult{}
	})
	svc.config.Store(&RiskConfig{})
	return svc
}

func (s *OrderService) SetLimits(holdQty, maxQty int64) {
	s.config.Update(old => &RiskConfig{HoldQty: holdQty, MaxQty: maxQty})
}

func (s *OrderService) ProcessBatch(ctx context.Context, batch const []CreateOrderReq) ([]string, error) {
	for i := range batch {
		batch[i].Validate()?
	}

	tx := s.db.Begin(ctx)?
	defer tx.Close()?
	errdefer tx.Rollback()?
	errdefer s.forget(batch)

	go group (ctx, limit = 8) {
		for _, req := range batch {
			go {
				res := s.execute(tx, req)?
				s.ledger.WithLock(m => {
					(*m)[req.ID] = res
				})
			}
		}
	}

	tx.Commit()?

	receipts := batch
		.filter(r => r.Qty >= 10)
		.map(r => $"Order #{r.ID} by {r.Author} ({r.PromoTag ?? "NO-PROMO"})")

	s.logger.Info("batch committed", "orders", len(batch), "receipts", len(receipts))
	return receipts, nil
}

func (s *OrderService) execute(tx *Tx, req const CreateOrderReq) (OrderResult, error) {
	cfg := s.config.Load()
	if req.Qty > cfg.MaxQty {
		return Rejected{Reason: $"quantity {req.Qty} above limit {cfg.MaxQty}", Code: 422}, nil
	}
	if req.Qty > cfg.HoldQty {
		return Pending{}, nil
	}
	bps := feeTierBps[req.Tier] ?? 25
	price := tx.ExecuteTrade(req.Symbol, req.Qty, bps)?
	return Filled{TxID: $"TX-{req.ID}", Price: price}, nil
}

func (s *OrderService) forget(batch const []CreateOrderReq) {
	s.ledger.WithLock(m => {
		for _, req := range batch {
			delete(*m, req.ID)
		}
	})
}

func (s *OrderService) Report() []string {
	var lines []string
	s.ledger.WithLock(m => {
		for _, id := range slices.Sorted(maps.Keys(*m)) {
			res, _ := (*m)[id]
			lines = append(lines, $"#{id} {describe(res)}")
		}
	})
	return lines
}

func describe(r OrderResult) string {
	var line string
	switch v := r.(type) {
	case Filled:
		line = $"filled {v.TxID} at {v.Price}"
	case Rejected:
		line = $"rejected: {v.Reason} (code {v.Code})"
	case Pending:
		line = "pending review"
	case nil:
		line = "unknown"
	}
	return line
}

func newLogger() *slog.Logger {
	return slog.New(slog.NewTextHandler(io.Discard, &slog.HandlerOptions{}))
}

func Audit(a Auditable) string {
	return $"order {a.ID} submitted by {a.Author}"
}

func receipt(id int64, author, tag string) string {
	return fmt.Sprint("Order #", id, " by ", author, " (", tag, ")")
}

func run() error {
	ctx := context.Background()
	svc := NewOrderService(NewDatabase(), newLogger())

	first := []CreateOrderReq{
		{ID: 101, Author: "ada", Symbol: "ACME", Qty: 40, PromoTag: "SPRING"},
		{ID: 102, Author: "bob", Symbol: "GLOBEX", Qty: 5, Tier: "VIP"},
		{ID: 103, Author: "cyd", Symbol: "INITECH", Qty: 700, Tier: "PLATINUM"},
		{ID: 104, Author: "dee", Symbol: "ACME", Qty: 2000, Tier: "GUEST"},
		{ID: 105, Author: "eve", Symbol: "GLOBEX", Qty: 12, Tier: "PLATINUM"},
	}
	if _, ok := any(&first[0]).(*CreateOrderReq); !ok {
		failNow("pointer assertion failed")
	}
	gotAudit := Audit(&first[0])
	check("audit-names-order-and-author", gotAudit == "order 101 submitted by ada", gotAudit, "order 101 submitted by ada")
	if err := checkFirstBatch(ctx, svc, first); err != nil {
		return err
	}
	if err := checkSecondBatch(ctx, svc); err != nil {
		return err
	}
	if err := checkFailedBatches(ctx, svc); err != nil {
		return err
	}
	stats := svc.db.Stats()
	check("commit-rollback-close-counts", stats.Commits == 2 && stats.Rollbacks == 1 && stats.Closes == 3, fmt.Sprint(stats.Commits, stats.Rollbacks, stats.Closes), "2 1 3")
	return nil
}

func checkFirstBatch(ctx context.Context, svc *OrderService, first []CreateOrderReq) error {
	receipts := svc.ProcessBatch(ctx, first)?
	check("receipts-filter-below-threshold", fmt.Sprint(receipts) == fmt.Sprint([]string{
		receipt(101, "ada", "SPRING"),
		receipt(103, "cyd", "NO-PROMO"),
		receipt(104, "dee", "NO-PROMO"),
		receipt(105, "eve", "NO-PROMO"),
	}), fmt.Sprint(receipts), "[Order #101 by ada (SPRING) Order #103 by cyd (NO-PROMO) Order #104 by dee (NO-PROMO) Order #105 by eve (NO-PROMO)]")
	check("ledger-records-filled-with-fee-price", fmt.Sprint(svc.Report()) == fmt.Sprint([]string{
		"#101 filled TX-101 at 480480",
		"#102 filled TX-102 at 170034",
		"#103 pending review",
		"#104 rejected: quantity 2000 above limit 1000 (code 422)",
		"#105 filled TX-105 at 409020",
	}), fmt.Sprint(svc.Report()), "batch1")
	check("only-filled-orders-trade", svc.db.Stats().Trades == 3, svc.db.Stats().Trades, 3)
	return nil
}

func checkSecondBatch(ctx context.Context, svc *OrderService) error {
	svc.SetLimits(800, 1000)
	second := []CreateOrderReq{
		{ID: 103, Author: "cyd", Symbol: "INITECH", Qty: 700, Tier: "PLATINUM"},
		{ID: 106, Author: "joy", Symbol: "ACME"},
	}
	receipts := svc.ProcessBatch(ctx, second)?
	check("receipts-cover-second-batch", fmt.Sprint(receipts) == fmt.Sprint([]string{
		receipt(103, "cyd", "NO-PROMO"),
	}), fmt.Sprint(receipts), "[Order #103 by cyd (NO-PROMO)]")
	check("ledger-is-sorted-by-id", slices.IsSorted(svc.Report()), fmt.Sprint(svc.Report()), "sorted")
	check("raised-limits-fill-previous-pending", fmt.Sprint(svc.Report()) == fmt.Sprint([]string{
		"#101 filled TX-101 at 480480",
		"#102 filled TX-102 at 170034",
		"#103 filled TX-103 at 5263125",
		"#104 rejected: quantity 2000 above limit 1000 (code 422)",
		"#105 filled TX-105 at 409020",
		"#106 filled TX-106 at 12012",
	}), fmt.Sprint(svc.Report()), "batch2")
	return nil
}

func checkFailedBatches(ctx context.Context, svc *OrderService) error {
	before := svc.Report()
	_, err := svc.ProcessBatch(ctx, []CreateOrderReq{
		{ID: 201, Author: "fay", Symbol: "ACME", Qty: 10},
		{ID: 202, Author: "gus", Symbol: "ACME", Qty: 0},
	})
	check("validation-rejects-zero-quantity", err != nil && err.Error() == "invalid quantity 0 for order 202", fmt.Sprint(err), "invalid quantity 0 for order 202")
	_, err = svc.ProcessBatch(ctx, []CreateOrderReq{
		{ID: 301, Author: "hal", Symbol: "ACME", Qty: 10},
		{ID: 302, Author: "ivy", Symbol: "NOPE", Qty: 10},
	})
	check("missing-quote-fails-batch", err != nil && err.Error() == "no quote for symbol NOPE", fmt.Sprint(err), "no quote for symbol NOPE")
	check("failed-batches-leave-ledger-unchanged", fmt.Sprint(svc.Report()) == fmt.Sprint(before), fmt.Sprint(svc.Report()), fmt.Sprint(before))
	return nil
}

func failNow(tag string) {
	failed = true
	fmt.Println("FAIL", tag)
	os.Exit(1)
}

func main() {
	if err := run(); err != nil {
		if !failed {
			fmt.Println("FAIL run:", err)
		}
		os.Exit(1)
	}
	if failed {
		os.Exit(1)
	}
}
